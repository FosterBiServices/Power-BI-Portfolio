	measure '<WINDOW_START_MEASURE_NAME>' = MIN('<SLICER_TABLE_NAME>'[<DATE_COLUMN_NAME>])
		formatString: <MEASURE_DATE_FORMAT>
		lineageTag: <WINDOW_START_LINEAGE_TAG>

	measure '<WINDOW_END_MEASURE_NAME>' = MAX('<SLICER_TABLE_NAME>'[<DATE_COLUMN_NAME>])
		formatString: <MEASURE_DATE_FORMAT>
		lineageTag: <WINDOW_END_LINEAGE_TAG>
