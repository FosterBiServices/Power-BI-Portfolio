			/// Plots cumulative enrollment totals over time for the trend line chart. For each month in the Dynamic Slicer, it calculates Enrolled Individuals as of that month. Returns BLANK when the month is out of scope or outside the valid date window, preventing phantom data points.
			measure 'Enrollment Trend' = ```
					
					VAR __Result = 
					    CALCULATE(
					        [Enrolled Individuals],
					        ALL( 'dimDate' ),
					        'dimdate'[Month Year]
					            = SELECTEDVALUE( 'Dynamic Slicer'[Month] )
					    )
					  
					RETURN
					
					    IF(
					        NOT ISINSCOPE( 'Dynamic Slicer'[Month] ),
					        BLANK()
					        ,
					        IF
					        (
					            SELECTEDVALUE( 'Dynamic Slicer'[Month Sort] )
					            <= MAX( 'dimDate'[Month Sort] )
					            && SELECTEDVALUE( 'Dynamic Slicer'[Month Sort] )
					            >= MAX( 'dimDate'[Month Sort] ) - 11,
					            __Result
					        )
					    )
					```
				displayFolder: Enrollment\Trend
				lineageTag: 76b11610-380b-4870-83a8-f36f6ef685b8

				annotation PBI_FormatHint = {"isGeneralNumber":true}

