			/// A code identifying the agency responsible for the participant's case.
			column 'AGENCY CODE'
				dataType: string
				lineageTag: c4c6e22e-9b2e-43e3-896b-f3fd1cfbf31d
				summarizeBy: none
				sourceColumn: AGENCY CODE

				annotation SummarizationSetBy = Automatic

			/// Calculated column that concatenates the service category and service name to create a user-friendly display label for the service provided.
			column 'SERVICE PROVIDED' =
					SWITCH(
						TRUE,
						ISBLANK('ServicesProvided'[SERVICE]),
						"(Blank)",
						'ServicesProvided'[SERVICE] IN {"101 - Orientation",
							"102 - Initial Assessment",
							"106 - In Program ""Follow Up""",
							"107 - Provision of Labor Market Research",
							"108 - Referred to WIOA Services (not training)",
							"109 - Referred to Community Resource",
							"112 - Job Fair",
							"115 - Resume Preparation Assistance",
							"121 - Job Referral: Job Outside CalJOBS (non-Federal)",
							"125 - Job Search and Placement Assistance",
							"134 - Workshop"},
						"BASIC",
						'ServicesProvided'[SERVICE] IN {"010 - Co-Funded Service"},
						"HOUSEKEEPING",
						'ServicesProvided'[SERVICE] IN {"181 - Supportive Service: Transportation Assistance",
							"185 - Supportive Service: Other",
							"188 - Supportive Service: Tools/Clothing",
							"190 - Supportive Service: Utilities",
							"200 - Individual Counseling",
							"202 - Career Guidance/Planning",
							"203 - Objective Assessment",
							"205 - Development of Individual Employment Plan (IEP)"},
						"INDIVIDUAL SERVICES",
						'ServicesProvided'[SERVICE] IN {"215 - Short-Term Prevocational Services",
							"300 - Occupational Skills Training (Approved ETPL Provider)",
							"321 - Transitional Job",
							"328 - Occupational Skills Training (non-ETPL Provider)"},
						"TRAINING",
						'ServicesProvided'[SERVICE]
					)
				lineageTag: 40bc1787-20ac-43ea-851e-9f8686a7e4d6
				summarizeBy: none

				extendedProperty GroupingMetadata =
