			measure 'Enrollment TT - Progress Bar SVG' = ```
					
					VAR _target = [Target]
					VAR _value  = [Enrollment Switch]
					VAR _PM = [Bubble Switch]
					VAR _text = IF ( _value = 1, "Enrollment", "Enrollments" )
					
					/* CARD SIZE */
					VAR _width  = 400
					VAR _height = 150
					VAR _paddingX = 20
					VAR _visualXOffset = 20  -- tweak between 15–30 for your card
					
					/* STATE */
					VAR _hasTarget =
					    NOT ISBLANK(_target) && _target > 0
					
					VAR _div =
					    DIVIDE(_value, _target)
					
					/* COLORS */
					VAR _positive = "#658E95"
					VAR _negative = "#7D1D3A"
					VAR _grey     = "#D0D0D0"
					
					VAR _stateColor =
					    IF(_value < _target, _negative, _positive)
					VAR _ChangeColor = [Mom CF Switch]
					
					/* SVG CORE */
					VAR _svg =
					"data:image/svg+xml;utf8,
					<svg xmlns='http://www.w3.org/2000/svg'
					     viewBox='0 0 " & _width & " " & _height & "'>
					
					<style>
					text{
					    font-family: Segoe UI;
					    text-anchor: middle;
					    dominant-baseline: middle;
					}
					.main{
					    fill:" & _positive & ";
					    font-size:18px;
					    font-weight:600;
					}
					.sub{
					    fill:#888;
					    font-size:18px;
					}
					.monthsub{
					    fill:" & _ChangeColor & ";
					    font-size:18px;
					}
					.total{
					    fill:" & _stateColor & ";
					    font-size:18px;
					    font-weight:600;
					}
					.barBg{
					    fill:" & _grey & ";
					}
					.barFg{
					    fill:" & _stateColor & ";
					}
					</style>
					<g transform='translate(" & _visualXOffset & ",0)'>
					"
					
					/* TEXT */
					VAR _texts =
					IF(
					    NOT _hasTarget,
					    "
					    <text class='main' x='50%' y='75' style='font-size:36px'>
					        " & FORMAT(_value, "#,0") & " Enrolled
					    </text>
					    ",
					    "
					    <text class='main' x='50%' y='32'>
					        Total Enrollments: " & FORMAT(_value, "#,0") &
					    "</text>
					
					    <text class='sub' x='50%' y='58'>
					        Target: " & _target &
					    "</text>
					
					    <text class='total' x='50%' y='84'>
					        " & FORMAT(_div, "0.0%") & " of target reached " &
					    "</text>
					
					    <text class='sub' x='50%' y='110'>
					        " & ABS(_value - _target) &
					        IF(_value >= _target, " over target", " below target") &
					    "</text>
					    "
					)
					/* MONTHLY TEXT */
					VAR _montexts =
					IF(
					    NOT _hasTarget,
					    "
					    <text class='main' x='50%' y='75' style='font-size:48px'>
					        " & FORMAT(_value, "#,0") & " " & _text & "
					    </text>
					    <text class='monthsub' x='50%' y='115' style='font-size:24px'>
					        " & _PM &
					    "</text>
					    ",
					    "
					    <text class='main' x='50%' y='75' style='font-size:48px'>
					        " & FORMAT(_value, "#,0") & " " & _text & "
					    </text>
					    <text class='monthsub' x='50%' y='115' style='font-size:24px'>
					         " & _PM &
					    "</text>
					    "
					)
					/* BAR */
					VAR _bar =
					IF(
					    NOT _hasTarget,
					    "",
					    VAR _usableWidth = _width - (_paddingX * 2)
					    VAR _barWidth =
					        MIN(_usableWidth, _usableWidth * _div)
					    RETURN
					    "<rect class='barBg'
					          x='" & _paddingX & "'
					          y='136'
					          width='" & _usableWidth & "'
					          height='10' rx='5'/>
					
					    <rect class='barFg'
					          x='" & _paddingX & "'
					          y='136'
					          width='" & _barWidth & "'
					          height='10' rx='5'/>
					    "
					)
					
					/* CLOSE */
					RETURN
					IF ( 
					    SELECTEDVALUE('Aggregation Table'[Aggregation], "Total") = "Total", 
					_svg & _texts & _bar & "</g></svg>", 
					[Enrollment TT - Card with Columns]
					//_svg & _montexts & "</g></svg>"
					)
					```
				lineageTag: c906bef7-9a9b-45ee-b2e0-1c827e3f21df

			/// Returns the total enrollment target value for comparison against actual enrollments. Used in KPI cards and SVG visuals to benchmark progress toward planned enrollment goals.
			measure Target = SUM('Targets'[ENROLLMENT TARGETS] )
				formatString: 0
				lineageTag: fa42e123-5ca1-421e-a6ea-b939e6f13220

			measure 'Enrollment to Target SVG Total' =
					
					
					/* SETUP */
					VAR _total = [Target]  // Will be used as a target
					VAR _value = [Localized Enrollments Total] // Will be used as a current value
					VAR _width = 250 // Width size of the SVG
					VAR _height = 310 // Height size of the SVG
					VAR _CanvasSize = MIN( _height, _width ) // Canvas size
					VAR _paddning = 15 // Padding between the circle and the canvas
					
					/* COLOR DEFINITION */
					VAR _positive = "#658E95" // Positive Color
					VAR _neutral = "#E7E74E" // Neutral Color
					VAR _negative = "#7D1D3A" // Negative Color
					
					/* PRE CALCULATION */
					VAR _halfSize = _CanvasSize / 2 // Half of the canvas size
					VAR _r = _halfSize - _paddning * 1.5 // Radius of the circle
					VAR _round = 2 * PI( ) * _r // Circumference of the circle
					VAR _perc = IF(_value && _total,  DIVIDE(_value, _total) ) // Percentage of the current value
					VAR _ratio = _round - _round * _perc // Ratio of the current value
					VAR _clr =  // Determine the color of the circle based on the percentage
					SWITCH(
					        TRUE( ),
					        _perc >= 0.75, _positive, // Positive Color
					        _perc >= 0.5, _neutral, // Neutral Color
					        _negative // Negative Color
					    )
					
					/* STYLE DECLARTIONS */
					VAR _styles =
					    "
					  <style>
					    text{
					        font-family: Segoe UI;
					    }
					    .backgroundCircle{
					      transform:rotate(-90deg) translate(-"
					        & ( _height + _width ) / 2
					        & "px, "
					        & ( _width - _height ) / 2
					        & "px);
					    }
					    .backgroundCircle{
					      fill: transparent;
					      stroke-width: "
					        & _paddning
					        & ";
					    }
					    .background{
					      stroke: #e0e0e0;
					    }
					    .filling{
					      stroke: "
					        & _clr
					        & ";
					      stroke-linecap: round;
					      stroke-dasharray: "
					        & _round
					        & ";
					      stroke-dashoffset: "
					        & _ratio
					        & ";
					    }
					    .mainText{
					      fill: "
					        & _clr
					        & ";
					      font-size: 300%;
					      text-anchor: middle;
					      dominant-baseline: middle;
					      font-weight: bold;
					    }
					    .subTexts{
					      fill: #CCCCCC;
					      font-size: 150%;
					      dominant-baseline: middle;
					    }
					    .leftPositioned{
					        text-anchor: end;
					    }
					    .rightPositioned{
					        text-anchor: start;
					    }
					    .bolden{
					        font-weight: bold;
					    }
					  </style>
					"
					
					/* SVG DECLARTIONS */
					VAR _svgDeclaration = "data:image/svg+xml;utf8,"
					VAR _svgHeader = "<svg xmlns='http://www.w3.org/2000/svg' height='" & _height & "' width='" & _width & "'>"
					VAR _svgEnd = "</svg>"
					
					/* CALCULATION */
					VAR _sv =
					    "
					  <g class='backgroundCircle'>
					  <circle r='" & _r & "' cx='50%' cy='50%' class='background' />
					  <circle r='" & _r
					        & "' cx='50%' cy='50%' class='filling'/>
					  </g>
					  <g class='mainText'>
					  <text x='50%' y='37.5%' >"
					        & FORMAT( _perc, "0.0%" )
					        & "</text>
					  </g>
					  <g class='subTexts'>
					  <g class='leftPositioned'>
					  <text x='55%' y='50.5%' >"
					        & "Target:"
					        & "</text>
					  <text x='55%' y='60%' >"
					        & "Enrolled:"
					        & "</text>
					  <text x='55%' y='69.5%' class='bolden'>"
					        & "Delta:"
					        & "</text>
					  </g>
					  <g class='rightPositioned'>
					  <text x='57%' y='50.5%' >"
					        & _total
					        & "</text>
					  <text x='57%' y='60%' >"
					        & ROUND( _value, 1 )
					        & "</text>
					  <text x='57%' y='69.5%' class='bolden'>"
					        & ROUND( _total - _value, 1 )
					        & "</text>
					  </g>
					  </g>
					"
					VAR _result = _svgDeclaration & _svgHeader & _styles & _sv & _svgEnd
					RETURN
					    _result
				lineageTag: 010001d2-5140-4394-a866-e4ca3dccd839

