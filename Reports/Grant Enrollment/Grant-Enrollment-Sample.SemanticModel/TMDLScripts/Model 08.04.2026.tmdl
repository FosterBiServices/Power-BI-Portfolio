			/// Returns a conditional format color for assessment response counts based on the selected survey response. Uses SurveyResponseColorMap to ensure consistent color encoding across all assessment visuals.
			measure 'Responses CF' = ```
					
					VAR resp =
					    SELECTEDVALUE ( 'NeedsAssessmentResponses'[RESPONSE] )
					RETURN
					COALESCE (
					    LOOKUPVALUE (
					        SurveyResponseColorMap[HexColor],
					        SurveyResponseColorMap[RESPONSE], resp
					    ),
					    "#004081"   -- default gray for informational / lists / free text
					)
					
