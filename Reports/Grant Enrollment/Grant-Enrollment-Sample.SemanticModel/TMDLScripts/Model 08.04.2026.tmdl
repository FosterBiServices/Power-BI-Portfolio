			partition ServicesProvided = m
				mode: import
				queryGroup: facts
				source = ```
						let
						  Source = Excel.Workbook(
						    Web.Contents(
						      "https://apmus.sharepoint.com/sites/DataandInsights/Shared%20Documents/Power%20BI%20Source%20Files/DOR-AJCC%20Collab/(All)%20DOR-AJCC%20Collab_SevicesProvided.xlsx"
						    ), 
						    null, 
						    true
						  ),
						    Sheet1_Sheet = Source{[Item="Sheet1",Kind="Sheet"]}[Data],
						    PromoteHeaders = Table.PromoteHeaders(Sheet1_Sheet, [PromoteAllScalars=true])
						, 
						  TypePairs = {
						    {"CREATE DATE", type date}, 
						    {"ACTUAL BEGIN DATE", type date}, 
						    {"PROJECTED BEGIN DATE", type date}, 
						    {"ACTUAL END DATE", type date}, 
						    {"PROJECTED END DATE", type date}, 
						    {
						      "MOST RECENT EMPLOYMENT DATE", 
						      type date
						    }, 
						    {"USER ID", Int64.Type}, 
						    {"STATE ID", type text}, 
						    {"APP ID", type text}, 
						    {"REGION LWDB", type text}, 
						    {"OFFICE", type text}, 
						    {
						      "OFFICE OF RESPONSIBILITY", 
						      type text
						    }, 
						    {"SERVICE", type text}, 
						    {"NAICS", type text}, 
						    {"ONET", type text}, 
						    {"COMPLETION STATUS", type text}, 
						    {"PROGRAM", type text}, 
						    {"PROVIDER", type text}, 
						    {
						      "REGISTERED APPRENTICESHIP", 
						      type text
						    }, 
						    {
						      "TYPE OF APPRENTICESHIP", 
						      type text
						    }, 
						    {"HISPANIC", type text}, 
						    {"LEARNING MODE", type text}, 
						    {"AGENCY CODE", type text}, 
						    {"COMMENTS", type text}
						  }, 
						  ExistingCols = Table.ColumnNames(
						    PromoteHeaders
						  ), 
						  // Keep type rules only for columns that actually exist
						  TypePairsExistingOnly = List.Select(
						    TypePairs, 
						    each List.Contains(
						      ExistingCols, 
						      _{0}
						    )
						  ), 
						  // Convert those explicit pairs into a lookup record: ColumnName -> Type
						  ExplicitTypeMap = Record.FromList(
						    List.Transform(
						      TypePairsExistingOnly, 
						      each _{1}
						    ), 
						    List.Transform(
						      TypePairsExistingOnly, 
						      each _{0}
						    )
						  ), 
						  // - If we specified a type in ExplicitTypeMap, use it.
						  // - Otherwise default to type text.
						  AllTypePairs = List.Transform(
						    ExistingCols, 
						    (c) => {
						      c, 
						      Record.FieldOrDefault(
						        ExplicitTypeMap, 
						        c, 
						        type text
						      )
						    }
						  ), 
						  // Apply types in one go
						  ChangeTypes
						    = Table.TransformColumnTypes(
						    PromoteHeaders, 
						    AllTypePairs
						  ), 
						  #"Added Custom" = Table.AddColumn(
						    ChangeTypes, 
						    "SERVICE PREFIX", 
						    each Text.Start([SERVICE], 3), 
						    Int64.Type
						  ), 
						  #"Merged Queries" = Table.NestedJoin(
						    #"Added Custom", 
						    {"SERVICE PREFIX"}, 
						    ActivityCodes, 
						    {"CODE"}, 
						    "ActivityCodes", 
						    JoinKind.LeftOuter
						  ), 
						  #"Expanded ActivityCodes"
						    = Table.ExpandTableColumn(
						    #"Merged Queries", 
						    "ActivityCodes", 
						    {
						      "REPORTING CATEGORY", 
						      "CATEGORY SORT"
						    }, 
						    {
						      "SERVICE CATEGORY", 
						      "CATEGORY SORT"
						    }
						  ), 
						  #"Changed Type"
						    = Table.TransformColumnTypes(
						    #"Expanded ActivityCodes", 
						    {{"SERVICE PREFIX", type text},
						    {"SERVICE CATEGORY", type text}}
						  )
						in
						    #"Changed Type"
						```

			annotation PBI_ResultType = Exception

			annotation PBI_NavigationStepName = Navigation

		/// Aggregated data sourced from (All) DOR-AJCC Collab_GrantParticipants file. Contains demographic and program details for individuals enrolled in a workforce program, including  region (LWDB), disability status, employment status, and key dates such as Grant Enrollment Date and Exit Date. This is the primary fact table for enrollment-based measures.
