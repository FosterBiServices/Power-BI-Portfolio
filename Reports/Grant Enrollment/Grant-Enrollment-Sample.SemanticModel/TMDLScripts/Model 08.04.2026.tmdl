		/// Date dimension table providing a calendar spine for all time-based filtering and slicing. Contains one row per date with derived attributes including year, month name, month sort order, quarter, weekday, and offset fields used by measures to calculate cumulative totals and month-over-month comparisons.
		table dimdate
			lineageTag: ecd74eef-8bca-4236-b3d8-32375f192b97

			/// The full calendar date. This is the primary key of the date dimension and the field used to join enrollment and service tables to the calendar.
			column Date
				formatString: General Date
				lineageTag: a5040e86-b742-4a65-bc97-ecc5397aabae
				summarizeBy: none
				isNameInferred
				sourceColumn: [Date]

				annotation SummarizationSetBy = Automatic

			/// The four-digit calendar year (e.g. 2024).
