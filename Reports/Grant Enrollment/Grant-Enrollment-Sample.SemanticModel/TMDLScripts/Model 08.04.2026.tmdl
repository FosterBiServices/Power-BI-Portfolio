			/// Routes between the cumulative Services SVG Total and the monthly Services SVG ring image using ApplyPeriod. Ensures the services donut chart shows the correct period's SVG.
			measure 'Services SVG Switch' = ```
					ApplyPeriod([Services SVG Total], [Services SVG]) 
