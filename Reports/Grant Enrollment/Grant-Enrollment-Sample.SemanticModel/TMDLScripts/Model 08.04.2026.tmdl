				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// Dynamic subtitle for the services chart. In Total mode shows cumulative services from the earliest date to the selected month; in Monthly mode shows services for the selected month only.
			measure 'Services Provided Subtitle' = ```
					
					var _TServices = [Services Provided Total]
					var _MServices = [Services Provided]
					var _MinSort = CALCULATE( MIN ( dimdate[Month Sort] ), ALL ( dimdate ) ) 
					var _MinDate = CALCULATE( MIN ( dimdate[Month Year] ), ALL ( dimdate ), dimdate[Month Sort] = _MinSort ) 
					var _MaxDate = SELECTEDVALUE( dimdate[Month Year] ) 
					var _Total = _TServices & " Total Services Provided from " & _MinDate & " - " & _MaxDate
					var _Monthly = _MServices & " Services Provided in " & _MaxDate
					var _SelectedAgg = SELECTEDVALUE ('Aggregation Table'[Aggregation])
					RETURN 
						IF ( 
							_SelectedAgg = "Total", 
							_Total, 
							_Monthly
						)
					```
				displayFolder: Formatting\Subtitle
				lineageTag: 6f57bde9-e3c4-47b2-997c-1c73ee203ab7

			/// Dynamic subtitle for the exits chart. Reads the selected employment status (With/Without Employment) from the Employment slicer, then shows either cumulative or monthly exit counts for that status along with the relevant date range.
			measure 'Exits Subtitle' = ```
					
					var _Status = SELECTEDVALUE('Employment'[Status], "With Employment")
					var _TServices = IF ( _Status = "With Employment", COALESCE([Exiting Individuals with Employment],0), COALESCE([Exiting Individuals without Employment],0))
					var _MServices = IF ( _Status = "With Employment", COALESCE([Exiters with Employment],0), COALESCE([Exiters without Employment],0))
					var _MinSort = CALCULATE( MIN ( dimdate[Month Sort] ), ALL ( dimdate ) ) 
					var _MinDate = CALCULATE( MIN ( dimdate[Month Year] ), ALL ( dimdate ), dimdate[Month Sort] = _MinSort ) 
					var _MaxDate = SELECTEDVALUE( dimdate[Month Year] ) 
					var _Total = _TServices & " Total Exits " & _status & " from " & _MinDate & " - " & _MaxDate
					var _Monthly = _MServices & " Exits " & _status & " in " & _MaxDate
					var _SelectedAgg = SELECTEDVALUE ('Aggregation Table'[Aggregation])
					
					RETURN 
						IF ( 
							_SelectedAgg = "Total", 
							_Total, 
							_Monthly
						)
					```
				displayFolder: Formatting\Subtitle
				lineageTag: b1e01f5b-b582-4953-93a3-29be8de38b13

			/// Dynamic subtitle for the localization (SVG ring) visuals. In Total mode shows the full date range from the earliest month to the selected month; in Monthly mode shows only the selected month.
			measure 'Localization Subtitle' = ```
					
					var _MinSort = CALCULATE( MIN ( dimdate[Month Sort] ), ALL ( dimdate ) ) 
					var _MinDate = CALCULATE( MIN ( dimdate[Month Year] ), ALL ( dimdate ), dimdate[Month Sort] = _MinSort ) 
					var _Monthly = SELECTEDVALUE( dimdate[Month Year] ) 
					var _SelectedAgg = SELECTEDVALUE ('Aggregation Table'[Aggregation])
					RETURN 
						IF ( 
							_SelectedAgg = "Total", 
							_MinDate & " - " & _Monthly, 
							_Monthly
						)
					```
				displayFolder: Formatting\Subtitle
				lineageTag: 59a2bdb6-8a71-46ce-9e2c-8e7d6949af1a

			/// Dynamic label for the date slicer header. Returns 'Choose an End Month:' in Total mode (since the user is picking a cumulative end date) or 'Choose a Month:' in Monthly mode. Powered by ApplyPeriod.
			measure 'Date Slicer Header Switch' = ApplyPeriod("Choose an End Month:", "Choose a Month:")
				displayFolder: Formatting\Title
