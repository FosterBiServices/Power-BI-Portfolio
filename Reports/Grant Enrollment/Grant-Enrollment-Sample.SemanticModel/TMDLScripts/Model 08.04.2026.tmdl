		/// ApplyPeriod: applies Total vs Monthly (MTD) transformation to a base measure reference
		function ApplyPeriod = ```
				
				(
				    total  : ANYREF EXPR,
				    monthly : ANYREF EXPR
				)
				=>
				    SWITCH(
						SELECTEDVALUE( 'Aggregation Table'[Aggregation] ), 
				        "Total", total, 
				        "Monthly", monthly
				    )
				```
			lineageTag: 58112bd0-2036-4da5-a43a-59c963ad125b

		function SurveyColorHelper = ```
				(
					ColumnName : anyref expr
				) =>     
				VAR txt = LOWER( SELECTEDVALUE( ColumnName ) )
				RETURN
				SWITCH(
				    TRUE(),
				    txt = BLANK(),                    "#333333",   
					txt = "n",        "#AB0C2F",   -- Red
				    txt = "y",       "#73AF2F",   -- Green
					CONTAINSSTRING(txt, "planning"), "#0076A5",   -- Blue
					CONTAINSSTRING(txt, "has started"),       "#73AF2F",   -- Green
				    CONTAINSSTRING(txt, "no"),        "#AB0C2F",   -- Red
				    CONTAINSSTRING(txt, "yes"),       "#73AF2F",   -- Green
				    CONTAINSSTRING(txt, "scheduled"), "#0076A5",   -- Light Blue
				    CONTAINSSTRING(txt, "progress"),  "#F89D24",   -- Orange
				    CONTAINSSTRING(txt, "not yet"),   "#333333",   
				    "#333333"  -- default
				)
				```
			lineageTag: 021d30e1-c403-4e07-9fb5-2d62d6c226bb

		function TextCFColorHelper = ```
				(
					ColumnName : anyref expr
				) =>     
				VAR txt = LOWER( SELECTEDVALUE( ColumnName ) )
				RETURN
				SWITCH(
				    TRUE(),
				    txt = BLANK(),                    "#333333",   
					txt = "n", "#AB0C2F",   -- Red
				    txt = "y", "#73AF2F",   -- Green
					CONTAINSSTRING(txt, "not specified"), "#004081",   -- Blue
				    CONTAINSSTRING(txt, "no"),        "#AB0C2F",   -- Red
				    CONTAINSSTRING(txt, "yes"),       "#73AF2F",   -- Green
				
				     "#004081"  -- default
				)
				```
			lineageTag: ca0ee41e-34c0-4518-bc2c-ea936ec6d8ba

		function AssessmentColorHelper = ```
				(
					ColumnName : anyref expr
				) =>     
				
				VAR txt =
				    LOWER ( TRIM ( SELECTEDVALUE ( 'NeedsAssessmentResponses'[RESPONSE] ) ) )
				RETURN
				SWITCH (
				    TRUE(),
				
				    /* ------------------------
				       BLANK / UNKNOWN
				    -------------------------*/
				    ISBLANK ( txt )
				        || CONTAINSSTRING ( txt, "not yet" )
				        || CONTAINSSTRING ( txt, "unknown" ),
				        "#333333",   -- Gray
				
				
				    /* ------------------------
				       NEGATIVE / NOT PRESENT
				    -------------------------*/
				    txt IN { "no", "not aligned", "not used", "n/a" }
				        || CONTAINSSTRING ( txt, "not aligned" )
				        || CONTAINSSTRING ( txt, "not currently happening" )
				        || CONTAINSSTRING ( txt, "do not" ),
				        "#AB0C2F",   -- Red
				
				
				    /* ------------------------
				       STRONG POSITIVE / MATURE
				    -------------------------*/
				    txt IN { "yes", "fully aligned" }
				        || CONTAINSSTRING ( txt, "fully aligned" )
				        || CONTAINSSTRING ( txt, "implemented" )
				        || CONTAINSSTRING ( txt, "in place" )
				        || CONTAINSSTRING ( txt, "weekly" ),
				        "#73AF2F",   -- Green
				
				
				    /* ------------------------
				       PARTIAL / MODERATE
				    -------------------------*/
				    txt IN { "partially aligned" }
				        || CONTAINSSTRING ( txt, "partially aligned" )
				        || CONTAINSSTRING ( txt, "bi-weekly" )
				        || CONTAINSSTRING ( txt, "biweekly" ),
				        "#F5A623",   -- Amber
					txt = "partially", "#F5A623",   -- Amber
				
				    /* ------------------------
				       MINIMAL / LOW
				    -------------------------*/
				    txt IN { "minimally aligned" }
				        || CONTAINSSTRING ( txt, "minimally aligned" )
				        || CONTAINSSTRING ( txt, "monthly" )
				        || CONTAINSSTRING ( txt, "as needed" ),
				        "#0076A5",   -- Neutral Blue
				
				
				    /* ------------------------
				       IN PROGRESS
				    -------------------------*/
				    CONTAINSSTRING ( txt, "in progress" )
				        || CONTAINSSTRING ( txt, "has started" )
				        || CONTAINSSTRING ( txt, "underway" ),
				        "#F89D24",   -- Orange
				
				
				    /* ------------------------
				       PLANNED / SCHEDULED
				    -------------------------*/
				    CONTAINSSTRING ( txt, "planned" )
				        || CONTAINSSTRING ( txt, "planning" )
				        || CONTAINSSTRING ( txt, "roadmap" ),
				        "#004081",   -- Blue
						CONTAINSSTRING ( txt, "scheduled" ) , "#0076A5", -- light blue
				    /* =========================
				       BLANK / N/A / INFORMATIONAL
				    ========================== */
				    ISBLANK ( txt )
				        || CONTAINSSTRING ( txt, "n/a" )
				        || CONTAINSSTRING ( txt, "other" )
				        || CONTAINSSTRING ( txt, "varies depending" ),
				        "#333333",   -- Gray
				
				
				    /* =========================
				       STRONG POSITIVE (GREEN)
				    ========================== */
				    CONTAINSSTRING ( txt, "fully aligned" )
				        || CONTAINSSTRING ( txt, "very effectively" )
				        || CONTAINSSTRING ( txt, "very confident" )
				        || CONTAINSSTRING ( txt, "on track" )
				        || CONTAINSSTRING ( txt, "yes, documented and consistently followed" )
				        || CONTAINSSTRING ( txt, "fully established" )
				        || CONTAINSSTRING ( txt, "fully visible" )
				        || txt = "yes"
				        || txt = "weekly"
				        || txt = "within 30 days"
				        || CONTAINSSTRING ( txt, "realistic and achievable" ),
				        "#73AF2F",   -- Green
				
				
				    /* =========================
				       PARTIAL / MODERATE (AMBER)
				    ========================== */
				    CONTAINSSTRING ( txt, "partially aligned" )
				        || CONTAINSSTRING ( txt, "somewhat effectively" )
				        || CONTAINSSTRING ( txt, "somewhat confident" )
				        || CONTAINSSTRING ( txt, "slightly behind" )
				        || CONTAINSSTRING ( txt, "partially defined" )
				        || CONTAINSSTRING ( txt, "partially developed" )
				        || CONTAINSSTRING ( txt, "mostly visible" )
				        || txt = "bi-weekly"
				        || txt = "biweekly"
				        || txt = "30–60 days"
				        || CONTAINSSTRING ( txt, "may require adjustments" )
				        || CONTAINSSTRING ( txt, "minor adjustments" ),
				        "#F5A623",   -- Amber
				
				
				    /* =========================
				       LOW / LIMITED (BLUE)
				    ========================== */
				    CONTAINSSTRING ( txt, "minimally aligned" )
				        || CONTAINSSTRING ( txt, "limited ability" )
				        || CONTAINSSTRING ( txt, "limited visibility" )
				        || CONTAINSSTRING ( txt, "minimal visibility" )
				        || txt = "monthly"
				        || txt = "as needed",
				        "#0076A5",   -- Blue
				
				
				    /* =========================
				       AT RISK (ORANGE)
				    ========================== */
				    CONTAINSSTRING ( txt, "inconsistently" )
				        || CONTAINSSTRING ( txt, "with significant delays" )
				        || CONTAINSSTRING ( txt, "behind and may require support" )
				        || txt = "60–90 days"
				        || CONTAINSSTRING ( txt, "moderate changes" ),
				        "#F89D24",   -- Orange
				
				
				    /* =========================
				       NEGATIVE / NOT OCCURRING (RED)
				    ========================== */
				    CONTAINSSTRING ( txt, "not aligned" )
				        || CONTAINSSTRING ( txt, "not currently happening" )
				        || CONTAINSSTRING ( txt, "not currently used" )
				        || CONTAINSSTRING ( txt, "not yet defined" )
				        || CONTAINSSTRING ( txt, "not yet operationalized" )
				        || txt = "no"
				        || txt = "more than 90 days"
				        || CONTAINSSTRING ( txt, "not realistic" )
				        || CONTAINSSTRING ( txt, "not currently able" )
				        || CONTAINSSTRING ( txt, "significant changes" ),
				        "#AB0C2F",   -- Red
				
				    /* ------------------------
				       DEFAULT
				    -------------------------*/
				    "#333333"
				)
				```
			lineageTag: 031a8a65-c35c-4814-b4ad-91683d262b01

		function StaffSurveyColorHelper =
				(
				        ColumnName : anyref expr
				    ) =>
				VAR txt = LOWER( TRIM( SELECTEDVALUE( ColumnName, "" ) ) )
				
				RETURN
				SWITCH(
				    TRUE(),
				
				    //----------------------------------
				    -- Blank / Missing
				    //----------------------------------
				    txt = "", "#333333",
				
				    //----------------------------------
				    -- POSITIVE (Green)
				    //----------------------------------
				    txt = "yes", "#73AF2F",
				    CONTAINSSTRING(txt, "strongly agree"), "#73AF2F",
				    CONTAINSSTRING(txt, "agree"), "#73AF2F",
				    CONTAINSSTRING(txt, "very strong"), "#73AF2F",
				    txt = "strong", "#73AF2F",
				    CONTAINSSTRING(txt, "very effective"), "#73AF2F",
				    txt = "effective", "#73AF2F",
				    CONTAINSSTRING(txt, "great extent"), "#73AF2F",
				    txt = "frequently", "#73AF2F",
				
				    //----------------------------------
				    -- NEUTRAL (Orange)
				    //----------------------------------
				    txt = "neutral", "#F89D24",
				    txt = "moderate", "#F89D24",
				    txt = "occasionally", "#F89D24",
				    txt = "not sure", "#F89D24",
				    CONTAINSSTRING(txt, "moderate extent"), "#F89D24",
				
				    //----------------------------------
				    -- NEGATIVE (Red)
				    //----------------------------------
				    txt = "no", "#AB0C2F",
				    CONTAINSSTRING(txt, "strongly disagree"), "#AB0C2F",
				    CONTAINSSTRING(txt, "disagree"), "#AB0C2F",
				    txt = "ineffective", "#AB0C2F",
				    txt = "limited", "#AB0C2F",
				    txt = "rarely", "#AB0C2F",
				    txt = "never", "#AB0C2F",
				    CONTAINSSTRING(txt, "small extent"), "#AB0C2F",
				
				    //----------------------------------
				    -- FALLBACK
				    //----------------------------------
				    "#333333"
				)
			lineageTag: 2c50e849-222d-4906-9dfd-e7f642a4e6b0

