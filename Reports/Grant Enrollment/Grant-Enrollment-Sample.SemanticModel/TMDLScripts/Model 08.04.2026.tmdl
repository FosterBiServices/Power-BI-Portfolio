			measure 'Enrollment TT - Card with Columns' = ```
					
					/* =========================
					   SETUP
					========================= */
					VAR _spaceBetweenColumns = 3
					VAR _maxColumnWidthPct   = 6
					VAR _columnRounding      = 4
					VAR _width               = 400
					VAR _height              = 150
					
					/* =========================
					   COLORS
					========================= */
					VAR _barColor   = "#658E95"
					VAR _textColor  = "#658E95"
					VAR _dataLabelColor = "#D0D0D0"
					
					/* =========================
					   SVG WRAPPER
					========================= */
					VAR _svgDeclaration = "data:image/svg+xml;utf8,"
					VAR _svgHeader =
					    "<svg xmlns='http://www.w3.org/2000/svg'
					          width='" & _width & "'
					          height='" & _height & "'>"
					VAR _svgEnd = "</svg>"
					
					/* =========================
					   CSS
					========================= */
					VAR _style =
					"<style>
					    text {
					        font-family: Segoe UI;
					        dominant-baseline: middle;
					    }
					    .bar {
					        fill: " & _barColor & ";
					    }
					    .bolder {
					        font-weight: 600;
					    }
					</style>"
					
					/* =========================
					   CALLOUT (SLICER AWARE)
					========================= */
					VAR _selectedMonthEnrollments =
					    [Enrollments]   -- intentionally keeps slicer context
					VAR _selectedMonth = 
					    SELECTEDVALUE('dimdate'[Month Year])
					VAR _avgMonthlyEnrollments = 
					    [Average Monthly Enrollments]
					VAR _calloutText =
					"<text x='20%' y='15%'
					       fill='" & _textColor & "'
					       font-size='12'>
					    <tspan class='bolder'>"
					        & FORMAT ( _selectedMonthEnrollments, "#,0" ) &
					    "</tspan>
					    <tspan font-size='12'> enrollment(s) in " & _selectedMonth & "</tspan>
					    <tspan x='20%' dy='14' fill='" & _dataLabelColor & "' font-size='11'>
					        Avg enrollments per month: "
					        & FORMAT ( _avgMonthlyEnrollments, "#,0.0" ) &
					    "</tspan>
					
					</text>"
					
					/* =========================
					   BAR DATA (IGNORE SLICER)
					========================= */
					VAR _anchorMonthSort =
					    CALCULATE (
					        MAX ( 'dimDate'[Month Sort] ),
					        REMOVEFILTERS ( 'dimDate' )
					    )
					
					VAR _data =
					    ADDCOLUMNS (
					        FILTER (
					            SUMMARIZE (
					                ALL ( 'dimDate' ),
					                'dimDate'[Month Year],
					                'dimDate'[Month Sort]
					            ),
					            'dimDate'[Month Sort] <= _anchorMonthSort
					                && 'dimDate'[Month Sort] > _anchorMonthSort - 12
					        ),
					        "@Enrollments", [Enrollments],
					        "@RowNum",
					            ROWNUMBER (
					                FILTER (
					                    SUMMARIZE (
					                        ALL ( 'dimDate' ),
					                        'dimDate'[Month Year],
					                        'dimDate'[Month Sort]
					                    ),
					                    'dimDate'[Month Sort] <= _anchorMonthSort
					                        && 'dimDate'[Month Sort] > _anchorMonthSort - 12
					                ),
					                ORDERBY ( 'dimDate'[Month Sort], ASC )
					            )
					    )
					
					VAR _rowCount = COUNTROWS ( _data )
					VAR _maxValue = MAXX ( _data, [@Enrollments] )
					
					/* =========================
					   COLUMN SIZING
					========================= */
					VAR _columnWidthPct =
					    MIN (
					        _maxColumnWidthPct,
					        DIVIDE (
					            100 - ( _rowCount + 1 ) * _spaceBetweenColumns,
					            _rowCount
					        )
					    )
					
					/* =========================
					   BARS
					========================= */
					VAR _columns =
					    CONCATENATEX (
					        _data,
					        VAR _heightPct =
					            IF (
					                _maxValue = 0,
					                0,
					                ROUND ( DIVIDE ( [@Enrollments], _maxValue ) * 45, 2 )
					            )
					
					        VAR _x =
					            ( [@RowNum] - 1 ) * _columnWidthPct
					            + ( [@RowNum] * _spaceBetweenColumns )
					
					        VAR _y = 80 - _heightPct
					
					        VAR _xCenter = _x + ( _columnWidthPct / 2 )
					        VAR _yCenter = _y + ( _heightPct / 2 )
					
					        RETURN
					            /* Bar */
					            "<rect class='bar'
					                x='" & _x & "%'
					                y='" & _y & "%'
					                width='" & _columnWidthPct & "%'
					                height='" & _heightPct & "%'
					                rx='" & _columnRounding & "' />"
					
					            /* Value label */
					            &
					            IF (
					                _heightPct >= 8,  -- prevent clutter on tiny bars
					                "<text
					                    x='" & _xCenter & "%'
					                    y='" & _yCenter & "%'
					                    text-anchor='middle'
					                    dominant-baseline='middle'
					                    font-size='10'
					                    fill='white'>"
					                        & FORMAT ( [@Enrollments], "#,0" ) &
					                "</text>",
					                ""
					            )
					    )
					/* =========================
					   MONTH LABELS
					========================= */
					VAR _monthLabels =
					    CONCATENATEX (
					        _data,
					        VAR _xCenter =
					            ( ( [@RowNum] - 1 ) * _columnWidthPct )
					            + ( [@RowNum] * _spaceBetweenColumns )
					            + ( _columnWidthPct / 2 )
					        RETURN
					            "<text x='" & _xCenter & "%'
					                   y='86%'
					                   text-anchor='middle'
					                   font-size='10'
					                   fill='" & _dataLabelColor & "'>"
					                & FORMAT (
					                    DATE (
					                        2000,
					                        MONTH ( DATEVALUE ( "1 " & 'dimDate'[Month Year] ) ),
					                        1
					                    ),
					                    "MMM"
					                )
					            & "</text>"
					    )
					/* =========================
					   FINAL SVG
					========================= */
					RETURN
					    _svgDeclaration
					        & _svgHeader
					        & _style
					        & _calloutText
					        & _columns
					        & _monthLabels
					        & _svgEnd
					```
				lineageTag: 0638c0ff-81af-49a2-b61b-1034b8606a56
				dataCategory: ImageUrl

			measure 'Enrollment TT Subtitle' = ```
					
					var _MinSort = CALCULATE( MIN ( dimdate[Month Sort] ), ALL ( dimdate ) ) 
					var _MinDate = CALCULATE( MIN ( dimdate[Month Year] ), ALL ( dimdate ), dimdate[Month Sort] = _MinSort ) 
					var _Monthly = SELECTEDVALUE( dimdate[Month Year] ) 
					var _SelectedAgg = SELECTEDVALUE ('Aggregation Table'[Aggregation])
					var _Enroll = [Enrollments]
					RETURN 
						IF ( 
							_SelectedAgg = "Total", 
							_MinDate & " - " & _Monthly, 
							BLANK()
						)
					```
				lineageTag: 2f83d257-d1d8-4817-82b1-3debec34ee90

			measure 'Average Monthly Enrollments' =
					
					VAR _baseTable =
					    ADDCOLUMNS (
					        SUMMARIZE (
					            ALL ( 'dimDate' ),
					            'dimDate'[Month Sort],
					            'dimDate'[Month Year]
					        ),
					        "@Enrollments", [Enrollments]
					    )
					
					/* First month with activity */
					VAR _firstActiveMonth =
					    MINX (
					        FILTER ( _baseTable, [@Enrollments] > 0 ),
					        'dimDate'[Month Sort]
					    )
					
					/* Valid months = from first activity onward */
					VAR _validMonths =
					    FILTER (
					        _baseTable,
					        'dimDate'[Month Sort] >= _firstActiveMonth
					    )
					
					VAR _monthCount = COUNTROWS ( _validMonths )
					
					VAR _totalEnrollments =
					    SUMX ( _validMonths, [@Enrollments] )
					
					RETURN
					    DIVIDE ( _totalEnrollments, _monthCount )
				lineageTag: c189971b-4dc0-46cc-a9ac-9607a4def4bc

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Svg Legend' =
					
					VAR _lineHeight = 30
					VAR _fontSize = 20
					VAR _fontFamily = "Segoe UI"
					
					-- Build row index so we can vertically position text
					VAR _baseTable =
					    ADDCOLUMNS(
					        VALUES('Regions'[REGION SHORT ABBR]),
					        "_name", CALCULATE(SELECTEDVALUE('Regions'[REGION LWDB])),
					        "_index", RANKX(VALUES('Regions'[REGION SHORT ABBR]), 'Regions'[REGION SHORT ABBR], , ASC, DENSE)
					    )
					
					-- Build SVG text rows
					VAR _rows =
					    CONCATENATEX(
					        _baseTable,
					        "<text x='10' y='" & ([_index] * _lineHeight) & "' font-size='" & _fontSize & "' font-family='" & _fontFamily & "' fill='#004081'>"
					            & [REGION SHORT ABBR] & " → " & [_name] &
					        "</text>",
					        ""
					    )
					
					-- Calculate dynamic height
					VAR _rowCount = COUNTROWS(_baseTable)
					VAR _height = (_rowCount + 1) * _lineHeight
					VAR _width = 850
					
					RETURN
					"data:image/svg+xml;utf8," &
					"<svg xmlns='http://www.w3.org/2000/svg' width='" & _width & "' height='" & _height & "'>" &
					    "<rect width='100%' height='100%' fill='white' rx='6' ry='6' stroke='#fff' />" &
					    _rows &
					"</svg>"
				lineageTag: 27c6c6db-407b-409c-a241-77c13cd04d12

