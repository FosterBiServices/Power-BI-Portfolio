			/// Distinct count of enrolled participants (by User Name) for the currently selected month. This is the simple monthly snapshot — no cumulative logic.
			measure Enrollments = ```
					
					        SUM(
					            'Participants'[APP ID]
					        )
					```
				formatString: 0
				displayFolder: Enrollment\SelectedMonth
				lineageTag: 0f90b155-3d86-42d6-969e-c24a857c726b

			/// Month-over-month change in enrollments compared to the prior month. Displays a red downward triangle (🔻) for a decrease, a green checkmark (✔) for an increase, or a dash for no change, followed by the absolute difference and 'LM Δ' label.
			measure 'Enrollments MoM' = ```
					
					VAR _PMonth = MAX ( dimdate[Month Sort] ) -1
					 VAR _Result = 
					    COALESCE([Enrollments],0 ) - 
					    COALESCE(
					        CALCULATE(
					            [Enrollments],  
					            ALL( dimdate ), 
					            dimdate[Month Sort] = _PMonth
					        ),
					        0 
					    )
					VAR _Icon = 
					    IF ( 
					        _Result < 0, "▼", 
					        IF ( 
					            _Result > 0, "▲", 
					            " ▬ " 
					        )
					    )
					RETURN 
					    _Icon 
					        & " " 
					            & IF( _Result < 0, _Result * -1, 
					                    _Result)
					```
				displayFolder: Enrollment\SelectedMonth
				lineageTag: 84c84564-b5af-44a7-880c-9706aac20149

			/// Returns the single currently selected region name from the Regions slicer. Used by title and subtitle measures to make visuals context-aware.
			measure Region = ```
					SELECTEDVALUE( Regions[Region Lwdb] ) 
					```
				displayFolder: SelectedValues
				lineageTag: e1bd9336-a930-423a-99eb-e8593f318034

			/// Dynamic subtitle for the enrollment chart. In Total mode shows cumulative enrollments from the earliest date to the selected month; in Monthly mode shows enrollments for the selected month only.
			measure 'Enrollment Subtitle' = ```
					
					var _TEnrollments = [Enrolled Individuals]
					var _MEnrollments = [Enrollments]
					var _MinSort = CALCULATE( MIN ( dimdate[Month Sort] ), ALL ( dimdate ) ) 
					var _MinDate = CALCULATE( MIN ( dimdate[Month Year] ), ALL ( dimdate ), dimdate[Month Sort] = _MinSort ) 
					var _MaxDate = SELECTEDVALUE( dimdate[Month Year] ) 
					var _Total = _TEnrollments & " Total Enrollments from " & _MinDate & " - " & _MaxDate
					var _Monthly = _MEnrollments & " Enrollments in " & _MaxDate & " | " & [Enrollments MoM] & " MoM"  
					var _SelectedAgg = SELECTEDVALUE ('Aggregation Table'[Aggregation])
					RETURN 
						IF ( 
							_SelectedAgg = "Total", 
							_Total, 
							_Monthly
						)
					```
				displayFolder: Formatting\Subtitle
				lineageTag: dbe92776-f406-4f67-b374-d465c06ce6cc

			/// Running total of distinct participants who exited with employment (Entered Employment = Y) up to and including the selected month. Accumulates across all months up to the slicer selection.
			measure 'Exiting Individuals with Employment' = ```
					
					var _Month = SELECTEDVALUE( dimdate[Month Sort] )
					var Result = 
					    CALCULATE(
					        [Exits],
					        Participants[Entered Employment] = "Y",
					        ALL ( dimdate ), 
					        dimdate[Month Sort] <= _Month
					    )
					RETURN 
					    Result
					```
				formatString: 0
				displayFolder: Exiters\UpToDate
				lineageTag: 90722c79-091c-480a-9529-3a859f7b61e7

			/// The selected region's cumulative enrolled individuals as a percentage of the statewide total up to the selected month. Returns blank if there are no regional enrollments. Formatted as a percentage string (e.g. '34.5%').
			measure 'Enrolled Individuals % to Total' = ```
					
					var _Month = SELECTEDVALUE( dimdate[Month Sort] )
					var _Enrolled = [Enrolled Individuals]
					var _Total = 
					    CALCULATE(
					        SUM(
					            'Participants'[APP ID]
					        ), 
					        ALL ( dimdate ), 
					        dimdate[Month Sort] <= _Month, 
					        REMOVEFILTERS( Regions[Region Lwdb], Regions[REGION SHORT ABBR] ) 
					    )
					RETURN 
					IF ( _Enrolled, 
					        FORMAT(DIVIDE( _Enrolled, _Total ),"#.0%")
					)
					```
				displayFolder: Enrollment\UpToDate
				lineageTag: c77e4d79-bd52-44af-9d6d-0745c7c37fc5

			/// Sets the Y-axis maximum for the cumulative enrollment chart to 2.2x the highest regional value, creating headroom above the tallest bar so labels do not get clipped.
			measure 'Y Max Position' = ```
					
					VAR _MAXVALUE = 
					    MAXX( 
					    ALLSELECTED( 'Regions'[Region Lwdb]), 
					    [Enrolled Individuals]
					    )
					RETURN 
					    _MAXVALUE * 2.2
					
					```
				displayFolder: Formatting\Visuals
				lineageTag: 7b5f1801-d9ad-4eb5-8f78-68bafb45b3ff

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// Sets the Y-axis maximum for the monthly enrollment chart to 2.2x the highest monthly regional value, ensuring consistent headroom above bars.
			measure 'Monthly Y Max Position' = ```
					
					VAR _MAXVALUE = 
					    MAXX( 
					    ALLSELECTED( 'Regions'[Region Lwdb]), 
					    [Enrollments]
					    )
					RETURN 
					    _MAXVALUE * 2.2
					
					```
				displayFolder: Formatting\Visuals
				lineageTag: 8a764ac9-f1ff-4ea3-89c5-42e734832974

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// Returns a hex color code for month-over-month enrollment change: red (#9C0006) for a decrease, green (#006100) for an increase, or blue (#004081) for no change. Used as a conditional format color on the MoM label.
			measure 'Enrollments MoM CF' = ```
					
					 VAR _PMonth = MAX ( dimdate[Month Sort] ) - 1
					 VAR _Result = 
					 COALESCE( [Enrollments] - 
					    CALCULATE(
					        [Enrollments],  
					        ALL( dimdate ), 
					        dimdate[Month Sort] = _PMonth
					    ), 0 ) 
					    
					VAR _Color = 
					    IF ( 
					        _Result < 0, "#9C0006", 
					        IF ( 
					            _Result > 0, "#006100", 
					            "#999999"
					        )
					    )
					RETURN 
					    _Color
					```
				displayFolder: Formatting
				lineageTag: c91e75dd-edf9-4034-8f3d-96d8fa1166c4

			/// Running total of services delivered up to and including the selected month. Uses App ID as the counting field and accumulates across all months up to the slicer selection.
			measure 'Services Provided Total' = ```
					
					var _Month = SELECTEDVALUE( dimdate[Month Sort] )
					var Result = 
					    CALCULATE(
					        SUM(
					            'ServicesProvided'[USER ID]
					        ), 
					        ALL ( dimdate ), 
					        dimdate[Month Sort] <= _Month
					    )
					RETURN 
					    Result
					```
				formatString: 0
				displayFolder: ServicesProvided\UpToDate
				lineageTag: 6e6b004d-80bd-4ae3-8363-5af66a59234a

			/// Running total of distinct enrolled participants for the selected region, up to and including the selected month. Clears all date and region filters then re-applies the locality and date ceiling.
			measure 'Localized Enrollments Total' = ```
					
					VAR Locality = SELECTEDVALUE( Regions[REGION CODE] )	
					var _Month = SELECTEDVALUE( dimdate[Month Sort] )
					VAR Result = CALCULATE(
					        [Enrollments], 
					        ALL( Regions ), 
					        Regions[REGION CODE] = Locality, 
					        ALL ( dimdate ), 
					        dimdate[Month Sort] <= _Month	
					)
					RETURN 
					    Result
					```
				formatString: 0
				displayFolder: Enrollment\UpToDate
				lineageTag: f1d870d0-2eec-45ab-b07f-eff070f551bb

			/// Running total of services delivered in the selected region, up to and including the selected month. Clears date and region filters then re-applies the locality and date ceiling.
			measure 'Localized Services Provided Total' = ```
					
					VAR Locality = SELECTEDVALUE( Regions[REGION CODE] )	
					var _Month = SELECTEDVALUE( dimdate[Month Sort] )
					VAR Result = CALCULATE(
					        SUM(
					            'ServicesProvided'[User Id]
					        ), 
					        ALL( Regions ), 
					        Regions[REGION CODE] = Locality, 
					        ALL ( dimdate ), 
					        dimdate[Month Sort] <= _Month
					)
					RETURN 
					    IF( NOT ISBLANK(Locality), 
					    Result
					    )
					```
				formatString: 0
				displayFolder: ServicesProvided\UpToDate
				lineageTag: 6e7159ce-6624-4b07-a95c-faad0dc8451d

			/// Generates the same circular SVG progress ring as Enrollment SVG but uses cumulative (Total) enrollment figures instead of monthly figures. Compares Localized Enrollments Total against Enrolled Individuals all Regions.
			measure 'Enrollment SVG Total' =
					
					
					/* SETUP */
					VAR _total = [Enrolled Individuals all Regions]  // Will be used as a target
					VAR _value = [Localized Enrollments Total] // Will be used as a current value
					VAR _width = 250 // Width size of the SVG
					VAR _height = 310 // Height size of the SVG
					VAR _CanvasSize = MIN( _height, _width ) // Canvas size
					VAR _paddning = 15 // Padding between the circle and the canvas
					
					/* COLOR DEFINITION */
					VAR _positive = "#658E95" // Positive Color
					VAR _neutral = "#E7E74E" // Neutral Color
					VAR _negative = "#7D1D3A" // Negative Color
					
					/* PRE CALCULATION */
					VAR _halfSize = _CanvasSize / 2 // Half of the canvas size
					VAR _r = _halfSize - _paddning * 1.5 // Radius of the circle
					VAR _round = 2 * PI( ) * _r // Circumference of the circle
					VAR _perc = _value / _total // Percentage of the current value
					VAR _ratio = _round - _round * _perc // Ratio of the current value
					VAR _clr =  // Determine the color of the circle based on the percentage
					SWITCH(
					        TRUE( ),
					        _perc >= 0.75, _positive, // Positive Color
					        _perc >= 0.5, _neutral, // Neutral Color
					        _negative // Negative Color
					    )
					
					/* STYLE DECLARTIONS */
					VAR _styles =
					    "
					  <style>
					    text{
					        font-family: Segoe UI;
					    }
					    .backgroundCircle{
					      transform:rotate(-90deg) translate(-"
					        & ( _height + _width ) / 2
					        & "px, "
					        & ( _width - _height ) / 2
					        & "px);
					    }
					    .backgroundCircle{
					      fill: transparent;
					      stroke-width: "
					        & _paddning
					        & ";
					    }
					    .background{
					      stroke: #e0e0e0;
					    }
					    .filling{
					      stroke: "
					        & _clr
					        & ";
					      stroke-linecap: round;
					      stroke-dasharray: "
					        & _round
					        & ";
					      stroke-dashoffset: "
					        & _ratio
					        & ";
					    }
					    .mainText{
					      fill: "
					        & _clr
					        & ";
					      font-size: 300%;
					      text-anchor: middle;
					      dominant-baseline: middle;
					      font-weight: bold;
					    }
					    .subTexts{
					      fill: #CCCCCC;
					      font-size: 150%;
					      dominant-baseline: middle;
					    }
					    .leftPositioned{
					        text-anchor: end;
					    }
					    .rightPositioned{
					        text-anchor: start;
					    }
					    .bolden{
					        font-weight: bold;
					    }
					  </style>
					"
					
					/* SVG DECLARTIONS */
					VAR _svgDeclaration = "data:image/svg+xml;utf8,"
					VAR _svgHeader = "<svg xmlns='http://www.w3.org/2000/svg' height='" & _height & "' width='" & _width & "'>"
					VAR _svgEnd = "</svg>"
					
					/* CALCULATION */
					VAR _sv =
					    "
					  <g class='backgroundCircle'>
					  <circle r='" & _r & "' cx='50%' cy='50%' class='background' />
					  <circle r='" & _r
					        & "' cx='50%' cy='50%' class='filling'/>
					  </g>
					  <g class='mainText'>
					  <text x='50%' y='37.5%' >"
					        & FORMAT( _perc, "0.0%" )
					        & "</text>
					  </g>
					  <g class='subTexts'>
					  <g class='leftPositioned'>
					  <text x='51%' y='50.5%' >"
					        & "Total:"
					        & "</text>
					  <text x='51%' y='60%' >"
					        & "Local:"
					        & "</text>
					  <text x='51%' y='69.5%' class='bolden'>"
					        & "Delta:"
					        & "</text>
					  </g>
					  <g class='rightPositioned'>
					  <text x='53%' y='50.5%' >"
					        & _total
					        & "</text>
					  <text x='53%' y='60%' >"
					        & ROUND( _value, 1 )
					        & "</text>
					  <text x='53%' y='69.5%' class='bolden'>"
					        & ROUND( _total - _value, 1 )
					        & "</text>
					  </g>
					  </g>
					"
					VAR _result = _svgDeclaration & _svgHeader & _styles & _sv & _svgEnd
					RETURN
					    _result
				displayFolder: Enrollment\SVG
				lineageTag: 6fb789bb-b99a-4e1d-b981-126e07c6b2fd

			/// Running total of distinct enrolled participants statewide (all regions) up to and including the selected month. Used as the denominator in the total-period SVG ring visual.
			measure 'Enrolled Individuals all Regions' = ```
					
					var _Month = SELECTEDVALUE( dimdate[Month Sort] )
					
					var Result = 
					    CALCULATE(
					        SUM(
					            'Participants'[APP ID]
					        ), 
					        ALL ( dimdate ), 
					        dimdate[Month Sort] <= _Month, 
					        REMOVEFILTERS( Regions )
					    )
					RETURN 
					    Result
					```
				formatString: 0
				displayFolder: Enrollment\UpToDate
				lineageTag: bee5d676-4ea2-48a7-936a-8e4b8197fc0b

			/// Running total of services delivered statewide (all regions) up to and including the selected month. Used as the denominator in the total-period Services SVG ring visual.
			measure 'Services Provided all Regions' = ```
					
