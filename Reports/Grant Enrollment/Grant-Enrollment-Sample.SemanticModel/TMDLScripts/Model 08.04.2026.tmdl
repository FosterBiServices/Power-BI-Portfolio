			measure 'Enrollment Title (Detailed)' = ```
					
					VAR _Agg =
					    SELECTEDVALUE ( 'Aggregation Table'[Aggregation] )
					
					VAR TopXValue =
					    MAX (
					        1,
					        CEILING (
					            MAX ( TopXSelector[Value]),
					            1
					        )
					    )
					VAR Numerator = 
					    CALCULATE(
					        [Enrollment Switch], 
					        TOPN ( 
					            TopXValue, 
					            ALLSELECTED( 'Regions'[REGION LWDB] ), 
					            [Enrollment Switch], 
					            DESC
					        )
					    )
					VAR Denominator =
					    var _TEnrollments = CALCULATE([Enrolled Individuals], ALL('Regions'[REGION LWDB]))
					    var _MEnrollments = CALCULATE([Enrollments], ALL('Regions'[REGION LWDB]))
					    RETURN 
					        IF ( 
					            _Agg = "Total", 
					            _TEnrollments, 
					            _MEnrollments
					        )
					
					VAR _TopXPct =
					    DIVIDE (
					        Numerator,
					        Denominator
					    )
					
					VAR _Pct =
					    FORMAT ( _TopXPct, "0.0%" )
					
					
					RETURN
					IF (
					    _Agg = "Total",
					    "Top " & TopXValue &
					    " Regions represent " & _Pct &
					    " of total enrollment",
					    "Top " & TopXValue &
					    " Regions represent " & _Pct &
					    " of monthly enrollment"
					)
					```
				displayFolder: Formatting\Title
				lineageTag: 171c9578-722f-49bd-9c32-7f58ba1a62a1

			measure 'Disability Status Title (Detailed)' = ```
					
					VAR Numerator = 
					    CALCULATE(
					        [Disability Status], 
					        Participants[WITH DISABILITY]  = "Y"
					    )
					VAR Denominator =
					    CALCULATE(
					        [Disability Status], 
					        Participants[WITH DISABILITY]  <> "Y"
					    )
					
					VAR _TopXPct =
					    DIVIDE (
					        Numerator,
					        Numerator + Denominator
					    )
					
					VAR _Pct =
					    FORMAT ( _TopXPct, "0.0%" )
					
					RETURN
					 _Pct & " answered yes to having disability "
					```
				displayFolder: Formatting\Title
				lineageTag: b2fd538b-7e31-47b9-b39e-4bdd1f9ae55e

