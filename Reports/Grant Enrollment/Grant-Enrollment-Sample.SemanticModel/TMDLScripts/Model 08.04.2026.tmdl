			measure 'MoM Enrollment Change CF' = ```
					
					VAR _CurrentMonthSort =
					    SELECTEDVALUE ( 'Dynamic Slicer'[Month Sort] )
					
					VAR _PreviousMonthSort =
					    MAXX (
					        FILTER (
					            ALL ( dimDate[Month Sort] ),
					            dimDate[Month Sort] < _CurrentMonthSort
					        ),
					        dimDate[Month Sort]
					    )
					
					VAR _CurrentMonthEnrollments =
					    CALCULATE (
					        [Enrollments],
					        REMOVEFILTERS ( dimDate ),
					        TREATAS ( { _CurrentMonthSort }, dimDate[Month Sort] )
					    )
					
					VAR _PreviousMonthEnrollments =
					    CALCULATE (
					        [Enrollments],
					        REMOVEFILTERS ( dimDate ),
					        TREATAS ( { _PreviousMonthSort }, dimDate[Month Sort] )
					    )
					VAR _Result = 
					    _CurrentMonthEnrollments - _PreviousMonthEnrollments
					VAR _ResultColor = 
					    IF (
					        ISBLANK ( _Result ),
					        "#cccccc",
					        IF ( _Result > 0,
					            "#73AF2F",
					            "#AB0C2F"
					        )
					    )
					RETURN
					IF (
					    ISBLANK ( _CurrentMonthSort ),
					    BLANK (),
					    _ResultColor
					)
					```
				displayFolder: Formatting
				lineageTag: 8a4220c9-ba94-4abb-ae18-11ac4d1a6ae6

			measure 'Enrollment by Month' = ```
					
					VAR __Result = 
					    CALCULATE(
					        [Enrollments],
					        ALL( 'dimDate' ),
					        'dimdate'[Month Year]
					            = SELECTEDVALUE( 'Dynamic Slicer'[Month] )
					    )
					  
					RETURN
					COALESCE ( 
					    IF(
					        NOT ISINSCOPE( 'Dynamic Slicer'[Month] ),
					        BLANK()
					        ,
					        IF
					        (
					            SELECTEDVALUE( 'Dynamic Slicer'[Month Sort] )
					            <= MAX( 'dimDate'[Month Sort] )
					            && SELECTEDVALUE( 'Dynamic Slicer'[Month Sort] )
					            >= MAX( 'dimDate'[Month Sort] ) - 11,
					            __Result
					        )
					    ), 
					    0
					)
					```
