			partition Participants = m
				mode: import
				queryGroup: facts
				source = ```
						let
						  Source = Excel.Workbook(
						    Web.Contents(
						      "https://apmus.sharepoint.com/sites/DataandInsights/Shared%20Documents/Power%20BI%20Source%20Files/DOR-AJCC%20Collab/(All)%20DOR-AJCC%20Collab_GrantParticipants.xlsx"
