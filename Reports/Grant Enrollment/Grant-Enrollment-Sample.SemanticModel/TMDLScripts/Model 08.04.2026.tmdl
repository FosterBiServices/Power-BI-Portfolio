			measure 'Enrollment Label CF' =
					
					VAR _CurrentMonth =
					    SELECTEDVALUE ( 'Dynamic Slicer'[Month Sort] )
					
					VAR _MonthSummary =
					    ADDCOLUMNS (
					        ALL ( dimDate[Month Sort], dimDate[Month Year] ),
					        "@Enrollments", CALCULATE ( [Enrollments] )
					    )
					
					VAR _ValidMonths =
					    FILTER ( _MonthSummary, NOT ISBLANK ( [@Enrollments] ) )
					
					VAR _HighMonth =
					    MINX (
					        TOPN (
					            1,
					            _ValidMonths,
					            [@Enrollments], DESC,
					            dimDate[Month Sort], ASC
					        ),
					        dimDate[Month Sort]
					    )
					
					VAR _LowMonth =
					    MINX (
					        TOPN (
					            1,
					            _ValidMonths,
					            [@Enrollments], ASC,
					            dimDate[Month Sort], ASC
					        ),
					        dimDate[Month Sort]
					    )
					
					RETURN
					SWITCH (
					    TRUE (),
					    _CurrentMonth = _HighMonth, "#73AF2F",   -- green
					    _CurrentMonth = _LowMonth,  "#AB0C2F",   -- red
					    "#004081"                              -- transparent for all others
					)
				displayFolder: Formatting
				lineageTag: 38bb34af-f803-406d-9412-ea71694ccc33

