			partition NeedsAssessmentResponses = m
				mode: import
				queryGroup: facts
				source = ```
						let
						  Source = Excel.Workbook(
						    Web.Contents(
						      "https://apmus.sharepoint.com/sites/DataandInsights/Shared%20Documents/Power%20BI%20Source%20Files/DOR-AJCC%20Collab/Phase%20II-%20Needs%20Assessment%20Responses%20Raw%20Data.xlsx"
						    ), 
						    null, 
						    true
						  ),
						    Sheet1_Sheet = Source{[Item="Sheet1",Kind="Sheet"]}[Data],
						    PromoteHeaders = Table.PromoteHeaders(Sheet1_Sheet, [PromoteAllScalars=true]), 
						  TypePairs = {
						      {"PROJECT SITE", type text },
						      {"WORKFLOW ESTABLISHED", type text },
						      {"SYSTEMS USED", type text },
						      {"DOCUMENTED PROCESS", type text },
						      {"AJCC–DOR ALIGNMENT", type text },
						      {"CONFIDENCE", type text },
						      {"STAFF AWARENESS", type text },
						      {"COMPLIANCE COMPONENTS", type text },
						      {"TRAINING", type text },
						      {"SCREENING CRITERIA", type text },
						      {"OTHER SCREENING CRITERIA", type text },
						      {"TIMING OF ENROLLMENT", type text },
						      {"CO-ENROLLED PROGRAMS", type text },
						      {"OTHER CO-ENROLLED PROGRAMS", type text },
						      {"BRAIDED FUNDING", type text },
						      {"OTHER BRAIDED FUNDING", type text },
						      {"FIRST PROGRAM ENROLLED", type text },
						      {"OTHER FIRST PROGRAM ENROLLED", type text },
						      {"TRACKING METHOD", type text },
						      {"WORKFLOW VISIBILITY", type text },
						      {"BOTTLENECK IDENTIFICATION", type text },
						      {"CASE NOTES USAGE", type text },
						      {"CO-CASE MANAGEMENT", type text },
						      {"COORDINATION METHODS", type text },
						      {"COORDINATION FREQUENCY", type text },
						      {"PROCESS GAPS", type text },
						      {"RISKS", type text },
						      {"TA NEEDS", type text },
						      {"PROGRESS STATUS", type text },
						      {"READINESS TIMELINE", type text },
						      {"GOAL FEASIBILITY", type text },
						      {"ENROLLMENT BARRIERS", type text },
						      {"OTHER ENROLLMENT BARRIERS", type text },
						      {"SCOPE CHANGES", type text },
						      {"WORKFLOW EFFECTIVENESS", type text }, 
						      {"REGION CODE", Int64.Type}
						  }, 
						  ExistingCols = Table.ColumnNames(
						    PromoteHeaders
						  ), 
						  // Keep type rules only for columns that actually exist
						  TypePairsExistingOnly = List.Select(
						    TypePairs, 
						    each List.Contains(
						      ExistingCols, 
						      _{0}
						    )
						  ), 
						  // Convert those explicit pairs into a lookup record: ColumnName -> Type
						  ExplicitTypeMap = Record.FromList(
						    List.Transform(
						      TypePairsExistingOnly, 
						      each _{1}
						    ), 
						    List.Transform(
						      TypePairsExistingOnly, 
						      each _{0}
						    )
						  ), 
						  // - If we specified a type in ExplicitTypeMap, use it.
						  // - Otherwise default to type text.
						  AllTypePairs = List.Transform(
						    ExistingCols, 
						    (c) => {
						      c, 
						      Record.FieldOrDefault(
						        ExplicitTypeMap, 
						        c, 
						        type text
						      )
						    }
						  ), 
						  // Apply types in one go
						  ChangeTypes
						    = Table.TransformColumnTypes(
						    PromoteHeaders, 
						    AllTypePairs
						  ),
						    joinQuestions = Table.NestedJoin(ChangeTypes, {"QUESTION"}, AssessmentQuestions, {"Question"}, "AssessmentQuestions", JoinKind.LeftOuter),
						    GetQuestionText = Table.ExpandTableColumn(joinQuestions, "AssessmentQuestions", {"QuestionText", "Description"}, {"QuestionText", "Description"})
						in
						    GetQuestionText
						```

			annotation PBI_NavigationStepName = Navigation

			annotation PBI_ResultType = Table

		/// The SurveyResponseColorMap table is used to conditionally format Operational Assessment Survey Responses
		table SurveyResponseColorMap
			lineageTag: 9535647d-7bda-4694-bc41-445c3f6549db

			column Response
				lineageTag: 4c291656-e53a-4aac-8cce-5c8c1f615736
				summarizeBy: none
				isNameInferred
				sourceColumn: [Response]

				annotation SummarizationSetBy = Automatic

			column HexColor
				lineageTag: 061db940-71c4-4e6e-ac5f-7ebd1c6ea8ea
				summarizeBy: none
				isNameInferred
				sourceColumn: [HexColor]

				annotation SummarizationSetBy = Automatic

			partition SurveyResponseColorMap = calculated
				mode: import
				source = ```
						
						DATATABLE (
						    "Response", STRING,
						    "HexColor", STRING,
						    {
						
						        /* ---------- ALIGNMENT ---------- */
						        { "Fully aligned with clear processes and roles", "#73AF2F" },
						        { "Partially aligned", "#9CCB3B" },
						        { "Minimally aligned", "#E29A2D" },
						        { "Not aligned at all", "#AB0C2F" },
						
						        /* ---------- EFFECTIVENESS ---------- */
						        { "Very effectively", "#73AF2F" },
						        { "Very effectively and consistently", "#73AF2F" },
						        { "Somewhat effectively", "#9CCB3B" },
						        { "Inconsistently", "#D45A1E" },
						        { "Inconsistently applied", "#D45A1E" },
						        { "Limited ability", "#E29A2D" },
						        { "With significant delays", "#D45A1E" },
						        { "Not currently able to identify bottlenecks", "#AB0C2F" },
						        { "Not currently used", "#AB0C2F" },
						        { "Not yet operationalized", "#AB0C2F" },
						
						        /* ---------- PROCESS ---------- */
						        { "Yes, documented and consistently followed", "#73AF2F" },
						        { "Partially defined", "#D45A1E" },
						        { "Partially", "#D45A1E" },
						        { "Not yet defined", "#AB0C2F" }, 
						
						        /* ---------- CO-CASE MANAGEMENT ---------- */
						        { "Yes, formalized and in use", "#73AF2F" },
						        { "Informal practices exist", "#E29A2D" },
						        { "Not yet established", "#AB0C2F" },
						
						        /* ---------- PROGRESS / STATUS ---------- */
						        { "On track to meet or exceed goals", "#73AF2F" },
						        { "Slightly behind, but expect to catch up", "#9CCB3B" },
						        { "Behind and may require support", "#D45A1E" },
						        { "Not currently on track", "#AB0C2F" },
						
						        /* ---------- FREQUENCY ---------- */
						        { "Weekly", "#73AF2F" },
						        { "Bi-weekly", "#9CCB3B" },
						        { "Monthly", "#E29A2D" },
						        { "As needed", "#E29A2D" },
						        { "Not currently happening", "#AB0C2F" },
						
						        /* ---------- CONFIDENCE / FEASIBILITY ---------- */
						        { "Very confident", "#73AF2F" },
						        { "Somewhat confident", "#9CCB3B" },
						        { "Yes, goals are realistic and achievable", "#73AF2F" },
						        { "Somewhat realistic, but may require adjustments", "#9CCB3B" },
						        { "Not realistic without significant changes", "#AB0C2F" },
						
						        /* ---------- READINESS ---------- */
						        { "Within 30 days", "#73AF2F" },
						        { "30–60 days", "#9CCB3B" },
						        { "60–90 days", "#D45A1E" },
						        { "More than 90 days", "#AB0C2F" },
						
						        /* ---------- TIMING ---------- */
						        { "After DOR confirms eligibility", "#2F6690" },   
						        { "After IPE/IEP development", "#3FA7D6" },        
						        { "After referral to DOR", "#6FBEDB" },           
						        { "When a participant self-identifies as a person with a disability", "#9FD3C7" }, 
						        { "Varies significantly by participant", "#8E9AAF" }, 
						        { "Not Applicable - Enrollment activities have not yet started", "#AB0C2F" }, 
						             
						      /* ---------- TRACKING ---------- */
						        { "Tracked through shared spreadsheets or internal trackers", "#2F6690" }, 
						        { "Documented primarily through case notes", "#3FA7D6" }, 
						        { "Entered and tracked directly in CalJOBS", "#9FD3C7" }, 
						        { "Managed across multiple disconnected methods", "#AB0C2F" }, 
						
						        /* ---------- TRAINING ---------- */
						        { "Yes", "#73AF2F" },
						        { "Not yet, but scheduled", "#9CCB3B" },
						        { "No", "#AB0C2F" },
						
						        /* ---------- WORKFLOW ---------- */
						        { "Fully established and consistently implemented", "#73AF2F" },
						        { "Fully visible across all stages", "#73AF2F" },
						        { "Mostly visible, with some gaps", "#9CCB3B" },
						        { "Established but inconsistently implemented", "#D45A1E" },
						        { "Partially developed", "#9FD3C7" }, 
						        { "Limited visibility", "#E29A2D" },
						        { "Minimal visibility", "#E29A2D" },
						        { "Not currently tracked in a way that allows monitoring", "#AB0C2F" },
						
						        /* ---------- SCOPE ---------- */
						        { "No changes", "#73AF2F" },
						        { "Minor adjustments within existing scope", "#C4B85A  " },
						        { "Changes under discussion but not finalized", "#E29A2D" },
						        { "Moderate changes affecting workflow or staffing", "#D45A1E" },
						        { "Significant changes affecting enrollment strategy", "#AB0C2F" }
						
						    }
						)
						
						
						```

			annotation PBI_Id = 324af3ff4bd94acfbc8f2d898498ea6e

