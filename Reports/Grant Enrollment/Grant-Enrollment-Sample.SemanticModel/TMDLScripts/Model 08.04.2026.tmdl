		/// One row per partner site readiness assessment response. Captures the project site and self-assessed readiness ratings across eight readiness dimensions: DOR Meeting, Key Contacts, Communication Plan, Customer Flow, Marketing, First Partner Meeting, Staffing, and Enrollment. Used to power the AJCC Collaboration readiness survey visuals.
		table ReadinessSurvey
			lineageTag: 9a0c588e-a162-48b1-b83c-c0b5addd3817

			/// The name of the partner project site this readiness survey response represents.
			column 'PROJECT SITE'
				dataType: string
				lineageTag: f4c01d9d-ffe3-4b76-9c84-51d6f6a208f3
				summarizeBy: none
				sourceColumn: PROJECT SITE

				annotation SummarizationSetBy = Automatic

			/// The readiness rating for whether an initial DOR meeting has been held at this site (e.g. Complete, In Progress, Not Started).
