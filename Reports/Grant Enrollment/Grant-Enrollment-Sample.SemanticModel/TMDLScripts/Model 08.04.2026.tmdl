						}

				annotation GroupingDesignState = {"Version":0,"Sources":[{"Name":"s","Entity":"ServicesProvided"}],"GroupedColumns":[{"Column":{"Expression":{"SourceRef":{"Source":"s"}},"Property":"SERVICE"}}],"GroupItems":[{"DisplayName":"(Blank)","BlankDefaultPlaceholder":true},{"DisplayName":"BASIC","Expression":{"In":{"Expressions":[{"Column":{"Expression":{"SourceRef":{"Source":"s"}},"Property":"SERVICE"}}],"Values":[[{"Literal":{"Value":"'101 - Orientation'"}}],[{"Literal":{"Value":"'102 - Initial Assessment'"}}],[{"Literal":{"Value":"'106 - In Program \"Follow Up\"'"}}],[{"Literal":{"Value":"'107 - Provision of Labor Market Research'"}}],[{"Literal":{"Value":"'108 - Referred to WIOA Services (not training)'"}}],[{"Literal":{"Value":"'109 - Referred to Community Resource'"}}],[{"Literal":{"Value":"'112 - Job Fair'"}}],[{"Literal":{"Value":"'115 - Resume Preparation Assistance'"}}],[{"Literal":{"Value":"'121 - Job Referral: Job Outside CalJOBS (non-Federal)'"}}],[{"Literal":{"Value":"'125 - Job Search and Placement Assistance'"}}],[{"Literal":{"Value":"'134 - Workshop'"}}]]}}},{"DisplayName":"HOUSEKEEPING","Expression":{"In":{"Expressions":[{"Column":{"Expression":{"SourceRef":{"Source":"s"}},"Property":"SERVICE"}}],"Values":[[{"Literal":{"Value":"'010 - Co-Funded Service'"}}]]}}},{"DisplayName":"INDIVIDUAL SERVICES","Expression":{"In":{"Expressions":[{"Column":{"Expression":{"SourceRef":{"Source":"s"}},"Property":"SERVICE"}}],"Values":[[{"Literal":{"Value":"'181 - Supportive Service: Transportation Assistance'"}}],[{"Literal":{"Value":"'185 - Supportive Service: Other'"}}],[{"Literal":{"Value":"'188 - Supportive Service: Tools/Clothing'"}}],[{"Literal":{"Value":"'190 - Supportive Service: Utilities'"}}],[{"Literal":{"Value":"'200 - Individual Counseling'"}}],[{"Literal":{"Value":"'202 - Career Guidance/Planning'"}}],[{"Literal":{"Value":"'203 - Objective Assessment'"}}],[{"Literal":{"Value":"'205 - Development of Individual Employment Plan (IEP)'"}}]]}}},{"DisplayName":"TRAINING","Expression":{"In":{"Expressions":[{"Column":{"Expression":{"SourceRef":{"Source":"s"}},"Property":"SERVICE"}}],"Values":[[{"Literal":{"Value":"'215 - Short-Term Prevocational Services'"}}],[{"Literal":{"Value":"'300 - Occupational Skills Training (Approved ETPL Provider)'"}}],[{"Literal":{"Value":"'321 - Transitional Job'"}}],[{"Literal":{"Value":"'328 - Occupational Skills Training (non-ETPL Provider)'"}}]]}}}]}

				annotation SummarizationSetBy = Automatic

