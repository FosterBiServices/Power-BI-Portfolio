			/// Calculates the selected service category's share of total services for the current period and region, formatted as '- XX.X%'. Used as a reference label on the service category breakdown chart to show each category's contribution.
			measure 'Service Category Detail Label' = ```
					
					var _Month = SELECTEDVALUE( dimdate[Month Sort] )
					var _Monthly = 
					    CALCULATE(
					        SUM(
					            'ServicesProvided'[User Id]
					        ), 
					        ALL ( dimdate ), 
					        dimdate[Month Sort] = _Month,
					        ALL ( 'ServicesProvided' ),
					        KEEPFILTERS( Regions )
					    )
					var _Total = 
					    CALCULATE(
					        SUM(
					            'ServicesProvided'[User Id]
					        ), 
					        ALL ( dimdate ), 
					        dimdate[Month Sort] <= _Month, 
					        ALL ( 'ServicesProvided' ),
					        KEEPFILTERS( Regions )
					    )
					var _Switcheroo =  
					    ApplyPeriod(_Total, _Monthly)
					
					var _SPSwitch = [Services Provided Switch]
					
					RETURN
					"- " & 
					    FORMAT( 
					        DIVIDE ( _SPSwitch, _Switcheroo ), 
					        "#.0%"
					    )
					    
					```
				displayFolder: Formatting\ReferenceLabels
				lineageTag: 425189ca-7d70-43fc-9a09-8f0116ad23ef

