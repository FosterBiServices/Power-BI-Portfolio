				sortByColumn: 'CATEGORY SORT'

				changedProperty = SortByColumn

				annotation SummarizationSetBy = Automatic

			/// Numeric sort order for service categories, ensuring they display in a logical sequence in charts and tables rather than alphabetically.
			column 'CATEGORY SORT'
				dataType: int64
