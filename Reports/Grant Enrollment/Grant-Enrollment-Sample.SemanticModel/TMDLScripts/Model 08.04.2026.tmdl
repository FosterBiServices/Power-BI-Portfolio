			/// Returns either Exiting Individuals with Employment or Exiting Individuals without Employment (cumulative totals) based on the Employment slicer selection. Defaults to With Employment.
			measure 'Exiting Individuals' = ```
					
					var _Status = SELECTEDVALUE('Employment'[Status], "With Employment")
					var _Services = IF ( _Status = "With Employment", [Exiting Individuals with Employment], [Exiting Individuals without Employment] )
					RETURN 
