			partition ReadinessSurvey = m
				mode: import
				queryGroup: facts
				source = ```
						let
						  Source = Excel.Workbook(
						    Web.Contents(
						      "https://apmus.sharepoint.com/sites/DataandInsights/Shared%20Documents/Power%20BI%20Source%20Files/DOR-AJCC%20Collab/Project%20Readiness%20Survey.xlsx"
						    ), 
						    null, 
						    true
						  ),
						    Sheet1_Sheet = Source{[Item="Sheet1",Kind="Sheet"]}[Data],
						    PromoteHeaders = Table.PromoteHeaders(Sheet1_Sheet, [PromoteAllScalars=true])
						, 
						  TypePairs = 
						    {
						      {"LAST NAME", type text},
						      {"FIRST NAME", type text},
						      {"TITLE", type text},
						      {"PROJECT SITE", type text},
						      {"DOR MEETING", type text},
						      {"KEY CONTACTS", type text},
						      {"COMMUNICATION PLAN", type text},
						      {"CUSTOMER FLOW", type text},
						      {"MARKETING", type text},
						      {"FIRST PARTNER MEETING", type text},
						      {"STAFFING", type text}, 
						      {"ENROLLEMMENT", type text}, 
						      {"WHEN", type text},
						      {"TA NEEDS", type text}, 
						      {"REGION CODE", Int64.Type}
						    }, 
						  ExistingCols = Table.ColumnNames(
						    PromoteHeaders
						  ), 
						  TypePairsExistingOnly = List.Select(
						    TypePairs, 
						    each List.Contains(
						      ExistingCols, 
						      _{0}
						    )
						  ), 
						  ChangeTypes
						    = Table.TransformColumnTypes(
						    PromoteHeaders, 
						    TypePairsExistingOnly
						  ),
						  RenameColumn = Table.RenameColumns(ChangeTypes,{{"ENROLLEMMENT", "ENROLLMENT"}})
						in
						    RenameColumn
						```

			annotation PBI_NavigationStepName = Navigation

			annotation PBI_ResultType = Table

		/// TopXSelector is used to control number of objects shown in various visuals throughout the report.
		table TopXSelector
			lineageTag: 261d9846-3531-4837-a4fa-31595e386465

			column Value
				formatString: 0
				lineageTag: 8492d916-16a7-4c82-9353-a80ced47f077
				summarizeby: none
				isNameInferred
				sourceColumn: [Value]

				annotation SummarizationSetBy = Automatic

			partition TopXSelector = calculated
				mode: import
				source = ```
						GENERATESERIES(1, 10, 1)
						
						```

			annotation PBI_Id = ff74c583a76545f3bffe8da50afd822a

		/// The Operational Needs table provides a high‑level assessment of how project sites manage enrollment, coordination, and service delivery across programs. It captures the maturity of workflows, systems, staff readiness, and compliance practices, while also identifying gaps, risks, and barriers. Overall, it is used to understand current operations and inform planning, technical assistance, and readiness for improvement or change.
		table NeedsAssessmentResponses
			lineageTag: ca850a68-6694-45f1-b5ab-5015c7864f94

			/// Generates a scalable SVG visual listing up to five project site names for the current filter context. Displays a “+N” indicator when more than five sites exist and includes drill-through instructions for detailed review.
			measure 'PROJECT SITE SVG' = ```
					
					VAR MaxValuesToShow = 5
					VAR ProjectSiteCount =
					    DISTINCTCOUNT ( 'NeedsAssessmentResponses'[PROJECT SITE] )
					
					VAR SitesToShow =
					    TOPN (
					        MaxValuesToShow,
					        VALUES ( 'NeedsAssessmentResponses'[PROJECT SITE] ),
					        'NeedsAssessmentResponses'[PROJECT SITE],
					        ASC
					    )
					
					VAR SiteText =
					    CONCATENATEX (
					        SitesToShow,
					        "<tspan x='0' dy='2.15em'>" &
					            'NeedsAssessmentResponses'[PROJECT SITE] &
					        "</tspan>",
					        "",
					        'NeedsAssessmentResponses'[PROJECT SITE],
					        ASC
					    )
					
					VAR EtcText =
					    IF (
					        ProjectSiteCount > MaxValuesToShow,
					        "<tspan x='0' dy='2.15em'> +" & ProjectSiteCount -  MaxValuesToShow & "</tspan>",
					        ""
					    )
					
					VAR DrillText =
					    IF (
					        ProjectSiteCount > MaxValuesToShow,
					        "<tspan x='0' dy='2.4em' font-size='12' fill='#333333'>
					            For full list, right‑click to drill through and hover over 'breadcrumb' callout.
					        </tspan>",
					        ""
					    )
					
					RETURN
					"data:image/svg+xml;utf8,
					<svg xmlns='http://www.w3.org/2000/svg'
					     width='400'
					     height='250'
					     viewBox='0 0 400 250'
					     preserveAspectRatio='xMinYMin meet'>
					    <style>
					        text {
					            font-family: Segoe UI, Arial, sans-serif;
					            font-size: 12px;
					            fill: #004081;
					        }
					    </style>
					    <text x='0' y='14'>
					        " & SiteText & EtcText & DrillText & "
					    </text>
					</svg>"
					
					```
				lineageTag: 11c50924-db19-4056-8a9f-3adff2959d86
				dataCategory: ImageUrl

				extendedProperty MeasureTemplate =
						{
						  "version": 0,
						  "daxTemplateName": "ConcatenateValues"
						}

				changedProperty = FormatString

			measure 'List of PROJECT SITE values' =
					
					VAR __DISTINCT_VALUES_COUNT = DISTINCTCOUNT('NeedsAssessmentResponses'[PROJECT SITE])
					VAR __MAX_VALUES_TO_SHOW = 20
					RETURN
						IF(
							__DISTINCT_VALUES_COUNT > __MAX_VALUES_TO_SHOW,
							CONCATENATE(
								CONCATENATEX(
									TOPN(
										__MAX_VALUES_TO_SHOW,
										VALUES('NeedsAssessmentResponses'[PROJECT SITE]),
										'NeedsAssessmentResponses'[PROJECT SITE],
										ASC
									),
									'NeedsAssessmentResponses'[PROJECT SITE],
					                UNICHAR(10),
									'NeedsAssessmentResponses'[PROJECT SITE],
									ASC
								),
								", etc."
							),
							CONCATENATEX(
								VALUES('NeedsAssessmentResponses'[PROJECT SITE]),
								'NeedsAssessmentResponses'[PROJECT SITE],
								 UNICHAR(10),
								'NeedsAssessmentResponses'[PROJECT SITE],
								ASC
							)
						)
				lineageTag: 82e10e55-b89f-41fc-800d-dccbd07946f2

				extendedProperty MeasureTemplate =
						{
						  "version": 0,
						  "daxTemplateName": "ConcatenateValues"
						}

				changedProperty = FormatString

