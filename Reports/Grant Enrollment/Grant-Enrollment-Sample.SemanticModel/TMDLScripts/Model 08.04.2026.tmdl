			partition dimdate = calculated
				mode: import
				source = ```
						
						VAR MinDate =
						    MINX (
						        FILTER ( Participants, NOT ISBLANK ( Participants[GRANT ENROLL DATE] ) ),
						        Participants[GRANT ENROLL DATE]
						    )
						VAR MaxDate =
						    MAXX (
						        FILTER ( Participants, NOT ISBLANK ( Participants[GRANT ENROLL DATE] ) ),
						        Participants[GRANT ENROLL DATE]
						    )
						/* Anchor month start (you already had this) */
						VAR AnchorMonthStart = DATE ( YEAR ( MaxDate ), MONTH ( MaxDate ), 1 )
						/* Anchor quarter start derived from MaxDate */
						VAR AnchorQuarterStart =
						    DATE (
						        YEAR ( MaxDate ),
						        1 + 3 * ( TRUNC ( ( MONTH ( MaxDate ) - 1 ) / 3, 0 ) ),
						        1
						    )
						RETURN
						ADDCOLUMNS (
						    CALENDAR ( MinDate, MaxDate ),
						    "Calendar Year", YEAR ( [Date] ),
						    "Weekday", FORMAT ( [Date], "dddd" ),
						    "Weekday number", WEEKDAY ( [Date] ),
						    "Month Name", FORMAT ( [Date], "mmmm" ),
						    "Month Number", FORMAT ( [Date], "mm" ),
						    "Month Sort", YEAR ( [Date] ) * 12 + MONTH ( [Date] ),
						    "Month Year", FORMAT ( [Date], "mmmm yyyy" ),
						    "MonthOffset",
						        VAR RowMonthStart = DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 )
						        RETURN DATEDIFF ( RowMonthStart, AnchorMonthStart, MONTH ),
						    "Quarter Number", 1 + TRUNC ( ( MONTH ( [Date] ) - 1 ) / 3, 0 ),
						    "Quarter", "Q" & ( 1 + TRUNC ( ( MONTH ( [Date] ) - 1 ) / 3, 0 ) ),
						    "Quarter Year",
						        VAR QN = 1 + TRUNC ( ( MONTH ( [Date] ) - 1 ) / 3, 0 )
						        RETURN FORMAT ( [Date], "yyyy" ) & " Q" & QN,
						    "Quarter Start Date",
						        DATE (
						            YEAR ( [Date] ),
						            1 + 3 * ( TRUNC ( ( MONTH ( [Date] ) - 1 ) / 3, 0 ) ),
						            1
						        ),
						    "Quarter Sort",
						        YEAR ( [Date] ) * 4 + ( 1 + TRUNC ( ( MONTH ( [Date] ) - 1 ) / 3, 0 ) ),
						    "QuarterOffset",
						        VAR RowQuarterStart =
						            DATE (
						                YEAR ( [Date] ),
						                1 + 3 * ( TRUNC ( ( MONTH ( [Date] ) - 1 ) / 3, 0 ) ),
						                1
						            )
						        RETURN DATEDIFF ( RowQuarterStart, AnchorQuarterStart, QUARTER )
						)
						
						```

			annotation PBI_Id = c5663006cbdb496ea4aa469f0310118e

		/// Hidden calculation table that houses all DAX measures for this model. No data rows — used purely as an organizational container to keep all measures in one place rather than scattered across fact and dimension tables.
		table _Measures
			lineageTag: 31dc1f0e-46a4-43ff-86dc-4408f3931ffa

			/// Running total of distinct participants (by User Name) enrolled up to and including the selected month. Captures all months up to the slicer selection so cumulative enrollment grows over time.
			measure 'Enrolled Individuals' = ```
					
					var _Month = SELECTEDVALUE( dimdate[Month Sort] )
					var Result = 
					    CALCULATE(
					        SUM(
					            'Participants'[APP ID]
					        ), 
					        ALL ( dimdate ), 
					        dimdate[Month Sort] <= _Month
					    )
					RETURN 
					    Result
					```
				formatString: 0
				displayFolder: Enrollment\UpToDate
				lineageTag: 58a0d3c6-b105-4ff1-9473-a50424ccb216

			/// Total count of participants by disability status, sourced from the Participant table. Used to show the disability breakdown in the participant summary section.
			measure 'Disability Status' = ```
					
					CALCULATE (
					    [Enrollments], 
					    REMOVEFILTERS(dimdate[Month Year])
					    )
					```
				formatString: 0
				displayFolder: Enrollment Disability
				lineageTag: ac87f82b-0911-49d0-8ba2-fe6ae7fe8304

			/// Count of service records delivered in the currently selected month. Each row in ServicesProvided represents one service delivered to one participant.
			measure 'Services Provided' = ```
					
					        SUM(
					            'ServicesProvided'[User Id]
					        )
					
					```
				formatString: 0
				displayFolder: ServicesProvided\SelectedMonth
				lineageTag: 65b5fb56-2045-4ce7-8e68-23f540202829

			/// Sum of participants App ID who exited the program and entered employment (Entered Employment = Y) in the selected month.
			measure 'Exiters with Employment' = ```
					
					CALCULATE(
					    [Exits],
					    Participants[Entered Employment] = "Y" 
					)
					```
				formatString: 0
				displayFolder: Exiters\SelectedMonth
				lineageTag: 3200844e-59c6-49d2-babb-25e0ff0e9f15

			/// Distinct count of enrolled participants filtered to the currently selected region (LWDB). Ignores the Regions filter context then re-applies only the selected locality, ensuring accurate regional counts.
			measure 'Localized Enrollments' = ```
					
					VAR Locality = SELECTEDVALUE( Regions[Region Lwdb] )
					VAR Result = CALCULATE(
					        SUM(
					            'Participants'[APP ID]
					        ), 
					        ALL( Regions ), 
					        Regions[Region Lwdb] = Locality
					)
					RETURN 
					    Result
					```
				formatString: 0
				displayFolder: Enrollment\SelectedMonth
				lineageTag: 2f3cdd2e-fa41-408f-82f9-c0415ed604e7

			/// Distinct count of enrolled participants across all regions, ignoring any region filter. Used as the statewide denominator for regional contribution calculations.
			measure 'Total Enrollments' = ```
					
					VAR Result = CALCULATE(
					        SUM(
					            'Participants'[APP ID]
					        ), 
					        REMOVEFILTERS( Regions[Region Lwdb] )
					)
					RETURN 
					    Result
					```
				formatString: 0
				displayFolder: Enrollment\SelectedMonth
				lineageTag: ace8e8f2-1836-4f4e-b890-d72c9d118336

			/// Count of service records for the currently selected region. Clears the Regions filter then pins it back to the selected locality so the number stays accurate regardless of other visual filters.
			measure 'Localized Services Provided' = ```
					
					VAR Locality = SELECTEDVALUE( Regions[REGION CODE] )
					VAR Result = CALCULATE(
					        SUM(
					            'ServicesProvided'[User Id]
					        ), 
					        ALL( Regions ), 
					        Regions[REGION CODE] = Locality
					)
					RETURN 
					    IF( NOT ISBLANK(Locality), 
					        Result
					    )
					```
				formatString: 0
				displayFolder: ServicesProvided\SelectedMonth
				lineageTag: e77d5593-c9c3-4d41-8d50-2d66aa36951c

			/// Count of all service records statewide, with the region filter removed. Used as the denominator when calculating a region's share of services.
			measure 'Total Services Provided' = ```
					
					VAR Result = CALCULATE(
					        SUM(
					            'ServicesProvided'[User Id]
					        ), 
					        ALL( Regions )
					)
					RETURN 
					    Result
					```
				formatString: 0
				displayFolder: ServicesProvided\SelectedMonth
				lineageTag: 2e89deea-359c-41e5-8988-391f743b87e1

			/// Generates a circular progress ring SVG image showing the selected region's enrollment as a percentage of total statewide enrollment for the selected month. The ring color turns teal (>=75%), yellow (>=50%), or dark red (<50%). Also displays Total, Local, and Delta counts inside the ring.
			measure 'Enrollment SVG' =
					
					
					/* SETUP */
					VAR _total = [Total Enrollments]  // Will be used as a target
					VAR _value = [Localized Enrollments] // Will be used as a current value
					VAR _width = 250 // Width size of the SVG
					VAR _height = 310 // Height size of the SVG
					VAR _CanvasSize = MIN( _height, _width ) // Canvas size
					VAR _paddning = 15 // Padding between the circle and the canvas
					
					/* COLOR DEFINITION */
					VAR _positive = "#658E95" // Positive Color
					VAR _neutral = "#E7E74E" // Neutral Color
					VAR _negative = "#7D1D3A" // Negative Color
					
					/* PRE CALCULATION */
					VAR _halfSize = _CanvasSize / 2 // Half of the canvas size
					VAR _r = _halfSize - _paddning * 1.5 // Radius of the circle
					VAR _round = 2 * PI( ) * _r // Circumference of the circle
					VAR _perc = _value / _total // Percentage of the current value
					VAR _ratio = _round - _round * _perc // Ratio of the current value
					VAR _clr =  // Determine the color of the circle based on the percentage
					SWITCH(
					        TRUE( ),
					        _perc >= 0.75, _positive, // Positive Color
					        _perc >= 0.5, _neutral, // Neutral Color
					        _negative // Negative Color
					    )
					
					/* STYLE DECLARTIONS */
					VAR _styles =
					    "
					  <style>
					    text{
					        font-family: Segoe UI;
					    }
					    .backgroundCircle{
					      transform:rotate(-90deg) translate(-"
					        & ( _height + _width ) / 2
					        & "px, "
					        & ( _width - _height ) / 2
					        & "px);
					    }
					    .backgroundCircle{
					      fill: transparent;
					      stroke-width: "
					        & _paddning
					        & ";
					    }
					    .background{
					      stroke: #e0e0e0;
					    }
					    .filling{
					      stroke: "
					        & _clr
					        & ";
					      stroke-linecap: round;
					      stroke-dasharray: "
					        & _round
					        & ";
					      stroke-dashoffset: "
					        & _ratio
					        & ";
					    }
					    .mainText{
					      fill: "
					        & _clr
					        & ";
					      font-size: 300%;
					      text-anchor: middle;
					      dominant-baseline: middle;
					      font-weight: bold;
					    }
					    .subTexts{
					      fill: #CCCCCC;
					      font-size: 150%;
					      dominant-baseline: middle;
					    }
					    .leftPositioned{
					        text-anchor: end;
					    }
					    .rightPositioned{
					        text-anchor: start;
					    }
					    .bolden{
					        font-weight: bold;
					    }
					  </style>
					"
					
					/* SVG DECLARTIONS */
					VAR _svgDeclaration = "data:image/svg+xml;utf8,"
					VAR _svgHeader = "<svg xmlns='http://www.w3.org/2000/svg' height='" & _height & "' width='" & _width & "'>"
					VAR _svgEnd = "</svg>"
					
					/* CALCULATION */
					VAR _sv =
					    "
					  <g class='backgroundCircle'>
					  <circle r='" & _r & "' cx='50%' cy='50%' class='background' />
					  <circle r='" & _r
					        & "' cx='50%' cy='50%' class='filling'/>
					  </g>
					  <g class='mainText'>
					  <text x='50%' y='37.5%' >"
					        & FORMAT( _perc, "0.0%" )
					        & "</text>
					  </g>
					  <g class='subTexts'>
					  <g class='leftPositioned'>
					  <text x='51%' y='50.5%' >"
					        & "Total:"
					        & "</text>
					  <text x='51%' y='60%' >"
					        & "Local:"
					        & "</text>
					  <text x='51%' y='69.5%' class='bolden'>"
					        & "Delta:"
					        & "</text>
					  </g>
					  <g class='rightPositioned'>
					  <text x='53%' y='50.5%' >"
					        & _total
					        & "</text>
					  <text x='53%' y='60%' >"
					        & ROUND( _value, 1 )
					        & "</text>
					  <text x='53%' y='69.5%' class='bolden'>"
					        & ROUND( _total - _value, 1 )
					        & "</text>
					  </g>
					  </g>
					"
					VAR _result = _svgDeclaration & _svgHeader & _styles & _sv & _svgEnd
					RETURN
					    _result
				displayFolder: Enrollment\SVG
				lineageTag: cbbcecba-fb4e-4ddb-abac-f17787894d1b
				dataCategory: ImageUrl

			/// Returns a single space character. Used as an empty placeholder measure to fill visual slots or suppress unwanted default values in chart visuals.
			measure blank = ```
					" " 
