			partition StaffSurvey = m
				mode: import
				queryGroup: facts
				source = ```
						let
						  Source = Excel.Workbook(
						    Web.Contents(
						      "https://apmus.sharepoint.com/sites/DataandInsights/Shared Documents/Power BI Source Files/DOR-AJCC Collab/DOR Staff Survey.xlsx"
						    ), 
						    null, 
						    true
						  ),
						    Sheet1_Sheet = Source{[Item="Sheet1",Kind="Sheet"]}[Data],
						    PromoteHeaders = Table.PromoteHeaders(Sheet1_Sheet, [PromoteAllScalars=true])
						, 
						  TypePairs = {
						    {"CREATE DATE", type date}
						  }, 
						  ExistingCols = Table.ColumnNames(
						    PromoteHeaders
						  ), 
						  // Keep type rules only for columns that actually exist
						  TypePairsExistingOnly = List.Select(
						    TypePairs, 
						    each List.Contains(
						      ExistingCols, 
						      _{0}
						    )
						  ), 
						  // Convert those explicit pairs into a lookup record: ColumnName -> Type
						  ExplicitTypeMap = Record.FromList(
						    List.Transform(
						      TypePairsExistingOnly, 
						      each _{1}
						    ), 
						    List.Transform(
						      TypePairsExistingOnly, 
						      each _{0}
						    )
						  ), 
						  // - If we specified a type in ExplicitTypeMap, use it.
						  // - Otherwise default to type text.
						  AllTypePairs = List.Transform(
						    ExistingCols, 
						    (c) => {
						      c, 
						      Record.FieldOrDefault(
						        ExplicitTypeMap, 
						        c, 
						        type text
						      )
						    }
						  ), 
						  // Apply types in one go
						  ChangeTypes
						    = Table.TransformColumnTypes(
						    PromoteHeaders, 
						    AllTypePairs
						  ),
						    #"Added Conditional Column" = Table.AddColumn(ChangeTypes, "ROLE_FINAL", each if [ROLE] = "Other (please specify)" then [OTHER_ROLE] else [ROLE], type text)
						in
						    #"Added Conditional Column"
						```

