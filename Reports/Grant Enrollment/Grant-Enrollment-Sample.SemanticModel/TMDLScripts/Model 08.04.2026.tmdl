			/// Running total of distinct participants who exited without employment up to and including the selected month, accumulated across all months up to the slicer selection.
			measure 'Exiting Individuals without Employment' = ```
					
					var _Month = SELECTEDVALUE( dimdate[Month Sort] )
					var Result = 
					    CALCULATE(
					        [Exits],
					        Participants[Entered Employment] = "N",
					        ALL ( dimdate ), 
					        dimdate[Month Sort] <= _Month
					    )
					RETURN 
					    Result
					```
				formatString: 0
				displayFolder: Exiters
				lineageTag: dabc74c6-d697-4410-94b7-44c54933185b

			/// Total count of participants with an Exit Date, sourced from the Participant table. Count is based on the currently selected Employment status slicer value (with or without employment). Defaults to With Employment if nothing is selected.
			measure Exiters =
					
					var _Status = SELECTEDVALUE('Employment'[Status], "With Employment")
					var _Services = IF ( _Status = "With Employment", [Exiters with Employment], [Exiters without Employment])
					RETURN _Services
				formatString: 0
