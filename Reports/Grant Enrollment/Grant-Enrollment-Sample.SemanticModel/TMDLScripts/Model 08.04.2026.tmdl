			/// A short prefix code that groups services into high-level categories (e.g. 108 = Co-Enrollment, 140 = Referral). Used to filter specific service types in measures.
			column 'SERVICE PREFIX'
				dataType: string
				lineageTag: 7fd8d054-c725-4e5b-a8ec-791900d01138
				summarizeBy: none
				sourceColumn: SERVICE PREFIX

				annotation SummarizationSetBy = Automatic

			/// The broad grouping of the service type (e.g. Career Services, Training, Support Services). Used to slice service counts by category in charts.
			column 'SERVICE CATEGORY'
