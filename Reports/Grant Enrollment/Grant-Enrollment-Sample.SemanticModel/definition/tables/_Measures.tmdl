	/// Calculates enrollment-related output for the current filter context. Used in enrollment KPI, trend, target, and contribution visuals.
	measure 'MoM Enrollment Change' =
			VAR _CurrentMonthSort =
			    SELECTEDVALUE
			    (
			        'Dynamic Slicer'[Month Sort]
			    )
			VAR _PreviousMonthSort =
			    MAXX
			    (
			        FILTER
			        (
			            ALL ( dimdate[Month Sort] ),
			            dimdate[Month Sort] < _CurrentMonthSort
			        ),
			        dimdate[Month Sort]
			    )
			VAR _CurrentMonthEnrollments =
			    CALCULATE
			    (
			        [Enrollments],
			        REMOVEFILTERS ( dimdate ),
			        TREATAS
			        (
			            { _CurrentMonthSort },
			            dimdate[Month Sort]
			        )
			    )
			VAR _PreviousMonthEnrollments =
			    CALCULATE
			    (
			        [Enrollments],
			        REMOVEFILTERS ( dimdate ),
			        TREATAS
			        (
			            { _PreviousMonthSort },
			            dimdate[Month Sort]
			        )
			    )
			VAR _Result =
			    _CurrentMonthEnrollments
			        - _PreviousMonthEnrollments
			VAR _ResultText =
			    IF
			    (
			        ISBLANK ( _Result ),
			        "n/a",
			        IF
			        (
			            _Result > 0,
			            "(▲ " & FORMAT ( ABS ( _Result ), "#,0" )
			                & ")",
			            "(▼ " & FORMAT ( ABS ( _Result ), "#,0" )
			                & ")"
			        )
			    )
			RETURN
			    IF
			    (
			        ISBLANK ( _CurrentMonthSort ),
			        BLANK ( ),
			        _ResultText
			    )
		displayFolder: Enrollment\Trend
		lineageTag: bf2d52e8-0c4b-4618-99f9-f9e4d6f1d9bd

	/// Returns the conditional formatting color for MoM Enrollment Change. Used by visuals to apply consistent response-status color encoding.
	measure 'MoM Enrollment Change CF' =
			VAR _CurrentMonthSort =
			    SELECTEDVALUE
			    (
			        'Dynamic Slicer'[Month Sort]
			    )
			VAR _PreviousMonthSort =
			    MAXX
			    (
			        FILTER
			        (
			            ALL ( dimdate[Month Sort] ),
			            dimdate[Month Sort] < _CurrentMonthSort
			        ),
			        dimdate[Month Sort]
			    )
			VAR _CurrentMonthEnrollments =
			    CALCULATE
			    (
			        [Enrollments],
			        REMOVEFILTERS ( dimdate ),
			        TREATAS
			        (
			            { _CurrentMonthSort },
			            dimdate[Month Sort]
			        )
			    )
			VAR _PreviousMonthEnrollments =
			    CALCULATE
			    (
			        [Enrollments],
			        REMOVEFILTERS ( dimdate ),
			        TREATAS
			        (
			            { _PreviousMonthSort },
			            dimdate[Month Sort]
			        )
			    )
			VAR _Result =
			    _CurrentMonthEnrollments
			        - _PreviousMonthEnrollments
			VAR _ResultColor =
			    IF
			    (
			        ISBLANK ( _Result ),
			        "#cccccc",
			        IF ( _Result > 0, "#73AF2F", "#AB0C2F" )
			    )
			RETURN
			    IF
			    (
			        ISBLANK ( _CurrentMonthSort ),
			        BLANK ( ),
			        _ResultColor
			    )
		displayFolder: Formatting
		lineageTag: 8a4220c9-ba94-4abb-ae18-11ac4d1a6ae6

	/// Calculates enrollment-related output for the current filter context. Used in enrollment KPI, trend, target, and contribution visuals.
	measure 'Enrollment by Month' =
			VAR __Result =
			    CALCULATE
			    (
			        [Enrollments],
			        ALL ( dimdate ),
			        dimdate[Month Year]
			            = SELECTEDVALUE ( 'Dynamic Slicer'[Month] )
			    )
			RETURN
			    COALESCE
			    (
			        IF
			        (
			            NOT ISINSCOPE ( 'Dynamic Slicer'[Month] ),
			            BLANK ( ),
			            IF
			            (
			                SELECTEDVALUE
			                (
			                    'Dynamic Slicer'[Month Sort]
			                )
			                    <= MAX ( dimdate[Month Sort] )
			                    && SELECTEDVALUE
			                (
			                    'Dynamic Slicer'[Month Sort]
			                )
			                    >= MAX ( dimdate[Month Sort] ) - 11,
			                __Result
			            )
			        ),
			        0
			    )
		formatString: #,0
		displayFolder: Enrollment\Trend
		lineageTag: 25e4260f-53ea-40bb-ac6e-8235d639f1d4

	/// Returns an SVG image URL string for the Enrollment TT - Progress Bar SVG visual. Used in report cards or tooltip visuals and should be categorized as Image URL rather than formatted as a number.
	measure 'Enrollment TT - Progress Bar SVG' = ```
			VAR _target = [Target]
			VAR _value = [Enrollment Switch]
			
			
			/* CARD SIZE */
			VAR _width = 400
			VAR _height = 160
			VAR _paddingX = 20
			// VAR _visualXOffset = 20  -- tweak between 15–30 for your card
			/* STATE */
			VAR _hasTarget =
			    NOT ISBLANK ( _target ) && _target > 0
			VAR _div = DIVIDE ( _value, _target )
			
			/* COLORS */
			VAR _positive = "#658E95"
			VAR _negative = "#7D1D3A"
			VAR _grey = "#D0D0D0"
			VAR _stateColor =
			    IF
			    (
			        _value < _target,
			        _negative,
			        _positive
			    )
			VAR _ChangeColor = [Mom CF Switch]
			
			/* SVG CORE */
			VAR _svg =
			    "data:image/svg+xml;utf8,
			<svg xmlns='http://www.w3.org/2000/svg'
			     viewBox='0 0 "
			        & _width
			        & " "
			        & _height
			        & "'
			          preserveAspectRatio='none'
			          width='100%'
			          height='100%'>
			
			<style>
			text{
			    font-family: Segoe UI;
			    text-anchor: middle;
			    dominant-baseline: middle;
			}
			.main{
			    fill:"
			        & _positive
			        & ";
			    font-size:18px;
			    font-weight:600;
			}
			.sub{
			    fill:#888;
			    font-size:18px;
			}
			.monthsub{
			    fill:"
			        & _ChangeColor
			        & ";
			    font-size:18px;
			}
			.total{
			    fill:"
			        & _stateColor
			        & ";
			    font-size:18px;
			    font-weight:600;
			}
			.barBg{
			    fill:"
			        & _grey
			        & ";
			}
			.barFg{
			    fill:"
			        & _stateColor
			        & ";
			}
			</style>
			<g transform='translate("
			        & "0" 
			        & ",0)'>
			"
			
			
			
			/* TEXT */
			VAR _texts =
			    IF
			    (
			        NOT _hasTarget,
			        "
			    <text class='main' x='50%' y='75' style='font-size:36px'>
			        "
			            & FORMAT ( _value, "#,0" )
			            & " Enrolled
			    </text>
			    ",
			        "
			    <text class='main' x='50%' y='42'>
			        Total Enrollments: "
			            & FORMAT ( _value, "#,0" )
			            & "</text>
			
			    <text class='sub' x='50%' y='66'>
			        Target: "
			            & _target
			            & "</text>
			
			    <text class='total' x='50%' y='90'>
			        "
			            & FORMAT ( _div, "#,#.0%" )
			            & " of target reached "
			            & "</text>
			
			    <text class='sub' x='50%' y='114'>
			        "
			            & ABS ( _value - _target )
			            & IF
			            (
			                _value >= _target,
			                " over target",
			                " below target"
			            )
			            & "</text>
			    "
			    )
			
			/* BAR */
			VAR _bar =
			    IF
			    (
			        NOT _hasTarget,
			        "",
			        VAR _usableWidth = _width - ( _paddingX * 2 )
			        VAR _barWidth =
			            MIN ( _usableWidth, _usableWidth * _div )
			        RETURN
			            "<rect class='barBg'
			          x='"
			                & _paddingX
			                & "'
			          y='136'
			          width='"
			                & _usableWidth
			                & "'
			          height='10' rx='5'/>
			
			    <rect class='barFg'
			          x='"
			                & _paddingX
			                & "'
			          y='136'
			          width='"
			                & _barWidth
			                & "'
			          height='10' rx='5'/>
			    "
			    )
			
			/* CLOSE */
			RETURN
			    IF
			    (
			        SELECTEDVALUE
			        (
			            'Aggregation Table'[Aggregation],
			            "Total"
			        )
			            = "Total",
			        _svg & _texts & _bar & "</g></svg>",
			        [Enrollment TT - Card with Columns]
			    //_svg & _montexts & "</g></svg>"
			    )
			```
		displayFolder: KPIs
		lineageTag: c906bef7-9a9b-45ee-b2e0-1c827e3f21df

	/// Returns the total enrollment target value for comparison against actual enrollments. Used in KPI cards and SVG visuals to benchmark progress toward planned enrollment goals.
	measure Target = SUM ( Targets[ENROLLMENT TARGETS] )
		formatString: #,0
		displayFolder: KPIs
		lineageTag: fa42e123-5ca1-421e-a6ea-b939e6f13220

	/// Returns an SVG image URL string for the Enrollment to Target SVG Total visual. Used in report cards or tooltip visuals and should be categorized as Image URL rather than formatted as a number.
	measure 'Enrollment to Target SVG Total' =
			/* SETUP */
			VAR _total = [Target]  // Will be used as a target
			VAR _value = [Localized Enrollments Total] // Will be used as a current value
			VAR _width = 250 // Width size of the SVG
			VAR _height = 310 // Height size of the SVG
			VAR _CanvasSize = MIN ( _height, _width ) // Canvas size
			VAR _paddning = 15 // Padding between the circle and the canvas
			/* COLOR DEFINITION */
			VAR _positive = "#658E95" // Positive Color
			VAR _neutral = "#E7E74E" // Neutral Color
			VAR _negative = "#7D1D3A" // Negative Color
			/* PRE CALCULATION */
			VAR _halfSize = _CanvasSize / 2 // Half of the canvas size
			VAR _r = _halfSize - _paddning * 1.5 // Radius of the circle
			VAR _round = 2 * PI ( ) * _r // Circumference of the circle
			VAR _perc =
			    IF
			    (
			        _value && _total,
			        DIVIDE ( _value, _total )
			    ) // Percentage of the current value
			VAR _ratio = _round - _round * _perc // Ratio of the current value
			VAR _clr =  // Determine the color of the circle based on the percentage
			    SWITCH
			    (
			        TRUE ( ),
			        _perc >= 0.75, _positive, // Positive Color
			        _perc >= 0.5, _neutral, // Neutral Color
			        _negative // Negative Color
			    )
			
			/* STYLE DECLARTIONS */
			VAR _styles =
			    "
			  <style>
			    text{
			        font-family: Segoe UI;
			    }
			    .backgroundCircle{
			      transform:rotate(-90deg) translate(-"
			        & ( _height + _width ) / 2
			        & "px, "
			        & ( _width - _height ) / 2
			        & "px);
			    }
			    .backgroundCircle{
			      fill: transparent;
			      stroke-width: "
			        & _paddning
			        & ";
			    }
			    .background{
			      stroke: #e0e0e0;
			    }
			    .filling{
			      stroke: "
			        & _clr
			        & ";
			      stroke-linecap: round;
			      stroke-dasharray: "
			        & _round
			        & ";
			      stroke-dashoffset: "
			        & _ratio
			        & ";
			    }
			    .mainText{
			      fill: "
			        & _clr
			        & ";
			      font-size: 300%;
			      text-anchor: middle;
			      dominant-baseline: middle;
			      font-weight: bold;
			    }
			    .subTexts{
			      fill: #CCCCCC;
			      font-size: 150%;
			      dominant-baseline: middle;
			    }
			    .leftPositioned{
			        text-anchor: end;
			    }
			    .rightPositioned{
			        text-anchor: start;
			    }
			    .bolden{
			        font-weight: bold;
			    }
			  </style>
			"
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			/* SVG DECLARTIONS */
			VAR _svgDeclaration =
			    "data:image/svg+xml;utf8,"
			VAR _svgHeader =
			    "<svg xmlns='http://www.w3.org/2000/svg' height='"
			        & _height
			        & "' width='"
			        & _width
			        & "'>"
			VAR _svgEnd = "</svg>"
			
			/* CALCULATION */
			VAR _sv =
			    "
			  <g class='backgroundCircle'>
			  <circle r='"
			        & _r
			        & "' cx='50%' cy='50%' class='background' />
			  <circle r='"
			        & _r
			        & "' cx='50%' cy='50%' class='filling'/>
			  </g>
			  <g class='mainText'>
			  <text x='50%' y='37.5%' >"
			        & FORMAT ( _perc, "#,#.0%" )
			        & "</text>
			  </g>
			  <g class='subTexts'>
			  <g class='leftPositioned'>
			  <text x='55%' y='50.5%' >"
			        & "Target:"
			        & "</text>
			  <text x='55%' y='60%' >"
			        & "Enrolled:"
			        & "</text>
			  <text x='55%' y='69.5%' class='bolden'>"
			        & "Delta:"
			        & "</text>
			  </g>
			  <g class='rightPositioned'>
			  <text x='57%' y='50.5%' >"
			        & _total
			        & "</text>
			  <text x='57%' y='60%' >"
			        & ROUND ( _value, 1 )
			        & "</text>
			  <text x='57%' y='69.5%' class='bolden'>"
			        & ROUND ( _total - _value, 1 )
			        & "</text>
			  </g>
			  </g>
			"
			VAR _result =
			    _svgDeclaration & _svgHeader & _styles
			        & _sv
			        & _svgEnd
			RETURN
			    _result
		displayFolder: KPIs
		lineageTag: 010001d2-5140-4394-a866-e4ca3dccd839

