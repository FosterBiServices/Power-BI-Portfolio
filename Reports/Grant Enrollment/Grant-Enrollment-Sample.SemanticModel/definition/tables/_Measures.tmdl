	/// Calculates enrollment-related output for the current filter context. Used in enrollment KPI, trend, target, and contribution visuals.
	measure 'MoM Enrollment Change Card' =
			VAR _CurrentMonthSort =
			    SELECTEDVALUE
			    (
			        'Dynamic Slicer'[Month Sort]
			    )
			VAR _PreviousMonthSort =
			    MAXX
			    (
			        FILTER
			        (
			            ALL ( dimdate[Month Sort] ),
			            dimdate[Month Sort] < _CurrentMonthSort
			        ),
			        dimdate[Month Sort]
			    )
			VAR _CurrentMonthEnrollments =
			    CALCULATE
			    (
			        [Enrollments],
			        REMOVEFILTERS ( dimdate ),
			        TREATAS
			        (
			            { _CurrentMonthSort },
			            dimdate[Month Sort]
			        )
			    )
			VAR _PreviousMonthEnrollments =
			    CALCULATE
			    (
			        [Enrollments],
			        REMOVEFILTERS ( dimdate ),
			        TREATAS
			        (
			            { _PreviousMonthSort },
			            dimdate[Month Sort]
			        )
			    )
			VAR _Result =
			    _CurrentMonthEnrollments
			        - _PreviousMonthEnrollments
			VAR _ResultText =
			    IF
			    (
			        ISBLANK ( _Result ),
			        "n/a",
			        IF
			        (
			            _Result > 0,
			            "▲ " & FORMAT ( ABS ( _Result ), "#,0" ),
			            "▼ " & FORMAT ( ABS ( _Result ), "#,0" )
			        )
			    )
			RETURN
			    IF
			    (
			        ISBLANK ( _CurrentMonthSort ),
			        BLANK ( ),
			        _ResultText
			    )
		displayFolder: KPIs
		lineageTag: e25fc306-2b65-4ac3-9df9-bd89aef9311e

