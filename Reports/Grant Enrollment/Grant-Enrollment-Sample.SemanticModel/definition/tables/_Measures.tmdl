	/// Returns dynamic title text for the Enrollments vs Target Subtitle visual based on the active slicer and filter context.
	measure 'Enrollments vs Target Subtitle' =
			VAR _MinSort =
			    CALCULATE
			    (
			        MIN ( dimdate[Month Sort] ),
			        ALL ( dimdate )
			    )
			VAR _MinDate =
			    CALCULATE
			    (
			        MIN ( dimdate[Month Year] ),
			        ALL ( dimdate ),
			        dimdate[Month Sort] = _MinSort
			    )
			VAR _Monthly =
			    SELECTEDVALUE ( dimdate[Month Year] )
			RETURN
			    _MinDate & " - " & _Monthly
