	/// Returns the conditional formatting color for Enrollment Label. Used by visuals to apply consistent response-status color encoding.
	measure 'Enrollment Label CF' =
			VAR _CurrentMonth =
			    SELECTEDVALUE
			    (
			        'Dynamic Slicer'[Month Sort]
			    )
			VAR _MonthSummary =
			    ADDCOLUMNS
			    (
			        ALL
			        (
			            dimdate[Month Sort],
			            dimdate[Month Year]
			        ),
			        "@Enrollments",
			            CALCULATE ( [Enrollments] )
			    )
			VAR _ValidMonths =
			    FILTER
			    (
			        _MonthSummary,
			        NOT ISBLANK ( [@Enrollments] )
			    )
			VAR _HighMonth =
			    MINX
			    (
			        TOPN
			        (
			            1,
			            _ValidMonths,
			            [@Enrollments], DESC,
			            dimdate[Month Sort], ASC
			        ),
			        dimdate[Month Sort]
			    )
			VAR _LowMonth =
			    MINX
			    (
			        TOPN
			        (
			            1,
			            _ValidMonths,
			            [@Enrollments], ASC,
			            dimdate[Month Sort], ASC
			        ),
			        dimdate[Month Sort]
			    )
			RETURN
			    SWITCH
			    (
			        TRUE ( ),
			        _CurrentMonth = _HighMonth, "#73AF2F",   -- green
			        _CurrentMonth = _LowMonth, "#AB0C2F",   -- red
			        "#004081"                              -- transparent for all others
			    )
		displayFolder: Formatting
		lineageTag: 38bb34af-f803-406d-9412-ea71694ccc33

	/// Routes between total-period and monthly-period logic for Total Exiters Switch using the FosterBiServices.ApplyPeriod user-defined function.
	measure 'Total Exiters Switch' =
			FosterBIServices.ApplyPeriod
			(
			    [Exiting Individuals with Employment]
			        + [Exiting Individuals without Employment],
			    [Exiters with Employment]
			        + [Exiters without Employment]
			)
		formatString: #,0
		displayFolder: Formatting\Function
		lineageTag: 02bf29a0-ed4a-4e1e-a79a-fa8eb4342953

	/// Returns dynamic title text for the Exiters (Detailed) visual based on the active slicer and filter context.
	measure 'Exiters Title (Detailed)' =
			VAR _Agg =
			    SELECTEDVALUE ( Employment[Status] )
			VAR Numerator = [Exits Switch]
			VAR Denominator = [Total Exiters Switch]
			VAR _TopXPct =
			    DIVIDE ( Numerator, Denominator )
			VAR _Pct = FORMAT ( _TopXPct, "#,#.0%" )
			RETURN
			    IF
			    (
			        Numerator,
			        IF
			        (
			            _Agg = "With Employment",
			            "Exits with employment " & " represent "
			                & _Pct
			                & " of total exits",
			            "Exits without employment "
			                & " represent "
			                & _Pct
			                & " of total exits"
			        ),
			        _Agg
			    )
		displayFolder: Formatting\Title
		lineageTag: 9826e6e4-cd1b-4594-9154-2f3a9153a5b3

	/// Returns a zero-value spacer series when exit data is present, or BLANK when absent. Used to enforce consistent bar spacing in exit-related clustered bar charts.
	measure 'Exits Clustered Chart Spacing' =
			IF
			(
			    ISBLANK ( [Exits Switch] ),
			    BLANK ( ),
			    0
			)
		formatString: #,0
