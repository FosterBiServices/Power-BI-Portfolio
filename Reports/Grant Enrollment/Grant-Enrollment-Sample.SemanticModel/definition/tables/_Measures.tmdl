	/// Returns a fixed blue color (#004081) for enrollment percentage labels when in Total aggregation mode. Provides a consistent static color for the cumulative % to total indicator.
	measure 'Enrollments % to total CF' = VAR _Color = "#004081" RETURN _Color
		displayFolder: Formatting
		lineageTag: 0b744e0c-3bd1-48d0-aedb-901e9ef0eb95

	/// Routes between the cumulative Services Provided Total and the monthly Services Provided figure using ApplyPeriod. Use this measure on visuals to automatically respond to the Total/Monthly aggregation slicer.
	measure 'Services Provided Switch' =
