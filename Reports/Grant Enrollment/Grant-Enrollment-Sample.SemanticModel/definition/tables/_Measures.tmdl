	/// Returns tooltip content for Enrollment TT - Card with Columns. Used to provide contextual detail in report tooltip pages or visual hover states.
	measure 'Enrollment TT - Card with Columns' =
			/* =========================
			   SETUP
			========================= */
			VAR _spaceBetweenColumns = 3
			VAR _maxColumnWidthPct = 100
			VAR _columnRounding = 4
			VAR _width = 400
			VAR _height = 200
			
			/* =========================
			   COLORS
			========================= */
			VAR _barColor = "#658E95"
			VAR _textColor = "#658E95"
			VAR _dataLabelColor = "#D0D0D0"
			
			/* =========================
			   SVG WRAPPER
			========================= */
			VAR _svgDeclaration =
			    "data:image/svg+xml;utf8,"
			VAR _svgHeader =
			    "<svg xmlns='http://www.w3.org/2000/svg'
			          viewBox='0 0 " & _width & " " & _height & "'
			          preserveAspectRatio='none'
			          width='100%'
			          height='100%'>"
			VAR _svgEnd = "</svg>"
			
			/* =========================
			   CSS
			========================= */
			VAR _style =
			    "<style>
			    text {
			        font-family: Segoe UI;
			        dominant-baseline: middle;
			    }
			    .bar {
			        fill: "
			        & _barColor
			        & ";
			    }
			    .bolder {
			        font-weight: 600;
			    }
			</style>"
			
			/* =========================
			   CALLOUT (SLICER AWARE)
			========================= */
			VAR _selectedMonthEnrollments =
			    [Enrollments]   -- intentionally keeps slicer context
			VAR _selectedMonth =
			    SELECTEDVALUE ( dimdate[Month Year] )
			VAR _avgMonthlyEnrollments =
			    [Average Monthly Enrollments]
			VAR _calloutText =
			    "<text x='35%' y='15%'
			       fill='"
			        & _textColor
			        & "'
			       font-size='12'>
			    <tspan class='bolder'>"
			        & FORMAT
			        (
			            _selectedMonthEnrollments,
			            "#,0"
			        )
			        & "</tspan>
			    <tspan font-size='12'> enrollment(s) in "
			        & _selectedMonth
			        & "</tspan>
			    <tspan x='35%' dy='14' fill='"
			        & _dataLabelColor
			        & "' font-size='11'>
			        Avg enrollments per month: "
			        & FORMAT
			        (
			            _avgMonthlyEnrollments,
			            "#,#.0"
			        )
			        & "</tspan>
			
			</text>"
			
			/* =========================
			   BAR DATA (IGNORE SLICER)
			========================= */
			VAR _anchorMonthSort =
			    CALCULATE
			    (
			        MAX ( dimdate[Month Sort] ),
			        REMOVEFILTERS ( dimdate )
			    )
			VAR _data =
			    ADDCOLUMNS
			    (
			        FILTER
			        (
			            SUMMARIZE
			            (
			                ALL ( dimdate ),
			                dimdate[Month Year],
			                dimdate[Month Sort]
			            ),
			            dimdate[Month Sort] <= _anchorMonthSort
			                && dimdate[Month Sort]
			                > _anchorMonthSort - 12
			        ),
			        "@Enrollments", [Enrollments],
			        "@RowNum",
			            ROWNUMBER
			            (
			                FILTER
			                (
			                    SUMMARIZE
			                    (
			                        ALL ( dimdate ),
			                        dimdate[Month Year],
			                        dimdate[Month Sort]
			                    ),
			                    dimdate[Month Sort] <= _anchorMonthSort
			                        && dimdate[Month Sort]
			                        > _anchorMonthSort - 12
			                ),
			                ORDERBY ( dimdate[Month Sort], ASC )
			            )
			    )
			VAR _rowCount = COUNTROWS ( _data )
			VAR _maxValue =
			    MAXX ( _data, [@Enrollments] )
			
			/* =========================
			   COLUMN SIZING
			========================= */
			VAR _columnWidthPct =
			    MIN
			    (
			        _maxColumnWidthPct,
			        DIVIDE
			        (
			            100
			                - ( _rowCount + 1 ) * _spaceBetweenColumns,
			            _rowCount
			        )
			    )
			
			/* =========================
			   BARS
			========================= */
			VAR _columns =
			    CONCATENATEX
			    (
			        _data,
					VAR _heightPct =
						IF ( _maxValue = 0, 0,
							ROUND ( DIVIDE ( [@Enrollments], _maxValue ) * 60, 2 )   -- was * 45
							)
			        VAR _x =
			            ( [@RowNum] - 1 ) * _columnWidthPct
			                + ( [@RowNum] * _spaceBetweenColumns )
			        VAR _y = 88 - _heightPct
			        VAR _xCenter = _x + ( _columnWidthPct / 2 )
			        VAR _yCenter = _y + ( _heightPct / 2 )
			        RETURN
			            /* Bar */
			            "<rect class='bar'
			                x='"
			                & _x
			                & "%'
			                y='"
			                & _y
			                & "%'
			                width='"
			                & _columnWidthPct
			                & "%'
			                height='"
			                & _heightPct
			                & "%'
			                rx='"
			                & _columnRounding
			                & "' />"
			
			                /* Value label */
			                & IF
			                (
			                    _heightPct >= 8,  -- prevent clutter on tiny bars
			                    "<text
			                    x='"
			                        & _xCenter
			                        & "%'
			                    y='"
			                        & _yCenter
			                        & "%'
			                    text-anchor='middle'
			                    dominant-baseline='middle'
			                    font-size='10'
			                    fill='white'>"
			                        & FORMAT ( [@Enrollments], "#,0" )
			                        & "</text>",
			                    ""
			                )
			    )
			/* =========================
			   MONTH LABELS
			========================= */
			VAR _monthLabels =
			    CONCATENATEX
			    (
			        _data,
			        VAR _xCenter =
			            ( ( [@RowNum] - 1 ) * _columnWidthPct )
			                + ( [@RowNum] * _spaceBetweenColumns )
			                + ( _columnWidthPct / 2 )
			        RETURN
			            "<text x='" & _xCenter
			                & "%'
			                   y='94%'
			                   text-anchor='middle'
			                   font-size='10'
			                   fill='"
			                & _dataLabelColor
			                & "'>"
			                & FORMAT
			                (
			                    DATE
			                    (
			                        2000,
			                        MONTH
			                        (
			                            DATEVALUE ( "1 " & dimdate[Month Year] )
			                        ),
			                        1
			                    ),
			                    "MMM"
			                )
			                & "</text>"
			    )
			/* =========================
			   FINAL SVG
			========================= */
			RETURN
			    _svgDeclaration & _svgHeader & _style
			        & _calloutText
			        & _columns
			        & _monthLabels
			        & _svgEnd
		displayFolder: KPIs
		lineageTag: 0638c0ff-81af-49a2-b61b-1034b8606a56
		dataCategory: ImageUrl

	/// Returns dynamic title text for the Enrollment TT Subtitle visual based on the active slicer and filter context.
	measure 'Enrollment TT Subtitle' =
			VAR _MinSort =
			    CALCULATE
			    (
			        MIN ( dimdate[Month Sort] ),
			        ALL ( dimdate )
			    )
			VAR _MinDate =
			    CALCULATE
			    (
			        MIN ( dimdate[Month Year] ),
			        ALL ( dimdate ),
			        dimdate[Month Sort] = _MinSort
			    )
			VAR _Monthly =
			    SELECTEDVALUE ( dimdate[Month Year] )
			VAR _SelectedAgg =
			    SELECTEDVALUE
			    (
			        'Aggregation Table'[Aggregation]
			    )
			
			RETURN
			    IF
			    (
			        _SelectedAgg = "Total",
			        _MinDate & " - " & _Monthly,
			        BLANK ( )
			    )
		displayFolder: KPIs
		lineageTag: 2f83d257-d1d8-4817-82b1-3debec34ee90

	/// Calculates enrollment-related output for the current filter context. Used in enrollment KPI, trend, target, and contribution visuals.
	measure 'Average Monthly Enrollments' =
			VAR _baseTable =
			    ADDCOLUMNS
			    (
			        SUMMARIZE
			        (
			            ALL ( dimdate ),
			            dimdate[Month Sort],
			            dimdate[Month Year]
			        ),
			        "@Enrollments", [Enrollments]
			    )
			
			/* First month with activity */
			VAR _firstActiveMonth =
			    MINX
			    (
			        FILTER ( _baseTable, [@Enrollments] > 0 ),
			        dimdate[Month Sort]
			    )
			
			/* Valid months = from first activity onward */
			VAR _validMonths =
			    FILTER
			    (
			        _baseTable,
			        dimdate[Month Sort] >= _firstActiveMonth
			    )
			VAR _monthCount = COUNTROWS ( _validMonths )
			VAR _totalEnrollments =
			    SUMX ( _validMonths, [@Enrollments] )
			RETURN
			    DIVIDE ( _totalEnrollments, _monthCount )
		formatString: #,#.0
		displayFolder: KPIs
		lineageTag: c189971b-4dc0-46cc-a9ac-9607a4def4bc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Returns an SVG image URL string for the Svg Legend visual. Used in report cards or tooltip visuals and should be categorized as Image URL rather than formatted as a number.
	measure 'Svg Legend' =
			VAR _lineHeight = 30
			VAR _fontSize = 16
			VAR _fontFamily = "Segoe UI"
			
			-- Build row index so we can vertically position text
			VAR _baseTable =
			    ADDCOLUMNS
			    (
			        VALUES ( Regions[REGION SHORT ABBR] ),
			        "_name",
			            CALCULATE
			            (
			                SELECTEDVALUE ( Regions[REGION LWDB] )
			            ),
			        "_index",
			            RANKX
			            (
			                VALUES ( Regions[REGION SHORT ABBR] ),
			                Regions[REGION SHORT ABBR],
			                ,
			                ASC,
			                DENSE
			            )
			    )
			
			-- Build SVG text rows
			VAR _rows =
			    CONCATENATEX
			    (
			        _baseTable,
			        "<text x='10' y='"
			            & ( [_index] * _lineHeight )
			            & "' font-size='"
			            & _fontSize
			            & "' font-family='"
			            & _fontFamily
			            & "' fill='#004081'>"
			            & Regions[REGION SHORT ABBR]
			            & " → "
			            & [_name]
			            & "</text>",
			        ""
			    )
			
			-- Calculate dynamic height
			VAR _rowCount = COUNTROWS ( _baseTable )
			VAR _height = ( _rowCount + 1 ) * _lineHeight
			VAR _width = 850
			RETURN
			    "data:image/svg+xml;utf8,"
			        & "<svg xmlns='http://www.w3.org/2000/svg' width='"
			        & _width
			        & "' height='"
			        & _height
			        & "'>"
			        & "<rect width='100%' height='100%' fill='white' rx='6' ry='6' stroke='#fff' />"
			        & _rows
			        & "</svg>"
		displayFolder: KPIs
		lineageTag: 27c6c6db-407b-409c-a241-77c13cd04d12

