	partition _Measures = m
		mode: import
		source = ```
				let
				  Source = Table.FromRows(
				    Json.Document(
				      Binary.Decompress(
				        Binary.FromText(
				          "i44FAA==", 
				          BinaryEncoding.Base64
				        ), 
				        Compression.Deflate
				      )
				    ), 
				    let
				      _t = (
				        (type nullable text)
				          meta [Serialized.Text = true]
				      )
				    in
				      type table [Column1 = _t]
				  ), 
				  #"Removed Columns"
				    = Table.RemoveColumns(
				    Source, 
				    {"Column1"}
				  )
				in
				  #"Removed Columns"
				```

