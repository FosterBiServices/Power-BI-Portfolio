	/// Dynamic subtitle for the services chart. In Total mode shows cumulative services from the earliest date to the selected month; in Monthly mode shows services for the selected month only.
	measure 'Services Provided Subtitle' =
			VAR _TServices = [Services Provided Total]
			VAR _MServices = [Services Provided]
			VAR _MinSort =
			    CALCULATE
			    (
			        MIN ( dimdate[Month Sort] ),
			        ALL ( dimdate )
			    )
			VAR _MinDate =
			    CALCULATE
			    (
			        MIN ( dimdate[Month Year] ),
			        ALL ( dimdate ),
			        dimdate[Month Sort] = _MinSort
			    )
			VAR _MaxDate =
			    SELECTEDVALUE ( dimdate[Month Year] )
			VAR _Total =
			    _TServices
			        & " Total Services Provided from "
			        & _MinDate
			        & " - "
			        & _MaxDate
			VAR _Monthly =
			    _MServices & " Services Provided in "
			        & _MaxDate
			VAR _SelectedAgg =
			    SELECTEDVALUE
			    (
			        'Aggregation Table'[Aggregation]
			    )
			RETURN
			    IF
			    (
			        _SelectedAgg = "Total",
			        _Total,
			        _Monthly
			    )
		displayFolder: Formatting\Subtitle
		lineageTag: 6f57bde9-e3c4-47b2-997c-1c73ee203ab7

	/// Dynamic subtitle for the exits chart. Reads the selected employment status (With/Without Employment) from the Employment slicer, then shows either cumulative or monthly exit counts for that status along with the relevant date range.
	measure 'Exits Subtitle' =
			VAR _Status =
			    SELECTEDVALUE
			    (
			        Employment[Status],
			        "With Employment"
			    )
			VAR _TServices =
			    IF
			    (
			        _Status = "With Employment",
			        COALESCE
			        (
			            [Exiting Individuals with Employment],
			            0
			        ),
			        COALESCE
			        (
			            [Exiting Individuals without Employment],
			            0
			        )
			    )
			VAR _MServices =
			    IF
			    (
			        _Status = "With Employment",
			        COALESCE ( [Exiters with Employment], 0 ),
			        COALESCE
			        (
			            [Exiters without Employment],
			            0
			        )
			    )
			VAR _MinSort =
			    CALCULATE
			    (
			        MIN ( dimdate[Month Sort] ),
			        ALL ( dimdate )
			    )
			VAR _MinDate =
			    CALCULATE
			    (
			        MIN ( dimdate[Month Year] ),
			        ALL ( dimdate ),
			        dimdate[Month Sort] = _MinSort
			    )
			VAR _MaxDate =
			    SELECTEDVALUE ( dimdate[Month Year] )
			VAR _Total =
			    _TServices & " Total Exits " & _Status
			        & " from "
			        & _MinDate
			        & " - "
			        & _MaxDate
			VAR _Monthly =
			    _MServices & " Exits " & _Status
			        & " in "
			        & _MaxDate
			VAR _SelectedAgg =
			    SELECTEDVALUE
			    (
			        'Aggregation Table'[Aggregation]
			    )
			RETURN
			    IF
			    (
			        _SelectedAgg = "Total",
			        _Total,
			        _Monthly
			    )
		displayFolder: Formatting\Subtitle
		lineageTag: b1e01f5b-b582-4953-93a3-29be8de38b13

	/// Dynamic subtitle for the localization (SVG ring) visuals. In Total mode shows the full date range from the earliest month to the selected month; in Monthly mode shows only the selected month.
	measure 'Localization Subtitle' =
			VAR _MinSort =
			    CALCULATE
			    (
			        MIN ( dimdate[Month Sort] ),
			        ALL ( dimdate )
			    )
			VAR _MinDate =
			    CALCULATE
			    (
			        MIN ( dimdate[Month Year] ),
			        ALL ( dimdate ),
			        dimdate[Month Sort] = _MinSort
			    )
			VAR _Monthly =
			    SELECTEDVALUE ( dimdate[Month Year] )
			VAR _SelectedAgg =
			    SELECTEDVALUE
			    (
			        'Aggregation Table'[Aggregation]
			    )
			RETURN
			    IF
			    (
			        _SelectedAgg = "Total",
			        _MinDate & " - " & _Monthly,
			        _Monthly
			    )
		displayFolder: Formatting\Subtitle
		lineageTag: 59a2bdb6-8a71-46ce-9e2c-8e7d6949af1a

	/// Dynamic label for the date slicer header. Returns 'Choose an End Month:' in Total mode (since the user is picking a cumulative end date) or 'Choose a Month:' in Monthly mode. Powered by the FosterBiServices.ApplyPeriod user-defined function.
	measure 'Date Slicer Header Switch' = FosterBIServices.ApplyPeriod ( "Choose an End Month:", "Choose a Month:" )
		displayFolder: Formatting\Title
		lineageTag: 746fb56a-8d4d-45d9-ba62-8fad9ddb82cd

	/// Static tooltip text explaining the aggregation slicer behavior: Monthly shows data for the selected month only, Total shows all data up to the last day of the selected month.
	measure 'Aggregation Tooltip' = "Selecting Monthly will display data for the month selected, Total will show all data up to the last day of the selected month"
		displayFolder: Formatting\Visuals
		lineageTag: af88737c-9180-4bb5-8e31-82fcd4865c38

	/// Plots cumulative enrollment totals over time for the trend line chart. For each month in the Dynamic Slicer, it calculates Enrolled Individuals as of that month. Returns BLANK when the month is out of scope or outside the valid date window, preventing phantom data points.
	measure 'Enrollment Trend' =
			VAR __Result =
			    CALCULATE
			    (
			        [Enrolled Individuals],
			        ALL ( dimdate ),
			        dimdate[Month Year]
			            = SELECTEDVALUE ( 'Dynamic Slicer'[Month] )
			    )
			RETURN
			    IF
			    (
			        NOT ISINSCOPE ( 'Dynamic Slicer'[Month] ),
			        BLANK ( ),
			        IF
			        (
			            SELECTEDVALUE
			            (
			                'Dynamic Slicer'[Month Sort]
			            )
			                <= MAX ( dimdate[Month Sort] )
			                && SELECTEDVALUE
			            (
			                'Dynamic Slicer'[Month Sort]
			            )
			                >= MAX ( dimdate[Month Sort] ) - 11,
			            __Result
			        )
			    )
		formatString: #,#.0
		displayFolder: Enrollment\Trend
		lineageTag: 76b11610-380b-4870-83a8-f36f6ef685b8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Returns Enrolled Individuals multiplied by 1.3 to provide a slightly elevated Y-axis upper bound for enrollment trend charts, preventing the line from touching the top of the chart area.
	measure 'Enrollment Y-Axis Helper' = [Enrolled Individuals] * 1.3
		formatString: #,#.0
		displayFolder: Formatting\Visuals
		lineageTag: 1a99311c-6d82-4568-84f5-2db748dcd31e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Returns 0 when Services Provided Switch has a value, or BLANK when it does not. Used as a dummy series in clustered bar charts to create consistent spacing between cluster groups.
	measure 'Clustered Chart Spacing' =
			IF
			(
			    ISBLANK ( [Services Provided Switch] ),
			    BLANK ( ),
			    0
			)
		formatString: #,0
		displayFolder: Formatting\Visuals
		lineageTag: 71621506-2dd8-4652-93d3-9ab3e9089ada

	/// Returns the currently selected service category name, ignoring date filters. Used to display the active service category label in chart titles or reference labels without date context interfering.
	measure 'Current Service Category' =
			CALCULATE
			(
			    SELECTEDVALUE
			    (
			        ServicesProvided[SERVICE CATEGORY]
			    ),
			    REMOVEFILTERS ( dimdate )
			)
		displayFolder: ServicesProvided\Formatting
		lineageTag: 3532127b-fb46-4f21-a487-cf7103bd06f5

	/// Count of services with SERVICE PREFIX = 140 (Referrals), filtered to the current period via Services Provided Switch. The display format also shows each value as a percentage of total enrollments (e.g. '42 (18.3%)').
	measure Referrals =
			CALCULATE
			(
			    [Services Provided Switch],
			    ServicesProvided[SERVICE PREFIX] = "140"
			)
		displayFolder: ServicesProvided\CompoundSwitch
		lineageTag: 8ac49176-dd4e-426e-81bf-eed5f9c30a68

		formatStringDefinition =
				VAR _Value =
				    CALCULATE
				    (
				        [Services Provided Switch],
				        ServicesProvided[SERVICE PREFIX] = "140"
				    )
				RETURN
				    """" & _Value & " ("
				        & FORMAT
				        (
				            DIVIDE ( _Value, [Enrollment Switch] ),
				            "#,#.0%"
				        )
				        & ")"

	/// Count of services with SERVICE PREFIX = 108 (Co-Enrollments), filtered to the current period via Services Provided Switch. The display format also shows each value as a percentage of total enrollments (e.g. '15 (6.2%)').
	measure Co-Enrollments =
			CALCULATE
			(
			    [Services Provided Switch],
			    ServicesProvided[SERVICE PREFIX] = "108"
			)
		displayFolder: ServicesProvided\CompoundSwitch
		lineageTag: 49f92c14-c863-4aff-9165-795b47c8c05d

		formatStringDefinition =
				VAR _Value =
				    CALCULATE
				    (
				        [Services Provided Switch],
				        ServicesProvided[SERVICE PREFIX] = "108"
				    )
				RETURN
				    """" & _Value & " ("
				        & FORMAT
				        (
				            DIVIDE ( _Value, [Enrollment Switch] ),
				            "#,#.0%"
				        )
				        & ")"

	/// Participant identifier total for participants who exited the program and did not enter employment (Entered Employment = N) in the selected month.
	measure 'Exiters without Employment' =
			CALCULATE
			(
			    [Exits],
			    Participants[ENTERED EMPLOYMENT] = "N"
			)
		formatString: #,0
		displayFolder: Exiters
		lineageTag: 234e5987-9485-467d-a28b-77cea8e2e969

	/// Running total of distinct participants who exited without employment up to and including the selected month, accumulated across all months up to the slicer selection.
	measure 'Exiting Individuals without Employment' =
			VAR _Month =
			    SELECTEDVALUE ( dimdate[Month Sort] )
			VAR Result =
			    CALCULATE
			    (
			        [Exits],
			        Participants[ENTERED EMPLOYMENT] = "N",
			        ALL ( dimdate ),
			        dimdate[Month Sort] <= _Month
			    )
			RETURN
			    Result
		formatString: #,0
		displayFolder: Exiters
		lineageTag: dabc74c6-d697-4410-94b7-44c54933185b

	/// Total count of participants with an Exit Date, sourced from the Participant table. Count is based on the currently selected Employment status slicer value (with or without employment). Defaults to With Employment if nothing is selected.
	measure Exiters =
			VAR _Status =
			    SELECTEDVALUE
			    (
			        Employment[Status],
			        "With Employment"
			    )
			VAR _Services =
			    IF
			    (
			        _Status = "With Employment",
			        [Exiters with Employment],
			        [Exiters without Employment]
			    )
			RETURN
			    _Services
		formatString: #,0
		displayFolder: Exiters
		lineageTag: 10de5d3f-19c9-449f-b181-0fcd940945e6

	/// Returns either Exiting Individuals with Employment or Exiting Individuals without Employment (cumulative totals) based on the Employment slicer selection. Defaults to With Employment.
	measure 'Exiting Individuals' =
			VAR _Status =
			    SELECTEDVALUE
			    (
			        Employment[Status],
			        "With Employment"
			    )
			VAR _Services =
			    IF
			    (
			        _Status = "With Employment",
			        [Exiting Individuals with Employment],
			        [Exiting Individuals without Employment]
			    )
			RETURN
			    _Services
		formatString: #,0
		displayFolder: Exiters
		lineageTag: 4e08fa41-5596-4b54-8bd4-d3b1f2c9ff55

	/// Calculates the selected service category's share of total services for the current period and region, formatted as '- XX.X%'. Used as a reference label on the service category breakdown chart to show each category's contribution.
	measure 'Service Category Detail Label' =
			VAR _Month =
			    SELECTEDVALUE ( dimdate[Month Sort] )
			VAR _Monthly =
			    CALCULATE
			    (
			        SUM ( ServicesProvided[USER ID] ),
			        ALL ( dimdate ),
			        dimdate[Month Sort] = _Month,
			        ALL ( ServicesProvided ),
			        KEEPFILTERS ( Regions )
			    )
			VAR _Total =
			    CALCULATE
			    (
			        SUM ( ServicesProvided[USER ID] ),
			        ALL ( dimdate ),
			        dimdate[Month Sort] <= _Month,
			        ALL ( ServicesProvided ),
			        KEEPFILTERS ( Regions )
			    )
			VAR _Switcheroo = FosterBIServices.ApplyPeriod ( _Total, _Monthly )
			VAR _SPSwitch = [Services Provided Switch]
			RETURN
			    "- "
			        & FORMAT
			        (
			            DIVIDE ( _SPSwitch, _Switcheroo ),
			            "#,#.0%"
			        )
		displayFolder: Formatting\ReferenceLabels
		lineageTag: 425189ca-7d70-43fc-9a09-8f0116ad23ef

	/// Returns dynamic title text for the Enrollment (Detailed) visual based on the active slicer and filter context.
	measure 'Enrollment Title (Detailed)' =
			VAR _Agg =
			    SELECTEDVALUE
			    (
			        'Aggregation Table'[Aggregation]
			    )
			VAR TopXValue =
			    MAX
			    (
			        1,
			        CEILING ( MAX ( TopXSelector[Value] ), 1 )
			    )
			VAR Numerator =
			    CALCULATE
			    (
			        [Enrollment Switch],
			        TOPN
			        (
			            TopXValue,
			            ALLSELECTED ( Regions[REGION LWDB] ),
			            [Enrollment Switch], DESC
			        )
			    )
			VAR Denominator =
			    VAR _TEnrollments =
			        CALCULATE
			        (
			            [Enrolled Individuals],
			            ALL ( Regions[REGION LWDB] )
			        )
			    VAR _MEnrollments =
			        CALCULATE
			        (
			            [Enrollments],
			            ALL ( Regions[REGION LWDB] )
			        )
			    RETURN
			        IF
			        (
			            _Agg = "Total",
			            _TEnrollments,
			            _MEnrollments
			        )
			VAR _TopXPct =
			    DIVIDE ( Numerator, Denominator )
			VAR _Pct = FORMAT ( _TopXPct, "#,#.0%" )
			RETURN
			    IF
			    (
			        _Agg = "Total",
			        "Top " & TopXValue
			            & " Regions represent "
			            & _Pct
			            & " of total enrollment",
			        "Top " & TopXValue
			            & " Regions represent "
			            & _Pct
			            & " of monthly enrollment"
			    )
		displayFolder: Formatting\Title
		lineageTag: 171c9578-722f-49bd-9c32-7f58ba1a62a1

	/// Returns dynamic title text for the Disability Status (Detailed) visual based on the active slicer and filter context.
	measure 'Disability Status Title (Detailed)' =
			VAR Numerator =
			    CALCULATE
			    (
			        [Disability Status],
			        Participants[WITH DISABILITY] = "Y"
			    )
			VAR Denominator =
			    CALCULATE
			    (
			        [Disability Status],
			        Participants[WITH DISABILITY] <> "Y"
			    )
			VAR _TopXPct =
			    DIVIDE
			    (
			        Numerator,
			        Numerator + Denominator
			    )
			VAR _Pct = FORMAT ( _TopXPct, "#,#.0%" )
			RETURN
			    _Pct
			        & " answered yes to having disability "
		displayFolder: Formatting\Title
		lineageTag: b2fd538b-7e31-47b9-b39e-4bdd1f9ae55e

	/// Returns dynamic title text for the MoM Enrollment (Detailed) visual based on the active slicer and filter context.
	measure 'MoM Enrollment Title (Detailed)' =
			VAR monthCount =
			    CALCULATE
			    (
			        DISTINCTCOUNTNOBLANK
			        (
			            dimdate[Month Sort]
			        ),
			        ALL ( dimdate )
			    )
			RETURN
			    FORMAT
			    (
			        DIVIDE
			        (
			            [Enrolled Individuals],
			            monthCount
			        ),
			        "#,0"
			    )
			        & " average enrollments per month"
		displayFolder: Formatting\Title
		lineageTag: 2a45ecaa-8b43-4629-8749-e1f75afff3cc

	/// Returns dynamic title text for the Services Category (Detailed) visual based on the active slicer and filter context.
	measure 'Services Category Title (Detailed)' =
			VAR _Agg =
			    SELECTEDVALUE
			    (
			        'Aggregation Table'[Aggregation]
			    )
			VAR TopXValue =
			    MAX
			    (
			        1,
			        CEILING ( MAX ( TopXSelector[Value] ), 1 )
			    )
			VAR Numerator =
			    CALCULATE
			    (
			        [Services Provided Switch],
			        TOPN
			        (
			            TopXValue,
			            ALLSELECTED
			            (
			                ServicesProvided[SERVICE CATEGORY]
			            ),
			            [Services Provided Switch], DESC
			        )
			    )
			VAR Denominator =
			    CALCULATE
			    (
			        [Services Provided Switch],
			        ALL
			        (
			            ServicesProvided[SERVICE CATEGORY]
			        )
			    )
			VAR _TopXPct =
			    DIVIDE ( Numerator, Denominator )
			RETURN
			    TopXValue
