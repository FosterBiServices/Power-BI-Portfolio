	/// Returns tooltip content for MoM Enrollment Change TT. Used to provide contextual detail in report tooltip pages or visual hover states.
	measure 'MoM Enrollment Change TT' =
			VAR _CurrentMonthSort =
			    SELECTEDVALUE ( dimdate[Month Sort] )
			VAR _PreviousMonthSort =
			    MAXX
			    (
			        FILTER
			        (
			            ALL ( dimdate[Month Sort] ),
			            dimdate[Month Sort] < _CurrentMonthSort
			        ),
			        dimdate[Month Sort]
			    )
			VAR _CurrentMonthEnrollments =
			    CALCULATE
			    (
			        [Enrollments],
			        REMOVEFILTERS ( dimdate ),
			        TREATAS
			        (
			            { _CurrentMonthSort },
			            dimdate[Month Sort]
			        )
			    )
			VAR _PreviousMonthEnrollments =
			    CALCULATE
			    (
			        [Enrollments],
			        REMOVEFILTERS ( dimdate ),
			        TREATAS
			        (
			            { _PreviousMonthSort },
			            dimdate[Month Sort]
			        )
			    )
			VAR _Result =
			    _CurrentMonthEnrollments
			        - _PreviousMonthEnrollments
			VAR _ResultText =
			    IF
			    (
			        ISBLANK ( _Result ),
			        "n/a",
			        IF
			        (
			            _Result > 0,
			            "▲ " & FORMAT ( ABS ( _Result ), "#,0" ),
			            IF
			            (
			                _Result < 0,
			                "▼ " & FORMAT ( ABS ( _Result ), "#,0" ),
			                " ▬ "
			            )
			        )
			    )
			RETURN
			    IF
			    (
			        ISBLANK ( _CurrentMonthSort ),
			        BLANK ( ),
			        _ResultText
			    )
		displayFolder: KPIs
		lineageTag: b3fef423-878c-46fe-82b8-c9330929da0b

