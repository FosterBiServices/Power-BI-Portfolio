	/// Routes between the cumulative (Total) and monthly enrollment figures using the FosterBiServices.ApplyPeriod user-defined function. Returns Enrolled Individuals when Total is selected, or Enrollments when Monthly is selected.
	measure 'Enrollment Switch' = FosterBIServices.ApplyPeriod ( [Enrolled Individuals], [Enrollments] )
		formatString: #,0
		displayFolder: Function\Switch
		lineageTag: 9148361c-b9ea-43cb-bcbd-f939aa715516

	/// Routes between the cumulative Detail Position and the monthly Monthly Detail Position using ApplyPeriod, ensuring chart annotation labels are positioned correctly for whichever aggregation mode is active.
	measure 'Detail Position Switch' =
			FosterBIServices.ApplyPeriod
			(
			    [Detail Position],
