	/// Returns the conditional formatting color for Disability Status. Used by visuals to apply consistent response-status color encoding.
	measure 'Disability Status CF' = FosterBIServices.TextCFColorHelper ( Participants[WITH DISABILITY] )
		displayFolder: Formatting
