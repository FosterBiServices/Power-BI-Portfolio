/// Hidden calculation table that houses all DAX measures for this model. No data rows — used purely as an organizational container to keep all measures in one place rather than scattered across fact and dimension tables.
table _Measures
	lineageTag: 31dc1f0e-46a4-43ff-86dc-4408f3931ffa

	/// Running total of participants by APP ID enrolled up to and including the selected month. Captures all months up to the slicer selection so cumulative enrollment grows over time.
	measure 'Enrolled Individuals' =
			VAR _Month =
			    SELECTEDVALUE ( dimdate[Month Sort] )
			VAR Result =
			    CALCULATE
			    (
			        SUM ( Participants[APP ID] ),
			        ALL ( dimdate ),
			        dimdate[Month Sort] <= _Month
			    )
			RETURN
			    Result
		formatString: #,0
		displayFolder: Enrollment\UpToDate
		lineageTag: 58a0d3c6-b105-4ff1-9473-a50424ccb216

	/// Total count of participants by disability status, sourced from the Participant table. Used to show the disability breakdown in the participant summary section.
	measure 'Disability Status' =
			CALCULATE
			(
			    [Enrollments],
			    REMOVEFILTERS ( dimdate[Month Year] )
			)
		formatString: #,0
		displayFolder: Enrollment Disability
		lineageTag: ac87f82b-0911-49d0-8ba2-fe6ae7fe8304

	/// Count of service records delivered in the currently selected month. Each row in ServicesProvided represents one service delivered to one participant.
	measure 'Services Provided' = SUM ( ServicesProvided[USER ID] )
		formatString: #,0
		displayFolder: ServicesProvided\SelectedMonth
		lineageTag: 65b5fb56-2045-4ce7-8e68-23f540202829

	/// Participant identifier total for participants who exited the program and entered employment (Entered Employment = Y) in the selected month.
	measure 'Exiters with Employment' =
			CALCULATE
			(
			    [Exits],
			    Participants[ENTERED EMPLOYMENT] = "Y"
			)
		formatString: #,0
		displayFolder: Exiters\SelectedMonth
		lineageTag: 3200844e-59c6-49d2-babb-25e0ff0e9f15

	/// Distinct count of enrolled participants filtered to the currently selected region (LWDB). Ignores the Regions filter context then re-applies only the selected locality, ensuring accurate regional counts.
	measure 'Localized Enrollments' =
			VAR Locality =
			    SELECTEDVALUE ( Regions[REGION LWDB] )
			VAR Result =
			    CALCULATE
			    (
			        SUM ( Participants[APP ID] ),
			        ALL ( Regions ),
			        Regions[REGION LWDB] = Locality
			    )
			RETURN
			    Result
		formatString: #,0
		displayFolder: Enrollment\SelectedMonth
		lineageTag: 2f3cdd2e-fa41-408f-82f9-c0415ed604e7

	/// Distinct count of enrolled participants across all regions, ignoring any region filter. Used as the statewide denominator for regional contribution calculations.
	measure 'Total Enrollments' =
			VAR Result =
			    CALCULATE
			    (
			        SUM ( Participants[APP ID] ),
			        REMOVEFILTERS ( Regions[REGION LWDB] )
			    )
			RETURN
			    Result
		formatString: #,0
		displayFolder: Enrollment\SelectedMonth
		lineageTag: ace8e8f2-1836-4f4e-b890-d72c9d118336

	/// Count of service records for the currently selected region. Clears the Regions filter then pins it back to the selected locality so the number stays accurate regardless of other visual filters.
	measure 'Localized Services Provided' =
			VAR Locality =
			    SELECTEDVALUE ( Regions[REGION CODE] )
			VAR Result =
			    CALCULATE
			    (
			        SUM ( ServicesProvided[USER ID] ),
			        ALL ( Regions ),
			        Regions[REGION CODE] = Locality
			    )
			RETURN
			    IF ( NOT ISBLANK ( Locality ), Result )
		formatString: #,0
		displayFolder: ServicesProvided\SelectedMonth
		lineageTag: e77d5593-c9c3-4d41-8d50-2d66aa36951c

	/// Count of all service records statewide, with the region filter removed. Used as the denominator when calculating a region's share of services.
	measure 'Total Services Provided' =
			VAR Result =
			    CALCULATE
			    (
			        SUM ( ServicesProvided[USER ID] ),
			        ALL ( Regions )
			    )
			RETURN
			    Result
		formatString: #,0
		displayFolder: ServicesProvided\SelectedMonth
		lineageTag: 2e89deea-359c-41e5-8988-391f743b87e1

	/// Generates a circular progress ring SVG image showing the selected region's enrollment as a percentage of total statewide enrollment for the selected month. The ring color turns teal (>=75%), yellow (>=50%), or dark red (<50%). Also displays Total, Local, and Delta counts inside the ring.
	measure 'Enrollment SVG' =
			/* SETUP */
			VAR _total = [Total Enrollments]  // Will be used as a target
			VAR _value = [Localized Enrollments] // Will be used as a current value
			VAR _width = 250 // Width size of the SVG
			VAR _height = 310 // Height size of the SVG
			VAR _CanvasSize = MIN ( _height, _width ) // Canvas size
			VAR _paddning = 15 // Padding between the circle and the canvas
			/* COLOR DEFINITION */
			VAR _positive = "#658E95" // Positive Color
			VAR _neutral = "#E7E74E" // Neutral Color
			VAR _negative = "#7D1D3A" // Negative Color
			/* PRE CALCULATION */
			VAR _halfSize = _CanvasSize / 2 // Half of the canvas size
			VAR _r = _halfSize - _paddning * 1.5 // Radius of the circle
			VAR _round = 2 * PI ( ) * _r // Circumference of the circle
			VAR _perc = _value / _total // Percentage of the current value
			VAR _ratio = _round - _round * _perc // Ratio of the current value
			VAR _clr =  // Determine the color of the circle based on the percentage
			    SWITCH
			    (
			        TRUE ( ),
			        _perc >= 0.75, _positive, // Positive Color
			        _perc >= 0.5, _neutral, // Neutral Color
			        _negative // Negative Color
			    )
			
			/* STYLE DECLARTIONS */
			VAR _styles =
			    "
			  <style>
			    text{
			        font-family: Segoe UI;
			    }
			    .backgroundCircle{
			      transform:rotate(-90deg) translate(-"
			        & ( _height + _width ) / 2
			        & "px, "
			        & ( _width - _height ) / 2
			        & "px);
			    }
			    .backgroundCircle{
			      fill: transparent;
			      stroke-width: "
			        & _paddning
			        & ";
			    }
			    .background{
			      stroke: #e0e0e0;
			    }
			    .filling{
			      stroke: "
			        & _clr
			        & ";
			      stroke-linecap: round;
			      stroke-dasharray: "
			        & _round
			        & ";
			      stroke-dashoffset: "
			        & _ratio
			        & ";
			    }
			    .mainText{
			      fill: "
			        & _clr
			        & ";
			      font-size: 300%;
			      text-anchor: middle;
			      dominant-baseline: middle;
			      font-weight: bold;
			    }
			    .subTexts{
			      fill: #CCCCCC;
			      font-size: 150%;
			      dominant-baseline: middle;
			    }
			    .leftPositioned{
			        text-anchor: end;
			    }
			    .rightPositioned{
			        text-anchor: start;
			    }
			    .bolden{
			        font-weight: bold;
			    }
			  </style>
			"
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			/* SVG DECLARTIONS */
			VAR _svgDeclaration =
			    "data:image/svg+xml;utf8,"
			VAR _svgHeader =
			    "<svg xmlns='http://www.w3.org/2000/svg' height='"
			        & _height
			        & "' width='"
			        & _width
			        & "'>"
			VAR _svgEnd = "</svg>"
			
			/* CALCULATION */
			VAR _sv =
			    "
			  <g class='backgroundCircle'>
			  <circle r='"
			        & _r
			        & "' cx='50%' cy='50%' class='background' />
			  <circle r='"
			        & _r
			        & "' cx='50%' cy='50%' class='filling'/>
			  </g>
			  <g class='mainText'>
			  <text x='50%' y='37.5%' >"
			        & FORMAT ( _perc, "#,#.0%" )
			        & "</text>
			  </g>
			  <g class='subTexts'>
			  <g class='leftPositioned'>
			  <text x='51%' y='50.5%' >"
			        & "Total:"
			        & "</text>
			  <text x='51%' y='60%' >"
			        & "Local:"
			        & "</text>
			  <text x='51%' y='69.5%' class='bolden'>"
			        & "Delta:"
			        & "</text>
			  </g>
			  <g class='rightPositioned'>
			  <text x='53%' y='50.5%' >"
			        & _total
			        & "</text>
			  <text x='53%' y='60%' >"
			        & ROUND ( _value, 1 )
			        & "</text>
			  <text x='53%' y='69.5%' class='bolden'>"
			        & ROUND ( _total - _value, 1 )
			        & "</text>
			  </g>
			  </g>
			"
			VAR _result =
			    _svgDeclaration & _svgHeader & _styles
			        & _sv
			        & _svgEnd
			RETURN
			    _result
		displayFolder: Enrollment\SVG
		lineageTag: cbbcecba-fb4e-4ddb-abac-f17787894d1b
		dataCategory: ImageUrl

	/// Returns a single space character. Used as an empty placeholder measure to fill visual slots or suppress unwanted default values in chart visuals.
	measure blank = " "
		displayFolder: Formatting\Visuals
		lineageTag: e3a05491-d02f-405a-aedb-964bbd86873a

	/// Generates a circular progress ring SVG showing the selected region's services as a percentage of total statewide services for the selected month. Ring color is teal (>=75%), yellow (>=50%), or dark red (<50%). Displays Total, Local, and Delta inside the ring.
	measure 'Services SVG' =
			/* SETUP */
			VAR _total = [Total Services Provided]  // Will be used as a target
			VAR _value = [Localized Services Provided] // Will be used as a current value
			VAR _width = 250 // Width size of the SVG
			VAR _height = 310 // Height size of the SVG
			VAR _CanvasSize = MIN ( _height, _width ) // Canvas size
			VAR _paddning = 15 // Padding between the circle and the canvas
			/* COLOR DEFINITION */
			VAR _positive = "#658E95" // Positive Color
			VAR _neutral = "#E7E74E" // Neutral Color
			VAR _negative = "#7D1D3A" // Negative Color
			/* PRE CALCULATION */
			VAR _halfSize = _CanvasSize / 2 // Half of the canvas size
			VAR _r = _halfSize - _paddning * 1.5 // Radius of the circle
			VAR _round = 2 * PI ( ) * _r // Circumference of the circle
			VAR _perc = _value / _total // Percentage of the current value
			VAR _ratio = _round - _round * _perc // Ratio of the current value
			VAR _clr =  // Determine the color of the circle based on the percentage
			    SWITCH
			    (
			        TRUE ( ),
			        _perc >= 0.75, _positive, // Positive Color
			        _perc >= 0.5, _neutral, // Neutral Color
			        _negative // Negative Color
			    )
			
			/* STYLE DECLARTIONS */
			VAR _styles =
			    "
			  <style>
			    text{
			        font-family: Segoe UI;
			    }
			    .backgroundCircle{
			      transform:rotate(-90deg) translate(-"
			        & ( _height + _width ) / 2
			        & "px, "
			        & ( _width - _height ) / 2
			        & "px);
			    }
			    .backgroundCircle{
			      fill: transparent;
			      stroke-width: "
			        & _paddning
			        & ";
			    }
			    .background{
			      stroke: #e0e0e0;
			    }
			    .filling{
			      stroke: "
			        & _clr
			        & ";
			      stroke-linecap: round;
			      stroke-dasharray: "
			        & _round
			        & ";
			      stroke-dashoffset: "
			        & _ratio
			        & ";
			    }
			    .mainText{
			      fill: "
			        & _clr
			        & ";
			      font-size: 300%;
			      text-anchor: middle;
			      dominant-baseline: middle;
			      font-weight: bold;
			    }
			    .subTexts{
			      fill: #CCCCCC;
			      font-size: 150%;
			      dominant-baseline: middle;
			    }
			    .leftPositioned{
			        text-anchor: end;
			    }
			    .rightPositioned{
			        text-anchor: start;
			    }
			    .bolden{
			        font-weight: bold;
			    }
			  </style>
			"
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			/* SVG DECLARTIONS */
			VAR _svgDeclaration =
			    "data:image/svg+xml;utf8,"
			VAR _svgHeader =
			    "<svg xmlns='http://www.w3.org/2000/svg' height='"
			        & _height
			        & "' width='"
			        & _width
			        & "'>"
			VAR _svgEnd = "</svg>"
			
			/* CALCULATION */
			VAR _sv =
			    "
			  <g class='backgroundCircle'>
			  <circle r='"
			        & _r
			        & "' cx='50%' cy='50%' class='background' />
			  <circle r='"
			        & _r
			        & "' cx='50%' cy='50%' class='filling'/>
			  </g>
			  <g class='mainText'>
			  <text x='50%' y='37.5%' >"
			        & FORMAT ( _perc, "#,#.0%" )
			        & "</text>
			  </g>
			  <g class='subTexts'>
			  <g class='leftPositioned'>
			  <text x='51%' y='50.5%' >"
			        & "Total:"
			        & "</text>
			  <text x='51%' y='60%' >"
			        & "Local:"
			        & "</text>
			  <text x='51%' y='69.5%' class='bolden'>"
			        & "Delta:"
			        & "</text>
			  </g>
			  <g class='rightPositioned'>
			  <text x='53%' y='50.5%' >"
			        & _total
			        & "</text>
			  <text x='53%' y='60%' >"
			        & ROUND ( _value, 1 )
			        & "</text>
			  <text x='53%' y='69.5%' class='bolden'>"
			        & ROUND ( _total - _value, 1 )
			        & "</text>
			  </g>
			  </g>
			"
			VAR _result =
			    _svgDeclaration & _svgHeader & _styles
			        & _sv
			        & _svgEnd
			RETURN
			    _result
		displayFolder: ServicesProvided\SVG
		lineageTag: 6c0ab1bd-5989-47a2-aa02-dea570b20d0a

	/// Dynamic chart title that combines the currently selected region name with the text 'Contribution to Statewide Enrollment'. Updates automatically when the region slicer changes.
	measure 'Enrollment Title' =
			
			VAR _Region = [Current Region Category]
			RETURN
			    IF
			    (
			        NOT ISBLANK ( _Region ),
			        "Contribution to Statewide Enrollment",
			        "🚨 Please choose a Region"
			    )
		displayFolder: Formatting\Title
		lineageTag: 1381f3c3-bc9f-4965-8d66-88f58b316b2f

	/// Dynamic chart title that combines the currently selected region name with the text 'Services Provided'. Updates automatically when the region slicer changes.
	measure 'Services Title' =
			
			VAR _Region = [Current Region Category]
			RETURN
			    IF
			    (
			        NOT ISBLANK ( _Region ),
			        "Contribution to Statewide Services Provided",
			        "🚨 Please choose a Region"
			    )
		displayFolder: Formatting\Title
		lineageTag: fe1299ef-a325-4663-93e1-6cb8a59a252a

	/// Total enrolled participant identifier value for the currently selected month. This is the simple monthly snapshot — no cumulative logic.
	measure Enrollments = SUM ( Participants[APP ID] )
		formatString: #,0
		displayFolder: Enrollment\SelectedMonth
		lineageTag: 0f90b155-3d86-42d6-969e-c24a857c726b

	/// Month-over-month change in enrollments compared to the prior month. Displays a red downward triangle (🔻) for a decrease, a green checkmark (✔) for an increase, or a dash for no change, followed by the absolute difference and 'LM Δ' label.
	measure 'Enrollments MoM' =
			VAR _PMonth =
			    MAX ( dimdate[Month Sort] ) - 1
			VAR _Result =
			    COALESCE ( [Enrollments], 0 )
			        - COALESCE
			        (
			            CALCULATE
			            (
			                [Enrollments],
			                ALL ( dimdate ),
			                dimdate[Month Sort] = _PMonth
			            ),
			            0
			        )
			VAR _Icon =
			    IF
			    (
			        _Result < 0,
			        "▼",
			        IF ( _Result > 0, "▲", " ▬ " )
			    )
			RETURN
			    _Icon & " "
			        & IF ( _Result < 0, _Result * -1, _Result )
		displayFolder: Enrollment\SelectedMonth
		lineageTag: 84c84564-b5af-44a7-880c-9706aac20149

	/// Returns the single currently selected region name from the Regions slicer. Used by title and subtitle measures to make visuals context-aware.
	measure Region = SELECTEDVALUE ( Regions[REGION LWDB] )
		displayFolder: SelectedValues
		lineageTag: e1bd9336-a930-423a-99eb-e8593f318034

	/// Dynamic subtitle for the enrollment chart. In Total mode shows cumulative enrollments from the earliest date to the selected month; in Monthly mode shows enrollments for the selected month only.
	measure 'Enrollment Subtitle' =
			VAR _TEnrollments = [Enrolled Individuals]
			VAR _MEnrollments = [Enrollments]
			VAR _MinSort =
			    CALCULATE
			    (
			        MIN ( dimdate[Month Sort] ),
			        ALL ( dimdate )
			    )
			VAR _MinDate =
			    CALCULATE
			    (
			        MIN ( dimdate[Month Year] ),
			        ALL ( dimdate ),
			        dimdate[Month Sort] = _MinSort
			    )
			VAR _MaxDate =
			    SELECTEDVALUE ( dimdate[Month Year] )
			VAR _Total =
			    _TEnrollments
			        & " Total Enrollments from "
			        & _MinDate
			        & " - "
			        & _MaxDate
			VAR _Monthly =
			    _MEnrollments & " Enrollments in "
			        & _MaxDate
			        & " | "
			        & [Enrollments MoM]
			        & " MoM"
			VAR _SelectedAgg =
			    SELECTEDVALUE
			    (
			        'Aggregation Table'[Aggregation]
			    )
			RETURN
			    IF
			    (
			        _SelectedAgg = "Total",
			        _Total,
			        _Monthly
			    )
		displayFolder: Formatting\Subtitle
		lineageTag: dbe92776-f406-4f67-b374-d465c06ce6cc

	/// Running total of distinct participants who exited with employment (Entered Employment = Y) up to and including the selected month. Accumulates across all months up to the slicer selection.
	measure 'Exiting Individuals with Employment' =
			VAR _Month =
			    SELECTEDVALUE ( dimdate[Month Sort] )
			VAR Result =
			    CALCULATE
			    (
			        [Exits],
			        Participants[ENTERED EMPLOYMENT] = "Y",
			        ALL ( dimdate ),
			        dimdate[Month Sort] <= _Month
			    )
			RETURN
			    Result
		formatString: #,0
		displayFolder: Exiters\UpToDate
		lineageTag: 90722c79-091c-480a-9529-3a859f7b61e7

	/// The selected region's cumulative enrolled individuals as a percentage of the statewide total up to the selected month. Returns blank if there are no regional enrollments. Formatted as a percentage string (e.g. '34.5%').
	measure 'Enrolled Individuals % to Total' =
			VAR _Month =
			    SELECTEDVALUE ( dimdate[Month Sort] )
			VAR _Enrolled = [Enrolled Individuals]
			VAR _Total =
			    CALCULATE
			    (
			        SUM ( Participants[APP ID] ),
			        ALL ( dimdate ),
			        dimdate[Month Sort] <= _Month,
			        REMOVEFILTERS
			        (
			            Regions[REGION LWDB],
			            Regions[REGION SHORT ABBR]
			        )
			    )
			RETURN
			    IF
			    (
			        _Enrolled,
			        FORMAT
			        (
			            DIVIDE ( _Enrolled, _Total ),
			            "#,#.0%"
			        )
			    )
		displayFolder: Enrollment\UpToDate
		lineageTag: c77e4d79-bd52-44af-9d6d-0745c7c37fc5

	/// Sets the Y-axis maximum for the cumulative enrollment chart to 2.2x the highest regional value, creating headroom above the tallest bar so labels do not get clipped.
	measure 'Y Max Position' =
			VAR _MAXVALUE =
			    MAXX
			    (
			        ALLSELECTED ( Regions[REGION LWDB] ),
			        [Enrolled Individuals]
			    )
			RETURN
			    _MAXVALUE * 2.2
		formatString: #,#.0
		displayFolder: Formatting\Visuals
		lineageTag: 7b5f1801-d9ad-4eb5-8f78-68bafb45b3ff

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Sets the Y-axis maximum for the monthly enrollment chart to 2.2x the highest monthly regional value, ensuring consistent headroom above bars.
	measure 'Monthly Y Max Position' =
			VAR _MAXVALUE =
			    MAXX
			    (
			        ALLSELECTED ( Regions[REGION LWDB] ),
			        [Enrollments]
			    )
			RETURN
			    _MAXVALUE * 2.2
		formatString: #,#.0
		displayFolder: Formatting\Visuals
		lineageTag: 8a764ac9-f1ff-4ea3-89c5-42e734832974

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Returns a hex color code for month-over-month enrollment change: red (#9C0006) for a decrease, green (#006100) for an increase, or blue (#004081) for no change. Used as a conditional format color on the MoM label.
	measure 'Enrollments MoM CF' =
			VAR _PMonth =
			    MAX ( dimdate[Month Sort] ) - 1
			VAR _Result =
			    COALESCE
			    (
			        [Enrollments]
			            - CALCULATE
			            (
			                [Enrollments],
			                ALL ( dimdate ),
			                dimdate[Month Sort] = _PMonth
			            ),
			        0
			    )
			VAR _Color =
			    IF
			    (
			        _Result < 0,
			        "#9C0006",
			        IF ( _Result > 0, "#006100", "#999999" )
			    )
			RETURN
			    _Color
		displayFolder: Formatting
		lineageTag: c91e75dd-edf9-4034-8f3d-96d8fa1166c4

	/// Running total of services delivered up to and including the selected month. Uses USER ID as the service-record counting field and accumulates across all months up to the slicer selection.
	measure 'Services Provided Total' =
			VAR _Month =
			    SELECTEDVALUE ( dimdate[Month Sort] )
			VAR Result =
			    CALCULATE
			    (
			        SUM ( ServicesProvided[USER ID] ),
			        ALL ( dimdate ),
			        dimdate[Month Sort] <= _Month
			    )
			RETURN
			    Result
		formatString: #,0
		displayFolder: ServicesProvided\UpToDate
		lineageTag: 6e6b004d-80bd-4ae3-8363-5af66a59234a

	/// Running total of distinct enrolled participants for the selected region, up to and including the selected month. Clears all date and region filters then re-applies the locality and date ceiling.
	measure 'Localized Enrollments Total' =
			VAR Locality =
			    SELECTEDVALUE ( Regions[REGION CODE] )
			VAR _Month =
			    SELECTEDVALUE ( dimdate[Month Sort] )
			VAR Result =
			    CALCULATE
			    (
			        [Enrollments],
			        ALL ( Regions ),
			        Regions[REGION CODE] = Locality,
			        ALL ( dimdate ),
			        dimdate[Month Sort] <= _Month
			    )
			RETURN
			    Result
		formatString: #,0
		displayFolder: Enrollment\UpToDate
		lineageTag: f1d870d0-2eec-45ab-b07f-eff070f551bb

	/// Running total of services delivered in the selected region, up to and including the selected month. Clears date and region filters then re-applies the locality and date ceiling.
	measure 'Localized Services Provided Total' =
			VAR Locality =
			    SELECTEDVALUE ( Regions[REGION CODE] )
			VAR _Month =
			    SELECTEDVALUE ( dimdate[Month Sort] )
			VAR Result =
			    CALCULATE
			    (
			        SUM ( ServicesProvided[USER ID] ),
			        ALL ( Regions ),
			        Regions[REGION CODE] = Locality,
			        ALL ( dimdate ),
			        dimdate[Month Sort] <= _Month
			    )
			RETURN
			    IF ( NOT ISBLANK ( Locality ), Result )
		formatString: #,0
		displayFolder: ServicesProvided\UpToDate
		lineageTag: 6e7159ce-6624-4b07-a95c-faad0dc8451d

	/// Generates the same circular SVG progress ring as Enrollment SVG but uses cumulative (Total) enrollment figures instead of monthly figures. Compares Localized Enrollments Total against Enrolled Individuals all Regions.
	measure 'Enrollment SVG Total' =
			/* SETUP */
			VAR _total =
			    [Enrolled Individuals all Regions]  // Will be used as a target
			VAR _value = [Localized Enrollments Total] // Will be used as a current value
			VAR _width = 250 // Width size of the SVG
			VAR _height = 310 // Height size of the SVG
			VAR _CanvasSize = MIN ( _height, _width ) // Canvas size
			VAR _paddning = 15 // Padding between the circle and the canvas
			/* COLOR DEFINITION */
			VAR _positive = "#658E95" // Positive Color
			VAR _neutral = "#E7E74E" // Neutral Color
			VAR _negative = "#7D1D3A" // Negative Color
			/* PRE CALCULATION */
			VAR _halfSize = _CanvasSize / 2 // Half of the canvas size
			VAR _r = _halfSize - _paddning * 1.5 // Radius of the circle
			VAR _round = 2 * PI ( ) * _r // Circumference of the circle
			VAR _perc = _value / _total // Percentage of the current value
			VAR _ratio = _round - _round * _perc // Ratio of the current value
			VAR _clr =  // Determine the color of the circle based on the percentage
			    SWITCH
			    (
			        TRUE ( ),
			        _perc >= 0.75, _positive, // Positive Color
			        _perc >= 0.5, _neutral, // Neutral Color
			        _negative // Negative Color
			    )
			
			/* STYLE DECLARTIONS */
			VAR _styles =
			    "
			  <style>
			    text{
			        font-family: Segoe UI;
			    }
			    .backgroundCircle{
			      transform:rotate(-90deg) translate(-"
			        & ( _height + _width ) / 2
			        & "px, "
			        & ( _width - _height ) / 2
			        & "px);
			    }
			    .backgroundCircle{
			      fill: transparent;
			      stroke-width: "
			        & _paddning
			        & ";
			    }
			    .background{
			      stroke: #e0e0e0;
			    }
			    .filling{
			      stroke: "
			        & _clr
			        & ";
			      stroke-linecap: round;
			      stroke-dasharray: "
			        & _round
			        & ";
			      stroke-dashoffset: "
			        & _ratio
			        & ";
			    }
			    .mainText{
			      fill: "
			        & _clr
			        & ";
			      font-size: 300%;
			      text-anchor: middle;
			      dominant-baseline: middle;
			      font-weight: bold;
			    }
			    .subTexts{
			      fill: #CCCCCC;
			      font-size: 150%;
			      dominant-baseline: middle;
			    }
			    .leftPositioned{
			        text-anchor: end;
			    }
			    .rightPositioned{
			        text-anchor: start;
			    }
			    .bolden{
			        font-weight: bold;
			    }
			  </style>
			"
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			/* SVG DECLARTIONS */
			VAR _svgDeclaration =
			    "data:image/svg+xml;utf8,"
			VAR _svgHeader =
			    "<svg xmlns='http://www.w3.org/2000/svg' height='"
			        & _height
			        & "' width='"
			        & _width
			        & "'>"
			VAR _svgEnd = "</svg>"
			
			/* CALCULATION */
			VAR _sv =
			    "
			  <g class='backgroundCircle'>
			  <circle r='"
			        & _r
			        & "' cx='50%' cy='50%' class='background' />
			  <circle r='"
			        & _r
			        & "' cx='50%' cy='50%' class='filling'/>
			  </g>
			  <g class='mainText'>
			  <text x='50%' y='37.5%' >"
			        & FORMAT ( _perc, "#,#.0%" )
			        & "</text>
			  </g>
			  <g class='subTexts'>
			  <g class='leftPositioned'>
			  <text x='51%' y='50.5%' >"
			        & "Total:"
			        & "</text>
			  <text x='51%' y='60%' >"
			        & "Local:"
			        & "</text>
			  <text x='51%' y='69.5%' class='bolden'>"
			        & "Delta:"
			        & "</text>
			  </g>
			  <g class='rightPositioned'>
			  <text x='53%' y='50.5%' >"
			        & _total
			        & "</text>
			  <text x='53%' y='60%' >"
			        & ROUND ( _value, 1 )
			        & "</text>
			  <text x='53%' y='69.5%' class='bolden'>"
			        & ROUND ( _total - _value, 1 )
			        & "</text>
			  </g>
			  </g>
			"
			VAR _result =
			    _svgDeclaration & _svgHeader & _styles
			        & _sv
			        & _svgEnd
			RETURN
			    _result
		displayFolder: Enrollment\SVG
		lineageTag: 6fb789bb-b99a-4e1d-b981-126e07c6b2fd

	/// Running total of distinct enrolled participants statewide (all regions) up to and including the selected month. Used as the denominator in the total-period SVG ring visual.
	measure 'Enrolled Individuals all Regions' =
			VAR _Month =
			    SELECTEDVALUE ( dimdate[Month Sort] )
			VAR Result =
			    CALCULATE
			    (
			        SUM ( Participants[APP ID] ),
			        ALL ( dimdate ),
			        dimdate[Month Sort] <= _Month,
			        REMOVEFILTERS ( Regions )
			    )
			RETURN
			    Result
		formatString: #,0
		displayFolder: Enrollment\UpToDate
		lineageTag: bee5d676-4ea2-48a7-936a-8e4b8197fc0b

	/// Running total of services delivered statewide (all regions) up to and including the selected month. Used as the denominator in the total-period Services SVG ring visual.
	measure 'Services Provided all Regions' =
			VAR _Month =
			    SELECTEDVALUE ( dimdate[Month Sort] )
			VAR Result =
			    CALCULATE
			    (
			        SUM ( ServicesProvided[USER ID] ),
			        ALL ( dimdate ),
			        dimdate[Month Sort] <= _Month,
			        REMOVEFILTERS ( Regions )
			    )
			RETURN
			    Result
		formatString: #,0
		displayFolder: ServicesProvided\UpToDate
		lineageTag: 45bec848-3a31-4f9e-9f1f-99067d174f9f

