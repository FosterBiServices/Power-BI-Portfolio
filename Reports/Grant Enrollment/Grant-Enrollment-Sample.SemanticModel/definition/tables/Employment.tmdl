/// Single-column parameter table containing employment status options ('With Employment' and 'Without Employment'). Used as a slicer to toggle all exit-related measures and chart titles between participants who entered employment and those who did not.
table Employment
	lineageTag: 1459accb-9ebf-4eda-8c6f-053919b08611

	/// The employment status filter option shown in the slicer (e.g. 'With Employment', 'Without Employment'). Drives the Exiters, Exiting Individuals, and Exits Title measures to switch between employment outcome views.
	column Status
		isAvailableInMdx: false
		displayFolder: TableColumns
		lineageTag: f22a43ba-f71b-42b4-a116-5b8560728a58
		summarizeBy: none
		isNameInferred
		sourceColumn: [Status]

		annotation SummarizationSetBy = Automatic

	partition Employment = calculated
		mode: import
		source = ```
				
				DATATABLE(
				    "Status", STRING, 
				    {
				        {"With Employment"}, 
				        {"Without Employment"}
				    }
				)
				```

	annotation PBI_Id = 18e91d4701e249d1ab7f64214bb6d469

