	partition Participants = m
		mode: import
		queryGroup: facts
		source = ```
				let
				  Source = Excel.Workbook(File.Contents("C:\Users\StevenFoster\Downloads\Grant Enrollment Sample Data.xlsx"), true, true),
				  PromoteHeaders = Source{[Item = "Participants", Kind = "Sheet"]}[Data]
				, 
				  TypePairs = {
				    {"LWDB", Int64.Type},
				    {"APP ID", Int64.Type},
				    {"RESPONSIBLE OFFICE", type text},
				    {"PARTICIPATION DATE", type date},
				    {"GRANT ENROLL DATE", type date},
				    {"LAST GRANT ACTIVITY DATE", type date},
				    {"PROJECTED GRANT ACTIVITY END DATE", type date},
				    {"EXIT DATE", type date},
				    {"RECEIVED CREDENTIAL", type text},
				    {"ENTERED EMPLOYMENT", type text},
				    {"WITH DISABILITY", type text}
				  }, 
				  ExistingCols = Table.ColumnNames(
				    PromoteHeaders
				  ), 
				  // Keep type rules only for columns that actually exist
				  TypePairsExistingOnly = List.Select(
				    TypePairs, 
				    each List.Contains(
				      ExistingCols, 
				      _{0}
				    )
				  ), 
				  // Convert those explicit pairs into a lookup record: ColumnName -> Type
				  ExplicitTypeMap = Record.FromList(
				    List.Transform(
				      TypePairsExistingOnly, 
				      each _{1}
				    ), 
				    List.Transform(
				      TypePairsExistingOnly, 
				      each _{0}
				    )
				  ), 
				  // - If we specified a type in ExplicitTypeMap, use it.
				  // - Otherwise default to type text.
				  AllTypePairs = List.Transform(
				    ExistingCols, 
				    (c) => {
				      c, 
				      Record.FieldOrDefault(
				        ExplicitTypeMap, 
				        c, 
				        type text
				      )
				    }
				  ), 
				  // Apply types in one go
				  ChangeTypes
				    = Table.TransformColumnTypes(
				    PromoteHeaders, 
				    AllTypePairs
				  )
				in
				  ChangeTypes
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

