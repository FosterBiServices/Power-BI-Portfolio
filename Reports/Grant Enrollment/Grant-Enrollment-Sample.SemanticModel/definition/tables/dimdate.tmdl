/// Date dimension table providing a calendar spine for all time-based filtering and slicing. Contains one row per date with derived attributes including year, month name, month sort order, quarter, weekday, and offset fields used by measures to calculate cumulative totals and month-over-month comparisons.
table dimdate
	lineageTag: ecd74eef-8bca-4236-b3d8-32375f192b97
	dataCategory: Time

	/// The full calendar date. This is the primary key of the date dimension and the field used to join enrollment and service tables to the calendar.
	column Date
		isKey
		formatString: m/d/yyyy
		isAvailableInMdx: false
		displayFolder: TableColumns
		lineageTag: a5040e86-b742-4a65-bc97-ecc5397aabae
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	/// The four-digit calendar year (e.g. 2024).
	column 'Calendar Year'
		formatString: #,0
		isAvailableInMdx: false
		displayFolder: TableColumns
		lineageTag: 187e0d7a-c1b8-4586-83dc-529a1a640d00
		summarizeBy: none
		isNameInferred
		sourceColumn: [Calendar Year]

		annotation SummarizationSetBy = Automatic

	/// The full name of the month (e.g. January, February). Used in slicers and axis labels.
	column 'Month Name'
		isAvailableInMdx: false
		displayFolder: TableColumns
		lineageTag: c9f4494a-3282-42d7-a3e9-92167f11e5d2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Name]

		annotation SummarizationSetBy = Automatic

	/// The numeric month number as a string (01–12). Used for filtering and joining.
	column 'Month Number'
		isAvailableInMdx: false
		displayFolder: TableColumns
		lineageTag: 83fa6d68-3320-433e-89ac-902086ef0262
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Number]

		annotation SummarizationSetBy = Automatic

	/// The name of the day of the week (e.g. Monday, Tuesday).
	column Weekday
		isAvailableInMdx: false
		displayFolder: TableColumns
		lineageTag: 2801f66e-3c19-4b7a-89f6-34c9875b94b4
		summarizeBy: none
		isNameInferred
		sourceColumn: [Weekday]

		annotation SummarizationSetBy = Automatic

	/// The numeric day-of-week number (1 = Sunday through 7 = Saturday), used to sort weekday labels correctly.
	column 'Weekday number'
		formatString: #,0
		isAvailableInMdx: false
		displayFolder: TableColumns
		lineageTag: 4120ea50-c784-4a3e-9b88-e12ca1c09d7c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Weekday number]

		annotation SummarizationSetBy = User

	/// The quarter label (e.g. Q1, Q2). Used for quarterly grouping in visuals.
	column Quarter
		isAvailableInMdx: false
		displayFolder: TableColumns
		lineageTag: de6be539-a1d2-4125-8379-6f080d957de0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

		annotation SummarizationSetBy = Automatic

	/// A numeric sort key for months (e.g. 1 for January 2023, 13 for January 2024) used to sort months chronologically across years. This is the key field referenced by date slicer measures.
	column 'Month Sort'
		formatString: #,#.0
		displayFolder: TableColumns
		lineageTag: e0531098-f42c-4322-93df-b780726dd323
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Sort]

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// A display label combining month abbreviation and year (e.g. 'Jan 2024'). Used in chart axes and subtitles.
	column 'Month Year'
		isAvailableInMdx: false
		displayFolder: TableColumns
		lineageTag: 8e2b1344-2126-41ae-873e-d3b8aedd04eb
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Year]
		sortByColumn: 'Month Sort'

		annotation SummarizationSetBy = Automatic

	/// An integer offset from the current month (0 = current, -1 = prior month, etc.). Useful for relative date calculations.
	column MonthOffset
		formatString: #,0
		isAvailableInMdx: false
		displayFolder: TableColumns
		lineageTag: f4b16ee9-7d07-480e-a3ab-7050428ea442
		summarizeBy: none
		isNameInferred
		sourceColumn: [MonthOffset]

		annotation SummarizationSetBy = User

	/// The quarter expressed as a decimal number (e.g. 1.0, 2.0) for sorting purposes.
	column 'Quarter Number'
		formatString: #,#.0
		isAvailableInMdx: false
		displayFolder: TableColumns
		lineageTag: b5fab395-95ab-4000-b9d8-23c947892c74
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter Number]

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// A display label combining quarter and year (e.g. 'Q1 2024'). Used in quarterly chart axes.
	column 'Quarter Year'
		isAvailableInMdx: false
		displayFolder: TableColumns
		lineageTag: be1bbeb3-e782-4897-8f90-c9390751db31
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter Year]

		annotation SummarizationSetBy = Automatic

	/// The first date of the quarter this row belongs to. Used for quarter-level time intelligence calculations.
	column 'Quarter Start Date'
		formatString: m/d/yyyy
		isAvailableInMdx: false
		displayFolder: TableColumns
		lineageTag: 0d8c7354-6883-483c-b47f-484d21ce0d89
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter Start Date]

		annotation SummarizationSetBy = Automatic

	/// A numeric sort key for quarters, enabling correct chronological ordering of Quarter Year labels.
	column 'Quarter Sort'
		formatString: #,#.0
		isAvailableInMdx: false
		displayFolder: TableColumns
		lineageTag: f4334876-b551-4c92-8e9e-a07df9a178c7
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter Sort]

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// An integer offset from the current quarter (0 = current, -1 = prior quarter, etc.).
	column QuarterOffset
		formatString: #,0
		isAvailableInMdx: false
		displayFolder: TableColumns
		lineageTag: b495f6f2-1b8a-4686-9858-87a27d73c82f
		summarizeBy: none
		isNameInferred
		sourceColumn: [QuarterOffset]

		annotation SummarizationSetBy = User

	partition dimdate = calculated
		mode: import
		source = ```
				
				VAR MinDate =
				    MINX (
				        FILTER ( Participants, NOT ISBLANK ( Participants[GRANT ENROLL DATE] ) ),
				        Participants[GRANT ENROLL DATE]
				    )
				VAR MaxDate =
				    MAXX (
				        FILTER ( Participants, NOT ISBLANK ( Participants[GRANT ENROLL DATE] ) ),
				        Participants[GRANT ENROLL DATE]
				    )
				/* Anchor month start (you already had this) */
				VAR AnchorMonthStart = DATE ( YEAR ( MaxDate ), MONTH ( MaxDate ), 1 )
				/* Anchor quarter start derived from MaxDate */
				VAR AnchorQuarterStart =
				    DATE (
				        YEAR ( MaxDate ),
				        1 + 3 * ( TRUNC ( ( MONTH ( MaxDate ) - 1 ) / 3, 0 ) ),
				        1
				    )
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( MinDate, MaxDate ),
				    "Calendar Year", YEAR ( [Date] ),
				    "Weekday", FORMAT ( [Date], "dddd" ),
				    "Weekday number", WEEKDAY ( [Date] ),
				    "Month Name", FORMAT ( [Date], "mmmm" ),
				    "Month Number", FORMAT ( [Date], "mm" ),
				    "Month Sort", YEAR ( [Date] ) * 12 + MONTH ( [Date] ),
				    "Month Year", FORMAT ( [Date], "mmmm yyyy" ),
				    "MonthOffset",
				        VAR RowMonthStart = DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 )
				        RETURN DATEDIFF ( RowMonthStart, AnchorMonthStart, MONTH ),
				    "Quarter Number", 1 + TRUNC ( ( MONTH ( [Date] ) - 1 ) / 3, 0 ),
				    "Quarter", "Q" & ( 1 + TRUNC ( ( MONTH ( [Date] ) - 1 ) / 3, 0 ) ),
				    "Quarter Year",
				        VAR QN = 1 + TRUNC ( ( MONTH ( [Date] ) - 1 ) / 3, 0 )
				        RETURN FORMAT ( [Date], "yyyy" ) & " Q" & QN,
				    "Quarter Start Date",
				        DATE (
				            YEAR ( [Date] ),
				            1 + 3 * ( TRUNC ( ( MONTH ( [Date] ) - 1 ) / 3, 0 ) ),
				            1
				        ),
				    "Quarter Sort",
				        YEAR ( [Date] ) * 4 + ( 1 + TRUNC ( ( MONTH ( [Date] ) - 1 ) / 3, 0 ) ),
				    "QuarterOffset",
				        VAR RowQuarterStart =
				            DATE (
				                YEAR ( [Date] ),
				                1 + 3 * ( TRUNC ( ( MONTH ( [Date] ) - 1 ) / 3, 0 ) ),
				                1
				            )
				        RETURN DATEDIFF ( RowQuarterStart, AnchorQuarterStart, QUARTER )
				)
				
				```

	annotation PBI_Id = c5663006cbdb496ea4aa469f0310118e

