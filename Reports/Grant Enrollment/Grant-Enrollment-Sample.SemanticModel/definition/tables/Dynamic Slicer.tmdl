/// Parameter table used to drive the enrollment trend line chart. Contains one row per month with a Month label and a numeric Month Sort key. The Enrollment Trend measure iterates over this table to plot cumulative enrollment values at each month along the trend line.
table 'Dynamic Slicer'
	lineageTag: 0f8266fc-81d4-4856-bedd-f27a5a6f8062

	/// The display label for each month option in the dynamic trend slicer (e.g. 'Jan 2024'). Connects to dimdate so the Enrollment Trend measure can calculate cumulative enrollment as of each month.
	column Month
		isAvailableInMdx: false
		displayFolder: TableColumns
		lineageTag: 887b358d-5d6a-49cf-90c9-4bf9c1d97dd8
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'Month Sort'

		annotation SummarizationSetBy = Automatic

	/// The numeric sort key for each month in the dynamic trend slicer. Matches the Month Sort field in dimdate, ensuring the trend line plots months in correct chronological order.
	column 'Month Sort'
		formatString: #,0
		displayFolder: TableColumns
		lineageTag: 086ffae0-3de3-4edf-826a-4e74ca4cdd82
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Sort]

		annotation SummarizationSetBy = Automatic

	partition 'Dynamic Slicer' = calculated
		mode: import
		source = ```
				
				DISTINCT(
				        SELECTCOLUMNS(
				            'dimdate',
				                "Month",'dimdate'[Month Year], 
				                "Month Sort", dimdate[Month Sort])
				        )
				    
				```

	annotation PBI_Id = 933db2a3c6504c7c926e9263ee94bf30

