model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup dimRegions

	annotation PBI_QueryGroupOrder = 1

queryGroup Helper

	annotation PBI_QueryGroupOrder = 2

queryGroup facts

	annotation PBI_QueryGroupOrder = 3

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["ServicesProvided","Participants","_Measures","Regions","ActivityCodes","AssessmentQuestions","Targets"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","TMDLView_Desktop","MCP-PBIModeling","DevMode"]

annotation __TEdtr = 1

annotation __BNorm = 1

ref table ServicesProvided
ref table Participants
ref table dimdate
ref table _Measures
ref table Regions
ref table 'Aggregation Table'
ref table 'Dynamic Slicer'
ref table Employment
ref table TopXSelector
ref table Targets

ref cultureInfo en-US

