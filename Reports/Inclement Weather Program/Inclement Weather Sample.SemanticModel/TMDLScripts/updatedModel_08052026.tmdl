		expression stage_MPR = ```
				let
				  Source
				    = load_MPR,
				  CleanColumns
				    = fxCleanColumns(
				    Source
				  ),
				  RenamedColumns
				    = Table.RenameColumns(
				    CleanColumns,
				    {
				      {
				        "REFERRAL DATE & TIME",
				        "REFERRAL DATE"
				      },
				      {
				        "ENROLLMENT DATE & TIME",
				        "ENROLLMENT DATE"
				      },
				      {
				        "HOTEL CHECK-IN DATE & TIME",
				        "HOTEL CHECK IN"
				      },
				      {
				        "TOTAL INDIVIDUALS IN HOUSEHOLD (INCLUDING ADULTS & CHILDREN)",
				        "HOUSEHOLD"
				      },
				      {
				        "NUMBER OF CHILDREN UNDER 18",
				        "NUMBER OF CHILDREN"
				      },
				      {
				        "RACE/ETHNICITY",
				        "RACE_ETHNICITY"
				      }
				    },
				    MissingField.Ignore
				  ),
				    UIDSourceFlag = Table.AddColumn(RenamedColumns, "UID_SOURCE", each if [UNIQUE IDENTIFIER NUMBER] = null then "LU" else "MPR", type text),
				  TypePairs
				    = {
				    {
				      "RECORD ID",
				      type text
				    },
				    {
				      "UNIQUE IDENTIFIER NUMBER",
				      type text
				    },
				    {
				      "FIRST NAME",
				      type text
				    },
				    {
				      "LAST NAME",
				      type text
				    },
				    {
				    "ACTIVATION DATE",
				      type date
				    },
				    {
				    "ENROLLMENT DATE",
				      type date
				    },
				    {
				    "REFERRAL DATE",
				      type date
				    },
				    {
				      "HOTEL CHECK IN",
				      type date
				    },
				    {
				      "EXIT DATE",
				      type date
				    },
				    {
				      "HOUSEHOLD",
				      Int64.Type
				    },
				    {
				      "NUMBER OF ADULTS",
				      Int64.Type
				    },
				    {
				      "NUMBER OF CHILDREN",
				      Int64.Type
				    },
				    {
				      "NUMBER OF HOTEL NIGHTS",
				      Int64.Type
				    },
				    {
				      "TOTAL NIGHTS",
				      Int64.Type
				    },
				    {
				      "NUMBER OF HOTEL ROOMS RENTED",
				      Int64.Type
				    },
				    {
				      "DATE OF BIRTH",
				      type date
				    },
				    {
				      "CLIENT AGE",
				      Int64.Type
				    },
				    {
				      "GENDER",
				      type text
				    },
				    {
				      "RACE_ETHNICITY",
				      type text
				    },
				    {
				      "VETERAN",
				      type text
				    },
				    {
				      "DISABILITY",
				      type text
				    },
				    {
				      "ENROLLED THIS MONTH",
				      type text
				    },
				    {
				      "ENROLLED THIS FY",
				      type text
				    }
				  },
				  ExistingCols
				    = Table.ColumnNames(
				    UIDSourceFlag
				  ),
				  // Keep type rules only for columns that actually exist
				  TypePairsExistingOnly
				    = List.Select(
				    TypePairs,
				    each
				      List.Contains(
				        ExistingCols,
				        _{
				          0
				        }
				      )
				  ),
				  // Convert those explicit pairs into a lookup record: ColumnName -> Type
				  ExplicitTypeMap
				    = Record.FromList(
				    List.Transform(
				      TypePairsExistingOnly,
				      each
				        _{
				          1
				        }
				    ),
				    List.Transform(
				      TypePairsExistingOnly,
				      each
				        _{
				          0
				        }
				    )
				  ),
				  // - If we specified a type in ExplicitTypeMap, use it.
				  // - Otherwise default to type text.
				  AllTypePairs
				    = List.Transform(
				    ExistingCols,
				    (
				      c
				    ) => {
				      c,
				      Record.FieldOrDefault(
				        ExplicitTypeMap,
				        c,
				        type text
				      )
				    }
				  ),
				  // Apply types in one go
				  ChangeTypes
				    = Table.TransformColumnTypes(
				    UIDSourceFlag,
				    AllTypePairs
				  ),
				  ActivationKey
				    = Table.AddColumn(
				    ChangeTypes,
				    "ACTIVATION ID",
				    each
				      Text.Combine(
				        {
				          if [
				            ACTIVATION INDICATOR
				          ]
				            = null
				          then
				            [
				              COMMUNITY
				            ]
				          else
				            [
				              ACTIVATION INDICATOR
				            ],
				          Date.ToText(
				            [
				              ACTIVATION DATE
				            ],
				            [
				              Format
				                = "MMddyyyy",
				              Culture
				                = "de-EN"
				            ]
				          )
				        },
				        "-"
				      ),
				    type text
				  ),
				  LOS
				    = Table.AddColumn(
				    ActivationKey,
				    "LOS",
				    each
				      Duration.Days(
				        [
				          EXIT DATE
				        ]
				          - [
				            HOTEL CHECK IN
				          ]
				      )
				  ),
				  TURNDOWNS
				    = Table.AddColumn(
				    LOS,
				    "TURNDOWNS",
				    each
				
				        if [
				          LOS
				        ]
				          > 0
				        then
				          [
				            LOS
				          ]
				            - 1
				        else
				          0
				  ),
				  ChangeType
				    = Table.TransformColumnTypes(
				    TURNDOWNS,
				    {
				      {
				        "LOS",
				        Int64.Type
				      },
				      {
				        "TURNDOWNS",
				        Int64.Type
				      }
				    }
				  ),
				  ColumnsToClean
				    = {
				    "UNIQUE IDENTIFIER NUMBER"
				  },
				  CleanedTable
				    = Table.TransformColumns(
				    ChangeType,
				    List.Transform(
				      ColumnsToClean,
				      each
				        {
				          _,
				          fxCleanValues,
				          type text
				        }
				    )
				  ),
				  Lookup
				    = Table.SelectRows(
				    CleanedTable,
				    each
				      [
				        UNIQUE IDENTIFIER NUMBER
				      ]
				        <> null
				        and [
				          UNIQUE IDENTIFIER NUMBER
				        ]
				          <> ""
				  ),
				  LookupDistinct
				    = Table.Group(
				    Lookup,
				    {
				      "RECORD ID"
				    },
				    {
				      {
				        "UID",
				        each
				          List.First(
				            [
				              UNIQUE IDENTIFIER NUMBER
				            ]
				          ),
				        type text
				      }
				    }
				  ),
				  Merged
				    = Table.NestedJoin(
				    CleanedTable,
				    {
				      "RECORD ID"
				    },
				    LookupDistinct,
				    {
				      "RECORD ID"
				    },
				    "Lookup",
				    JoinKind.LeftOuter
				  ),
				  Expanded
				    = Table.ExpandTableColumn(
				    Merged,
				    "Lookup",
				    {
				      "UID"
				    },
				    {
				      "UID_Lookup"
				    }
				  ),
				  // ✅ Replace values directly in the existing column
				  ReplaceUID1
				    = Table.ReplaceValue(
				    Expanded,
				    each
				      [
				        UNIQUE IDENTIFIER NUMBER
				      ],
				    each
				
				        if [
				          UNIQUE IDENTIFIER NUMBER
				        ]
				          = null
				          or [
				            UNIQUE IDENTIFIER NUMBER
				          ]
				            = ""
				        then
				          [
				            UID_Lookup
				          ]
				        else
				          [
				            UNIQUE IDENTIFIER NUMBER
				          ],
				    Replacer.ReplaceValue,
				    {
				      "UNIQUE IDENTIFIER NUMBER"
				    }
				  ),
				  Cleaned
				    = Table.RemoveColumns(
				    ReplaceUID1,
				    {
				      "UID_Lookup"
				    }
				  ),
				  // Create lookup for Name + DOB
				  NameLookup
				    = Table.SelectRows(
				    Cleaned,
				    each
				      [
				        UNIQUE IDENTIFIER NUMBER
				      ]
				        <> null
				        and [
				          UNIQUE IDENTIFIER NUMBER
				        ]
				          <> ""
				  ),
				  NameLookupDistinct
				    = Table.Group(
				    NameLookup,
				    {
				      "FIRST NAME",
				      "LAST NAME",
				      "DATE OF BIRTH"
				    },
				    {
				      {
				        "UID_Name",
				        each
				          List.First(
				            [
				              UNIQUE IDENTIFIER NUMBER
				            ]
				          ),
				        type text
				      }
				    }
				  ),
				  // Merge on composite key
				  NameMerged
				    = Table.NestedJoin(
				    Cleaned,
				    {
				      "FIRST NAME",
				      "LAST NAME",
				      "DATE OF BIRTH"
				    },
				    NameLookupDistinct,
				    {
				      "FIRST NAME",
				      "LAST NAME",
				      "DATE OF BIRTH"
				    },
				    "NameLookup",
				    JoinKind.LeftOuter
				  ),
				  NameExpanded
				    = Table.ExpandTableColumn(
				    NameMerged,
				    "NameLookup",
				    {
				      "UID_Name"
				    },
				    {
				      "UID_Name_Lookup"
				    }
				  ),
				  // ✅ Replace remaining blanks only
				  Final
				    = Table.ReplaceValue(
				    NameExpanded,
				    each
				      [
				        UNIQUE IDENTIFIER NUMBER
				      ],
				    each
				
				        if [
				          UNIQUE IDENTIFIER NUMBER
				        ]
				          = null
				          or [
				            UNIQUE IDENTIFIER NUMBER
				          ]
				            = ""
				        then
				          [
				            UID_Name_Lookup
				          ]
				        else
				          [
				            UNIQUE IDENTIFIER NUMBER
				          ],
				    Replacer.ReplaceValue,
				    {
				      "UNIQUE IDENTIFIER NUMBER"
				    }
				  ),
				  CleanedFinal
				    = Table.RemoveColumns(
				    Final,
				    {
				      "UID_Name_Lookup"
				    }
				  ),
				  ColumnsToNormalize_lower
				    = {
				    "GENDER",
				    "RACE_ETHNICITY",
				    "VETERAN",
				    "DISABILITY",
				    "ENROLLED THIS MONTH",
				    "ENROLLED THIS FY"
				  },
				  lowerNormalized
				    = Table.TransformColumns(
				    CleanedFinal,
				    List.Transform(
				      ColumnsToNormalize_lower,
				      (
				        col
				      ) => {
				        col,
				        each
				          fxNormalize(
				            _
				          ),
				        type text
				      }
				    )
				  )
				,
				  ColumnsToNormalize_upper
				    = {
				    "UNIQUE IDENTIFIER NUMBER"
				  },
				  upperNormalized
				    = Table.TransformColumns(
				    lowerNormalized,
				    List.Transform(
				      ColumnsToNormalize_upper,
				      (
				        col
				      ) => {
				        col,
				        each
				          fxCleanValues(
				            _
				          ),
				        type text
				      }
				    )
				  ), 
				  
				  UniqueCheckInID
				    = Table.AddColumn(
				    upperNormalized,
				    "CHECK IN ID",
				    each
				      Text.Combine(
				        {
				          if [
				            UNIQUE IDENTIFIER NUMBER
				          ]
				            = null
				          then
				            [
				              RECORD ID
				            ]
				          else
				            [
				              UNIQUE IDENTIFIER NUMBER
				            ],
				            Text.Trim(
				            Date.ToText(
				              [
				                HOTEL CHECK IN
				              ],
				              [
				                Format
				                  = "MMddyyyy"
				              ]
				            )
				        )
				        },
				        "-"
				      ),
				    type text
				  ),
				UniqueKey =
				  Table.AddColumn(
				    UniqueCheckInID,
				    "ID",
				    each
				      Text.Combine(
				        {
				          Text.Trim(
				            Text.From(
				              if [UNIQUE IDENTIFIER NUMBER] = null
				              then [RECORD ID]
				              else [UNIQUE IDENTIFIER NUMBER]
				            )
				          ),
				          Text.Trim(
				            if [DATE OF BIRTH] = null
				            then ""
				            else Date.ToText(Date.From([DATE OF BIRTH]), "MMddyyyy")
				          )
				        },
				        "-"
				      ),
				    type text
				  ),
				    CommunityTrim = Table.TransformColumns(UniqueKey,{{"COMMUNITY", Text.Trim, type text}}),
				    #"Join->Community" = Table.NestedJoin(CommunityTrim, {"COMMUNITY"}, Community, {"COMMUNITY"}, "COMMUNITY.1", JoinKind.LeftOuter),
				    #"Expand->Community" = Table.ExpandTableColumn(#"Join->Community", "COMMUNITY.1", {"ZIPCODE"}, {"ZIPCODE"})
				in
				    #"Expand->Community"
				```
