			annotation PBI_NavigationStepName = Navigation

			annotation PBI_ResultType = Table

		expression 'MPR Clients' = ```
				let
				  Source = stage_MPR[[UNIQUE IDENTIFIER NUMBER], [FIRST NAME], [LAST NAME], [DATE OF BIRTH]],
				  RemoveNulls = Table.SelectRows(Source, each ([UNIQUE IDENTIFIER NUMBER] <> null)),
				  AddClient = Table.AddColumn(RemoveNulls, 
				    "CLIENT", 
				      each Text.Combine(
				          {Text.From([LAST NAME]), Text.From([FIRST NAME])}, ", "), 
				        type text
				      ), 
				  SourceField = Table.AddColumn(AddClient, "SOURCE", each "MPR"),
				    RemoveDups = Table.Distinct(SourceField, {"UNIQUE IDENTIFIER NUMBER"}),
				    NormalizeFirst = Table.AddColumn(RemoveDups, "First_Cleaned", each fxCleanNames([FIRST NAME], true),type text),
				    NormalizeLast = Table.AddColumn(NormalizeFirst, "Last_Cleaned", each fxCleanNames([LAST NAME], true), type text)
				in
				    NormalizeLast
				```
