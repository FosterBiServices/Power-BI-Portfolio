				annotation SummarizationSetBy = Automatic

			/// Client phone number collected during intake.
			column 'PHONE NUMBER'
				dataType: string
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: 202c2014-0684-49ae-b12f-4e94fcf0ce7e
