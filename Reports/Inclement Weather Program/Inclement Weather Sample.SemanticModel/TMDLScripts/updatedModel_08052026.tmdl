			annotation PBI_ResultType = Table

		expression MPR_Counts = ```
				let
				  Source =
				    Table.Distinct(
				    stage_MPR[
				      [UNIQUE IDENTIFIER NUMBER],
				      [COMMUNITY],
				      [DATE OF BIRTH],
				      [GENDER],
				      [RACE_ETHNICITY],
				      [VETERAN],
				      [DISABILITY],
				      [HOTEL CHECK IN],
				      [EXIT DATE]
				      ]
				    ),
				    Grouped =
				    Table.Group(
				      Source,
				      {"UNIQUE IDENTIFIER NUMBER"},
				      {
				        {"DateOfBirth_Count", each List.Count(List.Distinct(List.RemoveNulls([DATE OF BIRTH]))), Int64.Type},
				        {"Gender_Count", each List.Count(List.Distinct(List.RemoveNulls([GENDER]))), Int64.Type},
				        {"RaceEthnicity_Count", each List.Count(List.Distinct(List.RemoveNulls([RACE_ETHNICITY]))), Int64.Type},
				        {"Veteran_Count", each List.Count(List.Distinct(List.RemoveNulls([VETERAN]))), Int64.Type},
				        {"Disability_Count", each List.Count(List.Distinct(List.RemoveNulls([DISABILITY]))), Int64.Type},
				        {"Community_Count", each List.Count(List.Distinct(List.RemoveNulls([COMMUNITY]))), Int64.Type},
				
				        {"Row_Count", each Table.RowCount(_), Int64.Type},
				
				
				        {"StayCombo_Count",
				          each
				            Table.RowCount(
				              Table.Distinct(
				                Table.SelectColumns(_, {"HOTEL CHECK IN", "EXIT DATE"})
				              )
				            ),
				          Int64.Type
				        },
				
				        {"CheckIn_Count",
				          each
				            List.Count(
				              List.Distinct(
				                List.RemoveNulls([HOTEL CHECK IN])
				              )
				            ),
				          Int64.Type
				        }
				      }
				    ),
				
				
				  AddDuplicateStay =
				    Table.AddColumn(
				      Grouped,
				      "Has_Duplicate_Stay",
				      each [StayCombo_Count] < [Row_Count],
				      type logical
				    ),
				
				
				  AddDuplicateCheckIn =
				    Table.AddColumn(
				      AddDuplicateStay,
				      "Has_Duplicate_CheckIn",
				      each [CheckIn_Count] < [Row_Count],
				      type logical
				    ), 
				
				  AddHasConcerns =
				    Table.AddColumn(
				      AddDuplicateCheckIn,
				      "Has_Concerns",
				      each
				        [DateOfBirth_Count] > 1
				        or [Gender_Count] > 1
				        or [RaceEthnicity_Count] > 1
				        or [Veteran_Count] > 1
				        or [Disability_Count] > 1,
				        type logical
				    ),
				
				  AddMultipleLocations =
				    Table.AddColumn(
				      AddHasConcerns,
				      "Multiple_Locations",
				      each
				        [Community_Count] > 1,
				      type logical
				    ),
				
				  AddDuplicationConcern =
				    Table.AddColumn(
				      AddMultipleLocations,
				      "Possible_Duplicate",
				      each
				        [Has_Duplicate_Stay] = true
				        or [Has_Duplicate_CheckIn] = true,
				      type logical
				    )
				in
				    AddDuplicationConcern
				```
			lineageTag: 2477a684-5cd2-4493-a50a-9e551765db1e
			queryGroup: 'Data Validations'

			annotation PBI_NavigationStepName = Navigation

			annotation PBI_ResultType = Table

		expression MPR_variances = ```
				let
				  Source =
				  Table.Distinct(
				    stage_MPR[
				        [UNIQUE IDENTIFIER NUMBER],
				        [HOUSEHOLD],
				        [NUMBER OF ADULTS],
				        [NUMBER OF CHILDREN],
				        [UID_SOURCE],
				        [HOTEL CHECK IN],
				        [EXIT DATE]
				        ]
				    ),
				
				    FilteredRows = Table.SelectRows(
				        Source,
				        each [UID_SOURCE] <> "LU"
				    ),
				    Grouped
				    = Table.Group(
				    FilteredRows,
				    {"UNIQUE IDENTIFIER NUMBER"},
				    {
				        {"DISTINCT HOUSEHOLD", each List.Count(List.Distinct([HOUSEHOLD])), Int64.Type},
				        {"DISTINCT CHILDREN", each List.Count(List.Distinct([NUMBER OF CHILDREN])), Int64.Type},
				        {"DISTINCT ADULTS", each List.Count(List.Distinct([NUMBER OF ADULTS])), Int64.Type},
				        {"HOUSEHOLD VARIANCE", each List.Max([HOUSEHOLD]) - List.Min([HOUSEHOLD]), Int64.Type},
				        {"CHILDREN VARIANCE", each List.Max([NUMBER OF CHILDREN]) - List.Min([NUMBER OF CHILDREN]), Int64.Type},
				        {"ADULTS VARIANCE", each List.Max([NUMBER OF ADULTS]) - List.Min([NUMBER OF ADULTS]), Int64.Type}
				    }
				    ),
				
				    AddFlags = Table.AddColumn(
				        Grouped,
				        "Has_Variance",
				        each 
				            ([DISTINCT HOUSEHOLD] > 1) or
				            ([DISTINCT CHILDREN] > 1) or
				            ([DISTINCT ADULTS] > 1),
				        type logical
				    ), 
				    AddDetail = Table.AddColumn(
				        AddFlags,
				        "Variance_Details",
				        each Text.Combine(
				            List.RemoveNulls({
				                if [HOUSEHOLD VARIANCE] > 0 then "Household" else null,
				                if [CHILDREN VARIANCE] > 0 then "Children" else null,
				                if [ADULTS VARIANCE] > 0 then "Adults" else null
				            }),
				            ", "
				        ), 
				        type text
				    )
				in
				    AddDetail
				```
