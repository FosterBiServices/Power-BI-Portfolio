		expression stage_StaffTime = ```
				let
				    Source = load_StaffTime,
				    ConvertTimes =
				      Table.TransformColumns(
				        Source,
				        {
				          {
				            "Time In (HH:MM)",
				            each 
				              let v = _
				              in
				                if Value.Is(v, type number) then
				                  Time.ToText(Time.From(v), "hh:mm")
				                else if Value.Is(v, type datetime) then
				                  Time.ToText(Time.From(v), "hh:mm")
				                else if Value.Is(v, type time) then
				                  Time.ToText(v, "hh:mm")
				                else
				                  Text.Trim(Text.From(v)),
				            type text
				          },
				
				          {"Time In (AM/PM)", each Text.Upper(Text.Trim(Text.From(_))), type text},
				
				          {
				            "Time Out (HH:MM)",
				            each 
				              let v = _
				              in
				                if Value.Is(v, type number) then
				                  Time.ToText(Time.From(v), "hh:mm")
				                else if Value.Is(v, type datetime) then
				                  Time.ToText(Time.From(v), "hh:mm")
				                else if Value.Is(v, type time) then
				                  Time.ToText(v, "hh:mm")
				                else
				                  Text.Trim(Text.From(v)),
				            type text
				          },
				
				          {"Time Out (AM/PM)", each Text.Upper(Text.Trim(Text.From(_))), type text}
				        }
				      ),
				    TimeIn = Table.AddColumn(
				          ConvertTimes,
				            "TIME IN",
				            each 
				              try 
				                Time.FromText([#"Time In (HH:MM)"] & " " & [#"Time In (AM/PM)"])
				              otherwise 
				                null,
				            type time
				          ),
				
				    TimeOut = Table.AddColumn(
				          TimeIn,
				            "TIME OUT",
				            each 
				              try 
				                Time.FromText([#"Time Out (HH:MM)"] & " " & [#"Time Out (AM/PM)"])
				              otherwise 
				                null,
				            type time
				          ),
				    CleanColumns = fxCleanColumns(TimeOut),
				    TimeColumns = {
				          "TIME IN", "TIME OUT"
				
				        },
				    ConverttoTime = fxCleanTimes(CleanColumns, TimeColumns),
				    TypePairs = {
				        {"ID", Int64.Type},
				        {"START TIME", type datetime},
				        {"COMPLETION TIME", type datetime},
				        {"DATE", type date},
				        {"NAME", type text},
				        {"EMAIL", type text},
				        {"SERVICES", type text},
				        {"CASE NOTES", type text},
				        {"TIME IN", type time},
				        {"TIME OUT", type time}
				
				      }, 
				  ExistingCols = Table.ColumnNames(
				        ConverttoTime
				      ), 
				      // Keep type rules only for columns that actually exist
				  TypePairsExistingOnly = List.Select(
				        TypePairs, 
				        each List.Contains(
				          ExistingCols, 
				          _{0}
				        )
				      ), 
				      // Convert those explicit pairs into a lookup record: ColumnName -> Type
				  ExplicitTypeMap = Record.FromList(
				        List.Transform(
				          TypePairsExistingOnly, 
				          each _{1}
				        ), 
				        List.Transform(
				          TypePairsExistingOnly, 
				          each _{0}
				        )
				      ), 
				      // - If we specified a type in ExplicitTypeMap, use it.
				      // - Otherwise default to type text.
				  AllTypePairs = List.Transform(
				        ExistingCols, 
				        (c) => {
				          c, 
				          Record.FieldOrDefault(
				            ExplicitTypeMap, 
				            c, 
				            type text
				          )
				        }
				      ), 
				      // Apply types in one go
				  ChangeTypes
				        = Table.TransformColumnTypes(
				        ConverttoTime, 
				        AllTypePairs
				      ),
				        HoursWorked = Table.AddColumn(
				        ChangeTypes,
				        "DURATION",
				        each
				            Number.Round(Duration.TotalHours([TIME OUT] - [TIME IN]),2),
				            type number
				    ),
				        ReviewFlag = Table.AddColumn(HoursWorked, "REVIEW", each if [DURATION] > 12 then "Review" else if [DURATION] < 0 then "Review" else "OK")
				
				in
				  ReviewFlag
				```
			lineageTag: f60c0247-b2b3-432e-b954-e3d3cc62bd1b
			queryGroup: stage

			annotation PBI_NavigationStepName = Navigation

			annotation PBI_ResultType = Table

		expression fxCleanTimes =
				(tbl as table, Columns as list) as table =>
				let
				  NormalizeTime = (Input as any) as nullable time =>
				    let
				      // Valid time = keep it
				      _DirectTime =
				        try Time.From(Input) otherwise null,
				
				      Result =
				        if _DirectTime <> null then
				          _DirectTime
				        else
				          let
				            // Normalize Text
				            _Text   = try Text.From(Input) otherwise null,
				            _Trim   = if _Text <> null then Text.Trim(_Text) else null,
				            _Upper  = if _Trim <> null then Text.Upper(_Trim) else null,
				
				            // Remove problematic characters
				            _CleanChars =
				              if _Upper <> null then
				                Text.Select(_Upper, {"0".."9", ":", "A", "P", "M", " "})
				              else null,
				
				            // Fix spacing
				            _FixSpacing =
				              if _CleanChars <> null then
				                Text.Replace(Text.Replace(_CleanChars, "AM", " AM"), "PM", " PM")
				              else null,
				
				            _Normalized =
				              if _FixSpacing <> null then Text.Trim(_FixSpacing) else null,
				
				            // ✅ KEY FIX: Handle simple numbers explicitly
				            _AddMinutes =
				              if _Normalized <> null and _Normalized <> "" and not Text.Contains(_Normalized, ":")
				              then _Normalized & ":00"
				              else _Normalized,
				
				            // ✅ FINAL FIX: Convert the correct value
				            _Time =
				              try Time.From(_AddMinutes) otherwise null
				          in
				            _Time
				    in
				      Result,
				
				  Transform =
				    Table.TransformColumns(
				      tbl,
				      List.Transform(
				        Columns,
				        each { _, NormalizeTime, type time }
				      )
				    )
				in
				  Transform
			lineageTag: df39ab34-dc54-49d3-ad25-1edfd684bdc7
			queryGroup: functions

