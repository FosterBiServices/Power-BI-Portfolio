				        {"PRORATED PERCENTAGE", type number},
				        {"PERCENT INVESTED/OBLIGATED", type number},
				        {"EXPENDITURE TREND", type number}
				    }, 
				    ExistingCols = Table.ColumnNames(
				        Cleaned
				    ), 
				    // Keep type rules only for columns that actually exist
				    TypePairsExistingOnly = List.Select(
				        TypePairs, 
				        each List.Contains(
				        ExistingCols, 
