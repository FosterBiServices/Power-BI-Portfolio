				summarizeBy: none
				sourceColumn: COMMUNITY

				annotation SummarizationSetBy = Automatic

			/// ZIP code associated with the client or household at intake.
			column ZIPCODE
				dataType: string
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: f013219a-9086-45c3-804b-deb201e26b45
