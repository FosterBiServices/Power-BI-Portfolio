			queryGroup: load

			annotation PBI_NavigationStepName = Navigation

			annotation PBI_ResultType = Table

		expression load_Intake =
				let
				    Source = SharePointConnection,
				    Intake = Source{[Name="Master Intake sheet.xlsx"]}[Content],
				    Excel = Excel.Workbook(Intake),
				    Table = Excel{[Item="Table2",Kind="Table"]}[Data]
				in
				    Table
