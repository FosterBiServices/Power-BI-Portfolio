				    {"RACE_ETHNICITY", type text},
				    {"VETERAN STATUS", type text},
				    {"DISABILITY", type text},
				    {"TYPE OF PET", type text},
				    {"HOTEL PREFERRED", type text},
				    {"ADA ROOM", type text},
				    {"CONFIRMATION #", type text},
				    {"DOB", type date},
				    {"CHECK IN DATE", type date},
				    {"CHECK OUT DATE", type date},
				    {"SSN", type text},
				    {"# OF ADULTS", Int64.Type},
				    {"# OF CHILDREN", Int64.Type},
				    {"# OF ROOMS NEEDED", Int64.Type},
				    {"# OF PETS", Int64.Type}
				  }, 
				  ExistingCols = Table.ColumnNames(
				    #"Replaced Value"
				  ), 
				  // Keep type rules only for columns that actually exist
				  TypePairsExistingOnly = List.Select(
				    TypePairs, 
				    each List.Contains(
				      ExistingCols, 
				      _{0}
				    )
				  ), 
				  // Convert those explicit pairs into a lookup record: ColumnName -> Type
				  ExplicitTypeMap = Record.FromList(
				    List.Transform(
				      TypePairsExistingOnly, 
				      each _{1}
				    ), 
				    List.Transform(
				      TypePairsExistingOnly, 
				      each _{0}
				    )
				  ), 
				  // - If we specified a type in ExplicitTypeMap, use it.
				  // - Otherwise default to type text.
				  AllTypePairs = List.Transform(
				    ExistingCols, 
				    (c) => {
				      c, 
				      Record.FieldOrDefault(
				        ExplicitTypeMap, 
				        c, 
				        type text
				      )
				    }
				  ), 
				  // Apply types in one go
				  ChangeTypes
				    = Table.TransformColumnTypes(
				    #"Replaced Value", 
				    AllTypePairs
				  ),UniqueCheckInKey
				    = Table.AddColumn(
				    ChangeTypes,
				    "CHECK IN ID",
				    each
				      Text.Combine(
				        {
				          if [
				            HMIS UNIQUE IDENTIFIER
				          ]
				            = null
				          then
				            [
				              RECORD ID
				            ]
				          else
				            [
				              HMIS UNIQUE IDENTIFIER
				            ],
				          Date.ToText(
				            [
				              CHECK IN DATE
				            ],
				            [
				              Format
				                = "MMddyyyy",
				              Culture
				                = "de-EN"
				            ]
				          )
				        },
				        "-"
				      ),
				    type text
				  ),
				  UniqueKey
				    = Table.AddColumn(
				    ChangeTypes,
				    "ID",
				    each
				      Text.Combine(
				        {
				          if [
				            HMIS UNIQUE IDENTIFIER
				          ]
				            = null
				          then
				            [
				              RECORD ID
				            ]
				          else
				            [
				              HMIS UNIQUE IDENTIFIER
				            ],
				          Date.ToText(
				            [
				              DOB
				            ],
				            [
				              Format
				                = "MMddyyyy",
				              Culture
				                = "de-EN"
				            ]
				          )
				        },
				        "-"
				      ),
				    type text
				  ),
				
				  ColumnsToNormalize_lower
				    = {
				    "GENDER",
				    "RACE_ETHNICITY",
				    "VETERAN STATUS",
				    "DISABILITY",
				    "TYPE OF PET", 
				    "CONFIRMATION #", 
				    "ADA ROOM"
				  },
				  lowerNormalized
				    = Table.TransformColumns(
				    UniqueKey,
				    List.Transform(
				      ColumnsToNormalize_lower,
				      (
