				sourceColumn: RACE_ETHNICITY

				annotation SummarizationSetBy = Automatic

			/// Client veteran status as collected during intake.
			column 'VETERAN STATUS'
				dataType: string
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: 19cf6eb5-db70-434a-bb50-bed92f1c38c2
				summarizeBy: none
				sourceColumn: VETERAN STATUS

				annotation SummarizationSetBy = Automatic

			/// Client disability status as collected during intake.
			column DISABILITY
				dataType: string
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: 0d6a4a4a-e1a7-4559-b452-b9d770cfe71b
				summarizeBy: none
				sourceColumn: DISABILITY

				annotation SummarizationSetBy = Automatic

			/// Number of adults in the household as reported at intake.
			column '# OF ADULTS'
				dataType: int64
				formatString: #,0
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: 9788bab7-7216-4686-915a-acdafe973d44
				summarizeBy: none
				sourceColumn: # OF ADULTS

				annotation SummarizationSetBy = Automatic

			/// Number of children in the household as reported at intake.
			column '# OF CHILDREN'
				dataType: int64
				formatString: #,0
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: 33aa2f16-0a66-4949-a134-35b20b05417e
				summarizeBy: none
				sourceColumn: # OF CHILDREN

				annotation SummarizationSetBy = Automatic

			/// Number of rooms needed for the household as reported at intake.
			column '# OF ROOMS NEEDED'
				dataType: int64
				formatString: #,0
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: e2de57e8-5fd4-4dcc-a51e-e71e74929fb5
				summarizeBy: none
				sourceColumn: # OF ROOMS NEEDED

				annotation SummarizationSetBy = Automatic

			/// Type of pet reported at intake, when applicable.
			column 'TYPE OF PET'
				dataType: string
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: 8a313c22-4a1e-4f7c-a61a-3cb46b44d2a0
				summarizeBy: none
				sourceColumn: TYPE OF PET

				annotation SummarizationSetBy = Automatic

			/// Preferred hotel requested or identified during intake.
			column 'HOTEL PREFERRED'
				dataType: string
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: 1459b342-2a35-4ddc-b93d-6e3836a9fc58
				summarizeBy: none
				sourceColumn: HOTEL PREFERRED

				annotation SummarizationSetBy = Automatic

			/// Indicates whether an ADA-accessible room is needed.
			column 'ADA ROOM'
				dataType: string
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: a8915102-5022-47ab-ad2d-898c3103e1d1
				summarizeBy: none
