				    {"FIRST NAME", type text},
				    {"LAST NAME", type text},
				    {"VALID ID", type text},
				    {"COMMUNITY", type text},
				    {"ZIPCODE", type text},
				    {"HMIS UNIQUE IDENTIFIER", type text},
				    {"BLACK LIST", type text},
				    {"PHONE NUMBER", type text},
				    {"ALLOW TEXT", type text},
