		expression load_MPR = ```
				let 
				  Source = SharePointConnection,
				  MPR = Source{[Name="IWP MPR.xlsx"]}[Content],
				  Excel = Excel.Workbook(MPR),
				  Sheet = Excel{[Item="MPR",Kind="Sheet"]}[Data], 
				  PromoteHeaders = Table.PromoteHeaders(Sheet)
				in
				  PromoteHeaders
				```
