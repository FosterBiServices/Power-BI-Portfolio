				        col,
				        each
				          fxNormalize(
				            _
				          ),
				        type text
				      }
				    )
				  )
				,
				  ColumnsToNormalize_upper
				    = {
				    "HMIS UNIQUE IDENTIFIER", 
				    "CONFIRMATION #"
				  },
				  upperNormalized
				    = Table.TransformColumns(
				    lowerNormalized,
				    List.Transform(
				      ColumnsToNormalize_upper,
				      (
				        col
				      ) => {
				        col,
				        each
				          fxCleanValues(
				            _
				          ),
				        type text
				      }
				    )
				  )
				in
				    upperNormalized
				```
