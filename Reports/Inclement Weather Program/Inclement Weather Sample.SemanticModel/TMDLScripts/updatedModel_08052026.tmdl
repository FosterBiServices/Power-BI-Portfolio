			annotation PBI_NavigationStepName = Navigation

			annotation PBI_ResultType = Table

		expression stage_DataValidations = ```
				let
				  SourceData =
				    MPR_Counts,
				
				  MergeWithVariances =
				    Table.NestedJoin(
				      SourceData,
				      {"UNIQUE IDENTIFIER NUMBER"},
				      MPR_variances,
				      {"UNIQUE IDENTIFIER NUMBER"},
				      "Household",
				      JoinKind.LeftOuter
				    ),
				
				  ExpandVarianceColumns =
				    Table.ExpandTableColumn(
				      MergeWithVariances,
				      "Household",
				      {
				        "DISTINCT HOUSEHOLD",
				        "DISTINCT CHILDREN",
				        "DISTINCT ADULTS",
				        "HOUSEHOLD VARIANCE",
				        "CHILDREN VARIANCE",
				        "ADULTS VARIANCE",
				        "Has_Variance",
				        "Variance_Details"
				      }
				    ),
				
				  AppendHMISOnlyRecords =
				    Table.Combine({ExpandVarianceColumns, HMISOnly}),
				
				  AddHMISFlagColumn =
				    Table.AddColumn(
				      AppendHMISOnlyRecords,
				      "HMIS Flag",
				      each if [Row_Count] = null then "HMIS" else "MPR"
				    ),
				
				  SetHMISFlagType =
				    Table.TransformColumnTypes(
				      AddHMISFlagColumn,
				      {{"HMIS Flag", type text}}
				    ),
				
				  MergeWithMPROnly =
				    Table.NestedJoin(
				      SetHMISFlagType,
				      {"UNIQUE IDENTIFIER NUMBER"},
				      MPROnly,
				      {"UNIQUE IDENTIFIER NUMBER"},
				      "MPROnly",
				      JoinKind.LeftOuter
				    ),
				
				  ExpandMPROnlyIndicator =
				    Table.ExpandTableColumn(
				      MergeWithMPROnly,
				      "MPROnly",
				      {"UNIQUE IDENTIFIER NUMBER"},
				      {"MPR"}
				    ),
				
				  AddMPROnlyFlag =
				    Table.AddColumn(
				      ExpandMPROnlyIndicator,
				      "MPR Only",
				      each if [MPR] = null then false else true
				    ),
				    ChangeMPRFlag = Table.TransformColumnTypes(AddMPROnlyFlag,{{"MPR Only", type logical}}),
				    RemoveMPRMergeColumn = Table.RemoveColumns(ChangeMPRFlag,{"MPR"}), 
				    MergeWithMisMatches =
				    Table.NestedJoin(
				      RemoveMPRMergeColumn,
				      {"UNIQUE IDENTIFIER NUMBER"},
				      NameMisMatches,
				      {"UNIQUE IDENTIFIER NUMBER"},
				      "MisMatches",
				      JoinKind.LeftOuter
				    ),
				
				  ExpandMisMatchedColumns =
