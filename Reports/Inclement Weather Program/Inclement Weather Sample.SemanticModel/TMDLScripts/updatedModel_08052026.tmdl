				displayFolder: TableColumns
				lineageTag: 151e59f0-ceff-4ccb-b2d6-a3c35fe10dba
				summarizeBy: none
				isNameInferred
				sourceColumn: [Month Sort]

				annotation SummarizationSetBy = Automatic

			/// Month and year label used for monthly reporting.
			column 'Month Year'
				displayFolder: TableColumns
				lineageTag: 59e54afb-607c-4786-9df3-4f4dc6eb09bf
				summarizeBy: none
				isNameInferred
				sourceColumn: [Month Year]
				sortByColumn: 'Month Sort'

				annotation SummarizationSetBy = Automatic

			/// Calendar year for the date.
			column Year
				formatString: #,0
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: d564d7ee-eefd-4a3c-8c95-6c971b7c62a3
				summarizeBy: none
				isNameInferred
				sourceColumn: [Year]

				annotation SummarizationSetBy = Automatic

			/// Week-ending date for the calendar date.
			column 'Week Ending'
				formatString: m/d/yyyy
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: 2e2140c7-9f9d-42be-877b-623117f708c4
				summarizeBy: none
				isNameInferred
				sourceColumn: [Week Ending]

				annotation SummarizationSetBy = Automatic

			/// Weekday name for the calendar date.
			column Weekday
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: ed867449-38c4-4c71-a3dc-8c05bd4a7b85
				summarizeBy: none
				isNameInferred
				sourceColumn: [Weekday]

				annotation SummarizationSetBy = Automatic

			/// Numeric weekday value for the calendar date.
			column 'Weekday number'
				formatString: #,0
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: 86dcea0b-4af6-442b-ae56-c82d9ad67aa2
				summarizeBy: none
				isNameInferred
				sourceColumn: [Weekday number]

				annotation SummarizationSetBy = Automatic

			partition dimdate = calculated
				mode: import
				source = ```
						
						
						VAR MinDate = MIN(Financials[MONTH])
						RETURN
						ADDCOLUMNS(
							CALENDAR(MinDate, TODAY()), 
							"Year", YEAR ( [Date] ),
							"Quarter", "Q" & TRUNC ( ( MONTH ( [Date] ) - 1 ) / 3 ) + 1,
							"Month Name", FORMAT ( [Date], "mmmm" ),
							"Month Number", FORMAT( [Date], "mm"),
							"Month Sort", YEAR ( [Date] ) *12 + FORMAT( [Date], "mm") + 1, 
							"Month Year", FORMAT( [Date], "mmmm yyyy" ),
							"Week Ending", [Date] + (7 - WEEKDAY([Date], 2)),
							"Weekday", FORMAT ( [Date], "dddd" ),
							"Weekday number", WEEKDAY( [Date] )
						)
						
						
						```

			annotation PBI_Id = f750852ffad64968a254499b8ce7e327

