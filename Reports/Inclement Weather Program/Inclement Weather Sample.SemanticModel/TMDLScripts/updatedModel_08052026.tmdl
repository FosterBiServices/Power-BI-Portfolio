			queryGroup: load

			annotation PBI_NavigationStepName = Navigation

			annotation PBI_ResultType = Table

		expression stage_HMIS = ```
				let
				  Source = load_HMIS, 
				  RemoveRows = fxRemoveHMISRows(Source), 
				    TypePairs = {
				    {"PROGRAM NAME", type text},
				    {"CLIENT", type text},
				    {"UNIQUE IDENTIFIER", type text},
				    {"BIRTH DATE", type date},
				    {"AGE AT ENTRY", Int64.Type},
				    {"CURRENT AGE", Int64.Type},
				    {"ENROLL DATE", type date},
				    {"EXIT DATE", type date},
				    {"LOS", Int64.Type},
				    {"HOUSING MOVE IN", type text},
				    {"ASSESSMENTS", type text},
				    {"SERVICES", type text},
				    {"CASE NOTES", type text},
				    {"ASSIGNED STAFF", type text},
				    {"UNIT ASSIGNMENT", type text},
				    {"BED ASSIGNMENT", type text},
				    {"OCCUPANCY START DATE", type date},
				    {"OCCUPANCY END DATE", type date}
				
				
				  }, 
				  ExistingCols = Table.ColumnNames(
				    RemoveRows
				  ), 
				  // Keep type rules only for columns that actually exist
				  TypePairsExistingOnly = List.Select(
				    TypePairs, 
				    each List.Contains(
				      ExistingCols, 
				      _{0}
				    )
				  ), 
				  // Convert those explicit pairs into a lookup record: ColumnName -> Type
				  ExplicitTypeMap = Record.FromList(
				    List.Transform(
				      TypePairsExistingOnly, 
				      each _{1}
				    ), 
				    List.Transform(
				      TypePairsExistingOnly, 
				      each _{0}
				    )
				  ), 
				  // - If we specified a type in ExplicitTypeMap, use it.
				  // - Otherwise default to type text.
				  AllTypePairs = List.Transform(
				    ExistingCols, 
				    (c) => {
				      c, 
				      Record.FieldOrDefault(
				        ExplicitTypeMap, 
				        c, 
				        type text
				      )
				    }
				  ), 
				  // Apply types in one go
				  ChangeTypes
				    = Table.TransformColumnTypes(
				    RemoveRows, 
				    AllTypePairs
				  ), 
				  UniqueID = Table.AddColumn(
				        ChangeTypes, "CHECK IN ID", each Text.Combine(
				          {[UNIQUE IDENTIFIER], 
				          Text.Trim(Date.ToText([ENROLL DATE], [Format="MMddyyyy"]))}, 
				          "-"
				        ), 
				        type text
				      ),
				  UniqueKey =
				    Table.AddColumn(
				      UniqueID,
				      "ID",
				      each
				        Text.Combine(
				          {
				            Text.Trim(
				              Text.From(
				                if [UNIQUE IDENTIFIER] = null
				                then [RECORD ID]
				                else [UNIQUE IDENTIFIER]
				              )
				            ),
				            Text.Trim(
				              if [BIRTH DATE] = null
				              then ""
				              else Date.ToText(Date.From([BIRTH DATE]), "MMddyyyy")
				            )
				          },
				          "-"
				        ),
				      type text
				    ),
				    RenamedColumns = Table.RenameColumns(UniqueKey,{{"ASSESS- MENTS", "ASSESSMENTS"}, {"ASSIGNED STAFF (* DENOTES INACTIVE)", "ASSIGNED STAFF"}}),
				    RemovedColumns = Table.RemoveColumns(RenamedColumns,{"1", "COLUMN11", "COLUMN17"}, MissingField.Ignore), 
				
				    ColumnsToClean = {
				      "UNIQUE IDENTIFIER"
				    },
				
				    CleanedTable =
				      Table.TransformColumns(
				        RemovedColumns,
				        List.Transform(
				          ColumnsToClean,
				          each {_, fxCleanValues, type text}
				        )
				      )
				
				    in
				      CleanedTable
				```
			lineageTag: 2d565731-b843-4212-bede-6af3a51436f3
			queryGroup: stage

			annotation PBI_NavigationStepName = Navigation

			annotation PBI_ResultType = Table

		expression fxRemoveHMISRows = ```
				let
				    Source = (InputTable as table) as table =>
				
				let
				  IndexNumber = 
				    let
				    // Add Index to Table
				        #"Added Index" = Table.AddIndexColumn(#"InputTable", "Index", 0, 1, Int64.Type), 
				    // Change Column1 in next two steps to match your column name
				        #"Changed Type" = Table.TransformColumnTypes(#"Added Index", {{"Column1", type text}}),  
				    // Change Billable Encounters to match term you're looking for   
				        #"Filtered Rows" = Table.SelectRows(#"Added Index", each ([Column1] = "Program Name")){0}[Index] 
				    in
				      #"Filtered Rows",
				    // Skips down to row number found in Filtered Row steps and removes all previous rows
				    RemoveRows = Table.Skip(InputTable, IndexNumber), 
				    // Promotes headers, you can skip this if needed 
				    PromoteHeaders = Table.PromoteHeaders(RemoveRows, [PromoteAllScalars=true]) 
				    ,CleanNames = fxCleanColumns(PromoteHeaders) 
				    in 
				      CleanNames
				
				in
				    Source
				```
			lineageTag: 24d77543-75d9-4003-b135-32cb5cfda52f
			queryGroup: functions

			annotation PBI_NavigationStepName = Navigation

			annotation PBI_ResultType = Function

		expression fxCleanColumns = ```
				let
				    Source = (InputTable as table) as table =>
				
				  let
				    Source = #"InputTable",
				    CleanNames =
				      Table.TransformColumnNames(
				        Source,
				        each Text.Trim(
				          Text.Replace(
				            Text.Combine(List.Select(Text.Split(_, "#(lf)"), each _ <> ""), " "),
				            "  ",
				            " "
				          )
				        )
				      )
				    ,TrimColumnNames = Table.TransformColumnNames(CleanNames, Text.Trim) 
				    ,UpperColumnNames = Table.TransformColumnNames(TrimColumnNames, Text.Upper) 
				  in 
				    UpperColumnNames
				
				in
				  Source
				```
			lineageTag: e71caddd-4a8c-4f2c-8116-6a5cb78ecb3d
			queryGroup: functions

			annotation PBI_NavigationStepName = Navigation

			annotation PBI_ResultType = Function

		expression fxCleanValues =
				let
				    Source =
				    (
				        cleanValue as nullable text,
				        optional allowSpaces as nullable logical
				    )
				    as nullable text =>
				
				let
				    Result =
				        if cleanValue = null then
				            null
				        else
				            let
				                BaseText =
				                    Text.Trim(Text.From(cleanValue)),
				                RemoveControlChars =
				                    Text.Replace(
				                        Text.Replace(BaseText, "#(lf)", ""),
				                        "#(cr)",
				                        ""
				                    ),
				                RemoveQuotes =
				                    Text.Replace(RemoveControlChars, """", ""),
				                AllowedCharacters =
				                    if allowSpaces = true then
				                        {"A".."Z", "a".."z", "0".."9", " "}
				                    else
				                        {"A".."Z", "a".."z", "0".."9"},
				                Filtered =
				                    Text.Select(RemoveQuotes, AllowedCharacters),
				                FinalValue =
				                    Text.Upper(Filtered)
				
				            in
				                if FinalValue = "" then null else FinalValue
				in
				    Result
				in
				    Source
			lineageTag: ddc7b737-4df9-4db0-b4a9-8bf42426c4bf
			queryGroup: functions

