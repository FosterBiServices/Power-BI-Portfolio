				sourceColumn: ZIPCODE

				annotation SummarizationSetBy = Automatic

			/// Indicates whether the client or household is flagged on the blacklist field.
			column 'BLACK LIST'
				dataType: string
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: 6b07c8ca-a864-4bc6-8204-69cda56a9377
