			/// Indicates whether the client allows text message communication.
			column 'ALLOW TEXT'
				dataType: string
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: b3e35531-4038-441c-944a-3d557cd5d0e6
				summarizeBy: none
				sourceColumn: ALLOW TEXT

				annotation SummarizationSetBy = Automatic

			/// Client gender as collected during intake.
			column GENDER
				dataType: string
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: 99659654-e383-4419-a944-51860cd9174f
				summarizeBy: none
				sourceColumn: GENDER

				annotation SummarizationSetBy = Automatic

			/// Client race and/or ethnicity as collected during intake.
			column RACE_ETHNICITY
				dataType: string
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: 361b1788-c85e-4d0c-b62a-83f1252fa860
