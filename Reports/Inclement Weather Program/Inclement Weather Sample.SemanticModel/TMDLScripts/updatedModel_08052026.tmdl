				annotation SummarizationSetBy = Automatic

			/// Expected or recorded check-out date for the intake stay.
			column 'CHECK OUT DATE'
				dataType: dateTime
				formatString: m/d/yyyy
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: 81adb387-8ec4-41dd-a732-adda74dedb12
				summarizeBy: none
				sourceColumn: CHECK OUT DATE

				annotation SummarizationSetBy = Automatic

				annotation UnderlyingDateTimeDataType = Date

			/// Intake record identifier used for matching or traceability.
			column ID
				dataType: string
				isAvailableInMdx: false
				displayFolder: TableColumns
				lineageTag: 6d821407-83c5-4b39-83ab-4556868b6366
				summarizeBy: none
				sourceColumn: ID

				annotation SummarizationSetBy = Automatic

			partition Intake = m
				mode: import
				queryGroup: Report
				source =
						let
						Source = stage_Intake
						in
						Source

			annotation PBI_NavigationStepName = Navigation

			annotation PBI_ResultType = Exception

		/// Centralized table that stores reusable business measures and calculations used throughout the semantic model for reporting, analysis, and KPI tracking.
		table _Measures
			lineageTag: dd20d613-3ea5-4178-9d66-564fadc75a9e

			/// The number of unique program enrollments. Each distinct ID in the MPR table counts as one enrollment. Use this to track how many households or cases have been served.
			measure Enrollments = COUNTROWS ( MPR )
				formatString: #,0
				displayFolder: MPR
				lineageTag: de0e155c-3795-4c8d-a84b-0efd6c53c021

			/// The total number of children under 18 across all MPR records. Use this to understand the child population being served by the program.
			measure Children = SUM ( MPR[NUMBER OF CHILDREN] )
				formatString: #,0
				displayFolder: MPR
				lineageTag: c12f252c-d29b-41f4-82a4-e45fbd59f5aa

			/// The total number of adults across all MPR records. Use this alongside Children and Household to understand the makeup of the population being served.
			measure Adults = SUM ( MPR[NUMBER OF ADULTS] )
				formatString: #,0
				displayFolder: MPR
				lineageTag: 905fa252-53b9-458c-a5a4-97f1fe7dfefc

			/// The total number of individuals in households across all MPR records. This includes all members regardless of age, giving a full picture of household size.
			measure Household =
					CALCULATE
					(
					    SUM ( MPR[HOUSEHOLD] ),
					    MPR[UID_SOURCE] = "MPR"
					)
				formatString: #,0
				displayFolder: MPR
				lineageTag: ebf9b1d6-650c-45d7-a1f5-a3421ee422b0

			/// The total number of pets reported across all intake records. Useful for understanding additional accommodation needs when placing or supporting families.
			measure 'Intake - Pets' = SUM ( Intake[# OF PETS] )
				formatString: #,0
				displayFolder: Intake
				lineageTag: c6a6cd94-bdc2-4721-a958-38514c25209a

			/// Number of unique activations where the participant identified as female. Use this to analyze program reach and gender distribution across services.
			measure 'Gender - female' =
					CALCULATE
					(
					    DISTINCTCOUNT
					    (
					        MPR[UNIQUE IDENTIFIER NUMBER]
					    ),
					    MPR[GENDER] = "female"
					)
				formatString: #,0
				displayFolder: Demographics\Gender
				lineageTag: 742260d8-df24-43d8-814e-201e2bc1af87

			/// Number of unique activations where the participant identified as Male. Use this to analyze program reach and gender distribution across services.
			measure 'Gender - Male' =
					CALCULATE
					(
					    DISTINCTCOUNT
					    (
					        MPR[UNIQUE IDENTIFIER NUMBER]
					    ),
					    MPR[GENDER] = "male"
					)
				formatString: #,0
				displayFolder: Demographics\Gender
				lineageTag: f1f2a139-a817-4516-a78e-cf6ec99e087d

			/// Number of unique activations where the participant identified as Non-Binary. Use this to ensure equitable service visibility across gender identities.
			measure 'Gender - Non-Binary' =
					CALCULATE
					(
					    DISTINCTCOUNT
					    (
					        MPR[UNIQUE IDENTIFIER NUMBER]
					    ),
					    MPR[GENDER] = "non-binary"
					)
				formatString: #,0
				displayFolder: Demographics\Gender
				lineageTag: 2b56169f-0049-4be5-877f-06d0463fb3e8

			/// Number of unique activations where the participant identified with a gender identity not listed in the standard options. Helps ensure all gender identities are represented in reporting.
			measure 'Gender - Different Identity' =
					CALCULATE
					(
					    DISTINCTCOUNT
					    (
					        MPR[UNIQUE IDENTIFIER NUMBER]
					    ),
					    MPR[GENDER] = "different identity"
					)
				formatString: #,0
				displayFolder: Demographics\Gender
				lineageTag: 9e70871e-69d1-4727-9f83-1546d74b08ea

			/// Number of unique activations where the participant chose not to disclose their gender. Useful for understanding data completeness and participant comfort with data collection.
			measure 'Gender - Prefers Not to Answer' =
					CALCULATE
					(
					    DISTINCTCOUNT
					    (
					        MPR[UNIQUE IDENTIFIER NUMBER]
					    ),
					    MPR[GENDER] = "prefers not to answer"
					)
				formatString: #,0
				displayFolder: Demographics\Gender
				lineageTag: faa6beae-8db7-4069-bbce-d31a3d9cf34e

			/// Number of unique activations for participants aged 18 to 24. Use this to monitor service reach within this early-adulthood age group.
			measure 'Age - 18 to 24' =
					CALCULATE
					(
					    [Enrollments],
					    MPR[CLIENT AGE] >= 18
					        && MPR[CLIENT AGE] < 25
					)
				formatString: #,0
				displayFolder: Demographics\Age
				lineageTag: ddd122ca-751c-4cd9-9bde-9dcc5dd371df

			/// Number of unique activations for participants aged 55 to 64. Use this to monitor service reach within this mid-adulthood age group.
			measure 'Age - 55 to 64' =
					CALCULATE
					(
					    [Enrollments],
					    MPR[CLIENT AGE] >= 55
					        && MPR[CLIENT AGE] < 65
					)
				formatString: #,0
				displayFolder: Demographics\Age
				lineageTag: 0c44ced3-a5cb-4115-8878-72836e8acee5

			/// Number of unique activations for participants aged 65 and older. Senior participants often require additional support services and accommodations.
			measure 'Age - 65 and Over' =
					CALCULATE
					(
					    [Enrollments],
					    MPR[CLIENT AGE] >= 65
					)
				formatString: #,0
				displayFolder: Demographics\Age
				lineageTag: 71f7a4ba-2ff3-49c2-aac7-9bf094857d30

			/// Number of unique activations for participants who identified as veterans. Use this to track veteran-specific service utilization and ensure program reach within this priority population.
			measure 'Veteran - Yes' =
					CALCULATE
					(
					    [Enrollments],
					    MPR[VETERAN] = "yes"
					)
				formatString: #,0
				displayFolder: Demographics\Veteran Status
				lineageTag: 021f7e34-568f-454f-9de3-c426eba6d992

			/// Number of unique activations for participants who are not veterans. Use alongside the Veteran - Yes measure to understand the veteran vs. non-veteran breakdown of participants served.
			measure 'Veteran - No' =
					CALCULATE
					(
					    [Enrollments],
					    MPR[VETERAN] = "no"
					)
				formatString: #,0
				displayFolder: Demographics\Veteran Status
				lineageTag: fc2f11a3-2f90-4be4-9ff8-e7f6a7a22da4

			/// Number of unique activations for participants who reported having a disability. Use this to assess whether the program is adequately reaching and supporting individuals with disabilities.
			measure 'Disability - Yes' =
					CALCULATE
					(
					    [Enrollments],
					    MPR[DISABILITY] = "yes"
					)
				formatString: #,0
				displayFolder: Demographics\Disability Status
				lineageTag: b958f1a3-b037-4fd7-babb-872288e76bcc

			/// Number of unique activations for participants who reported not having a disability. Use alongside Disability - Yes to understand the full disability status breakdown of participants served.
			measure 'Disability - No' =
					CALCULATE
					(
					    [Enrollments],
					    MPR[DISABILITY] = "no"
					)
				formatString: #,0
				displayFolder: Demographics\Disability Status
				lineageTag: bcc45446-1532-401f-8e88-a883e75b9ecb

			/// The average number of intakes processed per day by each staff member, based on their total intake count divided by the number of days they worked. Use this to compare workload and productivity across employees.
			measure 'Avg Intakes Per Day' =
					DIVIDE
					(
					    [Intake Count],
					    [Days Worked (Intake)]
					)
				formatString: #,0.0
				displayFolder: Staff Activity
				lineageTag: b8182990-915e-45d2-8447-e3f7b469cb56

			/// The number of distinct days on which a staff member processed at least one intake. Use this in a table or matrix with Staff Name to see how many days each employee was active over any selected time period.
			measure 'Days Worked (Intake)' = DISTINCTCOUNT ( Intake[CHECK IN DATE] )
				formatString: #,0
				displayFolder: Staff Activity
				lineageTag: 2e6c5911-b26a-4e6b-b5fd-bb4eee2c60df

			/// The number of unique communities of origin represented across intake records in the current filter context. Use this to understand the geographic diversity of clients being served in any given period.
			measure 'Distinct Communities' = DISTINCTCOUNT ( MPR[COMMUNITY] )
				formatString: #,0
				displayFolder: Location
				lineageTag: cbaf1ad6-2458-43f1-816c-09c6638c77bb

			/// The earliest check-in date recorded for the staff member in the current filter context. Use this alongside Last Intake Date to understand the full date range over which an employee has been active.
			measure 'First Intake Date' = MIN ( Intake[CHECK IN DATE] )
				formatString: m/d/yyyy
				displayFolder: Staff Activity
				lineageTag: 5af43b31-d596-4be5-bf82-7264fa9cad1f

			/// The total number of intake records processed in the current filter context. When used with a date slicer or matrix, this shows how many intakes each staff member completed on a given day — making it easy to see who was working and how active they were.
			measure 'Intake Count' = COUNTROWS ( Intake )
				formatString: #,0
				displayFolder: Staff Activity
				lineageTag: 932950fc-86dc-4978-8141-d760aa0e64de

			/// The most recent check-in date recorded for the staff member in the current filter context. Useful for identifying when an employee last processed an intake, or confirming who was active on the latest date.
			measure 'Last Intake Date' = MAX ( Intake[CHECK IN DATE] )
				formatString: m/d/yyyy
				displayFolder: Staff Activity
				lineageTag: d91cc2a8-ba4c-4ab8-a186-1159046f4468

			/// The number of distinct staff members represented in the current filter context based on Intake records. Use this to understand staffing coverage and participation across reporting periods.
			measure 'Staff Count' = DISTINCTCOUNT ( Intake[STAFF NAME] )
				formatString: #,0.0
				displayFolder: Staff Activity
				lineageTag: 6f8c1b06-8cae-4b90-9661-62bb12061464

			/// The number of unique confirmation numbers recorded in the Intake table. Each distinct confirmation number counts as one activation, representing a household that was confirmed for placement. Use this to compare intake-level activations against MPR activations for data reconciliation.
			measure 'Intake - Activations' =
					DISTINCTCOUNTNOBLANK
					(
					    Intake[CONFIRMATION #]
					)
				formatString: #,0
				displayFolder: Intake
				lineageTag: b107cd1b-02a4-4f83-b8ee-8351f1068b00

			/// The total number of unique clients in the Clients table, identified by their Unique Identifier. Use this to understand the overall size of the client population across all data sources.
			measure Clients =
					DISTINCTCOUNT
					(
					    Clients[UNIQUE IDENTIFIER]
					)
				formatString: #,0
				displayFolder: Clients
				lineageTag: d55c9810-33ab-4900-b223-9ed73edc7d1c

			/// The average age of all clients in the Clients table. Use this to understand the general age profile of the population being served, and filter by program or date to see how it changes across segments.
			measure 'Average Age' = AVERAGE ( Clients[AGE] )
				formatString: 0.00
				displayFolder: Clients
				lineageTag: b90c7509-3d76-4d91-810b-f6b312765dc9

			/// The total number of hotel nights used across all MPR records in the current filter context. Each record contributes its hotel nights count; this is summed to give total night utilization. Use this to report on shelter capacity consumption.
			measure Nights = SUM ( MPR[NUMBER OF HOTEL NIGHTS] )
				formatString: #,0
				displayFolder: MPR
				lineageTag: 3cd68dd2-2772-44db-bb9c-f78f0a962870

			/// The total number of hotel rooms rented across all MPR records in the current filter context. Sums the rooms-rented field from each record. Use this to track resource utilization and hotel capacity over time.
			measure Rooms = SUM ( MPR[NUMBER OF HOTEL ROOMS RENTED] )
				formatString: #,0
				displayFolder: MPR
				lineageTag: 53b439a4-f3ae-454e-a8b6-9c7024fa2c95

			/// The average number of hotel nights per record in the current filter context. Use this alongside Total Nights to understand both the volume and the typical intensity of hotel usage per household.
			measure 'Average Length of Stay' = AVERAGE ( MPR[NUMBER OF HOTEL NIGHTS] )
				formatString: 0.00
				displayFolder: MPR
				lineageTag: 82cf4916-6b88-4be4-b637-6431b534c2d4

			/// The number of unique activation IDs in the Activations table. Each distinct Activation ID represents one household activation event. Use this as the primary activation count when working with the Activations table directly.
			measure Activations = DISTINCTCOUNT ( MPR[ACTIVATION ID] )
				formatString: #,0
				displayFolder: Activations
				lineageTag: a692da51-4c23-4eb7-82e3-aba7343b0b2d

			/// The number of unique client identifiers that appear in HMIS but not in QuickBase (MPR). It filters the DataIntegrity table to only rows flagged as 'HMIS' and counts the distinct IDs. Use this to identify clients who are enrolled in HMIS but have not been activated in the program database.
			measure 'HMIS Only UIDs' =
					CALCULATE
					(
					    DISTINCTCOUNT
					    (
					        DataIntegrity[UNIQUE IDENTIFIER NUMBER]
					    ),
					    DataIntegrity[HMIS Flag] = "HMIS"
					)
				formatString: #,0
				displayFolder: DataIntegrity
				lineageTag: 4a6fd3d9-aae3-4230-83c2-f365e6d4f4cf

			/// The number of unique client identifiers (UIDs) across all MPR records. Uses DISTINCTCOUNT to ensure each individual is counted only once, even if they appear in multiple rows. Use this to measure how many distinct individuals are represented in the MPR data.
			measure UID =
					DISTINCTCOUNT
					(
					    MPR[UNIQUE IDENTIFIER NUMBER]
					)
				formatString: #,0
				displayFolder: MPR
				lineageTag: 2cece439-b4d2-4b34-8761-e509f1e7325b

			/// The share of participants who identified as veterans, expressed as a percentage. Divides [Veteran - Yes] by the total of [Veteran - Yes] + [Veteran - No], using DIVIDE to safely return blank if both are zero. Use this to understand the veteran proportion of the population being served.
			measure 'Veteran Percentage' =
					DIVIDE
					(
					    [Veteran - Yes],
					    [Veteran - Yes] + [Veteran - No]
					)
				formatString: #,0.00%;-0.00%;0.00%
				displayFolder: Demographics\Veteran Status
				lineageTag: cc4cad79-054a-48e2-a50e-d921b0344140

			/// The share of participants who reported having a disability, expressed as a percentage. Divides [Disability - Yes] by the total of [Disability - Yes] + [Disability - No], using DIVIDE to safely return blank if both are zero. Use this to understand what proportion of the population served has a disability.
			measure 'Disability Percentage' =
					DIVIDE
					(
					    [Disability - Yes],
					    [Disability - Yes] + [Disability - No]
					)
				formatString: #,0.00%;-0.00%;0.00%
				displayFolder: Demographics\Disability Status
				lineageTag: e521701f-68c6-4dfc-91ca-e8f81c73ca3e

			/// Generates a dynamic chart title based on whichever measure the user has selected in the People Measure Selection slicer. It checks that exactly one option is selected, retrieves its display name, and appends 'by month' to form a readable title (e.g. 'Activations by month'). Returns blank if no single selection is made. Used to automatically label visuals based on user slicer choices.
			measure 'People Measure Selection Title' =
					VAR _Selection =
					    SELECTCOLUMNS
					    (
					        SUMMARIZE
					        (
					            'People Measure Selection',
					            'People Measure Selection'[Name],
					            'People Measure Selection'[Measure]
					        ),
					        "SelectedName", 'People Measure Selection'[Name]
					    )
					VAR Choice =
					    IF
					    (
					        COUNTROWS ( _Selection ) = 1,
					        _Selection
					    )
					RETURN
					    Choice & " by month"
				displayFolder: Formatting
				lineageTag: 4d38dd7c-9a0e-4f32-8d76-3176141ba11f

			/// The number of unique clients who checked in more than once within the same calendar month — but only when 'Activations' is selected in the People Measure Selection slicer. It groups MPR records by client ID and month, counts rows per group, then counts how many clients had more than one row. Returns blank when a different measure is selected. Used as a tooltip to flag potential duplicate or extended-stay records.
			measure 'Multiple Check-ins' =
					// Only applying this as tooltip -- Duplicate if needed elsewhere
					VAR _Selection =
					    SELECTCOLUMNS
					    (
					        SUMMARIZE
					        (
					            'People Measure Selection',
					            'People Measure Selection'[Name],
					            'People Measure Selection'[Measure]
					        ),
					        "SelectedName", 'People Measure Selection'[Name]
					    )
					VAR Choice =
					    IF
					    (
					        COUNTROWS ( _Selection ) = 1,
					        _Selection
					    )
					VAR _GroupedTable =
					    SUMMARIZE
					    (
					        MPR,
					        MPR[UNIQUE IDENTIFIER NUMBER],
					        dimdate[Month Year],
					        "CheckInCount", COUNTROWS ( MPR )
					    )
					RETURN
					    IF
					    (
					        Choice = "Enrollments",
					        COUNTROWS
					        (
					            SUMMARIZE
					            (
					                FILTER
					                (
					                    _GroupedTable,
					                    [CheckInCount] > 1
					                ),
					                MPR[UNIQUE IDENTIFIER NUMBER]
					            )
					        )
					    )
				formatString: #,0
				displayFolder: MPR
				lineageTag: 684f9a75-e229-4aa4-97a4-a96d27f8bb76

			/// Ranks each hotel by its [Activations] count relative to all hotels currently visible in the report (respecting slicers). Uses RANKX with ALLSELECTED so ranking updates when filters change, and DENSE ranking so tied hotels share the same rank with no gaps. Rank 1 = the hotel with the most activations. Used to power Top X filtering for hotel visuals.
			measure 'Hotel Activation Rank' =
					VAR m = [People Measure Selection Value]
					RETURN
					    IF
					    (
					        m = "Activations",
					        RANKX
					        (
					            ALLSELECTED ( MPR[HOTEL NAME] ),
					            [Activations],
					            ,
					            DESC,
					            DENSE
					        ),
					        RANKX
					        (
					            ALLSELECTED ( MPR[HOTEL NAME] ),
					            [Enrollments],
					            ,
					            DESC,
					            DENSE
					        )
					    )
				formatString: #,0
				displayFolder: Ranking
				lineageTag: 95cad91e-ba8e-4b53-9656-7172b8ca30a8

			/// Ranks each community by its [Activations] count relative to all communities currently visible in the report (respecting slicers). Uses RANKX with ALLSELECTED so ranking updates when filters change, and DENSE ranking so tied communities share the same rank with no gaps. Rank 1 = the community with the most activations. Used to power Top X filtering for community visuals.
			measure 'Community Activation Rank' =
					VAR m = [People Measure Selection Value]
					RETURN
					    IF
					    (
					        m = "Activations",
					        RANKX
					        (
					            ALLSELECTED ( MPR[COMMUNITY] ),
					            [Activations],
					            ,
					            DESC,
					            DENSE
					        ),
					        RANKX
					        (
					            ALLSELECTED ( MPR[COMMUNITY] ),
					            [Enrollments],
					            ,
					            DESC,
					            DENSE
					        )
					    )
				formatString: #,0
				displayFolder: Ranking
				lineageTag: 7fc7852f-0846-4149-b1a5-e7c1fdfe49bf

			/// Returns 1 if a hotel's activation rank falls within the Top X threshold selected by the user (defaulting to Top 5 if nothing is selected), and 0 otherwise. Used as a visual-level filter on hotel charts to show only the top-ranked hotels. Works in conjunction with Hotel Activation Rank and the Top X slicer.
			measure 'Hotel Show Top X' =
					VAR _TopN =
					    SELECTEDVALUE ( 'Top X'[Top X], 5 )
					RETURN
					    IF
					    (
					        [Hotel Activation Rank] <= _TopN,
					        1,
					        0
					    )
				formatString: #,0
				displayFolder: Top X
				lineageTag: 53b9df13-0f6c-4230-adca-d77b933052e6

			/// Returns 1 if a community's activation rank falls within the Top X threshold selected by the user (defaulting to Top 5 if nothing is selected), and 0 otherwise. Used as a visual-level filter on community charts to show only the top-ranked communities. Works in conjunction with Community Activation Rank and the Top X slicer.
			measure 'Community Show Top X' =
					VAR _TopN =
					    SELECTEDVALUE ( 'Top X'[Top X], 5 )
					RETURN
					    IF
					    (
					        [Community Activation Rank] <= _TopN,
					        1,
					        0
					    )
				formatString: #,0
				displayFolder: Top X
				lineageTag: 427adb65-5a8b-475f-995b-2ad48bc7af63

			/// Builds a dynamic chart title that reflects the current Top X number, the selected measure (e.g. 'Activations'), and the selected dimension (e.g. 'Hotel' or 'Community'). Produces output like 'Top 10 Activations by Hotel'. All three components update automatically based on slicer selections, keeping chart titles in sync with what is displayed.
			measure 'Top X Title' =
					VAR _TopN =
					    SELECTEDVALUE ( 'Top X'[Top X], 5 )
					VAR _Value =
					    [People Measure Selection Value]
					VAR _Dimension =
					    [MPR Dimension Selection Value]
					RETURN
					    "Top " & _TopN & " " & _Value & " by "
					        & _Dimension
				displayFolder: Formatting
				lineageTag: 3f00889a-5992-4249-b54e-992b36cc28ab

			/// The combined count of activations for participants who identified as Non-Binary, Preferred Not to Answer, or a Different Identity. Adds the three individual gender measures together into one rolled-up 'Other' category. Useful for simplified gender breakdowns where these groups are presented as a single segment alongside Male and Female.
			measure 'Gender - Other' =
					[Gender - Non-Binary]
					    + [Gender - Prefers Not to Answer]
					    + [Gender - Different Identity]
				formatString: #,0
				displayFolder: Demographics\Gender
				lineageTag: 766b478b-c9ec-4454-b0e5-9f15ba4e4596

			/// Returns the display name of the single measure currently selected in the People Measure Selection slicer. If exactly one option is selected it returns that name (e.g. 'Activations'); otherwise it returns blank. Used as a helper by other formatting measures such as Top X Title and Measure Selection Title to build dynamic labels.
			measure 'People Measure Selection Value' =
					VAR _Selection =
					    SELECTCOLUMNS
					    (
					        SUMMARIZE
					        (
					            'People Measure Selection',
					            'People Measure Selection'[Name],
					            'People Measure Selection'[Measure]
					        ),
					        "SelectedName", 'People Measure Selection'[Name]
					    )
					RETURN
					    IF
					    (
					        COUNTROWS ( _Selection ) = 1,
					        _Selection
					    )
				displayFolder: Formatting
				lineageTag: 047f2afa-6b63-4603-a6f4-935350db1d9b

			/// Returns the name of the single dimension currently selected in the MPR Dimension Selection slicer (e.g. 'Hotel' or 'Community'). If exactly one option is selected it returns that dimension name; otherwise it returns blank. Used as a helper by Top X Title and Top X Filter to drive dynamic chart titles and filtering logic.
			measure 'MPR Dimension Selection Value' =
					VAR _Selection =
					    SELECTCOLUMNS
					    (
					        SUMMARIZE
					        (
					            'MPR Dimension Selection',
					            'MPR Dimension Selection'[Dimension],
					            'MPR Dimension Selection'[Fields]
					        ),
					        "SelectedName", 'MPR Dimension Selection'[Dimension]
					    )
					RETURN
					    IF
					    (
					        COUNTROWS ( _Selection ) = 1,
					        _Selection
					    )
				displayFolder: Formatting
				lineageTag: 1dcbc5c4-f4ed-4b9c-a646-7702bfefdf07

			/// Routes to the correct Top X show/hide measure based on which dimension is currently selected. If the selected dimension is 'Hotel' it returns [Hotel Show Top X]; otherwise it returns [Community Show Top X]. Apply this as a visual-level filter (keep rows where value = 1) to make a single chart work across both hotel and community views without duplicating visuals.
			measure 'Top X Filter' =
					VAR _Dimension =
					    [MPR Dimension Selection Value]
					RETURN
					    IF
					    (
					        _Dimension = "Hotel",
					        [Hotel Show Top X],
					        [Community Show Top X]
					    )
				formatString: #,0
				displayFolder: Top X
				lineageTag: b7c21f93-e024-4d07-af0e-1b3f773d1376

			/// Generates a dynamic chart title based on whichever capacity measure the user has selected in the Capacity Measure Selection slicer. It checks that exactly one option is selected, retrieves its display name, and appends 'by month' to produce a readable title (e.g. 'Rooms by month'). Returns blank if no single selection is made. Used to automatically label capacity-related visuals based on user slicer choices.
			measure 'Capacity Measure Selection Title' =
					VAR _Selection =
					    SELECTCOLUMNS
					    (
					        SUMMARIZE
					        (
					            'Capacity Measure Selection',
					            'Capacity Measure Selection'[Selection],
					            'Capacity Measure Selection'[Selection Fields]
					        ),
					        "SelectedName", 'Capacity Measure Selection'[Selection]
					    )
					VAR Choice =
					    IF
					    (
					        COUNTROWS ( _Selection ) = 1,
					        _Selection
					    )
					RETURN
					    Choice & " by month"
				displayFolder: Formatting
				lineageTag: ebbd2fee-4c22-4b41-9111-bc8061906710

			/// The total difference in adult counts between two data sources (e.g. HMIS and QuickBase) across all records in the DataIntegrity table, filtered to the current client context. Sums the Adults Variance column and applies the Clients table as a filter to scope results to relevant clients only. A non-zero value indicates mismatches in adult household counts between systems.
			measure 'Adults Variance' =
					CALCULATE
					(
					    SUM ( DataIntegrity[ADULTS VARIANCE] ),
					    Clients
					)
				formatString: #,0
				displayFolder: DataIntegrity
				lineageTag: 7c983b46-44f0-423f-ac00-74b75b7cb27f

			/// The total difference in children counts between two data sources (e.g. HMIS and QuickBase) across all records in the DataIntegrity table, filtered to the current client context. Sums the Children Variance column and applies the Clients table as a filter to scope results to relevant clients only. A non-zero value indicates mismatches in child household counts between systems.
			measure 'Children Variance' =
					CALCULATE
					(
					    SUM ( DataIntegrity[CHILDREN VARIANCE] ),
					    Clients
					)
				formatString: #,0
				displayFolder: DataIntegrity
				lineageTag: 0f056654-3ca8-4415-aae1-d6924c522392

			/// The total difference in overall household size counts between two data sources (e.g. HMIS and QuickBase) across all records in the DataIntegrity table, filtered to the current client context. Sums the Household Variance column and applies the Clients table as a filter to scope results to relevant clients only. A non-zero value indicates mismatches in total household member counts between systems.
			measure 'Household Variance' =
					CALCULATE
					(
					    SUM ( DataIntegrity[HOUSEHOLD VARIANCE] ),
					    Clients
					)
				formatString: #,0
				displayFolder: DataIntegrity
				lineageTag: a8f21b1b-bb2b-4360-9c79-146ab4d6e3d3

			/// The number of DataIntegrity records where at least one household count (adults, children, or total) differs between data sources. Filters the DataIntegrity table to rows flagged Has_Variance = TRUE and counts them using [Records Scanned]. Use this to quickly see how many clients have discrepancies in their census data across systems.
			measure 'Clients with Census Variance' =
					CALCULATE
					(
					    [Records Scanned],
					    DataIntegrity[Has_Variance] = TRUE ( )
					)
				formatString: #,0
				displayFolder: DataIntegrity
				lineageTag: 3a355f17-42b3-45a8-b5c7-b6027f299f7c

			/// The number of DataIntegrity records where a client appears associated with more than one hotel or placement location. Filters to rows flagged Multiple_Locations = TRUE and counts them using [Records Scanned]. Use this to identify clients who may have been placed or recorded at more than one site, which could indicate data entry issues or legitimate transfers.
			measure 'Clients with Multiple Locations' =
					CALCULATE
					(
					    [Records Scanned],
					    DataIntegrity[Multiple_Locations]
					        = TRUE ( )
					)
				formatString: #,0
				displayFolder: DataIntegrity
				lineageTag: 6cbfab29-499e-41b0-8bb5-40bcf052b68d

			/// The total number of rows in the DataIntegrity table within the current filter context. This is the baseline count used by all other DataIntegrity measures (such as Records with Concerns and Clients with Census Variance) as the denominator or starting population. Use it to understand how many client records were evaluated during a data quality check.
			measure 'Records Scanned' = COUNTROWS ( DataIntegrity )
				formatString: #,0
				displayFolder: DataIntegrity
				lineageTag: 4b00be8c-4939-4df6-9025-f8ca968a04c3

			/// The number of DataIntegrity records flagged as having at least one data quality concern (e.g. a variance in household counts or multiple location assignments). Filters to rows where Has_Concerns = TRUE and counts them using [Records Scanned]. Use this as the top-line data quality metric — a high number signals records that need review before reporting.
			measure 'Records with Concerns' =
					CALCULATE
					(
					    [Records Scanned],
					    DataIntegrity[Has_Concerns] = TRUE ( )
					)
				formatString: #,0
				displayFolder: DataIntegrity
				lineageTag: ed8c872d-e742-48aa-86af-da72710d162a

			/// The number of unique client identifiers that appear in MPR but not in HMIS extract. It filters the DataIntegrity table to only rows flagged as 'TRUE' in the MPR Only column and counts the distinct IDs. Use this to identify clients who are included inthe MPR but have not been activated HMIS.
			measure 'MPR Only UIDs' =
					CALCULATE
					(
					    DISTINCTCOUNT
					    (
					        DataIntegrity[UNIQUE IDENTIFIER NUMBER]
					    ),
					    DataIntegrity[MPR Only] = TRUE ( )
					)
				formatString: #,0
				displayFolder: DataIntegrity
				lineageTag: 09dd0d02-0c86-4070-8eec-4316477261bf

			/// Number of unique activations for participants aged 25 to 54. Use this to monitor service reach within this early-adulthood age group.
			measure 'Age - 25 to 54' =
					CALCULATE
					(
					    [Enrollments],
					    MPR[CLIENT AGE] >= 25
					        && MPR[CLIENT AGE] < 55
					)
				formatString: #,0
				displayFolder: Demographics\Age
				lineageTag: 8a20cc60-2636-4a2a-9726-2955a5831551

			/// Counts the number of unique client identifiers in the DataIntegrity table where the client's name differs between HMIS and MPR records. Use this to identify records that may require manual review or client matching validation.
			measure 'Name Mismatch' =
					CALCULATE
					(
					    DISTINCTCOUNT
					    (
					        DataIntegrity[UNIQUE IDENTIFIER NUMBER]
					    ),
					    DataIntegrity[NameMismatchFlag]
					        = "Mismatch"
					)
				formatString: #,0
				displayFolder: DataIntegrity
				lineageTag: 18b93200-ba98-4ee2-94f3-0f732ed4c405

			/// Returns the total number of enrollments across all ethnicity categories while preserving other report filters. Used as the denominator for ethnicity percentage calculations.
			measure 'Enrollments (all ethnicity)' =
					CALCULATE
					(
					    [Enrollments],
					    ALLSELECTED ( MPR[RACE_ETHNICITY] )
					)
				formatString: #,0
				displayFolder: Demographics\Ethnicity
				lineageTag: 9fc499ba-197d-46dc-8863-62ea02777f7a

			/// Calculates the percentage of enrollments represented by the current ethnicity relative to all enrollments in the selected filter context. Returns the result as formatted text for display purposes.
			measure 'Enrollments (Ethnicity Percent to total)' =
					VAR result =
					    DIVIDE
					    (
					        [Enrollments],
					        [Enrollments (all ethnicity)]
					    )
					RETURN
					    "( " & FORMAT ( result, "#,0%" ) & " ) "
				displayFolder: Demographics\Ethnicity
				lineageTag: ddd53eca-213b-4c3e-87c7-e0e6f19fe4e3

			/// The number of hours recorded in Staff Time Sheet
			measure Hours = SUM ( StaffTime[DURATION] )
				formatString: #,0.0
				displayFolder: Staff Activity
				lineageTag: 833a0c4e-5709-48e6-a490-3322c973dbf4

			/// Generates a dynamic title based on the measure selected in the Staff Measure Selection slicer. Returns either 'Activations (from Intake form)' or 'Hours (from Staff Time Sheet)' to keep visuals labeled correctly.
			measure 'Staff Measure Selection Title' =
					VAR _Selection =
					    SELECTCOLUMNS
					    (
					        SUMMARIZE
					        (
					            'Staff Measure Selection',
					            'Staff Measure Selection'[Staff Measure Selection],
					            'Staff Measure Selection'[Staff Measure Selection Fields]
					        ),
					        "SelectedName", 'Staff Measure Selection'[Staff Measure Selection]
					    )
					VAR Choice =
					    IF
					    (
					        COUNTROWS ( _Selection ) = 1,
					        _Selection
					    )
					RETURN
					    IF
					    (
					        Choice = "Activations",
					        "Activations (from Intake form)",
					        "Hours (from Staff Time Sheet)"
					    )
				displayFolder: KPIs
				lineageTag: 57d33c5d-724e-4b0b-bb48-309c4f0746e6

			/// The number records over 12 hours or below 0 hours
			measure 'Hours needing Research' =
					CALCULATE
					(
					    COUNTROWS ( StaffTime ),
					    StaffTime[REVIEW] = "Review"
					)
				formatString: #,0
				displayFolder: Staff Activity
				lineageTag: e1ae9c70-7436-4804-8f7e-e1760bb5b5fc

			/// The total budget amount from the Financials table within the current filter context. Use this as the baseline planned funding value for financial performance analysis.
			measure Budget = SUM ( Financials[BUDGET] )
				formatString: $#,#.#0; ($#,#.#0)
				displayFolder: Financials
				lineageTag: a34631c5-7d78-4dd4-87b3-84e4dfb82ae4

			/// The total invested amount from the Financials table within the current filter context. Represents funds that have already been spent or committed as investments.
			measure Invested = SUM ( Financials[INVESTED] )
				formatString: $#,#.#0; ($#,#.#0)
				displayFolder: Financials
				lineageTag: c52ed30e-a27e-417b-867a-0f262b249531

			/// The total obligated amount from the Financials table within the current filter context. Represents funds that have been legally committed but may not yet be fully expended.
			measure Obligated = SUM ( Financials[OBLIGATED] )
				formatString: $#,#.#0; ($#,#.#0)
				displayFolder: Financials
				lineageTag: 5b97c7d5-77f5-42fd-9275-ec3473125ab2

			/// Calculates actual financial utilization by combining Invested and Obligated amounts. Use this measure to compare total committed spending against budget.
			measure Actual = [Invested] + [Obligated]
				formatString: $#,#.#0; ($#,#.#0)
				displayFolder: Financials
				lineageTag: aa5503d3-593b-4c25-b370-1ba4c5b67bf0

			/// Generates a dynamic SVG-based financial performance card showing actual spending, budget, budget utilization percentage, month-over-month trends, and visual progress toward budget targets. Intended for use in image-enabled visuals.
			measure 'Actual v Budget' =
					VAR _monthYearSort =
					    IF
					    (
					        HASONEVALUE ( dimdate[Month Year] )
					            && ISBLANK ( CALCULATE ( [Actual] ) ),
					        MAXX
					        (
					            FILTER
					            (
					                ALL ( dimdate ),
					                NOT ISBLANK ( CALCULATE ( [Actual] ) )
					                    || NOT ISBLANK ( CALCULATE ( [Budget] ) )
					            ),
					            dimdate[Month Sort]
					        ),
					        IF
					        (
					            HASONEVALUE ( dimdate[Month Year] ),
					            SELECTEDVALUE ( dimdate[Month Sort] ),
					            IF
					            (
					                NOT ISFILTERED ( dimdate[Month Year] ),
					                MAXX
					                (
					                    FILTER
					                    (
					                        ALL ( dimdate ),
					                        NOT ISBLANK ( CALCULATE ( [Actual] ) )
					                            || NOT ISBLANK ( CALCULATE ( [Budget] ) )
					                    ),
					                    dimdate[Month Sort]
					                )
					            )
					        )
					    )
					VAR _monthYear =
					    CALCULATE
					    (
					        MAX ( dimdate[Month Year] ),
					        ALL ( dimdate ),
					        dimdate[Month Sort] = _monthYearSort
					    )
					VAR _actual =
					    CALCULATE
					    (
					        [Actual],
					        ALL ( dimdate ),
					        dimdate[Month Sort] = _monthYearSort
					    )
					VAR _budget =
					    CALCULATE
					    (
					        [Budget],
					        ALL ( dimdate ),
					        dimdate[Month Sort] = _monthYearSort
					    )
					VAR _percent =
					    DIVIDE ( _actual, _budget, 0 )
					VAR _actualPM =
					    CALCULATE
					    (
					        [Actual],
					        ALL ( dimdate ),
					        dimdate[Month Sort] = _monthYearSort - 1
					    )
					VAR _actualPM2 =
					    CALCULATE
					    (
					        [Actual],
					        ALL ( dimdate ),
					        dimdate[Month Sort] = _monthYearSort - 2
					    )
					
					-- Current month increase
					VAR _currentIncrease =
					    IF
					    (
					        ISBLANK ( _actualPM )
					            || ISBLANK ( _actual ),
					        BLANK ( ),
					        _actual - _actualPM
					    )
					
					-- Current month increase percent
					VAR _increasePercent =
					    DIVIDE ( _currentIncrease, _actualPM )
					
					-- Previous month increase
					VAR _priorIncrease =
					    IF
					    (
					        ISBLANK ( _actualPM2 ),
					        BLANK ( ),
					        _actualPM - _actualPM2
					    )
					
					-- Difference between increases
					VAR _momChange =
					    IF
					    (
					        ISBLANK ( _priorIncrease ),
					        BLANK ( ),
					        _currentIncrease - _priorIncrease
					    )
					VAR _momPercent =
					    DIVIDE ( _momChange, _priorIncrease )
					VAR _actualText =
					    "Actual: " & FORMAT ( _actual, "$#,##0" )
					VAR _budgetText =
					    "Budget: " & FORMAT ( _budget, "$#,##0" )
					VAR _percentText = FORMAT ( _percent, "0%" )
					VAR _momArrow =
					    SWITCH
					    (
					        TRUE ( ),
					        ISBLANK ( _momChange ), "",
					        _momChange > 0, "↗ ",
					        _momChange < 0, "↘ ",
					        "• "
					    )
					VAR _momText =
					    "Trend: " & _momArrow
					        & FORMAT ( ABS ( _momChange ), "$#,##0" )
					        & " "
					        & FORMAT ( _momPercent, "0.0%; (0.0%)" )
					
					-- Bar
					VAR _percentClamped =
					    MIN ( MAX ( _percent, 0 ), 1 )
					VAR _barWidth =
					    INT ( 360 * _percentClamped )
					
					-- Colors
					VAR _bgColor = "#C6C6C6"
					VAR _barColor = "#63C17A"
					VAR _momColor =
					    IF
					    (
					        _momChange >= 0,
					        "#57B26C",
					        "#9C0006"
					    )
					RETURN
					    IF
					    (
					        ISBLANK ( _actual ),
					        BLANK ( ),
					        "data:image/svg+xml;utf8,"
					            & "<svg width='590' height='100' viewBox='0 0 590 100' xmlns='http://www.w3.org/2000/svg'>"
					            & "<!-- Title -->"
					            & "<text x='50' y='14' font-size='18' fill='#615E9B' font-weight='bold'>"
					            & _monthYear
					            & "</text>"
					            & "<!-- Actual -->"
					            & "<text x='50' y='34' font-size='13' font-weight='bold'>"
					            & "<tspan fill='#333'>"
					            & _actualText
					            & "</tspan>"
					            & "<tspan fill='#57B26C'>"
					            & " ( ▲ "
					            & FORMAT ( _currentIncrease, "$#,##0" )
					            & "</tspan>"
					            & "<tspan fill='#808080'>"
					            & " | "
					            & "</tspan>"
					            & "<tspan fill='#57B26C'>"
					            & "+"
					            & FORMAT ( _increasePercent, "#,#.0%" )
					            & " )"
					            & "</tspan>"
					            & "</text>"
					            & "<!-- Budget -->"
					            & "<text x='540' y='34' font-size='13' fill='#333' font-weight='bold' text-anchor='end'>"
					            & _budgetText
					            & "</text>"
					            & "<!-- Growth Trend -->"
					            & "<text x='50' y='54' font-size='12' fill='"
					            & _momColor
					            & "' font-weight='bold'>"
					            & _momText
					            & "</text>"
					            & "<!-- Background Bar -->"
					            & "<rect x='50' y='68' width='360' height='16' rx='8' fill='"
					            & _bgColor
					            & "' />"
					            & "<!-- Progress Bar -->"
					            & "<rect x='50' y='68' width='"
					            & INT ( _barWidth )
					            & "' height='14' rx='7' fill='"
					            & _barColor
					            & "' />"
					            & "<!-- Percent -->"
					            & "<text x='540' y='82' font-size='14' text-anchor='end' fill='#615E9B' font-weight='bold'>"
					            & _percentText
					            & " of budget"
					            & "</text>"
					            & "</svg>"
					    )
				displayFolder: Financials
				lineageTag: 097f4387-9867-4eb3-ad98-2eb28facbaf5
				dataCategory: ImageUrl

			/// Calculates actual spending as a percentage of budget using Actual divided by Budget. Use this to monitor budget utilization and financial performance.
			measure 'Percent Actual' = DIVIDE ( [Actual], [Budget], 0 )
				formatString: #,#.#0%; (#,#.#0%)
				displayFolder: Financials
				lineageTag: 45bab033-c7d8-4667-a839-221efb44fab6

			/// Returns an empty string. Used as a formatting or layout helper measure where a blank value is required in a visual or report design.
			measure Blank = ""
				displayFolder: Financials
				lineageTag: bbb4769f-0ff3-4141-bd63-c050d5901b77

			/// Calculates the month-over-month change in Actuals by comparing the selected month's Actual amount to the previous month's Actual amount. Returns the dollar increase or decrease from the prior month and returns blank when either month has no Actual value.
			measure 'Monthly Actual' =
					VAR _monthYearSort =
					    SELECTEDVALUE ( dimdate[Month Sort] )
					VAR _actual =
					    CALCULATE
					    (
					        [Actual],
					        ALL ( dimdate ),
					        dimdate[Month Sort] = _monthYearSort
					    )
					VAR _actualPM =
					    CALCULATE
					    (
					        [Actual],
					        ALL ( dimdate ),
					        dimdate[Month Sort] = _monthYearSort - 1
					    )
					
					-- Current month increase
					VAR _currentIncrease =
					    IF
					    (
					        ISBLANK ( _actual )
					            || ISBLANK ( _actualPM ),
					        BLANK ( ),
					        _actual - _actualPM
					    )
					RETURN
					    _currentIncrease
				formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
				displayFolder: KPIs
				lineageTag: 2ac2a793-26ec-49aa-a287-acef763606f9

				annotation PBI_FormatHint = {"currencyCulture":"en-US"}

			partition _Measures = m
				mode: import
				source =
						let
