expression HMISClients = ```
		let
		  Source = stage_HMIS[[UNIQUE IDENTIFIER NUMBER], [CLIENT], [BIRTH DATE]],
		    RemoveNulls = Table.SelectRows(Source, each ([UNIQUE IDENTIFIER NUMBER] <> null)),
		  CopyClient = Table.AddColumn(RemoveNulls, "CLIENT COPY", each [CLIENT]),
		  SplitClient = Table.SplitColumn(
		      CopyClient, "CLIENT COPY", 
		        Splitter.SplitTextByDelimiter(",", QuoteStyle.Csv), 
		          {"LAST NAME", "FIRST NAME"}), 
		    SourceField = Table.AddColumn(SplitClient, "SOURCE", each "HMIS"),
		    RemoveDuplicates = Table.Distinct(SourceField, {"UNIQUE IDENTIFIER NUMBER"}), 
		    NormalizeFirst = Table.AddColumn(RemoveDuplicates, "First_Cleaned", each fxCleanNames([FIRST NAME], true),type text),
		    NormalizeLast = Table.AddColumn(NormalizeFirst, "Last_Cleaned", each fxCleanNames([LAST NAME], true), type text)
		in
		    NormalizeLast
		```
	lineageTag: cf59712e-a2be-4b9d-8402-c7bb89e1b474
