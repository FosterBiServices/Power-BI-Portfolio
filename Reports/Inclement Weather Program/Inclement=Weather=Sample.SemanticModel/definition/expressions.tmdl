expression fxNormalize = ```
		let
		  Source = (value as nullable text) as nullable text =>
		  let
		    Clean =
		      if value = null then null
		      else Text.Lower(Text.Trim(value)),
		
		    Standardized =
		      if Clean = "y" or Clean = "YES" then "yes"
		      else if Clean = "n" or Clean = "NO" then "no"
		      else if Clean = "m" then "male"
		      else if Clean = "f" then "female"
		      else Clean
		  in
		    Standardized
		in 
		  Source
		```
	lineageTag: b25f042b-3c2a-484f-a16a-a9622b889d42
	queryGroup: functions

