expression NameMisMatches =
		let
			MPRSource =
			#"MPR Clients"[[UNIQUE IDENTIFIER NUMBER],[First_Cleaned], [Last_Cleaned]],
		
			HMISSource =
			HMISClients[[UNIQUE IDENTIFIER NUMBER],[First_Cleaned], [Last_Cleaned]],
		
			RenameHMIS =
			Table.RenameColumns(
				HMISSource,
				{{"UNIQUE IDENTIFIER NUMBER", "UNIQUE IDENTIFIER NUMBER"}}
			),
		
			MergeTables =
			Table.NestedJoin(
				RenameHMIS,
				{"UNIQUE IDENTIFIER NUMBER"},
				MPRSource,
				{"UNIQUE IDENTIFIER NUMBER"},
				"MPR",
				JoinKind.Inner
			),
		    Expanded = Table.ExpandTableColumn(MergeTables, "MPR", {"First_Cleaned", "Last_Cleaned"}, {"MPR.First_Cleaned", "MPR.Last_Cleaned"}),
		    AddFlag = Table.AddColumn(
		        Expanded,
		        "NameMismatchFlag",
		        each
		            if [MPR.First_Cleaned] = null or [MPR.Last_Cleaned] = null then
		                "Missing in HMIS"
		            else if [First_Cleaned] <> [MPR.First_Cleaned]
		                or [Last_Cleaned] <> [MPR.Last_Cleaned] then
		                "Mismatch"
		            else
		                "Match",
		        type text
		    ),
		    KeepMisMatches = Table.SelectRows(AddFlag, each ([NameMismatchFlag] = "Mismatch"))
		in
		    KeepMisMatches
