	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression stage_Clients = ```
		let
		  Source =
		    Table.NestedJoin(
		      HMISClients,
		      {"UNIQUE IDENTIFIER NUMBER"},
		      #"MPR Clients",
		      {"UNIQUE IDENTIFIER NUMBER"},
		      "MPR Clients",
		      JoinKind.FullOuter
		    ),
		    ExpandMPRClients =
		    Table.ExpandTableColumn(
		      Source,
		      "MPR Clients",
		      {
		        "UNIQUE IDENTIFIER NUMBER",
		        "CLIENT",
		        "FIRST NAME",
		        "LAST NAME",
		        "DATE OF BIRTH",
		        "SOURCE"
		      },
		      {
		        "MPR Clients.UNIQUE IDENTIFIER NUMBER",
		        "MPR Clients.CLIENT",
		        "MPR Clients.FIRST NAME",
		        "MPR Clients.LAST NAME",
		        "MPR Clients.DATE OF BIRTH",
		        "MPR Clients.SOURCE"
		      }
		    ),
		
		  // ✅ Explicit mapping
		  ColumnMapping = {
		    {"UNIQUE IDENTIFIER NUMBER", "MPR Clients.UNIQUE IDENTIFIER NUMBER"},
		    {"CLIENT", "MPR Clients.CLIENT"},
		    {"FIRST NAME", "MPR Clients.FIRST NAME"},
		    {"LAST NAME", "MPR Clients.LAST NAME"},
		    {"BIRTH DATE", "MPR Clients.DATE OF BIRTH"},
		    {"SOURCE", "MPR Clients.SOURCE"}
		  },
		
		  AddFixedColumns =
		    List.Accumulate(
		      ColumnMapping,
		      ExpandMPRClients,
		      (state, currentPair) =>
		        let
		          primaryCol = currentPair{0},
		          fallbackCol = currentPair{1}
		        in
		          Table.AddColumn(
		            state,
		            "_" & primaryCol,
		            each
		              let
		                primary =
		                  if Record.HasFields(_, primaryCol)
		                  then Record.Field(_, primaryCol)
		                  else null,
		
		                fallback =
		                  if Record.HasFields(_, fallbackCol)
		                  then Record.Field(_, fallbackCol)
		                  else null
		              in
		                if primary = null or
		                   (Value.Is(primary, type text) and Text.Trim(primary) = "")
		                then fallback
		                else primary,
		            type any
		          )
		    ),
		
		  RemoveOriginalColumns =
		    Table.RemoveColumns(
		      AddFixedColumns,
		      List.Transform(ColumnMapping, each _{0})
		    ),
		
		  RenameFinalColumns =
		    Table.RenameColumns(
		      RemoveOriginalColumns,
		      List.Transform(
		        ColumnMapping,
		        each {"_" & _{0}, _{0}}
		      )
		    ), 
		
		  RemoveMPRColumns =
		  Table.RemoveColumns(
		    RenameFinalColumns,
		    {
		      "MPR Clients.UNIQUE IDENTIFIER NUMBER",
		      "MPR Clients.CLIENT",
		      "MPR Clients.FIRST NAME",
		      "MPR Clients.LAST NAME",
		      "MPR Clients.DATE OF BIRTH",
		      "MPR Clients.SOURCE"
		    }
		  ),
		  TypePairs = {
		    {"CLIENT", type text},
		    {"UNIQUE IDENTIFIER NUMBER", type text},
		    {"BIRTH DATE", type date},
		    {"FIRST NAME", type text},
		    {"LAST NAME", type text}, 
		    {"SOURCE", type text} 
		}, 
		  ExistingCols = Table.ColumnNames(
		    RemoveMPRColumns
		  ), 
		  // Keep type rules only for columns that actually exist
		  TypePairsExistingOnly = List.Select(
		    TypePairs, 
		    each List.Contains(
		      ExistingCols, 
		      _{0}
		    )
		  ), 
		  // Convert those explicit pairs into a lookup record: ColumnName -> Type
		  ExplicitTypeMap = Record.FromList(
		    List.Transform(
		      TypePairsExistingOnly, 
		      each _{1}
		    ), 
		    List.Transform(
		      TypePairsExistingOnly, 
		      each _{0}
		    )
		  ), 
		  // - If we specified a type in ExplicitTypeMap, use it.
		  // - Otherwise default to type text.
		  AllTypePairs = List.Transform(
		    ExistingCols, 
		    (c) => {
		      c, 
		      Record.FieldOrDefault(
		        ExplicitTypeMap, 
		        c, 
		        type text
		      )
		    }
		  ), 
		  // Apply types in one go
		  ChangeTypes
		    = Table.TransformColumnTypes(
		    RemoveMPRColumns, 
		    AllTypePairs
		  ), 
		  AddAge =
		    Table.AddColumn(
		      ChangeTypes,
		      "AGE",
		      each
		        if [BIRTH DATE] = null then
		          null
		        else
		          let
		            today = Date.From(DateTime.LocalNow()),
		            birth = [BIRTH DATE],
		
		            currentYear = Date.Year(today),
		
		            // ✅ Manual leap year logic
		            isLeapYear =
		              (Number.Mod(currentYear, 4) = 0 and Number.Mod(currentYear, 100) <> 0)
		              or Number.Mod(currentYear, 400) = 0,
		
		            yearDiff = currentYear - Date.Year(birth),
		
		            birthdayThisYear =
		              if Date.Month(birth) = 2 and Date.Day(birth) = 29 and not isLeapYear
		              then #date(currentYear, 2, 28)
		              else #date(currentYear, Date.Month(birth), Date.Day(birth)),
		
		            adjustedAge =
		              if today < birthdayThisYear then yearDiff - 1 else yearDiff
		          in
		            adjustedAge,
		      Int64.Type
		    ),
		    #"Added Custom" = Table.AddColumn(AddAge, "Census UID", each [UNIQUE IDENTIFIER NUMBER], type text),
		    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Demographics UID", each [UNIQUE IDENTIFIER NUMBER], type text),
		    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "Community UID", each [UNIQUE IDENTIFIER NUMBER], type text)
		in
		    #"Added Custom2"
		```
	lineageTag: 82c71b62-c368-4ad9-8d5e-556710c8a4d5
	queryGroup: stage

	annotation PBI_NavigationStepName = Navigation

