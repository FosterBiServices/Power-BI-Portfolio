table StaffBridge
	isHidden
	lineageTag: f1f4d9a0-75b8-4d73-8840-1631af9289db

	column 'STAFF NAME'
		dataType: string
		isHidden
		isAvailableInMdx: false
		displayFolder: TableColumns
		lineageTag: 950d2230-1ebd-4376-a642-a959459035cf
		summarizeBy: none
		sourceColumn: STAFF NAME

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition StaffBridge = m
		mode: import
		queryGroup: derived
		source = ```
				let
				  Source = Table.Distinct(stage_Intake[[STAFF NAME]]),
				  TimeSource = Table.Distinct(stage_StaffTime[[NAME]]),
				  RenameTimeColumn = Table.RenameColumns(TimeSource,{{"NAME", "STAFF NAME"}}),
				  Appended = Table.Distinct(Table.Combine({Source, RenameTimeColumn}))
				 
				in
				  Appended
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

