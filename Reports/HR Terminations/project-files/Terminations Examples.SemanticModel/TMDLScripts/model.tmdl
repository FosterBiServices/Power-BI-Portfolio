					VAR _terminationType =
					         SELECTEDVALUE ( 'Terms for TO details'[Termination Type] )
					
					RETURN
					       SWITCH (
					        _terminationType,
					        "Involuntary", "#FDE7E9", 
					        "Voluntary",  "#DFF6DD",
					        "#FFFFFF"
					    )
