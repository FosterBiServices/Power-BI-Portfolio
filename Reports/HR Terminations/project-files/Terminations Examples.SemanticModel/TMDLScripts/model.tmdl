			measure 'Terminations By Month Subtitle' = ```
					
					VAR _avgTerms =
					    AVERAGEX (
					        VALUES ( dimDate[Month Sort] ),
					        [Terms Project Level]
					    )
					
					VAR _cm = 
					    CALCULATE (
					        MAX(dimdate[Month Year]),
					        TOPN (
					            1,
					            VALUES ( dimDate[Month Sort] ),
					            dimDate[Month Sort], DESC
					        )
					    )
					VAR _currentMonth =
					    CALCULATE (
					        [Terms Project Level],
					        TOPN (
					            1,
					            VALUES ( dimDate[Month Sort] ),
					            dimDate[Month Sort], DESC
					        )
					    )
					
					VAR _variance =
					    _currentMonth - _avgTerms
					
					VAR _varianceText =
					    IF (
					        _variance > 0,
					        "+" & FORMAT ( _variance, "#,##0" ),
					    IF (
					        _variance < 0,
					        "-" & FORMAT ( _variance, "#,##0" ), 
					        FORMAT ( _variance, "#,##0" )
					        )
					    )
					
					RETURN
					     _cm 
					        & ": " 
					        & FORMAT ( _currentMonth, "#,##0" )
					        & " | 12-Month Avg: "
					        & FORMAT ( _avgTerms, "#,##0" )
					        & " | "
					        & _varianceText
					
					```
