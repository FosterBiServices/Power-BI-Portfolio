	partition 'Terms for TO details' = m
		mode: import
		source = ```
				let
				
				  // Data Source
				  Source = Excel.Workbook(
				    File.Contents(
				      "C:\Users\Foster\Downloads\Termination-Report-Sample-Data.xlsx"
				    ), 
				    true, 
				    true
				  ), 
				  _data = Source
				    {
				      [
				        Item = "Terminations", 
				        Kind = "Sheet"
				      ]
				    }
				    [Data], 
				  TypePairs = {
				    {"Hire/Rehire Date", type date}, 
				    {"Termination Date", type date}, 
				    {"Seniority Date", type date}, 
				    {"Tenure", type number}, 
				    {
				      "Home Location Zip Code", 
				      Int64.Type
				    }, 
				    {"WORKLOC CODE", Int64.Type}
				  }, 
				  ChangeTypes = fxColumnTyping(
				    _data, 
				    TypePairs
				  )
				
				// Result
				in
				  ChangeTypes
				```

	annotation PBI_NavigationStepName = Navigation

