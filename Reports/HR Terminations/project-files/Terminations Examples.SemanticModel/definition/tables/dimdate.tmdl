	partition dimdate = m
		mode: import
		source = ```
				let
				
				  // Data Source
				  Source = Excel.Workbook(
				    File.Contents(
				      "C:\Users\Foster\Downloads\Termination-Report-Sample-Data.xlsx"
				    ), 
				    true, 
				    true
				  ), 
				  _data = Source
				    {[Item = "dimdate", Kind = "Sheet"]}
				    [Data], 
				  TypePairs = {
				    {"Date", type date}, 
				    {"Calendar Year", Int64.Type}, 
				    {"Fiscal Year", Int64.Type}, 
				    {"Month Number", Int64.Type}, 
				    {"Weekday Number", Int64.Type}, 
				    {"Month Sort", Int64.Type}, 
				    {
				      "Previous Period Index", 
				      Int64.Type
				    }
				  }, 
				  ChangeTypes = fxColumnTyping(
				    _data, 
				    TypePairs
				  )
				
				// Result
				in
