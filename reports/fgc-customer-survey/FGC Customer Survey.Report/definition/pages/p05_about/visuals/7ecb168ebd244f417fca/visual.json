    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Everything here is fictional. Foster Golf Co is a made-up golf retailer, and every response was generated with the Sample Data Maker survey functions (respondents, questions, responses and answers) using a golf question set, seed 2026, Nov 2024 to Oct 2026.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#5B6B80"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Each response has a hidden satisfaction level that its answers, NPS score and comment all lean on, so the numbers agree. Some golfers stop part way, and most skip the comment box. The 12 stores are the same as in the FGC Financials report.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#5B6B80"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "6pt",
                      "fontWeight": "normal",
                      "color": "#5B6B80"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How the dates work",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#01305C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The report only holds completed months and is anchored on the latest one. LCM (last completed month) is that month and Prior month is the one before it. LCQ (last completed quarter) is the latest quarter with all 3 months in. Last 3M, YTD and Last 12M end with the last completed month.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#5B6B80"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The change on each card compares the period with the same months a year earlier (Last 12M: the 12 months before). The second line adds the period just before: the month before for LCM and Prior month, the quarter before for LCQ, the 3 months before for Last 3M, and all of last year for YTD.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#5B6B80"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Under 100 responses in the period or its comparison, the change is shown in grey: too few answers to call it better or worse.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#5B6B80"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Trend charts always show 12 months, ending with the last completed month. Months in the selected period are navy; the rest are grey, for context.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#5B6B80"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
