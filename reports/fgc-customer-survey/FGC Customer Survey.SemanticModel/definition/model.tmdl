model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["_Measures", "Responses", "Answers", "Questions", "Respondents", "Stores", "Date", "Report Dates", "Period", "Time Window", "Comparison", "Trend Metric", "Score Band", "Items per Page", "Page Number"]

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop"]

ref table _Measures
ref table Responses
ref table Answers
ref table Questions
ref table Respondents
ref table Stores
ref table Date
ref table 'Report Dates'
ref table Period
ref table 'Time Window'
ref table Comparison
ref table 'Trend Metric'
ref table 'Score Band'
ref table 'Items per Page'
ref table 'Page Number'

ref cultureInfo en-US

