	/// The summary statement for the row, with numbers from the selected period.
	measure 'Insight Text' = ```
			SWITCH(
			    SELECTEDVALUE( Insights[Insight Key] ),
			    "W1", "Services " & IF( ABS( ( [Services Revenue Period] ) ) >= 1000000, FORMAT( ( [Services Revenue Period] ) / 1000000, "$#,0.0M;-$#,0.0M" ), FORMAT( ( [Services Revenue Period] ) / 1000, "$#,0K;-$#,0K" ) ) & " (" & FORMAT( DIVIDE( [Services Revenue Period], [Services Revenue Period PY] ) - 1, "+0%;-0%" ) & ") and e-commerce " & IF( ABS( ( [E-commerce Revenue Period] ) ) >= 1000000, FORMAT( ( [E-commerce Revenue Period] ) / 1000000, "$#,0.0M;-$#,0.0M" ), FORMAT( ( [E-commerce Revenue Period] ) / 1000, "$#,0K;-$#,0K" ) ) & " (" & FORMAT( DIVIDE( [E-commerce Revenue Period], [E-commerce Revenue Period PY] ) - 1, "+0%;-0%" ) & ") beat budget; simulator bays and fitting drive traffic.",
			    "W3", "Club margin " & FORMAT( [Clubs Margin % Period], "0.0%" ) & " (" & FORMAT( ( [Clubs Margin % Period] - [Clubs Margin % Period PY] ) * 100, "+0.0;-0.0" ) & " pts on last year): fitting sells premium heads. Ball price increase held.",
			    "W4", "Revenue per labor hour " & FORMAT( [Revenue per Labor Hour Period], "$#,0" ) & " (" & FORMAT( DIVIDE( [Revenue per Labor Hour Period], [Revenue per Labor Hour Period PY] ) - 1, "+0.0%;-0.0%" ) & " on last year): the scheduling tool is paying off.",
			    "P1", "EBITDA " & IF( ABS( ( [EBITDA Period] ) ) >= 1000000, FORMAT( ( [EBITDA Period] ) / 1000000, "$#,0.0M;-$#,0.0M" ), FORMAT( ( [EBITDA Period] ) / 1000, "$#,0K;-$#,0K" ) ) & " is " & IF( ABS( ( ABS( [EBITDA vs Budget] ) ) ) >= 1000000, FORMAT( ( ABS( [EBITDA vs Budget] ) ) / 1000000, "$#,0.0M;-$#,0.0M" ), FORMAT( ( ABS( [EBITDA vs Budget] ) ) / 1000, "$#,0K;-$#,0K" ) ) & " " & IF( [EBITDA vs Budget] < 0, "below", "above" ) & " budget: markdowns, freight, POS & ERP overrun, spring marketing.",
			    "P2", "Apparel over-bought: markdown rate " & FORMAT( [Apparel Markdown Rate Period], "0.0%" ) & " vs " & FORMAT( [Apparel Markdown Rate Period Budget], "0.0%" ) & " budget; " & IF( ABS( ( [Apparel Aged Inventory As Of] ) ) >= 1000000, FORMAT( ( [Apparel Aged Inventory As Of] ) / 1000000, "$#,0.0M;-$#,0.0M" ), FORMAT( ( [Apparel Aged Inventory As Of] ) / 1000, "$#,0K;-$#,0K" ) ) & " aged 180+ days. DIO " & FORMAT( [DIO As Of], "0" ) & " days vs " & FORMAT( [DIO PY As Of], "0" ) & " last year.",
			    "P3", "Commercial revenue " & FORMAT( [Commercial Revenue vs Budget %], "+0%;-0%" ) & " vs budget; " & [Largest Decline Customer] & " down " & IF( ABS( ( ABS( [Largest Decline Amount] ) ) ) >= 1000000, FORMAT( ( ABS( [Largest Decline Amount] ) ) / 1000000, "$#,0.0M;-$#,0.0M" ), FORMAT( ( ABS( [Largest Decline Amount] ) ) / 1000, "$#,0K;-$#,0K" ) ) & ". Top 5 accounts = " & FORMAT( [Top 5 Customer Share], "0%" ) & " of commercial.",
			    "P4", "Commercial DSO " & FORMAT( [Commercial DSO As Of], "0" ) & " days (budget " & FORMAT( [Commercial DSO Budget As Of], "0" ) & "); revolver " & IF( ABS( ( [Revolver Balance As Of] ) ) >= 1000000, FORMAT( ( [Revolver Balance As Of] ) / 1000000, "$#,0.0M;-$#,0.0M" ), FORMAT( ( [Revolver Balance As Of] ) / 1000, "$#,0K;-$#,0K" ) ) & ". Liquidity forecast low " & IF( ABS( ( [Lowest Forecast Liquidity] ) ) >= 1000000, FORMAT( ( [Lowest Forecast Liquidity] ) / 1000000, "$#,0.0M;-$#,0.0M" ), FORMAT( ( [Lowest Forecast Liquidity] ) / 1000, "$#,0K;-$#,0K" ) ) & " in " & [Lowest Forecast Liquidity Month] & " vs $7.5M floor.",
			    "A1", "Clear aged apparel by January and cut the Q1 apparel buy 15%: frees about " & IF( ABS( ( [Apparel Inventory As Of] - [Apparel Inventory PY As Of] ) ) >= 1000000, FORMAT( ( [Apparel Inventory As Of] - [Apparel Inventory PY As Of] ) / 1000000, "$#,0.0M;-$#,0.0M" ), FORMAT( ( [Apparel Inventory As Of] - [Apparel Inventory PY As Of] ) / 1000, "$#,0K;-$#,0K" ) ) & " of cash. Owner: Merchandising.",
			    "A2", "Collect " & IF( ABS( ( [Commercial Past Due As Of] ) ) >= 1000000, FORMAT( ( [Commercial Past Due As Of] ) / 1000000, "$#,0.0M;-$#,0.0M" ), FORMAT( ( [Commercial Past Due As Of] ) / 1000, "$#,0K;-$#,0K" ) ) & " of past-due commercial receivables: weekly calls to the top 3 slow payers, credit hold at 90 days. Owner: Controller.",
			    "A3", "Hold Simulator Bays Phase 2 ($1.4M) and freeze POS & ERP scope until forecast liquidity is above $9M. Owner: CFO.",
			    "A4", "Fill open roles at Stores 07 and 11 (overtime " & FORMAT( [Store Overtime % Period], "0.0%" ) & " vs " & FORMAT( [Store Overtime % Period Budget], "0.0%" ) & " budget); account plans for the top 10 accounts. Owners: Store Ops, Commercial."
			)
			```
		isHidden
		displayFolder: 10 Scorecard & Summary
		lineageTag: 62fca1a8-8e08-5ef1-b0ec-9c5d8f8a74c9

	/// Current value of the risk's key indicator.
	measure 'Risk Indicator Value' = ```
			SWITCH(
			    SELECTEDVALUE( 'Risk Register'[Risk ID] ),
			    "R1", [Lowest Forecast Liquidity],
			    "R2", [Top 5 Customer Share],
			    "R3", [Commercial DSO As Of],
			    "R4", [Aged Inventory % As Of],
			    "R5", [Markdown Rate Period],
			    "R6", [Store Overtime % Period],
			    "R7", CALCULATE( [Over Budget %], 'CapEx Projects'[ProjectKey] = "CP-05" ),
			    "R8", [Freight % of E-commerce Revenue Period]
			)
			```
		formatString: #,0.000
		displayFolder: 12 Risks
		lineageTag: dd0d0ded-c2d9-5ff5-b7ec-59c6c974e9a8

	/// The indicator, formatted.
	measure 'Risk Indicator Text' = ```
			VAR _V = [Risk Indicator Value]
			VAR _ID = SELECTEDVALUE( 'Risk Register'[Risk ID] )
			RETURN
			    SWITCH( _ID, "R1", IF( ABS( ( _V ) ) >= 1000000, FORMAT( ( _V ) / 1000000, "$#,0.0M;-$#,0.0M" ), FORMAT( ( _V ) / 1000, "$#,0K;-$#,0K" ) ), "R3", FORMAT( _V, "0" ) & " days", "R7", FORMAT( _V, "+0%;-0%" ), FORMAT( _V, "0.0%" ) )
			```
		isHidden
		displayFolder: 12 Risks
		lineageTag: 6032a599-01c7-517f-b906-1380a8bdff6e

	/// Where the risk turns red.
	measure 'Risk Threshold Text' = ```
			VAR _ID = SELECTEDVALUE( 'Risk Register'[Risk ID] )
			VAR _R = SELECTEDVALUE( 'Risk Register'[Red At] )
			RETURN
			    "Red " & IF( SELECTEDVALUE( 'Risk Register'[Higher Is Worse] ) = 1, "above ", "below " ) &
			    SWITCH( _ID, "R1", IF( ABS( ( _R ) ) >= 1000000, FORMAT( ( _R ) / 1000000, "$#,0.0M;-$#,0.0M" ), FORMAT( ( _R ) / 1000, "$#,0K;-$#,0K" ) ), "R3", FORMAT( _R, "0" ) & " days", "R7", FORMAT( _R, "0%" ), FORMAT( _R, "0.0%" ) )
			```
		isHidden
		displayFolder: 12 Risks
		lineageTag: d108b96c-60a9-5ac8-acd1-fd155a1da6ad

	/// 3 red, 2 amber, 1 green.
	measure 'Risk Level' = ```
			VAR _V = [Risk Indicator Value]
			VAR _A = SELECTEDVALUE( 'Risk Register'[Amber At] )
			VAR _R = SELECTEDVALUE( 'Risk Register'[Red At] )
			VAR _Worse = SELECTEDVALUE( 'Risk Register'[Higher Is Worse] ) = 1
			RETURN
			    IF( ISBLANK( _V ), BLANK(), IF( _Worse, SWITCH( TRUE(), _V >= _R, 3, _V >= _A, 2, 1 ), SWITCH( TRUE(), _V <= _R, 3, _V <= _A, 2, 1 ) ) )
			```
		formatString: 0
		displayFolder: 12 Risks
		lineageTag: a11257b4-8936-5acb-a317-03c673bed35f

	/// Likelihood 1-5 from the indicator: 5 well past red, 4 red, 3 amber, 2 green.
	measure 'Risk Likelihood' = ```
			VAR _V = [Risk Indicator Value]
			VAR _R = SELECTEDVALUE( 'Risk Register'[Red At] )
			VAR _Worse = SELECTEDVALUE( 'Risk Register'[Higher Is Worse] ) = 1
			VAR _Far = IF( _Worse, _V >= _R * 1.2, _V <= _R * 0.9 )
			RETURN
			    SWITCH( [Risk Level], 3, IF( _Far, 5, 4 ), 2, 3, 1, 2 )
			```
		formatString: 0
		displayFolder: 12 Risks
		lineageTag: bdeb2933-b001-5615-ace6-2ed1c4f30cff

	/// Act now, Watch or On track.
