	/// Size of the revolving credit facility.
	measure 'Revolver Limit' = 15000000
		formatString: $#,0;($#,0)
		displayFolder: 4 Balance Sheet & Working Capital
		lineageTag: 75ea9451-3594-5018-aea9-21385dfdf5e2

	/// Minimum liquidity (cash plus undrawn revolver) the lenders require.
	measure 'Liquidity Floor' = 7500000
		formatString: $#,0;($#,0)
		displayFolder: 4 Balance Sheet & Working Capital
		lineageTag: 106fade7-26a6-5e5e-bfb0-3a08442f7d8c

	/// Policy limit for the top-5 commercial accounts as a share of commercial revenue.
	measure 'Concentration Limit' = 0.45
		formatString: 0.0%;-0.0%
		displayFolder: 4 Balance Sheet & Working Capital
		lineageTag: ee9788ed-b622-51f5-b1bb-e4331956b709

	/// Cash at the end of the period.
	measure 'Cash Balance' = CALCULATE( SUM( 'General Ledger'[Signed Amount] ), Accounts[AccountKey] IN { 1010 }, LASTDATE( 'Date'[Date] ) )
		formatString: $#,0;($#,0)
		displayFolder: 4 Balance Sheet & Working Capital
		lineageTag: 54ae3b1a-674b-5f42-aece-53e39158ed8d

	/// Accounts receivable at the end of the period.
	measure 'Receivables Balance' = CALCULATE( SUM( 'General Ledger'[Signed Amount] ), Accounts[AccountKey] IN { 1100 }, LASTDATE( 'Date'[Date] ) )
		formatString: $#,0;($#,0)
		displayFolder: 4 Balance Sheet & Working Capital
		lineageTag: 0cfcdad1-a1c8-5da8-a867-7837683454f0

	/// Accounts payable at the end of the period.
	measure 'Payables Balance' = CALCULATE( SUM( 'General Ledger'[Signed Amount] ), Accounts[AccountKey] IN { 2010 }, LASTDATE( 'Date'[Date] ) )
		formatString: $#,0;($#,0)
		displayFolder: 4 Balance Sheet & Working Capital
		lineageTag: 201c71ee-75a5-5cbd-9b0f-f770da8ed5a2

	/// Revolver drawn at the end of the period.
	measure 'Revolver Balance' = CALCULATE( SUM( 'General Ledger'[Signed Amount] ), Accounts[AccountKey] IN { 2300 }, LASTDATE( 'Date'[Date] ) )
		formatString: $#,0;($#,0)
		displayFolder: 4 Balance Sheet & Working Capital
		lineageTag: 488480d7-bb89-54d6-9979-91cbbcec74dc

	/// Cash plus the undrawn revolver.
	measure Liquidity = [Cash Balance] + [Revolver Limit] - [Revolver Balance]
		formatString: $#,0;($#,0)
		displayFolder: 4 Balance Sheet & Working Capital
		lineageTag: aefb73e6-3db2-52e8-88a7-82e4e231320c

	/// Commercial accounts receivable at the end of the period (from the aging).
	measure 'Commercial Receivables' = CALCULATE( SUM( 'AR Aging'[Amount] ), LASTDATE( 'Date'[Date] ) )
		formatString: $#,0;($#,0)
		displayFolder: 4 Balance Sheet & Working Capital
		lineageTag: 8e1ab1a1-6301-5805-b6dc-958f079c1212

	/// Commercial receivables past due (any bucket after Current) at the last month end.
	measure 'Commercial Past Due As Of' = CALCULATE( [Commercial Receivables As Of], 'Aging Buckets'[Aging Bucket] <> "Current" )
		formatString: $#,0;($#,0)
		displayFolder: 4 Balance Sheet & Working Capital
		lineageTag: 1048c728-6b96-5aaf-8e3d-9e4dc1288342

	/// Inventory on hand under 180 days at the last month end.
	measure 'Current Inventory As Of' = [Inventory Detail As Of] - [Aged Inventory As Of]
		formatString: $#,0;($#,0)
		displayFolder: 4 Balance Sheet & Working Capital
		lineageTag: 929fcffb-7513-5f03-91d5-92cc55d1cadf

	/// Rank of the account by past-due commercial receivables.
	measure 'Customer Past Due Rank' = ```
			IF( ISBLANK( [Commercial Past Due As Of] ) || NOT HASONEVALUE( Customers[Customer] ), BLANK(),
			    RANKX( FILTER( ALL( Customers[Customer] ), NOT ISBLANK( [Commercial Past Due As Of] ) ), [Commercial Past Due As Of], , DESC, Dense ) )
			```
		formatString: 0
		displayFolder: 4 Balance Sheet & Working Capital
		lineageTag: 3dc2bf01-f2fa-56b9-a1ea-73b6d6a5bba7

