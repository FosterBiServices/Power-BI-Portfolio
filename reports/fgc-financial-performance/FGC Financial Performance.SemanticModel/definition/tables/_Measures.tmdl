	/// Yearly benefit in the business case.
	measure 'Annual Benefit' = SUM( 'CapEx Projects'[Annual Benefit] )
		formatString: $#,0;($#,0)
		displayFolder: 7 CapEx
		lineageTag: 3363c25b-4447-5b27-acda-b932d0584ce4

	/// Spent up to the last month end with actuals.
	measure 'Spent to Date' = ```
			VAR _AsOf = [As Of Date]
			RETURN
			    CALCULATE( [CapEx Spend], 'Scenario'[Scenario] = "Actual", 'Date'[Date] <= _AsOf )
			```
		formatString: $#,0;($#,0)
		displayFolder: 7 CapEx
		lineageTag: 471a1caa-2465-5774-8d21-b2ac28cfb70e

	/// Forecast spend still to come.
	measure 'Forecast to Complete' = ```
			VAR _AsOf = [As Of Date]
			RETURN
			    CALCULATE( [CapEx Spend], 'Scenario'[Scenario] = "Forecast", 'Date'[Date] > _AsOf )
			```
		formatString: $#,0;($#,0)
		displayFolder: 7 CapEx
		lineageTag: bbc8fd5c-f39f-50ee-9692-0b0620b9256e

	/// Spent to date plus forecast to complete.
	measure 'Forecast at Completion' = [Spent to Date] + [Forecast to Complete]
		formatString: $#,0;($#,0)
		displayFolder: 7 CapEx
		lineageTag: e15018ec-57c1-5b51-9b02-b4b4433c7bfc

	/// Forecast at completion over (under) the approved budget.
	measure 'Over Budget %' = DIVIDE( [Forecast at Completion], [Approved Budget] ) - 1
		formatString: +0%;-0%;0%
		displayFolder: 7 CapEx
		lineageTag: a5df9ef1-b4d5-5335-b0ca-c317963b868c

	/// Actual completion, or the last month with forecast spend.
	measure 'Completion Date' = ```
			VAR _Actual = MAX( 'CapEx Projects'[Actual Completion] )
			VAR _Last = CALCULATE( MAX( 'CapEx Spend'[Date] ), 'Scenario'[Scenario] IN { "Actual", "Forecast" } )
			RETURN
			    IF( NOT ISBLANK( _Actual ), _Actual, _Last )
			```
		formatString: mmm yyyy
		displayFolder: 7 CapEx
		lineageTag: 2e765a10-52cb-5a0d-8933-c82a58b09f68

	/// Months late (positive) or early.
	measure 'Schedule Slip (Months)' = ```
			VAR _Plan = MAX( 'CapEx Projects'[Planned Completion] )
			VAR _Done = [Completion Date]
			RETURN
			    IF( NOT ISBLANK( _Plan ) && NOT ISBLANK( _Done ), ( YEAR( _Done ) - YEAR( _Plan ) ) * 12 + MONTH( _Done ) - MONTH( _Plan ) )
			```
		formatString: +0;-0;0
		displayFolder: 7 CapEx
		lineageTag: c1431ec3-ed3f-5517-8307-cdb95ef64e90

	/// Complete, In progress or Planned.
	measure 'Project Status' = ```
			VAR _AsOf = [As Of Date]
			RETURN
			    SWITCH(
			        TRUE(),
			        NOT ISBLANK( MAX( 'CapEx Projects'[Actual Completion] ) ), "Complete",
			        [Spent to Date] > 0, "In progress",
			        "Planned"
			    )
			```
		isHidden
		displayFolder: 7 CapEx
		lineageTag: 30460ef5-1287-5adb-83e6-a15a134d0cb5

	/// Forecast cost over the yearly benefit.
	measure 'Payback (Years)' = DIVIDE( [Forecast at Completion], [Annual Benefit] )
		formatString: 0.0
		displayFolder: 7 CapEx
		lineageTag: cba603f4-9ce8-533f-837b-6b5b0b3b1fcd

	/// On track, Watch (over budget by 2%+ or a month late) or Act now (10%+ over or 3+ months late).
	measure 'Project RAG' = ```
			VAR _Over = [Over Budget %]
			VAR _Slip = [Schedule Slip (Months)]
			RETURN
			    SWITCH( TRUE(), _Over > 0.10 || _Slip >= 3, "Act now", _Over > 0.02 || _Slip >= 1, "Watch", "On track" )
			```
		isHidden
		displayFolder: 7 CapEx
		lineageTag: a1f144d5-dad1-54e6-a36d-47292113219d

	/// Status color.
	measure 'Project RAG Color' = SWITCH( [Project RAG], "Act now", "#9C0006", "Watch", "#9C5700", "#006100" )
		isHidden
		displayFolder: 9 Visual Helpers
		lineageTag: 02b2975c-38a1-5c2b-85b8-280a40696633

	/// Capital spend so far this year (actual).
	measure 'CapEx Cumulative Actual' = ```
			VAR _AsOf = [As Of Date]
			RETURN
			    IF( MAX( 'Date'[Date] ) <= _AsOf, CALCULATE( [CapEx Spend Actual], DATESYTD( 'Date'[Date] ) ) )
			```
		formatString: $#,0;($#,0)
		displayFolder: 7 CapEx
		lineageTag: 4bdca38b-e55b-50c4-826e-7dea92fb046b

	/// Capital spend so far this year (budget).
