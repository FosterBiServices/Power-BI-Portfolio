	/// How far the KPI is on the good side of target (negative = behind): share of target for money and rates, absolute for % and days.
	measure 'KPI Gap' = ```
			VAR _A = [KPI Actual]
			VAR _T = [KPI Target]
			VAR _Gap = IF( [KPI Higher Is Better] = 1, _A - _T, _T - _A )
			RETURN
			    IF( [KPI Kind] IN { "money", "rate" }, DIVIDE( _Gap, ABS( _T ) ), _Gap )
			```
		formatString: 0.000
		displayFolder: 10 Scorecard & Summary
		lineageTag: eb1b0b74-5f22-5715-a40d-1622046efe64

	/// On track (at or better than target), Watch (just behind) or Act now.
	measure 'KPI Status' = ```
			VAR _G = [KPI Gap]
			RETURN
			    IF( ISBLANK( [KPI Actual] ), BLANK(), SWITCH( TRUE(), _G >= 0, "On track", _G >= - [KPI Tolerance], "Watch", "Act now" ) )
			```
