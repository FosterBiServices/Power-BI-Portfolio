	/// How far from target still counts as Watch rather than Act now (share of target for money and rates; points for % KPIs; days).
	measure 'KPI Tolerance' = ```
			SWITCH(
			        SELECTEDVALUE( Scorecard[KPI] ),
			        "Net revenue", 0.01,
			        "Gross margin %", 0.003,
			        "EBITDA", 0.05,
			        "EBITDA margin %", 0.005,
			        "Labor % of revenue", 0.003,
			        "Revenue per labor hour", 0.02,
			        "Markdown rate", 0.003,
