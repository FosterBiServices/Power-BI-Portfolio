/// Every measure in the report, in display folders by subject. Families follow one pattern: X Actual / Budget / Forecast (by month), X Period / Period Budget / Period PY (the selected period), X vs Budget / vs PY, X FY Outlook (actual to date plus forecast).
table _Measures
	lineageTag: 35f04f4c-eead-5b83-bef7-3ad6cb11241d

	/// Last month end with actuals. Every period ends here.
	measure 'As Of Date' = CALCULATE( MAX( Sales[Date] ), 'Scenario'[Scenario] = "Actual", REMOVEFILTERS() )
		formatString: mmm d, yyyy
		displayFolder: 0 Dates & Period
		lineageTag: 7a9b4868-42c3-5847-8f62-d29609ce12f8

	/// The period picked on the Period buttons (YTD when none).
	measure 'Period Selected' = SELECTEDVALUE( Period[Period], "YTD" )
		isHidden
		displayFolder: 0 Dates & Period
		lineageTag: 6c9b3d11-d687-56e4-b3fe-6b0afdda2173

	/// Last day of the selected period: the last month end with actuals.
	measure 'Window End' = [As Of Date]
		formatString: Short Date
		displayFolder: 0 Dates & Period
		lineageTag: 44ea5b11-c9e7-5d1d-84d7-5fbb045df872

	/// First day of the selected period.
	measure 'Window Start' = ```
			VAR _AsOf = [As Of Date]
			VAR _MonthStart = DATE( YEAR( _AsOf ), MONTH( _AsOf ), 1 )
			RETURN
			    SWITCH(
			        [Period Selected],
			        "Month", _MonthStart,
			        "QTD", DATE( YEAR( _AsOf ), ( QUARTER( _AsOf ) - 1 ) * 3 + 1, 1 ),
			        "Last 12M", EDATE( _MonthStart, -11 ),
			        DATE( YEAR( _AsOf ), 1, 1 )
			    )
			```
		formatString: Short Date
		displayFolder: 0 Dates & Period
		lineageTag: 727e7035-098d-522c-9412-785b361a503e

	/// First day of the current fiscal (calendar) year.
	measure 'FY Start' = DATE( YEAR( [As Of Date] ), 1, 1 )
		formatString: Short Date
		displayFolder: 0 Dates & Period
		lineageTag: 79ea2c69-9eba-5682-9e8b-9cee7695e9a3

	/// Last day of the current fiscal (calendar) year.
	measure 'FY End' = DATE( YEAR( [As Of Date] ), 12, 31 )
		formatString: Short Date
		displayFolder: 0 Dates & Period
		lineageTag: 932d3c00-29d3-55e8-9955-8fb870d03451

	/// Sales before discounts and markdowns.
	measure 'Gross Sales' = CALCULATE( SUM( 'General Ledger'[Amount] ), Accounts[Line] = "Gross Sales" )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 5e303851-9345-5ef7-8f47-20bea5a444ad

	/// Discounts, markdowns and trade discounts.
	measure 'Discounts & Markdowns' = CALCULATE( SUM( 'General Ledger'[Amount] ), Accounts[Line] = "Discounts & Markdowns" )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 7fccf539-4baa-5817-a880-6c6939f33574

	/// Gross sales less discounts and markdowns.
	measure 'Net Revenue' = [Gross Sales] - [Discounts & Markdowns]
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 2777e802-9140-5249-b4ee-b70951ff02df

	/// Freight and fulfillment, shrink and obsolescence.
	measure 'Freight & Obsolescence' = CALCULATE( SUM( 'General Ledger'[Amount] ), Accounts[AccountKey] IN { 5020, 5030 } )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: bef5c0b4-36c1-59f5-8b3f-476ba0d3dc80

	/// Product cost, freight, shrink and obsolescence, service delivery cost.
	measure 'Cost of Sales' = CALCULATE( SUM( 'General Ledger'[Amount] ), Accounts[Section] = "Cost of Sales" )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 55899035-a20f-554c-b4c1-bf2718ae87ac

	/// Net revenue less cost of sales.
	measure 'Gross Margin' = [Net Revenue] - [Cost of Sales]
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: d42e23a2-5636-5b70-b7ec-ca68581408aa

	/// Wages, salaries, benefits and payroll taxes.
	measure 'Labor Cost' = CALCULATE( SUM( 'General Ledger'[Amount] ), Accounts[Line] = "Labor" )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 872a6d47-7203-55b6-afa7-718052da9919

	/// Rent, occupancy and utilities.
	measure 'Occupancy Cost' = CALCULATE( SUM( 'General Ledger'[Amount] ), Accounts[Line] = "Occupancy" )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: cebd60ff-2f3f-587e-a97e-a6fded80c794

	/// Marketing.
	measure 'Marketing Cost' = CALCULATE( SUM( 'General Ledger'[Amount] ), Accounts[Line] = "Marketing" )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 6fdd816e-4881-5fa5-b23e-ecd8cd4a0674

	/// Technology, card fees and other G&A.
	measure 'Technology & Admin Cost' = CALCULATE( SUM( 'General Ledger'[Amount] ), Accounts[Line] = "Technology & Admin" )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 2e731286-4807-504d-9345-b014befd197a

	/// Labor, occupancy, marketing, technology and admin.
	measure 'Operating Expenses' = CALCULATE( SUM( 'General Ledger'[Amount] ), Accounts[Section] = "Operating Expenses" )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 76a22fee-e4fe-54db-9fde-f23174404cb1

	/// Earnings before interest, tax, depreciation and amortization.
	measure EBITDA = [Gross Margin] - [Operating Expenses]
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 07c3b182-a70e-5b32-b6ea-3e2b03a2dbd5

	/// Gross margin as a share of net revenue.
	measure 'Gross Margin %' = DIVIDE( [Gross Margin], [Net Revenue] )
		formatString: 0.0%;-0.0%
		displayFolder: 1 Income Statement
		lineageTag: a9df954a-4db7-56c5-aa63-5c355e423bb3

	/// EBITDA as a share of net revenue.
	measure 'EBITDA Margin %' = DIVIDE( [EBITDA], [Net Revenue] )
		formatString: 0.0%;-0.0%
		displayFolder: 1 Income Statement
		lineageTag: 1606ddf1-85ea-558c-96b9-90b3a5e3bb64

	/// Labor cost as a share of net revenue.
	measure 'Labor % of Revenue' = DIVIDE( [Labor Cost], [Net Revenue] )
		formatString: 0.0%;-0.0%
		displayFolder: 1 Income Statement
		lineageTag: 13d6b7a1-d9a2-521a-99d6-24e29acc770f

	/// Discounts and markdowns as a share of gross sales.
	measure 'Markdown Rate' = DIVIDE( [Discounts & Markdowns], [Gross Sales] )
		formatString: 0.0%;-0.0%
		displayFolder: 1 Income Statement
		lineageTag: 46d161cf-b9f6-546d-8639-1ca056434447

	/// E-commerce freight and fulfillment as a share of e-commerce revenue.
	measure 'Freight % of E-commerce Revenue' = CALCULATE( DIVIDE( CALCULATE( SUM( 'General Ledger'[Amount] ), Accounts[AccountKey] = 5020 ), [Net Revenue] ), KEEPFILTERS( Locations[Location Type] = "E-commerce" ) )
		formatString: 0.0%;-0.0%
		displayFolder: 1 Income Statement
		lineageTag: 69970d0d-7dff-5efb-9515-6ab4f42f6d33

	/// Net sales from the sales detail (ties to net revenue).
	measure 'Sales Net' = SUM( Sales[Net Sales] )
		formatString: $#,0;($#,0)
		displayFolder: 2 Sales Detail
		lineageTag: 6383b13e-3a38-5f8d-bd4f-fe33556cae6d

	/// Gross sales from the sales detail.
	measure 'Sales Gross' = SUM( Sales[Gross Sales] )
		formatString: $#,0;($#,0)
		displayFolder: 2 Sales Detail
		lineageTag: 1b646d6c-29d5-5b01-8c7d-2c956321eb72

	/// Discounts from the sales detail.
	measure 'Sales Discounts' = SUM( Sales[Discounts] )
		formatString: $#,0;($#,0)
		displayFolder: 2 Sales Detail
		lineageTag: 79387bf6-1e54-5568-929f-7c34687f3232

	/// Units sold.
	measure 'Sales Units' = SUM( Sales[Units] )
		formatString: #,0
		displayFolder: 2 Sales Detail
		lineageTag: c0dd71c5-38d8-54a0-9960-86f129c7a088

	/// Product and service cost from the sales detail.
	measure 'Sales Cost' = SUM( Sales[Cost of Sales] )
		formatString: $#,0;($#,0)
		displayFolder: 2 Sales Detail
		lineageTag: fd0afd5e-7f1b-5d65-938b-8a80379f8258

	/// Net sales less product cost: the margin a product line earns before freight and shrink.
	measure 'Product Margin' = [Sales Net] - [Sales Cost]
		formatString: $#,0;($#,0)
		displayFolder: 2 Sales Detail
		lineageTag: aa7e4f35-0b9b-5c2d-bff8-721cf0381628

	/// Product margin as a share of net sales.
	measure 'Product Margin %' = DIVIDE( [Product Margin], [Sales Net] )
		formatString: 0.0%;-0.0%
		displayFolder: 2 Sales Detail
		lineageTag: 8edc1495-8f63-54bf-b072-74fa35770d13

	/// Discounts as a share of gross sales, from the sales detail.
	measure 'Product Markdown Rate' = DIVIDE( [Sales Discounts], [Sales Gross] )
		formatString: 0.0%;-0.0%
		displayFolder: 2 Sales Detail
		lineageTag: 381a5c9c-3ca7-5b4e-a986-50f49bb9292e

	/// Hours paid.
	measure 'Labor Hours' = SUM( Labor[Hours] )
		formatString: #,0
		displayFolder: 3 Labor
		lineageTag: 8f20ed17-aa74-51d8-a247-0235b30c506e

	/// Overtime hours paid.
	measure 'Overtime Hours' = SUM( Labor[Overtime Hours] )
		formatString: #,0
		displayFolder: 3 Labor
		lineageTag: b6b314ee-9aac-5504-95e5-a16d4daac609

	/// Overtime as a share of hours.
	measure 'Overtime %' = DIVIDE( [Overtime Hours], [Labor Hours] )
		formatString: 0.0%;-0.0%
		displayFolder: 3 Labor
		lineageTag: ca243914-8515-54d5-a8ee-ed655f9b2c24

	/// Net revenue per hour worked in stores and e-commerce fulfillment.
	measure 'Revenue per Labor Hour' = ```
			CALCULATE(
			    DIVIDE( [Net Revenue], [Labor Hours] ),
			    KEEPFILTERS( Locations[Location Type] IN { "Store", "E-commerce" } )
			)
			```
		formatString: $#,0
		displayFolder: 3 Labor
		lineageTag: e32a77dd-9f54-5023-900e-6b004067062d

	/// Overtime as a share of store hours.
	measure 'Store Overtime %' = CALCULATE( [Overtime %], KEEPFILTERS( Locations[Location Type] = "Store" ) )
		formatString: 0.0%;-0.0%
		displayFolder: 3 Labor
		lineageTag: 7f189a80-623b-5443-a286-104ba5b61702

	/// Cash in (positive) or out (negative).
	measure 'Cash Flow Amount' = SUM( 'Cash Flow'[Amount] )
		formatString: $#,0;($#,0)
		displayFolder: 5 Cash Flow
		lineageTag: ee5f28a0-99f0-569a-8bcb-3e5f20ec3c70

	/// Cash from operations: net income, non-cash costs and working capital.
	measure 'Operating Cash Flow' = CALCULATE( [Cash Flow Amount], 'Cash Flow Lines'[Section] = "Operating" )
		formatString: $#,0;($#,0)
		displayFolder: 5 Cash Flow
		lineageTag: 6e2bb1ff-cd50-5bd8-86cc-687447073aad

	/// Capital expenditures.
	measure 'Investing Cash Flow' = CALCULATE( [Cash Flow Amount], 'Cash Flow Lines'[Section] = "Investing" )
		formatString: $#,0;($#,0)
		displayFolder: 5 Cash Flow
		lineageTag: 23ee568c-6c10-5e61-9f96-e8bab0d638eb

	/// Cash from operations less capital expenditures.
	measure 'Free Cash Flow' = [Operating Cash Flow] + [Investing Cash Flow]
		formatString: $#,0;($#,0)
		displayFolder: 5 Cash Flow
		lineageTag: 120380dc-9990-52db-89cc-f96218a3cc80

	/// Capital spend.
	measure 'CapEx Spend' = SUM( 'CapEx Spend'[Amount] )
		formatString: $#,0;($#,0)
		displayFolder: 7 CapEx
		lineageTag: ce0422df-a6f1-570d-bff1-f9a2e643aeba

	/// Net Revenue. Actual.
	measure 'Net Revenue Actual' = CALCULATE( [Net Revenue], 'Scenario'[Scenario] = "Actual" )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 67e6cc6f-7c02-5654-812c-939e06c71c2f

	/// Net Revenue. Budget.
	measure 'Net Revenue Budget' = CALCULATE( [Net Revenue], 'Scenario'[Scenario] = "Budget" )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: b1c513ca-07db-5977-b7cb-699bf76b9370

	/// Net Revenue. Forecast.
	measure 'Net Revenue Forecast' = CALCULATE( [Net Revenue], 'Scenario'[Scenario] = "Forecast" )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: cd5a1ed4-3756-56c4-8199-9f92f460880d

	/// Net Revenue. Actual for the selected period.
	measure 'Net Revenue Period' = CALCULATE( [Net Revenue], 'Scenario'[Scenario] = "Actual", DATESBETWEEN( 'Date'[Date], [Window Start], [Window End] ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 0d9f9780-eebd-527b-a82e-0b13556bbfcc

	/// Net Revenue. Budget for the selected period.
	measure 'Net Revenue Period Budget' = CALCULATE( [Net Revenue], 'Scenario'[Scenario] = "Budget", DATESBETWEEN( 'Date'[Date], [Window Start], [Window End] ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 055314c2-6f87-5ca4-9b7d-ac31ccf32f5f

	/// Net Revenue. Actual for the same months a year earlier.
	measure 'Net Revenue Period PY' = CALCULATE( [Net Revenue], 'Scenario'[Scenario] = "Actual", DATESBETWEEN( 'Date'[Date], EDATE( [Window Start], -12 ), EOMONTH( [Window End], -12 ) ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 39d9e8d8-2eb4-5fe0-9e12-4335bbbcb6fb

	/// Net Revenue. Actual less budget for the selected period.
	measure 'Net Revenue vs Budget' = [Net Revenue Period] - [Net Revenue Period Budget]
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 5dec6b5a-9c1c-5443-8db6-72fa0f7beb37

	/// Net Revenue. Full year: actual to date plus forecast for the rest of the year.
	measure 'Net Revenue FY Outlook' = ```
			VAR _AsOf = [As Of Date]
			RETURN
			    CALCULATE( [Net Revenue], 'Scenario'[Scenario] = "Actual", DATESBETWEEN( 'Date'[Date], [FY Start], _AsOf ) )
			        + CALCULATE( [Net Revenue], 'Scenario'[Scenario] = "Forecast", DATESBETWEEN( 'Date'[Date], _AsOf + 1, [FY End] ) )
			```
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 49102f31-37da-5777-8151-4661689d43e7

	/// Net Revenue. Full-year budget.
	measure 'Net Revenue FY Budget' = CALCULATE( [Net Revenue], 'Scenario'[Scenario] = "Budget", DATESBETWEEN( 'Date'[Date], [FY Start], [FY End] ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: fc13f3e2-e261-5d96-a6dd-e8ab80aa2981

	/// Net Revenue. Forecast for next year.
	measure 'Net Revenue Next FY Forecast' = CALCULATE( [Net Revenue], 'Scenario'[Scenario] = "Forecast", DATESBETWEEN( 'Date'[Date], [FY End] + 1, EDATE( [FY End], 12 ) ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 6d86b739-435c-574d-8b6e-5ac27a1ba3cc

	/// Net Revenue. Actual, for trend lines (blank after the last month of actuals).
	measure 'Net Revenue Actual Line' = IF( MAX( 'Date'[Date] ) <= [As Of Date], [Net Revenue Actual] )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 64e2dc5d-92a6-5c43-8926-d4ad00adc17c

	/// Net Revenue. Forecast, for trend lines (starts at the last month of actuals so the lines join).
	measure 'Net Revenue Forecast Line' = ```
			VAR _D = MAX( 'Date'[Date] )
			VAR _AsOf = [As Of Date]
			RETURN
			    SWITCH( TRUE(), _D = _AsOf, [Net Revenue Actual], _D > _AsOf, [Net Revenue Forecast] )
			```
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: bdf6a38d-bc59-5539-9ec4-556c7de0229d

	/// Net Revenue. Budget, for trend lines.
	measure 'Net Revenue Budget Line' = IF( NOT ISBLANK( [Net Revenue Budget] ), [Net Revenue Budget] )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 7986cd09-1dda-50bb-8a03-409516894345

	/// Gross Sales. Actual for the selected period.
	measure 'Gross Sales Period' = CALCULATE( [Gross Sales], 'Scenario'[Scenario] = "Actual", DATESBETWEEN( 'Date'[Date], [Window Start], [Window End] ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 29163efb-b62c-56d9-850a-a57d40fd98f3

	/// Gross Sales. Budget for the selected period.
	measure 'Gross Sales Period Budget' = CALCULATE( [Gross Sales], 'Scenario'[Scenario] = "Budget", DATESBETWEEN( 'Date'[Date], [Window Start], [Window End] ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 01dcb2a8-867b-51b1-b2a0-26d6216006ea

	/// Discounts & Markdowns. Actual for the selected period.
	measure 'Discounts & Markdowns Period' = CALCULATE( [Discounts & Markdowns], 'Scenario'[Scenario] = "Actual", DATESBETWEEN( 'Date'[Date], [Window Start], [Window End] ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 03cf6eab-8408-5365-9af6-975f473ad580

	/// Discounts & Markdowns. Budget for the selected period.
	measure 'Discounts & Markdowns Period Budget' = CALCULATE( [Discounts & Markdowns], 'Scenario'[Scenario] = "Budget", DATESBETWEEN( 'Date'[Date], [Window Start], [Window End] ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 689e85c4-255f-56de-a54a-5fb2d9e3f76b

	/// Freight & Obsolescence. Actual for the selected period.
	measure 'Freight & Obsolescence Period' = CALCULATE( [Freight & Obsolescence], 'Scenario'[Scenario] = "Actual", DATESBETWEEN( 'Date'[Date], [Window Start], [Window End] ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 904cb4b4-12ba-5f59-b6ab-d99142899c24

	/// Freight & Obsolescence. Budget for the selected period.
	measure 'Freight & Obsolescence Period Budget' = CALCULATE( [Freight & Obsolescence], 'Scenario'[Scenario] = "Budget", DATESBETWEEN( 'Date'[Date], [Window Start], [Window End] ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 2739fc44-c86b-52ae-9362-8a74d3985689

	/// Gross Margin. Actual for the selected period.
	measure 'Gross Margin Period' = CALCULATE( [Gross Margin], 'Scenario'[Scenario] = "Actual", DATESBETWEEN( 'Date'[Date], [Window Start], [Window End] ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 163a6275-05aa-5405-a948-fda906a60688

	/// Gross Margin. Budget for the selected period.
	measure 'Gross Margin Period Budget' = CALCULATE( [Gross Margin], 'Scenario'[Scenario] = "Budget", DATESBETWEEN( 'Date'[Date], [Window Start], [Window End] ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: b87b7e6b-0567-5ed8-815c-6378883b3170

	/// Labor Cost. Actual for the selected period.
	measure 'Labor Cost Period' = CALCULATE( [Labor Cost], 'Scenario'[Scenario] = "Actual", DATESBETWEEN( 'Date'[Date], [Window Start], [Window End] ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 62cdfc97-ce7f-54da-8430-91f6fdcb5610

	/// Labor Cost. Budget for the selected period.
	measure 'Labor Cost Period Budget' = CALCULATE( [Labor Cost], 'Scenario'[Scenario] = "Budget", DATESBETWEEN( 'Date'[Date], [Window Start], [Window End] ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: a8d9db5e-ceca-5263-9aff-a6880c6e40a5

	/// Labor Cost. Actual for the same months a year earlier.
	measure 'Labor Cost Period PY' = CALCULATE( [Labor Cost], 'Scenario'[Scenario] = "Actual", DATESBETWEEN( 'Date'[Date], EDATE( [Window Start], -12 ), EOMONTH( [Window End], -12 ) ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 97888e55-e407-5774-9fe0-c50112a1bcaa

	/// Labor Cost. Actual less budget for the selected period.
	measure 'Labor Cost vs Budget' = [Labor Cost Period] - [Labor Cost Period Budget]
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 0691ad31-1c69-57f0-b694-f4f4f8e4ad7e

	/// Occupancy Cost. Actual for the selected period.
	measure 'Occupancy Cost Period' = CALCULATE( [Occupancy Cost], 'Scenario'[Scenario] = "Actual", DATESBETWEEN( 'Date'[Date], [Window Start], [Window End] ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: fa4eb480-1a02-5599-b14b-c7ea54668845

	/// Occupancy Cost. Budget for the selected period.
	measure 'Occupancy Cost Period Budget' = CALCULATE( [Occupancy Cost], 'Scenario'[Scenario] = "Budget", DATESBETWEEN( 'Date'[Date], [Window Start], [Window End] ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: fae9ff2c-1bec-5566-b370-4782bd08b78f

	/// Occupancy Cost. Actual less budget for the selected period.
	measure 'Occupancy Cost vs Budget' = [Occupancy Cost Period] - [Occupancy Cost Period Budget]
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 03a13311-8ca1-58c2-9f20-96124cfbc6f5

	/// Marketing Cost. Actual for the selected period.
	measure 'Marketing Cost Period' = CALCULATE( [Marketing Cost], 'Scenario'[Scenario] = "Actual", DATESBETWEEN( 'Date'[Date], [Window Start], [Window End] ) )
		formatString: $#,0;($#,0)
		displayFolder: 1 Income Statement
		lineageTag: 1790bb0f-0f4c-5957-8a8a-013d85b0f774

	/// Marketing Cost. Budget for the selected period.
