	measure 'Store Comparison Title' = "Stores ranked by " & SWITCH( SELECTEDVALUE( 'Store Metric'[Store Metric Order], 0 ), 1, "gross margin %", 2, "EBITDA", 3, "labor % of revenue", 4, "revenue per labor hour", 5, "overtime %", 6, "markdown rate", "net revenue" )
		isHidden
		displayFolder: 4 Balance Sheet & Working Capital
