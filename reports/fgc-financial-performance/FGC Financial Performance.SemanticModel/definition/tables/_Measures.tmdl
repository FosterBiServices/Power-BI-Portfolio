	measure 'Top-5 account share Card' =
			VAR _Value = [Top 5 Customer Share]
			VAR _ValueText = IF ( ISBLANK ( _Value ), "", FORMAT ( _Value, "0.0%" ) )
			VAR _Target = [Concentration Limit]
