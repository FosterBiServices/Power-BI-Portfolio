	/// The liquidity floor, drawn on liquidity charts.
	measure 'Liquidity Floor Line' = IF( NOT ISBLANK( [Liquidity Outlook] ), [Liquidity Floor] )
		formatString: $#,0;($#,0)
		displayFolder: 4 Balance Sheet & Working Capital
		lineageTag: d860b41a-b3f1-552c-837c-36e5ef46859f

	/// Lowest month-end liquidity in the next 6 forecast months.
	measure 'Lowest Forecast Liquidity' = ```
			VAR _AsOf = [As Of Date]
			VAR _Months =
			    CALCULATETABLE( VALUES( 'Date'[Month End] ), DATESBETWEEN( 'Date'[Date], _AsOf + 1, EOMONTH( _AsOf, 6 ) ) )
			RETURN
			    MINX( _Months, VAR _D = 'Date'[Month End] RETURN CALCULATE( [Liquidity Forecast], 'Date'[Date] = _D ) )
			```
		formatString: $#,0;($#,0)
		displayFolder: 4 Balance Sheet & Working Capital
		lineageTag: 4fd6358b-1b94-5ec1-b76a-9a8acd41c9a1

	/// Month of the lowest forecast liquidity.
	measure 'Lowest Forecast Liquidity Month' = ```
			VAR _AsOf = [As Of Date]
			VAR _Months =
			    ADDCOLUMNS(
			        CALCULATETABLE( VALUES( 'Date'[Month End] ), DATESBETWEEN( 'Date'[Date], _AsOf + 1, EOMONTH( _AsOf, 6 ) ) ),
			        "@Liq", VAR _D = 'Date'[Month End] RETURN CALCULATE( [Liquidity Forecast], 'Date'[Date] = _D )
			    )
			RETURN
			    FORMAT( MAXX( TOPN( 1, _Months, [@Liq], ASC ), 'Date'[Month End] ), "mmm yyyy" )
			```
		isHidden
		displayFolder: 4 Balance Sheet & Working Capital
		lineageTag: 998ed87e-5f02-5761-92e7-397b86baaa53

	/// Value of the income statement row: costs negative, margins as a share of revenue.
	measure 'P&L Line Value' = ```
			VAR _Keys = SELECTEDVALUE( 'P&L Layout'[Accounts] )
			VAR _Den = SELECTEDVALUE( 'P&L Layout'[Denominator] )
			VAR _Num =
			    CALCULATE( SUM( 'General Ledger'[Signed Amount] ), FILTER( ALL( Accounts[AccountKey] ), PATHCONTAINS( _Keys, Accounts[AccountKey] ) ) )
			RETURN
			    IF(
			        SELECTEDVALUE( 'P&L Layout'[Kind] ) = "Ratio",
			        DIVIDE( _Num, CALCULATE( SUM( 'General Ledger'[Signed Amount] ), FILTER( ALL( Accounts[AccountKey] ), PATHCONTAINS( _Den, Accounts[AccountKey] ) ) ) ),
			        _Num
			    )
			```
		formatString: #,0
		displayFolder: 6 Statements
		lineageTag: c7c55dd4-507e-5939-ba17-3c1bf5d537d7

	/// Income statement, actual for the selected period ($K).
	measure 'P&L Actual' = CALCULATE( [P&L Line Value], 'Scenario'[Scenario] = "Actual", DATESBETWEEN( 'Date'[Date], [Window Start], [Window End] ) )
		displayFolder: 6 Statements
		lineageTag: 1e6eb2f9-bdb9-5d76-a71e-07253f069059

		formatStringDefinition = IF( SELECTEDVALUE( 'P&L Layout'[Kind] ) = "Ratio", "0.0%", "#,0,;(#,0,);–" )

	/// Income statement, budget for the selected period ($K).
	measure 'P&L Budget' = CALCULATE( [P&L Line Value], 'Scenario'[Scenario] = "Budget", DATESBETWEEN( 'Date'[Date], [Window Start], [Window End] ) )
		displayFolder: 6 Statements
		lineageTag: c93a9a3c-90d8-5497-a481-ee74bfb02e4b

		formatStringDefinition = IF( SELECTEDVALUE( 'P&L Layout'[Kind] ) = "Ratio", "0.0%", "#,0,;(#,0,);–" )

	/// Income statement, same months last year ($K).
	measure 'P&L PY' = CALCULATE( [P&L Line Value], 'Scenario'[Scenario] = "Actual", DATESBETWEEN( 'Date'[Date], EDATE( [Window Start], -12 ), EOMONTH( [Window End], -12 ) ) )
		displayFolder: 6 Statements
		lineageTag: 311ee3e3-c0eb-5c3c-88eb-f81b7349ef27

		formatStringDefinition = IF( SELECTEDVALUE( 'P&L Layout'[Kind] ) = "Ratio", "0.0%", "#,0,;(#,0,);–" )

	/// Actual less budget: positive is better (more revenue or less cost). Margins in points.
	measure 'P&L vs Budget' = ```
			VAR _V = [P&L Actual] - [P&L Budget]
			RETURN IF( SELECTEDVALUE( 'P&L Layout'[Kind] ) = "Ratio", _V * 100, _V )
			```
		displayFolder: 6 Statements
		lineageTag: 974d573e-b4bd-5023-82d4-d15f7f26574a

		formatStringDefinition = IF( SELECTEDVALUE( 'P&L Layout'[Kind] ) = "Ratio", "+0.0 pts;-0.0 pts;–", "+#,0,;-#,0,;–" )

	/// Variance as a share of budget.
	measure 'P&L vs Budget %' = IF( SELECTEDVALUE( 'P&L Layout'[Kind] ) <> "Ratio", DIVIDE( [P&L Actual] - [P&L Budget], ABS( [P&L Budget] ) ) )
		formatString: +0.0%;-0.0%;–
		displayFolder: 6 Statements
		lineageTag: eab9e5dd-b421-5f6e-bbaa-52ab7c770b39

	/// Change on last year: % for amounts, points for margins.
	measure 'P&L vs PY %' = ```
			VAR _A = [P&L Actual]
			VAR _P = [P&L PY]
			RETURN
			    IF( SELECTEDVALUE( 'P&L Layout'[Kind] ) = "Ratio", ( _A - _P ) * 100, DIVIDE( _A - _P, ABS( _P ) ) )
			```
		displayFolder: 6 Statements
		lineageTag: 62d73e72-b72f-51a1-ab9b-cdbf31026121

		formatStringDefinition = IF( SELECTEDVALUE( 'P&L Layout'[Kind] ) = "Ratio", "+0.0 pts;-0.0 pts;–", "+0.0%;-0.0%;–" )

	/// Full-year outlook: actual to date plus forecast ($K).
	measure 'P&L FY Outlook' = ```
			VAR _AsOf = [As Of Date]
			VAR _Keys = SELECTEDVALUE( 'P&L Layout'[Accounts] )
			VAR _Den = SELECTEDVALUE( 'P&L Layout'[Denominator] )
			VAR _Num = ( CALCULATE( SUM( 'General Ledger'[Signed Amount] ), FILTER( ALL( Accounts[AccountKey] ), PATHCONTAINS( _Keys, Accounts[AccountKey] ) ), 'Scenario'[Scenario] = "Actual", DATESBETWEEN( 'Date'[Date], [FY Start], _AsOf ) ) + CALCULATE( SUM( 'General Ledger'[Signed Amount] ), FILTER( ALL( Accounts[AccountKey] ), PATHCONTAINS( _Keys, Accounts[AccountKey] ) ), 'Scenario'[Scenario] = "Forecast", DATESBETWEEN( 'Date'[Date], _AsOf + 1, [FY End] ) ) )
			RETURN
			    IF( SELECTEDVALUE( 'P&L Layout'[Kind] ) = "Ratio", DIVIDE( _Num, ( CALCULATE( SUM( 'General Ledger'[Signed Amount] ), FILTER( ALL( Accounts[AccountKey] ), PATHCONTAINS( _Den, Accounts[AccountKey] ) ), 'Scenario'[Scenario] = "Actual", DATESBETWEEN( 'Date'[Date], [FY Start], _AsOf ) ) + CALCULATE( SUM( 'General Ledger'[Signed Amount] ), FILTER( ALL( Accounts[AccountKey] ), PATHCONTAINS( _Den, Accounts[AccountKey] ) ), 'Scenario'[Scenario] = "Forecast", DATESBETWEEN( 'Date'[Date], _AsOf + 1, [FY End] ) ) ) ), _Num )
			```
		displayFolder: 6 Statements
		lineageTag: 5508f587-2ae3-5000-bcaa-4f7d14456a60

		formatStringDefinition = IF( SELECTEDVALUE( 'P&L Layout'[Kind] ) = "Ratio", "0.0%", "#,0,;(#,0,);–" )

	/// Full-year budget ($K).
	measure 'P&L FY Budget' = CALCULATE( [P&L Line Value], 'Scenario'[Scenario] = "Budget", DATESBETWEEN( 'Date'[Date], [FY Start], [FY End] ) )
		displayFolder: 6 Statements
		lineageTag: 736731ab-5be4-5f1d-ba43-609cd68cd78b

		formatStringDefinition = IF( SELECTEDVALUE( 'P&L Layout'[Kind] ) = "Ratio", "0.0%", "#,0,;(#,0,);–" )

	/// Green when the variance is favorable, red when not.
	measure 'P&L Variance Color' = ```
			VAR _V = [P&L vs Budget]
			RETURN IF( ISBLANK( _V ) || _V = 0, "#6B7785", IF( _V > 0, "#006100", "#9C0006" ) )
			```
		isHidden
		displayFolder: 9 Visual Helpers
		lineageTag: 12250cf8-86d6-5add-96ae-81551860c7e3

	/// Green when better than last year.
	measure 'P&L PY Color' = ```
			VAR _V = [P&L vs PY %]
			RETURN IF( ISBLANK( _V ) || _V = 0, "#6B7785", IF( _V > 0, "#006100", "#9C0006" ) )
			```
		isHidden
		displayFolder: 9 Visual Helpers
		lineageTag: 9f89bd29-52a1-5eff-84ba-4b80cb4da44c

	/// Row shading: subtotals light grey (#F5F5F5).
	measure 'P&L Row Style' = SWITCH( SELECTEDVALUE( 'P&L Layout'[Kind] ), "Subtotal", "#F5F5F5", "#FFFFFF" )
		isHidden
		displayFolder: 9 Visual Helpers
		lineageTag: dedf7505-e429-5673-905c-298ebc6161d6

	/// Balance of the balance sheet row (on the date in context).
	measure 'BS Line Value' = ```
