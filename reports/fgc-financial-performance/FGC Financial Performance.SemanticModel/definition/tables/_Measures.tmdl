					_VarT <= -0.02 && _VarT < 0, "#9C0006",
					"#9C5700"
				)
			VAR _VarTText = IF ( ISBLANK ( _VarT ), "", SWITCH ( TRUE (), _VarT > 0, UNICHAR ( 9650 ), _VarT < 0, UNICHAR ( 9660 ), UNICHAR ( 9658 ) ) & " " & FORMAT ( _VarT, "+0.0%;-0.0%;0.0%" ) )
			VAR _TargetText =
				SWITCH (
					TRUE (),
					ISBLANK ( _Target ), "",
					ABS ( _Target ) >= 1E9, FORMAT ( _Target / 1E9, "\$#,0.0" ) & "bn",
					ABS ( _Target ) >= 1E6, FORMAT ( _Target / 1E6, "\$#,0.0" ) & "M",
					ABS ( _Target ) >= 1E3, FORMAT ( _Target / 1E3, "\$#,0.0" ) & "K",
					FORMAT ( _Target, "\$#,0" )
				)
			VAR _Compare = [E-commerce Revenue Period PY]
			VAR _VarC = IF ( NOT ISBLANK ( _Value ) && NOT ISBLANK ( _Compare ) && _Compare <> 0, DIVIDE ( _Value - _Compare, ABS ( _Compare ) ) )
			VAR _ColC =
				SWITCH (
					TRUE (),
					ISBLANK ( _VarC ), "#5B6B7C",
					_VarC >= 0.02 && _VarC > 0, "#006100",
					_VarC <= -0.02 && _VarC < 0, "#9C0006",
					"#9C5700"
				)
			VAR _VarCText = IF ( ISBLANK ( _VarC ), "", SWITCH ( TRUE (), _VarC > 0, UNICHAR ( 9650 ), _VarC < 0, UNICHAR ( 9660 ), UNICHAR ( 9658 ) ) & " " & FORMAT ( _VarC, "+0.0%;-0.0%;0.0%" ) )
			VAR _CompareText =
				SWITCH (
					TRUE (),
					ISBLANK ( _Compare ), "",
					ABS ( _Compare ) >= 1E9, FORMAT ( _Compare / 1E9, "\$#,0.0" ) & "bn",
					ABS ( _Compare ) >= 1E6, FORMAT ( _Compare / 1E6, "\$#,0.0" ) & "M",
					ABS ( _Compare ) >= 1E3, FORMAT ( _Compare / 1E3, "\$#,0.0" ) & "K",
					FORMAT ( _Compare, "\$#,0" )
				)
			VAR _Svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='300' height='140' viewBox='0 0 300 140'>"
					& "<g transform='translate(18,9)'><circle cx='12' cy='12' r='12' fill='#FFF4D6'/><path d='M6 7h2l1.5 7h7l1.5-5H9' fill='none' stroke='#C98700' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'/><circle cx='10.5' cy='17' r='1.2' fill='#C98700'/><circle cx='15.5' cy='17' r='1.2' fill='#C98700'/></g><text x='50' y='26' font-family='Segoe UI, Arial, sans-serif' font-size='14' fill='#5B6B7C'>E-commerce revenue</text>"
					& "<text x='20' y='60' font-family='Segoe UI, Arial, sans-serif' font-size='28' fill='#01305C' font-weight='600'>" & _ValueText & "</text>"
					& "<line x1='20' y1='76' x2='284' y2='76' stroke='#E3E7EC'/>"
					& "<text x='20' y='96' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='#5B6B7C'>vs budget</text><text x='20' y='116' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='" & _ColT & "' font-weight='600'>" & _VarTText & "</text><text x='20' y='132' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='#5B6B7C'>Budget " & _TargetText & "</text>"
					& "<line x1='146' y1='86' x2='146' y2='132' stroke='#E3E7EC'/><text x='152' y='96' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='#5B6B7C'>vs last year</text><text x='152' y='116' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='" & _ColC & "' font-weight='600'>" & _VarCText & "</text><text x='152' y='132' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='#5B6B7C'>Last year " & _CompareText & "</text>"
					& "</svg>"
			RETURN
				IF ( NOT ISBLANK ( _Value ), "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _Svg, "%", "%25" ), "#", "%23" ) )
		isHidden
		dataCategory: ImageUrl
		displayFolder: KPI Visuals\E-commerce revenue

	/// Card with comparison columns: the whole card as one picture, 300 x 140 pixels. Colors come from the KPI Visualizer; change them there and paste the script again.
	measure 'CapEx spend Card' =
			VAR _Value = [CapEx Spend Period]
			VAR _ValueText =
				SWITCH (
					TRUE (),
					ISBLANK ( _Value ), "",
					ABS ( _Value ) >= 1E9, FORMAT ( _Value / 1E9, "\$#,0.0" ) & "bn",
					ABS ( _Value ) >= 1E6, FORMAT ( _Value / 1E6, "\$#,0.0" ) & "M",
					ABS ( _Value ) >= 1E3, FORMAT ( _Value / 1E3, "\$#,0.0" ) & "K",
					FORMAT ( _Value, "\$#,0" )
				)
			VAR _Target = [CapEx Spend Period Budget]
			VAR _VarT = IF ( NOT ISBLANK ( _Value ) && NOT ISBLANK ( _Target ) && _Target <> 0, DIVIDE ( _Value - _Target, ABS ( _Target ) ) )
			VAR _ColT =
				SWITCH (
					TRUE (),
					ISBLANK ( _VarT ), "#5B6B7C",
					-_VarT >= 0.02 && -_VarT > 0, "#006100",
					-_VarT <= -0.02 && -_VarT < 0, "#9C0006",
					"#9C5700"
				)
			VAR _VarTText = IF ( ISBLANK ( _VarT ), "", SWITCH ( TRUE (), _VarT > 0, UNICHAR ( 9650 ), _VarT < 0, UNICHAR ( 9660 ), UNICHAR ( 9658 ) ) & " " & FORMAT ( _VarT, "+0.0%;-0.0%;0.0%" ) )
			VAR _TargetText =
				SWITCH (
					TRUE (),
					ISBLANK ( _Target ), "",
					ABS ( _Target ) >= 1E9, FORMAT ( _Target / 1E9, "\$#,0.0" ) & "bn",
					ABS ( _Target ) >= 1E6, FORMAT ( _Target / 1E6, "\$#,0.0" ) & "M",
					ABS ( _Target ) >= 1E3, FORMAT ( _Target / 1E3, "\$#,0.0" ) & "K",
					FORMAT ( _Target, "\$#,0" )
				)
			VAR _Compare = [CapEx Spend Period PY]
			VAR _VarC = IF ( NOT ISBLANK ( _Value ) && NOT ISBLANK ( _Compare ) && _Compare <> 0, DIVIDE ( _Value - _Compare, ABS ( _Compare ) ) )
			VAR _ColC =
				SWITCH (
					TRUE (),
					ISBLANK ( _VarC ), "#5B6B7C",
					-_VarC >= 0.02 && -_VarC > 0, "#006100",
					-_VarC <= -0.02 && -_VarC < 0, "#9C0006",
					"#9C5700"
				)
			VAR _VarCText = IF ( ISBLANK ( _VarC ), "", SWITCH ( TRUE (), _VarC > 0, UNICHAR ( 9650 ), _VarC < 0, UNICHAR ( 9660 ), UNICHAR ( 9658 ) ) & " " & FORMAT ( _VarC, "+0.0%;-0.0%;0.0%" ) )
			VAR _CompareText =
				SWITCH (
					TRUE (),
					ISBLANK ( _Compare ), "",
					ABS ( _Compare ) >= 1E9, FORMAT ( _Compare / 1E9, "\$#,0.0" ) & "bn",
					ABS ( _Compare ) >= 1E6, FORMAT ( _Compare / 1E6, "\$#,0.0" ) & "M",
					ABS ( _Compare ) >= 1E3, FORMAT ( _Compare / 1E3, "\$#,0.0" ) & "K",
					FORMAT ( _Compare, "\$#,0" )
				)
			VAR _Svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='300' height='140' viewBox='0 0 300 140'>"
					& "<g transform='translate(18,9)'><circle cx='12' cy='12' r='12' fill='#FFF4D6'/><path d='M7 18V9l5-3 5 3v9M6 18h12M10.5 18v-4h3v4' fill='none' stroke='#C98700' stroke-width='1.6' stroke-linejoin='round' stroke-linecap='round'/></g><text x='50' y='26' font-family='Segoe UI, Arial, sans-serif' font-size='14' fill='#5B6B7C'>CapEx spend</text>"
					& "<text x='20' y='60' font-family='Segoe UI, Arial, sans-serif' font-size='28' fill='#01305C' font-weight='600'>" & _ValueText & "</text>"
					& "<line x1='20' y1='76' x2='284' y2='76' stroke='#E3E7EC'/>"
					& "<text x='20' y='96' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='#5B6B7C'>vs budget</text><text x='20' y='116' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='" & _ColT & "' font-weight='600'>" & _VarTText & "</text><text x='20' y='132' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='#5B6B7C'>Budget " & _TargetText & "</text>"
					& "<line x1='146' y1='86' x2='146' y2='132' stroke='#E3E7EC'/><text x='152' y='96' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='#5B6B7C'>vs last year</text><text x='152' y='116' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='" & _ColC & "' font-weight='600'>" & _VarCText & "</text><text x='152' y='132' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='#5B6B7C'>Last year " & _CompareText & "</text>"
					& "</svg>"
			RETURN
				IF ( NOT ISBLANK ( _Value ), "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _Svg, "%", "%25" ), "#", "%23" ) )
		isHidden
		dataCategory: ImageUrl
		displayFolder: KPI Visuals\CapEx spend

	/// Card with comparison columns: the whole card as one picture, 300 x 140 pixels. Colors come from the KPI Visualizer; change them there and paste the script again.
	measure 'Full-year CapEx outlook Card' =
			VAR _Value = [CapEx Spend FY Outlook]
			VAR _ValueText =
				SWITCH (
					TRUE (),
					ISBLANK ( _Value ), "",
					ABS ( _Value ) >= 1E9, FORMAT ( _Value / 1E9, "\$#,0.0" ) & "bn",
					ABS ( _Value ) >= 1E6, FORMAT ( _Value / 1E6, "\$#,0.0" ) & "M",
					ABS ( _Value ) >= 1E3, FORMAT ( _Value / 1E3, "\$#,0.0" ) & "K",
					FORMAT ( _Value, "\$#,0" )
				)
			VAR _Target = [CapEx Spend FY Budget]
			VAR _VarT = IF ( NOT ISBLANK ( _Value ) && NOT ISBLANK ( _Target ) && _Target <> 0, DIVIDE ( _Value - _Target, ABS ( _Target ) ) )
			VAR _ColT =
				SWITCH (
					TRUE (),
					ISBLANK ( _VarT ), "#5B6B7C",
					-_VarT >= 0.02 && -_VarT > 0, "#006100",
					-_VarT <= -0.02 && -_VarT < 0, "#9C0006",
					"#9C5700"
				)
			VAR _VarTText = IF ( ISBLANK ( _VarT ), "", SWITCH ( TRUE (), _VarT > 0, UNICHAR ( 9650 ), _VarT < 0, UNICHAR ( 9660 ), UNICHAR ( 9658 ) ) & " " & FORMAT ( _VarT, "+0.0%;-0.0%;0.0%" ) )
			VAR _TargetText =
				SWITCH (
					TRUE (),
					ISBLANK ( _Target ), "",
					ABS ( _Target ) >= 1E9, FORMAT ( _Target / 1E9, "\$#,0.0" ) & "bn",
					ABS ( _Target ) >= 1E6, FORMAT ( _Target / 1E6, "\$#,0.0" ) & "M",
					ABS ( _Target ) >= 1E3, FORMAT ( _Target / 1E3, "\$#,0.0" ) & "K",
					FORMAT ( _Target, "\$#,0" )
				)
			VAR _Compare = [CapEx Spend Last FY]
			VAR _VarC = IF ( NOT ISBLANK ( _Value ) && NOT ISBLANK ( _Compare ) && _Compare <> 0, DIVIDE ( _Value - _Compare, ABS ( _Compare ) ) )
			VAR _ColC =
				SWITCH (
					TRUE (),
					ISBLANK ( _VarC ), "#5B6B7C",
					-_VarC >= 0.02 && -_VarC > 0, "#006100",
					-_VarC <= -0.02 && -_VarC < 0, "#9C0006",
					"#9C5700"
				)
			VAR _VarCText = IF ( ISBLANK ( _VarC ), "", SWITCH ( TRUE (), _VarC > 0, UNICHAR ( 9650 ), _VarC < 0, UNICHAR ( 9660 ), UNICHAR ( 9658 ) ) & " " & FORMAT ( _VarC, "+0.0%;-0.0%;0.0%" ) )
			VAR _CompareText =
				SWITCH (
					TRUE (),
					ISBLANK ( _Compare ), "",
					ABS ( _Compare ) >= 1E9, FORMAT ( _Compare / 1E9, "\$#,0.0" ) & "bn",
					ABS ( _Compare ) >= 1E6, FORMAT ( _Compare / 1E6, "\$#,0.0" ) & "M",
					ABS ( _Compare ) >= 1E3, FORMAT ( _Compare / 1E3, "\$#,0.0" ) & "K",
					FORMAT ( _Compare, "\$#,0" )
				)
			VAR _Svg =
				"<svg xmlns='http://www.w3.org/2000/svg' width='300' height='140' viewBox='0 0 300 140'>"
					& "<g transform='translate(18,9)'><circle cx='12' cy='12' r='12' fill='#FFF4D6'/><path d='M7 18V9l5-3 5 3v9M6 18h12M10.5 18v-4h3v4' fill='none' stroke='#C98700' stroke-width='1.6' stroke-linejoin='round' stroke-linecap='round'/></g><text x='50' y='26' font-family='Segoe UI, Arial, sans-serif' font-size='14' fill='#5B6B7C'>Full-year CapEx outlook</text>"
					& "<text x='20' y='60' font-family='Segoe UI, Arial, sans-serif' font-size='28' fill='#01305C' font-weight='600'>" & _ValueText & "</text>"
					& "<line x1='20' y1='76' x2='284' y2='76' stroke='#E3E7EC'/>"
					& "<text x='20' y='96' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='#5B6B7C'>vs budget</text><text x='20' y='116' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='" & _ColT & "' font-weight='600'>" & _VarTText & "</text><text x='20' y='132' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='#5B6B7C'>Budget " & _TargetText & "</text>"
					& "<line x1='146' y1='86' x2='146' y2='132' stroke='#E3E7EC'/><text x='152' y='96' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='#5B6B7C'>vs last year</text><text x='152' y='116' font-family='Segoe UI, Arial, sans-serif' font-size='15' fill='" & _ColC & "' font-weight='600'>" & _VarCText & "</text><text x='152' y='132' font-family='Segoe UI, Arial, sans-serif' font-size='11' fill='#5B6B7C'>Last year " & _CompareText & "</text>"
					& "</svg>"
			RETURN
				IF ( NOT ISBLANK ( _Value ), "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _Svg, "%", "%25" ), "#", "%23" ) )
		isHidden
		dataCategory: ImageUrl
		displayFolder: KPI Visuals\Full-year CapEx outlook

	/// Rank of one account by commercial revenue in the selected period, largest first (ties broken by name); blank with no revenue or more than one account in context.
	measure 'Customer Rank' =
			IF (
				ISBLANK ( [Commercial Revenue Period] ) || NOT HASONEVALUE ( 'Customers'[Customer] ),
				BLANK (),
				RANK (
					ALL ( 'Customers'[Customer] ),
					ORDERBY ( [Commercial Revenue Period], DESC, 'Customers'[Customer], ASC )
				)
			)
		formatString: 0
		displayFolder: Chart Patterns

	/// Subtitle text for the ranked accounts chart: commercial revenue of the accounts shown versus all accounts in the period.
	measure 'Commercial Revenue Period Page Subtitle' =
			VAR _all = CALCULATE ( [Commercial Revenue Period], REMOVEFILTERS ( 'Customers'[Customer] ) )
			RETURN
				"Shown: " & FORMAT ( [Commercial Revenue Period], "\$#,0" ) & " | All: " & FORMAT ( _all, "\$#,0" )
		isHidden
		displayFolder: Chart Patterns

	/// The channel's share of net revenue for the selected period, against net revenue across all channels.
	measure 'Net Revenue Period % of Total' = DIVIDE ( [Net Revenue Period], CALCULATE ( [Net Revenue Period], REMOVEFILTERS ( 'Locations'[Channel] ) ) )
		formatString: 0.0%
		displayFolder: Chart Patterns

	/// Height for the share label on the channel chart: 1.6 times the largest channel's net revenue; blank for channels with no revenue.
	measure 'Net Revenue Period Bubble Label' =
			VAR _max = MAXX ( ALLSELECTED ( 'Locations'[Channel] ), [Net Revenue Period] )
			RETURN
				IF ( NOT ISBLANK ( [Net Revenue Period] ), _max * 1.6 )
		isHidden
		displayFolder: Chart Patterns

	/// Height for the share bubble marker on the channel chart: 1.7 times the largest channel's net revenue; blank for channels with no revenue.
	measure 'Net Revenue Period Bubble Position' =
			VAR _max = MAXX ( ALLSELECTED ( 'Locations'[Channel] ), [Net Revenue Period] )
			RETURN
				IF ( NOT ISBLANK ( [Net Revenue Period] ), _max * 1.7 )
		isHidden
		displayFolder: Chart Patterns

	/// Axis maximum for the channel chart: 2.2 times the largest channel's net revenue, so the share bubbles fit above the columns.
	measure 'Net Revenue Period Bubble Axis Max' =
			VAR _max = MAXX ( ALLSELECTED ( 'Locations'[Channel] ), [Net Revenue Period] )
			RETURN
				_max * 2.2
		isHidden
		displayFolder: Chart Patterns

	/// Subtitle text for the channel chart with net revenue for the selected period across all channels.
	measure 'Net Revenue Period Subtitle' =
			VAR _value = CALCULATE ( [Net Revenue Period], REMOVEFILTERS ( 'Locations'[Channel] ) )
			RETURN
			"Net Revenue Period (all channel): " & FORMAT ( _value, "\$#,0" )
		isHidden
		displayFolder: Chart Patterns

	/// Zero-height helper bar that carries the category name and share label above each bar on the product margin chart; blank where there is no margin.
	measure 'Product Margin Period Label Spacer' = IF ( ISBLANK ( [Product Margin Period] ), BLANK (), 0 )
		formatString: 0
		displayFolder: Chart Patterns

	/// The product category in context when exactly one is selected; blank otherwise.
	measure 'Selected Category' = SELECTEDVALUE ( 'Products'[Category] )
		isHidden
		displayFolder: Chart Patterns

	/// The category's share of product margin for the selected period, against all categories in the current selection.
	measure 'Product Margin Period % of Total' = DIVIDE ( [Product Margin Period], CALCULATE ( [Product Margin Period], ALLSELECTED ( 'Products'[Category] ) ) )
		formatString: 0.0%
		displayFolder: Chart Patterns

	/// Subtitle text for the product margin chart with total product margin for the selected period.
	measure 'Product Margin Period Subtitle' =
			VAR _value = [Product Margin Period]
			RETURN
			"Product Margin Period: " & FORMAT ( _value, "\$#,0" )
		displayFolder: Chart Patterns

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d6e5f131-fae3-55db-af35-56c7c604c070
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = { 1 }

	annotation PBI_Id = f11b372ddd3f5c87986e9974f314e203

