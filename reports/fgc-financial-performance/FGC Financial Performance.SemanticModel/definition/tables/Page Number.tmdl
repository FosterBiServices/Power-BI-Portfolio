/// Made with the Foster BI Toolkit Chart Patterns page (Top N per page).
table 'Page Number'
	lineageTag: 5e41eaf0-25dc-52fd-bfdc-a69f266e9517
	/// The page picked on the ranked accounts page buttons; 1 when nothing is picked.
	measure 'Page Number Value' = SELECTEDVALUE ( 'Page Number'[Page Number], 1 )
		formatString: 0
		displayFolder: Chart Patterns

	/// Filter for the page buttons: 1 for page numbers that hold at least one account with commercial revenue, 0 for empty pages.
	measure 'Page Filter' =
			VAR _count =
				COUNTROWS ( FILTER ( ALL ( 'Customers'[Customer] ), NOT ISBLANK ( [Commercial Revenue Period] ) ) )
			VAR _pages = ROUNDUP ( DIVIDE ( _count, [Items per Page Value] ), 0 )
			RETURN
				IF ( SELECTEDVALUE ( 'Page Number'[Page Number] ) <= _pages, 1, 0 )
		formatString: 0
		displayFolder: Chart Patterns

	column 'Page Number'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Value]

	partition 'Page Number' = calculated
		mode: import
		source = GENERATESERIES ( 1, 10, 1 )
