/// Calendar from the Foster BI Toolkit Date Table Generator: one row per day, 2023 to 2027, US holidays, marked as the date table. Fact tables are dated at month end.
table Date
	lineageTag: fcf135ac-87ad-5c5b-9db9-61ce2d49ba04
	dataCategory: Time

	column Date
		lineageTag: 7b581bf8-f41b-5d6d-bb4b-bbe331a31369
		dataType: dateTime
		isDataTypeInferred
		isKey
		formatString: Short Date
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	column Year
		lineageTag: bcd0471d-8d0f-5838-810e-12aa6e2d9493
		dataType: int64
		isDataTypeInferred
		formatString: 0
		summarizeBy: none
		isNameInferred
