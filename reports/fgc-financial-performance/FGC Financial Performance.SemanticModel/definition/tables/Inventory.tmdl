/// Inventory at cost at each month end, by product line, with the part on hand more than 180 days.
table Inventory
	lineageTag: 06c8fc3c-2f95-54a4-a20d-586fff5a6423

	/// Month end. Links to Date.
	column 'Date'
		isHidden
		dataType: dateTime
		formatString: Short Date
		lineageTag: 8a373501-1ebc-55f5-b67c-8803e318947c
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	/// Actual, Budget or Forecast.
	column Scenario
		dataType: string
		isHidden
		lineageTag: a9d05b52-7a62-58b4-b70b-077f2209d70c
		summarizeBy: none
		sourceColumn: Scenario

		annotation SummarizationSetBy = Automatic

	/// Links to Products.
	column ProductKey
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 9ef6a295-5c5d-5506-9762-646192f2fe9d
		summarizeBy: none
		sourceColumn: ProductKey

		annotation SummarizationSetBy = Automatic

	/// Inventory at cost.
	column 'Inventory Value'
		dataType: double
		formatString: #,0
		lineageTag: 2abd5f7d-8098-5aa6-b9c6-6fced0bce9bb
		summarizeBy: sum
		sourceColumn: Inventory Value

		annotation SummarizationSetBy = Automatic

	/// Inventory on hand more than 180 days.
	column 'Aged 180+ Days'
		dataType: double
		formatString: #,0
		lineageTag: 1b736a7d-4d63-52fa-8f86-fb0f0d0c64fd
		summarizeBy: sum
		sourceColumn: Aged 180+ Days

		annotation SummarizationSetBy = Automatic

	partition Inventory = m
		mode: import
		source =
				let
				    // rows from sample-data/csv/Inventory.csv, stored in the query as Base64 text of raw-deflate compressed JSON (no data source needed)
				    Source = Json.Document(
				        Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)
				    ),
				    Rows = Table.FromRows(
				        Source,
				        {
				            "Date",
				            "Scenario",
				            "ProductKey",
				            "Inventory Value",
				            "Aged 180+ Days"
				        }
				    ),
				    Typed = fxApplyTypes(
				        Rows,
				        {
				            {"Date", type date},
				            {"Scenario", type text},
				            {"ProductKey", Int64.Type},
				            {"Inventory Value", type number},
				            {"Aged 180+ Days", type number}
				        },
				        [Culture = "en-US"]
				    )
				in
				    Typed

	annotation PBI_ResultType = Table

