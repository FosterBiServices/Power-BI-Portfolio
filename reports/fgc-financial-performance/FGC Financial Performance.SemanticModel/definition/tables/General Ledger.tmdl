/// Monthly general ledger. Income statement accounts: the amount for the month (positive). Balance sheet accounts: the month-end balance.
table 'General Ledger'
	lineageTag: 8b406452-18e1-5a2d-adff-ad1ca7577cbb

	/// Month end. Links to Date.
	column 'Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: b5b75ea2-ffcd-52f2-be38-68d28b860800
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	/// Actual, Budget or Forecast.
	column Scenario
		dataType: string
		isHidden
		lineageTag: 6290012f-2fd6-5006-9446-76056bab5084
		summarizeBy: none
		sourceColumn: Scenario

		annotation SummarizationSetBy = Automatic

	/// Links to Locations.
	column LocationKey
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 937dff5c-9afc-5091-a6d5-8752bf73bbc0
		summarizeBy: none
		sourceColumn: LocationKey

		annotation SummarizationSetBy = Automatic

	/// Links to Accounts.
	column AccountKey
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 890a284b-1f17-523e-82b8-d9c6dc89d753
		summarizeBy: none
		sourceColumn: AccountKey

		annotation SummarizationSetBy = Automatic

	/// Amount for the month (income statement) or balance at month end (balance sheet).
	column Amount
		dataType: double
		formatString: #,0
		lineageTag: e6671afb-4d9d-5096-a4ba-bd301b5cadb5
		summarizeBy: sum
		sourceColumn: Amount

		annotation SummarizationSetBy = Automatic

	/// Amount with its sign: income statement costs negative (so a sum is profit), accumulated depreciation negative (so a sum is net assets).
	column 'Signed Amount' = 'General Ledger'[Amount] * RELATED( Accounts[Sign] )
		dataType: double
		formatString: #,0
		isHidden
		lineageTag: cca7c6be-899f-583a-8e2f-4c92ae1659b0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'General Ledger' = m
		mode: import
		source =
				let
				    // rows from sample-data/csv/General Ledger.csv, stored in the query as Base64 text of raw-deflate compressed JSON (no data source needed)
				    Source = Json.Document(
				        Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)
				    ),
				    Rows = Table.FromRows(
				        Source,
				        {
				            "Date",
				            "Scenario",
				            "LocationKey",
				            "AccountKey",
				            "Amount"
				        }
				    ),
				    Typed = fxApplyTypes(
				        Rows,
				        {
				            {"Date", type date},
				            {"Scenario", type text},
				            {"LocationKey", Int64.Type},
				            {"AccountKey", Int64.Type},
				            {"Amount", type number}
				        },
				        [Culture = "en-US"]
				    )
				in
				    Typed

	annotation PBI_ResultType = Table

