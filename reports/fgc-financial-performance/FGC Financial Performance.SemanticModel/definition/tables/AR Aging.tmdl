/// Commercial receivables at each month end, by account and aging bucket (days past due).
table 'AR Aging'
	lineageTag: 7346398b-2914-514f-9bd4-19342d17981e

	/// Month end. Links to Date.
	column 'Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 2115f570-cdee-5416-84ac-de5ca2a3264b
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	/// Actual, Budget or Forecast.
	column Scenario
		dataType: string
		isHidden
		lineageTag: df1b6cd5-0e4c-5823-a908-0dc4608250c0
		summarizeBy: none
		sourceColumn: Scenario

		annotation SummarizationSetBy = Automatic

	/// Links to Customers.
	column CustomerKey
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: b2be932b-aa10-575f-8e20-5f01c3f9a9e5
		summarizeBy: none
		sourceColumn: CustomerKey

		annotation SummarizationSetBy = Automatic

	/// Current, 1-30, 31-60, 61-90 or 90+ days past due.
	column 'Aging Bucket'
		dataType: string
		lineageTag: d515fdb4-7e61-54f4-b00f-aa4c4bf0bdfa
		summarizeBy: none
		sourceColumn: Aging Bucket

		annotation SummarizationSetBy = Automatic

	/// Amount owed.
	column Amount
		dataType: double
		formatString: #,0
		lineageTag: 98d1db11-9fde-578d-98b7-a43a7fd9b39c
		summarizeBy: sum
		sourceColumn: Amount

		annotation SummarizationSetBy = Automatic

	partition 'AR Aging' = m
		mode: import
		source =
				let
				    // rows from sample-data/csv/AR Aging.csv, stored in the query as Base64 text of raw-deflate compressed JSON (no data source needed)
				    Source = Json.Document(
				        Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)
				    ),
				    Rows = Table.FromRows(
				        Source,
				        {
				            "Date",
				            "Scenario",
				            "CustomerKey",
				            "Aging Bucket",
				            "Amount"
				        }
				    ),
				    Typed = fxApplyTypes(
				        Rows,
				        {
				            {"Date", type date},
				            {"Scenario", type text},
				            {"CustomerKey", Int64.Type},
				            {"Aging Bucket", type text},
				            {"Amount", type number}
				        },
				        [Culture = "en-US"]
				    )
				in
				    Typed

	annotation PBI_ResultType = Table

