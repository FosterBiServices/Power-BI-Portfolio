/// Monthly cash flow by line (indirect method), for Actual, Budget (FY2026) and Forecast. Inflows positive.
table 'Cash Flow'
	lineageTag: e2efad22-810b-5744-be89-69627642fc5d

	/// Month end. Links to Date.
	column 'Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: b5e17804-195e-599a-b25f-07524c74c56d
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	/// Actual, Budget or Forecast.
	column Scenario
		dataType: string
		isHidden
		lineageTag: f56ec299-3334-567a-96bd-038587321e04
		summarizeBy: none
		sourceColumn: Scenario

		annotation SummarizationSetBy = Automatic

	/// Cash flow line. Links to Cash Flow Lines.
	column 'Cash Flow Line'
		dataType: string
		lineageTag: 012cf5b1-0bbb-53ea-b151-f61c90508662
		summarizeBy: none
		sourceColumn: Cash Flow Line

		annotation SummarizationSetBy = Automatic

	/// Cash in (positive) or out (negative).
	column Amount
		dataType: double
		formatString: #,0
		lineageTag: 9724e871-a1e2-5659-930a-47a8160a3067
		summarizeBy: sum
		sourceColumn: Amount

		annotation SummarizationSetBy = Automatic

	partition 'Cash Flow' = m
		mode: import
		source =
				let
				    // rows from sample-data/csv/Cash Flow.csv, stored in the query as Base64 text of raw-deflate compressed JSON (no data source needed)
				    Source = Json.Document(
				        Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)
				    ),
				    Rows = Table.FromRows(
				        Source,
				        {
				            "Date",
				            "Scenario",
				            "Cash Flow Line",
				            "Amount"
				        }
				    ),
				    Typed = fxApplyTypes(
				        Rows,
				        {
				            {"Date", type date},
				            {"Scenario", type text},
				            {"Cash Flow Line", type text},
				            {"Amount", type number}
				        },
				        [Culture = "en-US"]
				    )
				in
				    Typed

	annotation PBI_ResultType = Table

