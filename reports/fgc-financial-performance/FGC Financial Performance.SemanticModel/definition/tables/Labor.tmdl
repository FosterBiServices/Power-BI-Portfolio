/// Monthly hours and pay by location and department, for Actual, Budget and Forecast. Labor cost in the general ledger is wages plus benefits.
table Labor
	lineageTag: cf9261f0-4eed-55b0-88eb-59172b862a69

	/// Month end. Links to Date.
	column 'Date'
		isHidden
		dataType: dateTime
		formatString: Short Date
		lineageTag: ebc9c77a-b5bf-5ea0-904a-ea5a4aeba16f
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	/// Actual, Budget or Forecast.
	column Scenario
		dataType: string
		isHidden
		lineageTag: 80cecb32-b458-50e1-adbf-dcfa6e8e1bed
		summarizeBy: none
		sourceColumn: Scenario

		annotation SummarizationSetBy = Automatic

	/// Links to Locations.
	column LocationKey
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 74185334-4185-5ad3-bfa7-b8e8e1639f07
		summarizeBy: none
		sourceColumn: LocationKey

		annotation SummarizationSetBy = Automatic

	/// Sales Floor, Fitting & Instruction, Store Management, Fulfillment, Account Management or Corporate.
	column Department
		dataType: string
		lineageTag: 7e9bb8a5-9f1c-5bfe-b91e-794eb3ae181e
		summarizeBy: none
		sourceColumn: Department

		annotation SummarizationSetBy = Automatic

	/// Hours paid, overtime included.
	column Hours
		dataType: int64
		formatString: #,0
		lineageTag: a1e1d6d6-f49f-5123-9416-3818c3a4064f
		summarizeBy: sum
		sourceColumn: Hours

		annotation SummarizationSetBy = Automatic

	/// Hours paid at time and a half.
	column 'Overtime Hours'
		dataType: int64
		formatString: #,0
		lineageTag: 30125960-b311-51af-a0c5-2ec8a973c66a
		summarizeBy: sum
		sourceColumn: Overtime Hours

		annotation SummarizationSetBy = Automatic

	/// Wages paid.
	column Wages
		dataType: double
		formatString: #,0
		lineageTag: e8cb650a-c35c-535b-99aa-c7a7cb0caf4c
		summarizeBy: sum
		sourceColumn: Wages

		annotation SummarizationSetBy = Automatic

	/// Benefits and payroll taxes.
	column Benefits
		dataType: double
		formatString: #,0
		lineageTag: ddf1cde7-e18b-5fed-b0a4-16410a4bc4c6
		summarizeBy: sum
		sourceColumn: Benefits

		annotation SummarizationSetBy = Automatic

	/// Full-time equivalents (hours / 173).
	column FTE
		dataType: double
		formatString: #,0.0
		lineageTag: 5aac1876-c284-56df-a51c-cfd901a4374d
		summarizeBy: sum
		sourceColumn: FTE

		annotation SummarizationSetBy = Automatic

	partition Labor = m
		mode: import
		source =
				let
				    // rows from sample-data/csv/Labor.csv, stored in the query as Base64 text of raw-deflate compressed JSON (no data source needed)
				    Source = Json.Document(
				        Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)
				    ),
				    Rows = Table.FromRows(
				        Source,
				        {
				            "Date",
				            "Scenario",
				            "LocationKey",
				            "Department",
				            "Hours",
				            "Overtime Hours",
				            "Wages",
				            "Benefits",
				            "FTE"
				        }
				    ),
				    Typed = fxApplyTypes(
				        Rows,
				        {
				            {"Date", type date},
				            {"Scenario", type text},
				            {"LocationKey", Int64.Type},
				            {"Department", type text},
				            {"Hours", Int64.Type},
				            {"Overtime Hours", Int64.Type},
				            {"Wages", type number},
				            {"Benefits", type number},
				            {"FTE", type number}
				        },
				        [Culture = "en-US"]
				    )
				in
				    Typed

	annotation PBI_ResultType = Table

