/// Monthly capital spend by project, for Actual, Budget and Forecast.
table 'CapEx Spend'
	lineageTag: bbc4d576-f27d-567c-834e-806c13103d09

	/// Month end. Links to Date.
	column 'Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 3945e3f3-c22c-5538-9a09-0073e18c4eee
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	/// Actual, Budget or Forecast.
	column Scenario
		dataType: string
		isHidden
		lineageTag: 5b75e2dc-e4e4-5b58-9d75-d55059ae6a98
		summarizeBy: none
		sourceColumn: Scenario

		annotation SummarizationSetBy = Automatic

	/// Links to CapEx Projects.
	column ProjectKey
		dataType: string
		isHidden
		lineageTag: c2f1ed99-cfd0-57d2-87e8-658a0d37a42f
		summarizeBy: none
		sourceColumn: ProjectKey

		annotation SummarizationSetBy = Automatic

	/// Capital spend.
	column Amount
		dataType: double
		formatString: #,0
		lineageTag: 1970b4eb-e840-5bcd-b10d-91e52e6d403b
		summarizeBy: sum
		sourceColumn: Amount

		annotation SummarizationSetBy = Automatic

	partition 'CapEx Spend' = m
		mode: import
		source =
				let
				    // rows from sample-data/csv/CapEx Spend.csv, stored in the query as Base64 text of raw-deflate compressed JSON (no data source needed)
				    Source = Json.Document(
				        Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)
				    ),
				    Rows = Table.FromRows(
				        Source,
				        {
				            "Date",
				            "Scenario",
				            "ProjectKey",
				            "Amount"
				        }
				    ),
				    Typed = fxApplyTypes(
				        Rows,
				        {
				            {"Date", type date},
				            {"Scenario", type text},
				            {"ProjectKey", type text},
				            {"Amount", type number}
				        },
				        [Culture = "en-US"]
				    )
				in
				    Typed

	annotation PBI_ResultType = Table

