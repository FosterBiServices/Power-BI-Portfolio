/// Monthly sales by location, product line and customer, for Actual, Budget and Forecast. Revenue and cost of sales in the general ledger are these rows summed.
table Sales
	lineageTag: 6ff4b258-2ef2-58b4-93a7-dd83ff53b25b

	/// Month end. Links to Date.
	column 'Date'
		isHidden
		dataType: dateTime
		formatString: Short Date
		lineageTag: f01293b2-a080-51c2-9fa0-795cf26da114
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	/// Actual, Budget or Forecast. Links to Scenario.
	column Scenario
		dataType: string
		isHidden
		lineageTag: 2af66b8f-3bb9-5203-8eaf-c06885883746
		summarizeBy: none
		sourceColumn: Scenario

		annotation SummarizationSetBy = Automatic

	/// Links to Locations.
	column LocationKey
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: e602d036-27e6-5cf4-8c37-0e6c438648fb
		summarizeBy: none
		sourceColumn: LocationKey

		annotation SummarizationSetBy = Automatic

	/// Links to Products.
	column ProductKey
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: d8d93316-95d5-592e-8de5-aa749769286f
		summarizeBy: none
		sourceColumn: ProductKey

		annotation SummarizationSetBy = Automatic

	/// Links to Customers.
	column CustomerKey
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: d379231f-1c9e-5ddd-ac31-4fb02f5a8667
		summarizeBy: none
		sourceColumn: CustomerKey

		annotation SummarizationSetBy = Automatic

	/// Units sold (sessions or hours for services).
	column Units
		dataType: int64
		formatString: #,0
		lineageTag: c89fed3f-e4d3-509e-b421-408fd0142104
		summarizeBy: sum
		sourceColumn: Units

		annotation SummarizationSetBy = Automatic

	/// Units at the price charged, before discounts.
	column 'Gross Sales'
		dataType: double
		formatString: #,0
		lineageTag: 723e0619-c838-5901-9253-dc7a176d9d77
		summarizeBy: sum
		sourceColumn: Gross Sales

		annotation SummarizationSetBy = Automatic

	/// Discounts, markdowns and trade discounts.
	column Discounts
		dataType: double
		formatString: #,0
		lineageTag: 9f0aa833-ff82-5b05-acf7-f7900e8a7982
		summarizeBy: sum
		sourceColumn: Discounts

		annotation SummarizationSetBy = Automatic

	/// Gross sales less discounts.
	column 'Net Sales'
		dataType: double
		formatString: #,0
		lineageTag: ff2f0668-1b8d-52f4-af4a-b778ff636390
		summarizeBy: sum
		sourceColumn: Net Sales

		annotation SummarizationSetBy = Automatic

	/// Product cost (or service delivery cost) of the units.
	column 'Cost of Sales'
		dataType: double
		formatString: #,0
		lineageTag: dd04bfda-664b-58bf-a650-fcc8d588f673
		summarizeBy: sum
		sourceColumn: Cost of Sales

		annotation SummarizationSetBy = Automatic

	partition Sales = m
		mode: import
		source =
				let
				    // rows from sample-data/csv/Sales.csv, stored in the query as Base64 text of raw-deflate compressed JSON (no data source needed)
				    Source = Json.Document(
				        Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)
				    ),
				    Rows = Table.FromRows(
				        Source,
				        {
				            "Date",
				            "Scenario",
				            "LocationKey",
				            "ProductKey",
				            "CustomerKey",
				            "Units",
				            "Gross Sales",
				            "Discounts",
				            "Net Sales",
				            "Cost of Sales"
				        }
				    ),
				    Typed = fxApplyTypes(
				        Rows,
				        {
				            {"Date", type date},
				            {"Scenario", type text},
				            {"LocationKey", Int64.Type},
				            {"ProductKey", Int64.Type},
				            {"CustomerKey", Int64.Type},
				            {"Units", Int64.Type},
				            {"Gross Sales", type number},
				            {"Discounts", type number},
				            {"Net Sales", type number},
				            {"Cost of Sales", type number}
				        },
				        [Culture = "en-US"]
				    )
				in
				    Typed

	annotation PBI_ResultType = Table

