	measure '<SPACER_MEASURE_NAME>' = If ( ISBLANK([<VALUE_MEASURE>]), BLANK(), 0 )
		formatString: <SPACER_FORMAT_STRING>

	measure '<CATEGORY_LABEL_MEASURE_NAME>' = SELECTEDVALUE(<CATEGORY_TABLE>[<CATEGORY_COLUMN>])

	measure '<PERCENT_MEASURE_NAME>' = DIVIDE ( [<VALUE_MEASURE>], CALCULATE ( [<VALUE_MEASURE>], ALLSELECTED ( <CATEGORY_TABLE>[<CATEGORY_COLUMN>] ) ) )
		formatString: <PERCENT_FORMAT_STRING>

	measure '<SUBTITLE_MEASURE_NAME>' = ```

			var _value = [<SUBTITLE_VALUE_MEASURE>]
			var _Header = "<SUBTITLE_PREFIX_TEXT>"
			RETURN
			_Header & FORMAT(_value,"<SUBTITLE_VALUE_FORMAT>")
			```
