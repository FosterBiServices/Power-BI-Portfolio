{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.10.0/schema.json",
  "name": "<VISUAL_ID>",
  "position": {
    "x": <POS_X>,
    "y": <POS_Y>,
    "z": <POS_Z>,
    "height": <POS_HEIGHT>,
    "width": <POS_WIDTH>,
    "tabOrder": <TAB_ORDER>
  },
  "visual": {
    "visualType": "<VISUAL_TYPE>",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "<CATEGORY_TABLE>"
                    }
                  },
                  "Property": "<CATEGORY_COLUMN>"
                }
              },
              "queryRef": "<CATEGORY_TABLE>.<CATEGORY_COLUMN>",
              "nativeQueryRef": "<CATEGORY_COLUMN>",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "<MEASURES_TABLE>"
                    }
                  },
                  "Property": "<SPACER_MEASURE_NAME>"
                }
              },
              "queryRef": "<MEASURES_TABLE>.<SPACER_MEASURE_NAME>",
              "nativeQueryRef": "<SPACER_MEASURE_NAME>"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "<MEASURES_TABLE>"
                    }
                  },
                  "Property": "<VALUE_MEASURE>"
                }
              },
              "queryRef": "<MEASURES_TABLE>.<VALUE_MEASURE>",
              "nativeQueryRef": "<VALUE_MEASURE>"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "<MEASURES_TABLE>"
                  }
                },
                "Property": "<VALUE_MEASURE>"
              }
            },
            "direction": "Descending"
          }
        ]
      }
    },
    "objects": {
      "labels": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "enableDetailDataLabel": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "detailContentType": {
              "expr": {
                "Literal": {
                  "Value": "'Custom'"
                }
              }
            }
          }
        },
        {
          "properties": {
            "dynamicLabelValue": {
              "expr": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "<MEASURES_TABLE>"
                    }
                  },
                  "Property": "<CATEGORY_LABEL_MEASURE_NAME>"
                }
              }
            },
            "dynamicLabelDetail": {
              "expr": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "<MEASURES_TABLE>"
                    }
                  },
                  "Property": "<PERCENT_MEASURE_NAME>"
                }
              }
            }
          },
          "selector": {
            "data": [
              {
                "dataViewWildcard": {
                  "matchingOption": 1
                }
              }
            ],
            "metadata": "<MEASURES_TABLE>.<SPACER_MEASURE_NAME>",
            "highlightMatching": 1
          }
        },
        {
          "properties": {
            "detailLabelDisplayUnits": {
              "expr": {
                "Literal": {
                  "Value": "<LABEL_DISPLAY_UNITS>"
                }
              }
            }
          },
          "selector": {
            "metadata": "<MEASURES_TABLE>.<SPACER_MEASURE_NAME>"
          }
        },
        {
          "properties": {
            "labelDisplayUnits": {
              "expr": {
                "Literal": {
                  "Value": "<LABEL_DISPLAY_UNITS>"
                }
              }
            },
            "italic": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "labelPosition": {
              "expr": {
                "Literal": {
                  "Value": "'OutsideEnd'"
                }
              }
            },
            "color": {
              "solid": {
                "color": {
                  "expr": {
                    "ThemeDataColor": {
                      "ColorId": <LABEL_COLOR_THEME_ID>,
                      "Percent": <LABEL_COLOR_PERCENT>
                    }
                  }
                }
              }
            },
            "enableBackground": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "backgroundColor": {
              "solid": {
                "color": {
                  "expr": {
                    "ThemeDataColor": {
                      "ColorId": <LABEL_BACKGROUND_THEME_ID>,
                      "Percent": <LABEL_BACKGROUND_PERCENT>
                    }
                  }
                }
              }
            },
            "backgroundTransparency": {
              "expr": {
                "Literal": {
                  "Value": "<LABEL_BACKGROUND_TRANSPARENCY>"
                }
              }
            }
          },
          "selector": {
            "metadata": "<MEASURES_TABLE>.<VALUE_MEASURE>"
          }
        }
      ],
      "categoryAxis": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            },
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            },
            "innerPadding": {
              "expr": {
                "Literal": {
                  "Value": "<CATEGORY_INNER_PADDING>"
                }
              }
            }
          }
        }
      ],
      "valueAxis": [
        {
          "properties": {
            "showAxisTitle": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            },
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "legend": [
        {
          "properties": {
            "showGradientLegend": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            },
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "layout": [
        {
          "properties": {
            "clusteredGapSize": {
              "expr": {
                "Literal": {
                  "Value": "<CLUSTERED_GAP_SIZE>"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'<TITLE_TEXT>'"
                }
              }
            },
            "background": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "null"
                    }
                  }
                }
              }
            },
            "fontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "ThemeDataColor": {
                      "ColorId": <TITLE_FONT_COLOR_THEME_ID>,
                      "Percent": 0
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "text": {
              "expr": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "<MEASURES_TABLE>"
                    }
                  },
                  "Property": "<SUBTITLE_MEASURE_NAME>"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  },
  "filterConfig": {
    "filters": [
      {
        "name": "<FILTER_ID_CATEGORY>",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "<CATEGORY_TABLE>"
              }
            },
            "Property": "<CATEGORY_COLUMN>"
          }
        },
        "type": "Categorical",
        "isHiddenInViewMode": true
      },
      {
        "name": "<FILTER_ID_SPACER>",
        "field": {
          "Measure": {
            "Expression": {
              "SourceRef": {
                "Entity": "<MEASURES_TABLE>"
              }
            },
            "Property": "<SPACER_MEASURE_NAME>"
          }
        },
        "type": "Advanced",
        "isHiddenInViewMode": true
      },
      {
        "name": "<FILTER_ID_VALUE>",
        "field": {
          "Measure": {
            "Expression": {
              "SourceRef": {
                "Entity": "<MEASURES_TABLE>"
              }
            },
            "Property": "<VALUE_MEASURE>"
          }
        },
        "type": "Advanced",
        "isHiddenInViewMode": true
      }
    ]
  }
}
